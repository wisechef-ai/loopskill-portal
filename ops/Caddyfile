{
    log {
        output file /var/log/caddy/recipes-portal.log {
            roll_size 10mb
            roll_keep 5
        }
    }
    servers :3001 {
        protocols h1
    }
}

# ─────────────────────────────────────────────────────────────────────────
# APEX REDIRECT (mesh0408 W3) — NOT ACTIVE UNTIL DNS MOVES. See below.
#
# THE DEFECT THIS ENDS. loopskill.io (GitHub Pages, repo
# wisechef-ai/loopskill-landing) served a SECOND storefront with the retired
# "open registry" positioning, a superseded pricing ladder, and three nav
# targets that 404'd — /docs, /pricing, /llms.txt — because those pages only
# ever existed on app.loopskill.io. The apex is the hostname people type, and
# it was the stale one. Adam's call, 2026-08-07: app.loopskill.io is canonical.
#
# The interim fix is a meta-refresh redirector shipped in loopskill-landing.
# It works for humans but GitHub Pages cannot emit an HTTP 301, and it serves
# the path-preserving case with a 404 status. THIS block is the durable fix:
# a real 301, path and query preserved.
#
# ACTIVATION ORDER — do not reorder, the middle step is what avoids downtime:
#   1. Merge the loopskill-landing redirector PR (apex stops contradicting
#      the app while still on Pages).
#   2. Paste this block into /etc/caddy/Caddyfile on the portal host, then
#      `caddy validate --config /etc/caddy/Caddyfile` and
#      `sudo systemctl reload caddy`. Caddy provisions the certificate for
#      loopskill.io on first request, so it must be live BEFORE DNS moves.
#   3. Repoint DNS: replace the four GitHub Pages A records for loopskill.io
#      with a single A record to this host, and repoint the www CNAME.
#      Exact values are in /tmp/ISSUES-w3.md.
#   4. Probe /docs, /pricing and /llms.txt at the apex and confirm 301 —
#      NOT just `/`. Trap E7: a root-path check would have passed throughout
#      the entire period this defect existed.
#
# Keep the two path exceptions. `curl -fsSL loopskill.io/install | sh` is
# published in the wild and must keep returning the script, not a redirect to
# an HTML page that a shell would then try to execute.
# ─────────────────────────────────────────────────────────────────────────
# loopskill.io, www.loopskill.io {
#     encode gzip zstd
#
#     # Published install one-liner — serve, never redirect.
#     handle /install {
#         root * /home/wisechef/loopskill-portal/dist
#         rewrite * /install.sh
#         file_server
#     }
#
#     # Social cards already shared against apex URLs.
#     handle /og.png {
#         root * /home/wisechef/loopskill-portal/dist
#         rewrite * /og-default.png
#         file_server
#     }
#
#     # Everything else: one storefront, permanently.
#     redir https://app.loopskill.io{uri} permanent
# }

:3001 {
    encode gzip zstd

    # /skill -> redirect to raw GitHub
    redir /skill https://raw.githubusercontent.com/wisechef-ai/recipes-skill/main/SKILL.md 302
    redir /skill/ https://raw.githubusercontent.com/wisechef-ai/recipes-skill/main/SKILL.md 302
    redir /SKILL.md https://raw.githubusercontent.com/wisechef-ai/recipes-skill/main/SKILL.md 302

    # /fleet -> framework installer (stabilization_2605 Phase C).
    # The static portal serves a self-contained fallback at /fleet/install.sh.
    # The redirect points operators at the always-fresh GitHub HEAD.
    redir /fleet https://raw.githubusercontent.com/wisechef-ai/recipes-skill/main/recipes-installer/install-fleet.sh 302

    # API reverse proxy
    handle /api/* {
        reverse_proxy localhost:8200
    }
    handle /api {
        reverse_proxy localhost:8200
    }

    # Static multi-page site. Astro emits per-route index.html files.
    # try_files resolves: /skills -> /skills/index.html (NOT homepage fallback).
    handle {
        # 2026-08-07: was /home/wisechef/recipes-portal/dist, which has not been
        # the served root since the loopskill rename. A reference file naming the
        # wrong root is how the 2026-07-17→25 deploys stayed green while shipping
        # nothing; CLAUDE.md has the real path and this file now agrees with it.
        root * /home/wisechef/loopskill-portal/dist
        try_files {path} {path}/index.html {path}.html
        file_server
    }
}
