---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IntentSurvey from '../components/IntentSurvey.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: 'website' | 'product' | 'article';
}

const {
  title = 'Recipes — The recipe book for AI agents',
  description = 'A skill marketplace for AI agents. One install, agency-grade tools — client reporting, content calendars, SEO audits, proposals — installed by your agent in seconds. By WiseChef.',
  ogImage = '/og-default.png',
  pageType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://recipes.wisechef.ai');
const ogTitle = title.includes('Recipes') ? title : `${title} | Recipes`;
const siteURL = 'https://recipes.wisechef.ai';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Recipes',
  alternateName: 'Recipes by WiseChef',
  url: siteURL,
  logo: `${siteURL}/favicon.svg`,
  description,
  parentOrganization: {
    '@type': 'Organization',
    name: 'WiseChef',
    url: 'https://wisechef.ai',
  },
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Recipes by WiseChef" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{ogTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
  </head>
  <body class="bg-bg text-text font-sans antialiased min-h-screen flex flex-col">
    <script is:inline>
      // WIS-660: Detect ?ref=<code> on any page → set referral cookie (30-day TTL)
      (function() {
        var p = new URLSearchParams(window.location.search);
        var ref = p.get('ref');
        if (ref && /^[A-Za-z0-9]{4,16}$/.test(ref)) {
          document.cookie = 'recipes_ref=' + ref + '; Max-Age=2592000; Path=/; SameSite=Lax';
          // Clean URL
          var u = new URL(window.location.href);
          u.searchParams.delete('ref');
          window.history.replaceState({}, '', u.toString());
        }
      })();
    </script>
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-bg focus:font-semibold focus:text-sm">
      Skip to content
    </a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <IntentSurvey />
  </body>
</html>
