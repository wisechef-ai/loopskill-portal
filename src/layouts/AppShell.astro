---
// AppShell.astro — THE one chrome for recipes.wisechef.ai (onechrome_0611).
//
// portal_0610 J1 shipped this as the authed "Garden" shell (left rail: Home ·
// Search · Your Library · Fleets · Delivery + live cookbook list).
// onechrome_0611 P0 adds the `mode` contract so the SAME chrome serves the
// whole site:
//
//   mode="member" (default) — member surfaces (/home, /library, /fleets,
//     /cockpit, /composer, account, dashboards). Anonymous visitors are
//     bounced to /signin?next=… behind a gate splash. Zero behavior change
//     for the 5 pre-P0 consumers.
//
//   mode="public" — public-browse surfaces (marketplace, pricing, docs,
//     legal…). NO anon bounce, NO gate splash (anon-first static render).
//     The rail renders sign-in CTAs by default; if /api/auth/me resolves a
//     session, JS swaps in the live member rail (cookbooks + account footer).
//     Member-only nav stays VISIBLE for discoverability — anon clicks land
//     on /signin?next=<target> via the member-nav links' normal hrefs
//     (AppShell member pages bounce, preserving intent).
//
// State-swap rules (skill: tailwind-auth-aware-ui-class-toggle-trap):
//   - Both anon + member rail states exist in the public-mode static HTML
//     (Trap C: never branch away a JS-fill target at build time).
//   - Swaps use classList AND inline style.display (Trap A: responsive
//     variants outrank `.hidden`).
//   - All auth fetches use credentials:'include' (Trap B pitfall 5).
//
// Public mode also carries the marketing-chrome responsibilities Base.astro
// used to own (Base retires in P3): canonical + OG/twitter tags, schema.org
// Organization JSON-LD, the WIS-660 ?ref= referral-cookie script, and the
// IntentSurvey exit modal. Member mode keeps robots=noindex.
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import IntentSurvey from '../components/IntentSurvey.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'search' | 'library' | 'fleets' | 'cockpit' | 'account' | '';
  mode?: 'member' | 'public';
  ogImage?: string;
  pageType?: 'website' | 'product' | 'article';
}

const {
  title = 'Recipes',
  description = 'Your agent-environment library — compose once, reproduce across every agent, sync your whole fleet.',
  active = '',
  mode = 'member',
  ogImage = '/og-default.png',
  pageType = 'website',
} = Astro.props;

const isPublic = mode === 'public';
const siteURL = 'https://recipes.wisechef.ai';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogTitle = title.includes('Recipes') ? title : `${title} | Recipes`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Recipes',
  alternateName: 'Recipes by WiseChef',
  url: siteURL,
  logo: `${siteURL}/favicon.svg`,
  description,
  parentOrganization: {
    '@type': 'Organization',
    name: 'WiseChef',
    url: 'https://wisechef.ai',
  },
};

const navItems = [
  { id: 'home',    href: '/home',    label: 'Home',         icon: 'M3 9.5L10 3l7 6.5M5 8.5V16h10V8.5' },
  { id: 'search',  href: '/skills',  label: 'Search',       icon: 'M8.5 14a5.5 5.5 0 100-11 5.5 5.5 0 000 11zM17 17l-3.5-3.5' },
  { id: 'library', href: '/library', label: 'Your Library', icon: 'M4 4h4v12H4zM10 4h2v12h-2zM14.5 4.2l3 .8-2.5 11.6-3-.8z' },
  { id: 'fleets',  href: '/fleets',  label: 'Fleets',       icon: 'M3 5h6v5H3zM11 5h6v5h-6zM7 13h6v4H7z' },
  { id: 'cockpit', href: '/cockpit', label: 'Delivery',     icon: 'M3 4h14v3H3zM3 9h14v7H3zM7 12h6' },
  { id: 'pricing', href: '/pricing', label: 'Pricing',      icon: 'M10 1v18M6 5h6.5a2.5 2.5 0 010 5H6m8 0H7.5a2.5 2.5 0 000 5H14' },
];
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {!isPublic && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Recipes by WiseChef" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{ogTitle}</title>
    {isPublic && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>}
  </head>
  <body class="bg-bg text-text font-sans antialiased min-h-screen flex flex-col">
    <script is:inline>
      // WIS-660: Detect ?ref=<code> on any page → set referral cookie (30-day TTL).
      // Runs on EVERY AppShell page (member too — harmless, a member clicking a
      // ref link just refreshes the cookie).
      (function() {
        var p = new URLSearchParams(window.location.search);
        var ref = p.get('ref');
        if (ref && /^[A-Za-z0-9]{4,16}$/.test(ref)) {
          document.cookie = 'recipes_ref=' + ref + '; Max-Age=2592000; Path=/; SameSite=Lax';
          var u = new URL(window.location.href);
          u.searchParams.delete('ref');
          window.history.replaceState({}, '', u.toString());
        }
      })();
    </script>

    <a href="#app-main"
       class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-bg focus:font-semibold focus:text-sm">
      Skip to content
    </a>

    {!isPublic && (
      <!-- Anon-gate splash (member mode only): covers until /api/auth/me resolves. -->
      <div id="appshell-gate" class="fixed inset-0 z-[60] flex items-center justify-center bg-bg">
        <p class="text-sm text-muted">Loading…</p>
      </div>
    )}

    <div class="flex flex-1 min-h-screen" id="appshell-root" data-mode={mode}>
      <!-- ── Left rail ──────────────────────────────────────────────── -->
      <aside class="hidden md:flex w-64 shrink-0 flex-col border-r border-border bg-bg/60 sticky top-0 h-screen overflow-y-auto"
             aria-label="App navigation">
        <a href={isPublic ? '/' : '/home'} class="flex items-center gap-2.5 px-5 h-16 shrink-0 border-b border-border group">
          <span class="relative flex items-center justify-center w-9 h-9 rounded-lg bg-gradient-to-br from-accent/15 to-cool/10 border border-accent/40 group-hover:border-accent/70 transition">
            <img src="/brand/mark-96.png?v=2" alt="" width="28" height="28" class="select-none" />
          </span>
          <span class="text-base font-semibold tracking-tight group-hover:text-accent transition">Recipes</span>
        </a>

        <!-- ── Unified search (onechrome_0611 P4): ONE box, TWO result groups —
             "In Marketplace" (live /api/skills/search) + "In Your Cookbooks"
             (client match on the member's cookbook names). Kills "am I
             searching the store or my stuff?". Esc or blur closes. -->
        <div class="px-3 pt-3 relative" id="shell-search-wrap">
          <div class="relative">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"
                 class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-soft pointer-events-none">
              <path d="M8.5 14a5.5 5.5 0 100-11 5.5 5.5 0 000 11zM17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input id="shell-search" type="search" placeholder="Search skills…" autocomplete="off"
                   aria-label="Search skills and your cookbooks"
                   class="w-full pl-9 pr-3 py-2 rounded-lg bg-bg-card border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
          </div>
          <div id="shell-search-results"
               class="hidden absolute left-3 right-3 top-full mt-1.5 z-[70] bg-bg-elev border border-border rounded-xl shadow-2xl overflow-hidden max-h-[60vh] overflow-y-auto">
          </div>
        </div>

        <nav class="flex flex-col gap-0.5 px-3 py-4" aria-label="Primary">
          {navItems.map((item) => (
            <a href={item.href}
               class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition ${active === item.id ? 'bg-accent/12 text-text font-medium' : 'text-muted hover:text-text hover:bg-bg-card'}`}
               aria-current={active === item.id ? 'page' : undefined}>
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d={item.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>

        <!-- Rail body: anon CTA (public default) ⇄ live cookbook list (member). -->
        {isPublic && (
          <div class="px-3 pb-4 flex-1 min-h-0" data-shell-anon>
            <div class="mx-3 rounded-xl border border-border bg-bg-card/50 p-4 flex flex-col gap-2.5">
              <span class="text-[10px] uppercase tracking-widest text-muted-soft">Your cookbooks</span>
              <p class="text-xs text-muted leading-relaxed">Sign in to bundle skills into cookbooks and sync them to your whole fleet.</p>
              <a href="/signin" data-signin-next
                 class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition">
                Sign in to build cookbooks
              </a>
              <a href="/pricing" class="text-center text-[11px] text-muted-soft hover:text-accent transition">View plans — Pro $20 · Pro+ $100</a>
            </div>
          </div>
        )}
        <div class={`px-3 pb-4 flex-1 min-h-0 ${isPublic ? 'hidden' : ''}`} data-shell-member>
          <div class="flex items-center justify-between px-3 mb-1.5">
            <span class="text-[10px] uppercase tracking-widest text-muted-soft">Your cookbooks</span>
            <a href="/composer" class="text-muted-soft hover:text-accent text-base leading-none" title="New cookbook" aria-label="New cookbook">+</a>
          </div>
          <div id="rail-cookbooks" class="flex flex-col gap-0.5">
            <p id="rail-cookbooks-empty" class="px-3 py-2 text-xs text-muted-soft">No cookbooks yet.</p>
          </div>
        </div>

        <!-- Rail footer: sign-in (public default) ⇄ account (member). -->
        {isPublic && (
          <div class="border-t border-border px-3 py-3 shrink-0" data-shell-anon>
            <a href="/signin" data-signin-next
               class="flex items-center gap-2.5 px-2 py-2 rounded-lg hover:bg-bg-card transition">
              <span class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center text-xs font-semibold shrink-0">→</span>
              <span class="flex flex-col min-w-0">
                <span class="text-xs text-text truncate">Sign in</span>
                <span class="text-[10px] text-muted-soft uppercase tracking-wider">free to start</span>
              </span>
            </a>
          </div>
        )}
        <div class={`border-t border-border px-3 py-3 shrink-0 ${isPublic ? 'hidden' : ''}`} data-shell-member>
          <!-- Ambient fleet status (P4): "show don't tell" — live from /api/fleets + /api/cookbooks. -->
          <p id="rail-fleet-status" class="hidden px-2 pb-2 text-[10px] text-muted-soft leading-relaxed"></p>
          <a href="/account" class={`flex items-center gap-2.5 px-2 py-2 rounded-lg transition ${active === 'account' ? 'bg-accent/12' : 'hover:bg-bg-card'}`}>
            <span id="rail-avatar" class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center text-xs font-semibold overflow-hidden shrink-0">·</span>
            <span class="flex flex-col min-w-0">
              <span id="rail-user-name" class="text-xs text-text truncate">Account</span>
              <span id="rail-user-plan" class="text-[10px] text-muted-soft uppercase tracking-wider">free</span>
            </span>
          </a>
          <button id="rail-signout" type="button" class="w-full mt-1 flex items-center gap-2.5 px-2 py-2 rounded-lg text-muted-soft hover:text-text hover:bg-bg-card transition text-xs">
            <span class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center shrink-0" aria-hidden="true">⏻</span>
            <span>Sign out</span>
          </button>
        </div>
      </aside>

      <!-- ── Main content ──────────────────────────────────────────── -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Mobile top bar (rail collapses on small screens) -->
        <header class="md:hidden sticky top-0 z-40 flex items-center justify-between gap-3 h-14 px-4 border-b border-border bg-bg/85 backdrop-blur-md">
          <a href={isPublic ? '/' : '/home'} class="flex items-center gap-2 font-semibold">
            <img src="/brand/mark-96.png?v=2" alt="" width="26" height="26" />
            <span>Recipes</span>
          </a>
          <details class="relative" id="appshell-mobile-menu">
            <summary class="list-none cursor-pointer p-2 text-muted hover:text-text" aria-label="Menu">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect y="3" width="20" height="2" rx="1" fill="currentColor"/><rect y="9" width="20" height="2" rx="1" fill="currentColor"/><rect y="15" width="20" height="2" rx="1" fill="currentColor"/></svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-52 bg-bg-elev border border-border rounded-xl shadow-xl overflow-hidden z-50">
              <nav class="flex flex-col text-sm">
                {navItems.map((item) => (
                  <a href={item.href} class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">{item.label}</a>
                ))}
                {isPublic && (
                  <a href="/signin" data-signin-next data-shell-anon class="px-4 py-3 text-accent font-medium hover:bg-bg-card transition border-t border-border">Sign in</a>
                )}
                <a href="/account" data-shell-member class={`px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition border-t border-border ${isPublic ? 'hidden' : ''}`}>Account</a>
                <button id="rail-signout-mobile" type="button" data-shell-member class={`px-4 py-3 text-left text-muted hover:text-text hover:bg-bg-card transition border-t border-border ${isPublic ? 'hidden' : ''}`}>Sign out</button>
              </nav>
            </div>
          </details>
        </header>

        <main id="app-main" class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    {isPublic && <IntentSurvey />}

    <script>
      // AppShell hydration — mode-aware auth gate + rail population.
      (async () => {
        const root = document.getElementById('appshell-root');
        const mode = root?.getAttribute('data-mode') || 'member';
        const gate = document.getElementById('appshell-gate');

        let user: any = null;
        try {
          const res = await fetch('/api/auth/me', { credentials: 'include' });
          if (res.ok) user = await res.json();
        } catch { /* network error → treat as anon */ }

        if (!user) {
          if (mode === 'member') {
            // Member surface — bounce anonymous visitors to sign-in, preserving intent.
            const next = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/signin?next=${next}`;
            return;
          }
          // Public surface, anonymous visitor: static anon state is already
          // correct. Just thread ?next= into the sign-in CTAs so OAuth
          // returns the visitor HERE, not /library.
          document.querySelectorAll<HTMLAnchorElement>('[data-signin-next]').forEach((a) => {
            a.href = `/signin?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
          });
          return;
        }
        gate?.remove();

        // Member confirmed. In public mode, swap anon rail → member rail.
        // classList AND inline style.display: responsive variants (md:flex)
        // outrank `.hidden` in the cascade (Trap A).
        document.querySelectorAll<HTMLElement>('[data-shell-anon]').forEach((el) => {
          el.classList.add('hidden');
          el.style.display = 'none';
        });
        document.querySelectorAll<HTMLElement>('[data-shell-member]').forEach((el) => {
          el.classList.remove('hidden');
          el.style.display = '';
        });

        // User footer
        const initials = (user.display_name || user.email || '?').slice(0, 1).toUpperCase();
        const avatar = document.getElementById('rail-avatar');
        if (avatar) {
          avatar.textContent = user.avatar_url ? '' : initials;
          if (user.avatar_url) avatar.innerHTML = `<img src="${user.avatar_url}" alt="" class="w-full h-full object-cover" referrerpolicy="no-referrer"/>`;
        }
        const nameEl = document.getElementById('rail-user-name');
        if (nameEl) nameEl.textContent = user.display_name || user.email || 'Account';
        const planEl = document.getElementById('rail-user-plan');
        const tier = (user.subscription_tier || 'free').toLowerCase();
        const status = user.subscription_status || '';
        const paidActive = ['active', 'trialing', 'past_due'].includes(status);
        if (planEl) planEl.textContent = (paidActive && tier !== 'free') ? tier.replace('_', '+') : 'free';

        // Live cookbook rail
        let userCookbooks: any[] = [];
        try {
          const cbRes = await fetch('/api/cookbooks', { credentials: 'include' });
          if (cbRes.ok) {
            const data = await cbRes.json();
            const cbooks = (data && data.cookbooks) || [];
            userCookbooks = cbooks;
            const wrap = document.getElementById('rail-cookbooks');
            const empty = document.getElementById('rail-cookbooks-empty');
            if (wrap && cbooks.length) {
              empty?.remove();
              wrap.innerHTML = cbooks.map((cb: any) =>
                `<a href="/cookbooks/view?id=${encodeURIComponent(cb.id)}" class="px-3 py-1.5 rounded-md text-xs text-muted hover:text-text hover:bg-bg-card transition truncate" title="${(cb.name||'').replace(/"/g,'&quot;')}">${cb.name || 'Untitled'}</a>`
              ).join('');
            }
          }
        } catch { /* rail is best-effort */ }
        // Expose for the unified-search "In Your Cookbooks" group.
        (window as any).__shellCookbooks = userCookbooks;

        // ── Ambient fleet status (P4) — honest numbers only, hidden when zero.
        try {
          const flRes = await fetch('/api/fleets', { credentials: 'include' });
          if (flRes.ok) {
            const fl = await flRes.json();
            const fleets = (fl && (fl.fleets || fl.items)) || [];
            const el = document.getElementById('rail-fleet-status');
            if (el && (fleets.length || userCookbooks.length)) {
              const bits: string[] = [];
              if (userCookbooks.length) bits.push(`${userCookbooks.length} cookbook${userCookbooks.length === 1 ? '' : 's'}`);
              if (fleets.length) bits.push(`${fleets.length} fleet${fleets.length === 1 ? '' : 's'} syncing`);
              el.textContent = bits.join(' · ');
              el.classList.remove('hidden');
              el.style.display = '';
            }
          }
        } catch { /* ambient is best-effort */ }

        // ── First-login onboarding pane (P4) — fires once, localStorage flag.
        try {
          const OB_KEY = 'recipes_onboarding_v1';
          if (!localStorage.getItem(OB_KEY) && !userCookbooks.length) {
            const main = document.getElementById('app-main');
            if (main) {
              const pane = document.createElement('div');
              pane.id = 'shell-onboarding';
              pane.className = 'max-w-6xl mx-auto px-6 pt-6';
              pane.innerHTML = `
                <div class="relative rounded-2xl border border-accent/30 bg-gradient-to-br from-accent/8 to-cool/5 p-5 md:p-6">
                  <button type="button" id="shell-onboarding-close" aria-label="Dismiss onboarding"
                          class="absolute top-3 right-3 p-2 -m-1 text-muted-soft hover:text-text transition">
                    <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 4L14 14M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  </button>
                  <p class="text-[10px] uppercase tracking-widest text-accent mb-2">Welcome — here's the loop</p>
                  <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-sm">
                    <a href="/skills" class="group flex flex-col gap-1 rounded-xl border border-border-soft bg-bg/40 p-3 hover:border-accent/50 transition">
                      <span class="text-muted-soft text-xs">1</span>
                      <span class="font-semibold text-text group-hover:text-accent transition">Find a skill</span>
                      <span class="text-xs text-muted">Search the catalog.</span>
                    </a>
                    <a href="/composer" class="group flex flex-col gap-1 rounded-xl border border-border-soft bg-bg/40 p-3 hover:border-accent/50 transition">
                      <span class="text-muted-soft text-xs">2</span>
                      <span class="font-semibold text-text group-hover:text-accent transition">Add to a cookbook</span>
                      <span class="text-xs text-muted">Bundle what you need.</span>
                    </a>
                    <a href="/fleets" class="group flex flex-col gap-1 rounded-xl border border-border-soft bg-bg/40 p-3 hover:border-accent/50 transition">
                      <span class="text-muted-soft text-xs">3</span>
                      <span class="font-semibold text-text group-hover:text-accent transition">Deploy to your fleet</span>
                      <span class="text-xs text-muted">One key, every agent.</span>
                    </a>
                    <div class="flex flex-col gap-1 rounded-xl border border-border-soft bg-bg/40 p-3">
                      <span class="text-muted-soft text-xs">4</span>
                      <span class="font-semibold text-text">Agents use it</span>
                      <span class="text-xs text-muted">Synced, signed, auto-updated.</span>
                    </div>
                  </div>
                </div>`;
              main.prepend(pane);
              document.getElementById('shell-onboarding-close')?.addEventListener('click', () => {
                localStorage.setItem(OB_KEY, '1');
                pane.remove();
              });
            }
          }
        } catch { /* onboarding is best-effort */ }

        // Sign out — both rail (desktop) and mobile menu, mirrors /account.
        const _logout = async () => {
          try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch {}
          window.location.href = '/';
        };
        document.getElementById('rail-signout')?.addEventListener('click', _logout);
        document.getElementById('rail-signout-mobile')?.addEventListener('click', _logout);
      })();
    </script>

    <script>
      // ── Unified search (P4): one box, two result groups. Marketplace via
      // /api/skills/search (anon-OK), "In Your Cookbooks" from the member's
      // rail cache (window.__shellCookbooks, empty for anon). Debounced 200ms.
      (() => {
        const input = document.getElementById('shell-search') as HTMLInputElement | null;
        const panel = document.getElementById('shell-search-results');
        if (!input || !panel) return;

        const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        let timer: ReturnType<typeof setTimeout> | undefined;
        let seq = 0;

        const close = () => { panel.classList.add('hidden'); panel.innerHTML = ''; };

        const render = (q: string, skills: any[], cookbooks: any[]) => {
          const mk = skills.slice(0, 6).map((s: any) =>
            `<a href="/skills/${encodeURIComponent(s.slug)}" class="flex items-start gap-2.5 px-4 py-2.5 hover:bg-bg-card transition">
               <span class="flex flex-col min-w-0">
                 <span class="text-sm text-text truncate">${esc(s.title || s.slug)}</span>
                 <span class="text-xs text-muted truncate">${esc((s.description || '').slice(0, 90))}</span>
               </span>
             </a>`).join('');
          const cb = cookbooks.slice(0, 4).map((c: any) =>
            `<a href="/cookbooks/view?id=${encodeURIComponent(c.id)}" class="flex items-center gap-2.5 px-4 py-2.5 hover:bg-bg-card transition">
               <span class="text-sm text-text truncate">${esc(c.name || 'Untitled')}</span>
             </a>`).join('');
          panel.innerHTML =
            `<div class="px-4 pt-3 pb-1 text-[10px] uppercase tracking-widest text-muted-soft">In Marketplace</div>` +
            (mk || `<p class="px-4 py-2.5 text-xs text-muted-soft">No catalog matches.</p>`) +
            (cb ? `<div class="px-4 pt-3 pb-1 text-[10px] uppercase tracking-widest text-muted-soft border-t border-border-soft mt-1">In Your Cookbooks</div>${cb}` : '') +
            `<a href="/skills?q=${encodeURIComponent(q)}" class="block px-4 py-2.5 text-xs text-accent hover:bg-bg-card transition border-t border-border-soft">See all results →</a>`;
          panel.classList.remove('hidden');
        };

        const run = async (q: string) => {
          const mySeq = ++seq;
          let skills: any[] = [];
          try {
            const r = await fetch(`/api/skills/search?q=${encodeURIComponent(q)}&page_size=6`, { credentials: 'include' });
            if (r.ok) { const d = await r.json(); skills = (d && (d.results || d.items)) || []; }
          } catch { /* offline → cookbook group still renders */ }
          if (mySeq !== seq) return; // stale response
          const ql = q.toLowerCase();
          const cbs = (((window as any).__shellCookbooks) || []).filter((c: any) =>
            (c.name || '').toLowerCase().includes(ql) || (c.description || '').toLowerCase().includes(ql));
          render(q, skills, cbs);
        };

        input.addEventListener('input', () => {
          const q = input.value.trim();
          if (timer) clearTimeout(timer);
          if (q.length < 2) { close(); return; }
          timer = setTimeout(() => run(q), 200);
        });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { close(); input.blur(); }
          if (e.key === 'Enter') {
            const q = input.value.trim();
            if (q) window.location.href = `/skills?q=${encodeURIComponent(q)}`;
          }
        });
        document.addEventListener('click', (e) => {
          const wrap = document.getElementById('shell-search-wrap');
          if (wrap && !wrap.contains(e.target as Node)) close();
        });
      })();
    </script>
  </body>
</html>
