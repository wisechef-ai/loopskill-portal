---
// AppShell.astro — THE one chrome for app.loopskill.io (onechrome_0611).
//
// portal_0610 J1 shipped this as the authed "Garden" shell (left rail: Home ·
// Search · Your Library · Fleets · Delivery + live bundle list).
// onechrome_0611 P0 adds the `mode` contract so the SAME chrome serves the
// whole site:
//
//   mode="member" (default) — member surfaces (/home, /library, /fleets,
//     /cockpit, /composer, account, dashboards). Anonymous visitors are
//     bounced to /signin?next=… behind a gate splash. Zero behavior change
//     for the 5 pre-P0 consumers.
//
//   mode="public" — public-browse surfaces (marketplace, pricing, docs,
//     legal…). NO anon bounce, NO gate splash (anon-first static render).
//     The rail renders sign-in CTAs by default; if /api/auth/me resolves a
//     session, JS swaps in the live member rail (bundles + account footer).
//     Member-only nav stays VISIBLE for discoverability — anon clicks land
//     on /signin?next=<target> via the member-nav links' normal hrefs
//     (AppShell member pages bounce, preserving intent).
//
// State-swap rules (skill: tailwind-auth-aware-ui-class-toggle-trap):
//   - Both anon + member rail states exist in the public-mode static HTML
//     (Trap C: never branch away a JS-fill target at build time).
//   - Swaps use classList AND inline style.display (Trap A: responsive
//     variants outrank `.hidden`).
//   - All auth fetches use credentials:'include' (Trap B pitfall 5).
//
// Public mode also carries the marketing-chrome responsibilities Base.astro
// used to own (Base retires in P3): canonical + OG/twitter tags, schema.org
// Organization JSON-LD, the WIS-660 ?ref= referral-cookie script, and the
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import LoopMark from '../components/LoopMark.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'browse' | 'search' | 'library' | 'fleets' | 'cockpit' | 'account' | 'personalities' | 'pricing' | '';
  mode?: 'member' | 'public';
  ogImage?: string;
  pageType?: 'website' | 'product' | 'article';
}

const {
  title = 'LoopSkill',
  description = 'LoopSkill — the open-source registry of vetted, runnable agent loops. Press run, get an objective pass/fail under enforced safety bounds. Plus an 80k+ skill library and shareable bundles.',
  active = '',
  mode = 'member',
  ogImage = '/og-default.png',
  pageType = 'website',
} = Astro.props;

const isPublic = mode === 'public';
// identity-guards fix (2026-07-05): canonical MUST match where content
// actually lives. Content is served from app.loopskill.io; the apex
// loopskill.io serves ONLY a root page (every other path 404s there), so
// canonicaling to the apex told Google to index dead URLs.
const siteURL = 'https://app.loopskill.io';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogTitle = title.includes('LoopSkill') ? title : `${title} | LoopSkill`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LoopSkill',
  alternateName: 'LoopSkill',
  url: siteURL,
  logo: `${siteURL}/favicon.svg`,
  description,
  parentOrganization: {
    '@type': 'Organization',
    name: 'WiseChef',
    url: 'https://wisechef.ai',
  },
};

// Spotify-model IA (feat/spotify-ia, council report §1): exactly three
// primary rail destinations. Pricing is a smaller pill below, never a
// primary nav item. Icons: lucide-style, stroke 1.75, size 20 (rendered
// inline below — no emoji, no per-item color hacks; active/hover state is
// carried entirely by the shared .rail-link / .rail-active CSS classes in
// global.css so Home shelves, Browse, and the rail share one visual system).
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    {!isPublic && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="LoopSkill" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{ogTitle}</title>
    {isPublic && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>}
    <slot name="head" />
  </head>
  <body class="bg-bg text-text font-sans antialiased min-h-screen flex flex-col">
    <script is:inline>
      // WIS-660: Detect ?ref=<code> on any page → set referral cookie (30-day TTL).
      // Runs on EVERY AppShell page (member too — harmless, a member clicking a
      // ref link just refreshes the cookie).
      //
      // qa0208-w3 (dual-accept rename, portal lane): loopskill_ref is now
      // primary; recipes_ref is written IN PARALLEL during the deprecation
      // window so anything still reading the legacy name (server-side or
      // client-side, ours or a stale cached script) keeps working. The API
      // reads loopskill_ref first, falls back to recipes_ref — do not drop
      // the legacy write until the API lane confirms it's safe.
      (function() {
        var p = new URLSearchParams(window.location.search);
        var ref = p.get('ref');
        if (ref && /^[A-Za-z0-9]{4,16}$/.test(ref)) {
          var cookieTail = '=' + ref + '; Max-Age=2592000; Path=/; SameSite=Lax';
          document.cookie = 'loopskill_ref' + cookieTail;
          document.cookie = 'recipes_ref' + cookieTail;
          var u = new URL(window.location.href);
          u.searchParams.delete('ref');
          window.history.replaceState({}, '', u.toString());
        }
      })();
    </script>

    <a href="#app-main"
       class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-accent focus:text-bg focus:font-semibold focus:text-sm">
      Skip to content
    </a>

    {!isPublic && (
      <!-- Anon-gate splash (member mode only): covers until /api/auth/me resolves. -->
      <div id="appshell-gate" class="fixed inset-0 z-[60] flex items-center justify-center bg-bg">
        <p class="text-sm text-muted">Loading…</p>
      </div>
    )}

    <div class="flex flex-1 min-h-screen" id="appshell-root" data-mode={mode}>
      <!-- ── Left rail ──────────────────────────────────────────────── -->
      <aside class="hidden md:flex w-64 shrink-0 flex-col border-r border-border bg-bg/60 sticky top-0 h-screen overflow-y-auto"
             aria-label="App navigation">
        <a href={isPublic ? '/' : '/home'} class="flex items-center gap-2.5 px-5 h-16 shrink-0 border-b border-border group">
          <span class="relative flex items-center justify-center w-9 h-9 rounded-lg bg-gradient-to-br from-accent/15 to-cool/10 border border-accent/40 group-hover:border-accent/70 transition">
            <LoopMark size={28} class="select-none" />
          </span>
          <span class="text-base font-semibold tracking-tight group-hover:text-accent transition">LoopSkill</span>
        </a>

        <!-- Rail search (onechrome_0611 P4, retargeted feat/spotify-ia council §8):
             a thin handoff only — Browse owns search now. No live dropdown here
             (avoids two competing search concepts); Enter navigates to
             /browse?q=<value>. -->
        <div class="px-3 pt-3" id="shell-search-wrap">
          <div class="relative">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"
                 class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-soft pointer-events-none">
              <path d="M8.5 14a5.5 5.5 0 100-11 5.5 5.5 0 000 11zM17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input id="shell-search" type="search" placeholder="Search…" autocomplete="off"
                   aria-label="Search loops, skills, bundles, personalities"
                   class="w-full pl-9 pr-3 py-2 rounded-lg bg-bg-card border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
          </div>
        </div>

        <nav class="flex flex-col gap-0.5 px-3 pt-4 pb-2" aria-label="Primary">
          <a href="/home"
             class={`rail-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition ${active === 'home' ? 'rail-active font-medium' : 'text-muted hover:text-text'}`}
             aria-current={active === 'home' ? 'page' : undefined}>
            <svg class="rail-icon shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>Home</span>
          </a>
          <a href="/browse"
             class={`rail-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition ${active === 'browse' ? 'rail-active font-medium' : 'text-muted hover:text-text'}`}
             aria-current={active === 'browse' ? 'page' : undefined}>
            <svg class="rail-icon shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88"/>
            </svg>
            <span>Browse</span>
          </a>
          {/* Your Library — anon signs in (§1: href /signin?next=/library),
              member goes straight to /library. Both variants exist in static
              HTML per AGENTS.md Trap C; JS auth swap toggles which is visible. */}
          {isPublic && (
            <a href="/signin?next=/library" data-signin-next data-shell-anon
               class="rail-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition text-muted hover:text-text">
              <svg class="rail-icon shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>
              </svg>
              <span>Your Library</span>
            </a>
          )}
          <a href="/library" data-shell-member
             class={`rail-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition ${isPublic ? 'hidden' : ''} ${active === 'library' ? 'rail-active font-medium' : 'text-muted hover:text-text'}`}
             aria-current={active === 'library' ? 'page' : undefined}>
            <svg class="rail-icon shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>
            </svg>
            <span>Your Library</span>
          </a>
        </nav>

        <!-- Pro pill (§1): one rail pill below primary nav, never a primary
             nav item, never the primary gold active treatment. -->
        <div class="px-3 pb-3">
          <a href="/pricing"
             class={`flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium transition border ${active === 'pricing' ? 'border-accent text-accent bg-accent/10' : 'border-border text-muted-soft hover:text-text hover:border-border-soft'}`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
            </svg>
            <span>Pro · $9.95/mo</span>
          </a>
        </div>

        <!-- Rail body: anon CTA (public default) ⇄ live bundle list (member).
             §1: anon body is ONE compact CTA, not a second story. Member body
             = "Recent bundles" preview, max 5, NO plus button in rail (the
             compose flow lives inside /library now). -->
        {isPublic && (
          <div class="px-3 pb-4 flex-1 min-h-0" data-shell-anon>
            <div class="mx-3 rounded-xl border border-border bg-bg-card/50 p-4 flex flex-col gap-2.5">
              <p class="text-xs text-muted leading-relaxed">Save bundles and sync fleets.</p>
              <a href="/signin?next=/library" data-signin-next
                 class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition">
                Sign in
              </a>
              <a href="/pricing" class="text-center text-[11px] text-muted-soft hover:text-accent transition">Pro $9.95/mo</a>
            </div>
          </div>
        )}
        <div class={`px-3 pb-4 flex-1 min-h-0 ${isPublic ? 'hidden' : ''}`} data-shell-member>
          <div class="flex items-center justify-between px-3 mb-1.5">
            <span class="text-[10px] uppercase tracking-widest text-muted-soft">Recent bundles</span>
          </div>
          <div id="rail-bundles" class="flex flex-col gap-0.5">
            <p id="rail-bundles-empty" class="px-3 py-2 text-xs text-muted-soft">No bundles yet.</p>
          </div>
        </div>

        <!-- Rail footer: sign-in (public default) ⇄ account (member). -->
        {isPublic && (
          <div class="border-t border-border px-3 py-3 shrink-0" data-shell-anon>
            <a href="/signin" data-signin-next
               class="flex items-center gap-2.5 px-2 py-2 rounded-lg hover:bg-bg-card transition">
              <span class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center text-xs font-semibold shrink-0">→</span>
              <span class="flex flex-col min-w-0">
                <span class="text-xs text-text truncate">Sign in</span>
                <span class="text-[10px] text-muted-soft uppercase tracking-wider">free to start</span>
              </span>
            </a>
          </div>
        )}
        <div class={`border-t border-border px-3 py-3 shrink-0 ${isPublic ? 'hidden' : ''}`} data-shell-member>
          <!-- Ambient fleet status (P4): "show don't tell" — live from /api/fleets + /api/cookbooks. -->
          <p id="rail-fleet-status" class="hidden px-2 pb-2 text-[10px] text-muted-soft leading-relaxed"></p>
          <a href="/account" class={`flex items-center gap-2.5 px-2 py-2 rounded-lg transition ${active === 'account' ? 'bg-accent/12' : 'hover:bg-bg-card'}`}>
            <span id="rail-avatar" class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center text-xs font-semibold overflow-hidden shrink-0">·</span>
            <span class="flex flex-col min-w-0">
              <span id="rail-user-name" class="text-xs text-text truncate">Account</span>
              <span id="rail-user-plan" class="text-[10px] text-muted-soft uppercase tracking-wider">free</span>
            </span>
          </a>
          <button id="rail-signout" type="button" class="w-full mt-1 flex items-center gap-2.5 px-2 py-2 rounded-lg text-muted-soft hover:text-text hover:bg-bg-card transition text-xs">
            <span class="w-7 h-7 rounded-full bg-bg-card border border-border flex items-center justify-center shrink-0" aria-hidden="true">⏻</span>
            <span>Sign out</span>
          </button>
        </div>
      </aside>

      <!-- ── Main content ──────────────────────────────────────────── -->
      <div class="flex-1 flex flex-col min-w-0">
        <!-- Mobile top bar (rail collapses on small screens) -->
        <header class="md:hidden sticky top-0 z-40 flex items-center justify-between gap-3 h-14 px-4 border-b border-border bg-bg/85 backdrop-blur-md">
          <a href={isPublic ? '/' : '/home'} class="flex items-center gap-2 font-semibold">
            <LoopMark size={26} />
            <span>LoopSkill</span>
          </a>
          <details class="relative" id="appshell-mobile-menu">
            <summary class="list-none cursor-pointer p-2 text-muted hover:text-text" aria-label="Menu">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect y="3" width="20" height="2" rx="1" fill="currentColor"/><rect y="9" width="20" height="2" rx="1" fill="currentColor"/><rect y="15" width="20" height="2" rx="1" fill="currentColor"/></svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-52 bg-bg-elev border border-border rounded-xl shadow-xl overflow-hidden z-50">
              <nav class="flex flex-col text-sm">
                <a href="/home" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Home</a>
                <a href="/browse" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Browse</a>
                <a href={isPublic ? '/signin?next=/library' : '/library'} data-signin-next={isPublic ? true : undefined} class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Your Library</a>
                <a href="/pricing" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Pro · $9.95/mo</a>
                {isPublic && (
                  <a href="/signin" data-signin-next data-shell-anon class="px-4 py-3 text-accent font-medium hover:bg-bg-card transition border-t border-border">Sign in</a>
                )}
                <a href="/account" data-shell-member class={`px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition border-t border-border ${isPublic ? 'hidden' : ''}`}>Account</a>
                <button id="rail-signout-mobile" type="button" data-shell-member class={`px-4 py-3 text-left text-muted hover:text-text hover:bg-bg-card transition border-t border-border ${isPublic ? 'hidden' : ''}`}>Sign out</button>
              </nav>
            </div>
          </details>
        </header>

        <main id="app-main" class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    {/* loopskill_portal_0627: IntentSurvey removed — it was a Recipes-specific
        $100/mo "Operator/Pro+ bundle" demand-validation modal that rendered on
        every public page; off-brand for LoopSkill's open-core Free + Pro story. */}

    <script>
      // AppShell hydration — mode-aware auth gate + rail population.
      (async () => {
        const root = document.getElementById('appshell-root');
        const mode = root?.getAttribute('data-mode') || 'member';
        const gate = document.getElementById('appshell-gate');

        let user: any = null;
        try {
          const res = await fetch('/api/auth/me', { credentials: 'include' });
          if (res.ok) user = await res.json();
        } catch { /* network error → treat as anon */ }

        if (!user) {
          if (mode === 'member') {
            // Member surface — bounce anonymous visitors to sign-in, preserving intent.
            const next = encodeURIComponent(window.location.pathname + window.location.search);
            window.location.href = `/signin?next=${next}`;
            return;
          }
          // Public surface, anonymous visitor: static anon state is already
          // correct. Just thread ?next= into the sign-in CTAs so OAuth
          // returns the visitor HERE, not /library.
          document.querySelectorAll<HTMLAnchorElement>('[data-signin-next]').forEach((a) => {
            a.href = `/signin?next=${encodeURIComponent(window.location.pathname + window.location.search)}`;
          });
          return;
        }
        gate?.remove();

        // Member confirmed. In public mode, swap anon rail → member rail.
        // classList AND inline style.display: responsive variants (md:flex)
        // outrank `.hidden` in the cascade (Trap A).
        document.querySelectorAll<HTMLElement>('[data-shell-anon]').forEach((el) => {
          el.classList.add('hidden');
          el.style.display = 'none';
        });
        document.querySelectorAll<HTMLElement>('[data-shell-member]').forEach((el) => {
          el.classList.remove('hidden');
          el.style.display = '';
        });

        // User footer
        const initials = (user.display_name || user.email || '?').slice(0, 1).toUpperCase();
        const avatar = document.getElementById('rail-avatar');
        if (avatar) {
          avatar.textContent = user.avatar_url ? '' : initials;
          if (user.avatar_url) avatar.innerHTML = `<img src="${user.avatar_url}" alt="" class="w-full h-full object-cover" referrerpolicy="no-referrer"/>`;
        }
        const nameEl = document.getElementById('rail-user-name');
        if (nameEl) nameEl.textContent = user.display_name || user.email || 'Account';
        const planEl = document.getElementById('rail-user-plan');
        const tier = (user.subscription_tier || 'free').toLowerCase();
        const status = user.subscription_status || '';
        const paidActive = ['active', 'trialing', 'past_due'].includes(status);
        if (planEl) planEl.textContent = (paidActive && tier !== 'free') ? tier.replace('_', '+') : 'free';

        // Live bundle rail — "Recent bundles" preview, max 5 (§1: no plus button).
        let userCookbooks: any[] = [];
        try {
          const cbRes = await fetch('/api/cookbooks', { credentials: 'include' });
          if (cbRes.ok) {
            const data = await cbRes.json();
            const cbooks = (data && (data.bundles || data.cookbooks)) || []; // bundles key canonical (issue #157 Ph 3); cookbooks fallback for pre-flip cached API
            userCookbooks = cbooks;
            const wrap = document.getElementById('rail-bundles');
            const empty = document.getElementById('rail-bundles-empty');
            if (wrap && cbooks.length) {
              empty?.remove();
              wrap.innerHTML = cbooks.slice(0, 5).map((cb: any) =>
                `<a href="/library" class="px-3 py-1.5 rounded-md text-xs text-muted hover:text-text hover:bg-bg-card transition truncate" title="${(cb.name||'').replace(/"/g,'&quot;')}">${cb.name || 'Untitled'}</a>`
              ).join('');
            }
          }
        } catch { /* rail is best-effort */ }
        // Kept for any surface still reading window.__shellCookbooks.
        (window as any).__shellCookbooks = userCookbooks;

        // ── Ambient fleet status (P4) — honest numbers only, hidden when zero.
        try {
          const flRes = await fetch('/api/fleets', { credentials: 'include' });
          if (flRes.ok) {
            const fl = await flRes.json();
            const fleets = (fl && (fl.fleets || fl.items)) || [];
            const el = document.getElementById('rail-fleet-status');
            if (el && (fleets.length || userCookbooks.length)) {
              const bits: string[] = [];
              if (userCookbooks.length) bits.push(`${userCookbooks.length} bundle${userCookbooks.length === 1 ? '' : 's'}`);
              if (fleets.length) bits.push(`${fleets.length} fleet${fleets.length === 1 ? '' : 's'} syncing`);
              el.textContent = bits.join(' · ');
              el.classList.remove('hidden');
              el.style.display = '';
            }
          }
        } catch { /* ambient is best-effort */ }

        // ── First-login onboarding pane REMOVED (feat/spotify-ia, council §4):
        // the global four-step pane fought the new IA by injecting itself
        // above arbitrary pages. Its replacement is a single panel INSIDE
        // /library (shown only when the member has zero bundles AND zero
        // fleets) — see library.astro.

        // Sign out — both rail (desktop) and mobile menu, mirrors /account.
        const _logout = async () => {
          try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch {}
          window.location.href = '/';
        };
        document.getElementById('rail-signout')?.addEventListener('click', _logout);
        document.getElementById('rail-signout-mobile')?.addEventListener('click', _logout);
      })();
    </script>

    <script>
      // Rail search (feat/spotify-ia, council §8): a thin handoff only.
      // Browse owns search now — no live dropdown, no second search concept.
      // Enter navigates to /browse?q=<value>; Esc clears/blurs.
      (() => {
        const input = document.getElementById('shell-search') as HTMLInputElement | null;
        if (!input) return;
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (input.value) { input.value = ''; } else { input.blur(); }
          }
          if (e.key === 'Enter') {
            const q = input.value.trim();
            window.location.href = q ? `/browse?q=${encodeURIComponent(q)}` : '/browse';
          }
        });
      })();
    </script>
  </body>
</html>
