---
import AppShell from '../layouts/AppShell.astro';
import Icon from '../components/Icon.astro';
---

<AppShell active="account" title="Account — Recipes" description="Your subscription, billing, and API keys.">
  <section class="max-w-5xl mx-auto px-6 pt-12 pb-24">
    <!-- Auth-success toast (dismissable) -->
    <div id="auth-success-toast" class="hidden mb-6 p-4 rounded-xl bg-accent/10 border border-accent/40 text-sm text-text flex items-center justify-between">
      <span>✓ Signed in successfully.</span>
      <button class="text-muted hover:text-text" onclick="this.parentElement.classList.add('hidden')">✕</button>
    </div>

    <!-- Auth gate state — shown while we check JWT -->
    <div id="auth-checking" class="text-center py-24 text-muted">
      <p class="text-sm">Loading your account…</p>
    </div>

    <!-- Main content (hidden until authed) -->
    <div id="library-main" class="hidden">
      <header class="mb-10 flex items-end justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl font-semibold tracking-tight" id="welcome-line">Account</h1>
          <p class="text-muted mt-1 text-sm">Manage your subscription, billing, and API keys.</p>
        </div>
        <a href="/library" class="text-sm text-accent hover:opacity-80 shrink-0">← Your Library</a>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Subscription card -->
        <div class="bg-bg-card border border-border rounded-2xl p-6">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">Subscription</h2>
              <p class="text-xs text-muted mt-1">Tier, status, and billing.</p>
            </div>
            <span id="sub-status-badge" class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border border-border text-muted-soft">…</span>
          </div>

          <!-- Active plan summary (shown only when a paid sub is active) -->
          <div id="sub-active-card" class="hidden mb-4 p-4 rounded-xl bg-accent/10 border border-accent/40">
            <div class="flex items-baseline justify-between gap-3">
              <span id="sub-tier-name" class="text-2xl font-semibold text-text">—</span>
              <span id="sub-tier-price" class="text-xs text-muted-soft font-mono">—</span>
            </div>
            <p id="sub-renews-line" class="text-xs text-muted mt-1.5">—</p>
          </div>

          <!-- Detail rows (always rendered for completeness) -->
          <div id="sub-body" class="space-y-3 text-sm">
            <div class="flex items-baseline justify-between">
              <span class="text-muted">Tier</span>
              <span id="sub-tier" class="font-mono text-text">—</span>
            </div>
            <div class="flex items-baseline justify-between">
              <span class="text-muted">Renews</span>
              <span id="sub-renews" class="text-text">—</span>
            </div>
          </div>

          <div class="mt-5 flex flex-col gap-2">
            <button id="manage-billing-btn" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-accent text-text text-sm font-medium transition">
              Manage billing →
            </button>
            <a id="upgrade-plan-link" href="/pricing" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-accent text-text text-sm font-medium transition">
              See other plans →
            </a>
            <a id="choose-plan-link" href="/pricing" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              Choose a plan →
            </a>
          </div>
        </div>

        <!-- API Keys card — Phase C per-cookbook key table -->
        <div class="md:col-span-2 bg-bg-card border border-border rounded-2xl p-6">
          <!-- quality_1705 Phase E — tier-aware cookbook subtitle (per plan §3 step 2) -->
          <div id="cookbook-tier-subtitle" class="hidden mb-4 pb-4 border-b border-border-soft">
            <div class="flex items-center gap-2 mb-1">
              <Icon name="box" size={14} class="text-accent" />
              <h3 class="text-sm font-semibold tracking-tight">Your cookbooks</h3>
            </div>
            <p id="cookbook-tier-subtitle-text" class="text-xs text-muted leading-relaxed"></p>
          </div>
          <div class="flex items-center justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">API keys</h2>
              <p class="text-xs text-muted mt-1">For the Recipes meta-skill and direct API access. <span id="key-tier-note" class="hidden">Pro: 1 key · Pro+: up to 20 keys.</span></p>
            </div>
            <button id="new-key-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition">
              + New key
            </button>
          </div>

          <!-- Key list table -->
          <div id="key-table-wrap" class="overflow-x-auto">
            <table class="w-full text-xs border-collapse" id="key-table">
              <thead>
                <tr class="border-b border-border">
                  <th class="text-left py-2 px-3 text-muted-soft font-medium">Label</th>
                  <th class="text-left py-2 px-3 text-muted-soft font-medium hidden sm:table-cell">Cookbook</th>
                  <th class="text-left py-2 px-3 text-muted-soft font-medium">Prefix</th>
                  <th class="text-left py-2 px-3 text-muted-soft font-medium hidden md:table-cell">Installs (total / 7d)</th>
                  <th class="text-left py-2 px-3 text-muted-soft font-medium hidden lg:table-cell">Created</th>
                  <th class="py-2 px-3 text-muted-soft font-medium">Actions</th>
                </tr>
              </thead>
              <tbody id="key-table-body">
                <!-- Populated by JS -->
              </tbody>
            </table>
            <p id="key-table-empty" class="text-sm text-muted py-4 text-center">No API keys yet. Generate one to start installing skills.</p>
          </div>

          <!-- "New key" just-created reveal -->
          <div id="api-key-just-created" class="hidden mt-5 space-y-3">
            <div class="bg-accent/10 border border-accent/40 rounded-lg p-4">
              <p class="text-xs font-semibold text-accent mb-2">⚠ Save this key now — it will not be shown again.</p>
              <div class="flex items-center gap-2">
                <code id="plaintext-key" class="font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2 flex-1 break-all"></code>
                <button id="copy-key-btn" class="px-3 py-2 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition shrink-0">Copy</button>
              </div>
            </div>
            <button id="dismiss-plaintext-btn" class="text-xs text-muted hover:text-text underline">I've saved it</button>
          </div>

          <!-- Cap exceeded error -->
          <div id="key-cap-error" class="hidden mt-3 p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-xs text-red-400"></div>
        </div>

        <!-- New Key Modal -->
        <div id="new-key-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-bg/80 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Generate new API key">
          <div class="bg-bg-card border border-border rounded-2xl p-6 w-full max-w-sm flex flex-col gap-4 shadow-2xl" id="new-key-modal-inner">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-base font-semibold">Generate new key</h3>
              <button id="close-modal-btn" class="text-muted hover:text-text text-lg leading-none" aria-label="Close">✕</button>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="modal-label" class="text-xs text-muted font-medium">Label <span class="text-accent">*</span></label>
              <input
                id="modal-label"
                type="text"
                maxlength="100"
                placeholder="e.g. ACME client, data-pipeline, personal"
                class="w-full px-3 py-2 text-sm bg-bg-elev border border-border rounded-lg text-text placeholder:text-muted focus:outline-none focus:border-accent"
              />
              <!-- quality_1705 Phase E — Pro+ hint for client-named cookbooks -->
              <p id="modal-label-pro-plus-hint" class="hidden text-[10px] text-muted-soft">
                Pro+ tip: name this after the client whose fleet you'll deploy to (e.g. <code class="text-accent">acme-corp-cookbook</code>) so install metrics stay scoped per-client.
              </p>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="modal-cookbook" class="text-xs text-muted font-medium">Cookbook (optional)</label>
              <select
                id="modal-cookbook"
                class="w-full px-3 py-2 text-sm bg-bg-elev border border-border rounded-lg text-text focus:outline-none focus:border-accent"
              >
                <option value="">Personal key (no cookbook)</option>
                <!-- Populated by JS -->
              </select>
              <p class="text-[10px] text-muted-soft">Scoping a key to a cookbook lets you see per-client install counts.</p>
            </div>

            <div id="modal-error" class="hidden text-xs text-red-400 bg-red-500/10 border border-red-500/30 rounded-lg p-3"></div>

            <div class="flex gap-2 mt-2">
              <button id="modal-submit-btn" class="flex-1 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
                Generate key
              </button>
              <button id="modal-cancel-btn" class="px-4 py-2 rounded-lg border border-border text-text text-sm hover:border-accent transition">
                Cancel
              </button>
            </div>
          </div>
        </div>

        <!-- WiseChef cross-sell (cook+ tier only) — WIS-648 -->
        <div id="wisechef-cta-card" class="hidden md:col-span-2 bg-gradient-to-br from-accent/10 to-cool/10 border border-accent/40 rounded-2xl p-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1">
              <h2 class="text-lg font-semibold tracking-tight">Want an AI agent that <em>does</em> the work, not just provides recipes?</h2>
              <p class="text-sm text-muted mt-2">WiseChef's managed AI employee plan — custom pricing. Cook &amp; Operator customers save 40% on the first 3 months.</p>
            </div>
            <div class="shrink-0">
              <button id="demo-cta-btn" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
                Book a 30-min demo →
              </button>
              <p id="demo-cta-confirmed" class="hidden text-xs text-accent mt-2">Demo requested ✓ check your inbox.</p>
            </div>
          </div>
        </div>

        <!-- Refer & Earn — canonical dashboard lives at /referrals (no dup here).
             livefix_0601: the full referral card was duplicated on both /library
             and /referrals. Compounded to a single link-out; /referrals owns the
             code, link, stats, and payout status. -->
        <div class="md:col-span-2 bg-bg-card border border-border rounded-2xl p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">Refer &amp; Earn</h2>
              <p class="text-xs text-muted mt-1">Share your link, earn 50% recurring on every Pro / Pro+ subscriber you bring in.</p>
            </div>
            <a href="/referrals" class="text-sm text-accent hover:opacity-80 shrink-0">Open referrals →</a>
          </div>
        </div>

        <!-- Your cookbooks + Installed skills moved to /library (Your Library) — portal_0610 J1. -->
      </div>

      <!-- Footer actions -->
      <div class="mt-10 pt-6 border-t border-border flex justify-between text-sm">
        <a href="/library" class="text-muted hover:text-text transition">← Your Library</a>
        <button id="library-signout" class="text-muted hover:text-accent transition">Sign out</button>
      </div>
    </div>
  </section>
</AppShell>

<script>
  // ────────────────────────────────────────────────────────────────────
  // /library hydration — vanilla JS, no framework
  // Phase C: per-cookbook key table, modal, install counts
  // ────────────────────────────────────────────────────────────────────
  type User = { id: string; display_name?: string; email?: string; avatar_url?: string;
                 subscription_tier?: string | null; subscription_status?: string | null;
                 subscription_current_period_end?: string | null };
  type Billing = { user_id: string; stripe_customer_id: string | null;
                   subscription_status: string | null; subscription_tier: string | null;
                   cookbook_limit?: number | null;
                   subscription_current_period_end: string | null };
  type ApiKey = {
    id: string; prefix: string;
    label: string | null; name: string | null;
    cookbook_id: string | null;
    is_active: boolean;
    created_at: string | null; last_used_at: string | null;
    install_count_total: number; install_count_7d: number;
  };
  type CookbookItem = { id: string; name: string };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const TIER_LABEL: Record<string, string> = {
    pro: 'PRO', pro_plus: 'PRO+',
    cook: 'PRO', operator: 'PRO+', studio: 'PRO+',
  };
  const TIER_PRICE: Record<string, string> = {
    pro: '$20/mo', pro_plus: '$100/mo',
    cook: '$20/mo', operator: '$100/mo', studio: '$100/mo',
  };
  const TIER_NAME: Record<string, string> = {
    pro: 'Pro', pro_plus: 'Pro+',
    cook: 'Pro', operator: 'Pro+', studio: 'Pro+',
  };

  // ── State ──────────────────────────────────────────────────────────────
  let _cookbooks: CookbookItem[] = [];

  function fmtRenewsIn(iso: string | null): string {
    if (!iso) return '—';
    const ts = new Date(iso).getTime();
    if (isNaN(ts)) return '—';
    const days = Math.max(0, Math.round((ts - Date.now()) / 86400000));
    if (days === 0) return 'today';
    if (days === 1) return 'tomorrow';
    return `in ${days} days`;
  }

  function fmtRenewsDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  async function fetchJson<T>(url: string, opts: RequestInit = {}): Promise<T | null> {
    try {
      const res = await fetch(url, { credentials: 'include', ...opts });
      if (!res.ok) return null;
      return await res.json() as T;
    } catch {
      return null;
    }
  }

  // ── Billing ────────────────────────────────────────────────────────────
  async function loadBilling(): Promise<void> {
    const billing = await fetchJson<Billing>('/api/billing/me');
    if (!billing) return;

    const status = billing.subscription_status || 'none';
    const tier = billing.subscription_tier;
    const isPaidActive = !!tier && (status === 'active' || status === 'trialing' || status === 'past_due');

    $('sub-status-badge').textContent = status === 'none' ? 'FREE' : status.toUpperCase();
    $('sub-tier').textContent = tier ? (TIER_LABEL[tier] || tier) : 'Free';
    $('sub-renews').textContent = isPaidActive ? fmtRenewsIn(billing.subscription_current_period_end) : '—';

    if (isPaidActive) {
      $('sub-active-card').classList.remove('hidden');
      $('sub-tier-name').textContent = TIER_NAME[tier!] || tier!;
      $('sub-tier-price').textContent = TIER_PRICE[tier!] || '';
      const renewsDate = fmtRenewsDate(billing.subscription_current_period_end);
      $('sub-renews-line').textContent = renewsDate
        ? `Renews ${renewsDate} (${fmtRenewsIn(billing.subscription_current_period_end)})`
        : 'Active subscription';

      $('manage-billing-btn').classList.remove('hidden');
      $('sub-status-badge').classList.add('text-accent', 'border-accent/40');

      if (tier !== 'pro_plus' && tier !== 'operator' && tier !== 'studio') {
        $('upgrade-plan-link').classList.remove('hidden');
      }
      $('choose-plan-link').classList.add('hidden');
    } else {
      $('choose-plan-link').classList.remove('hidden');
    }

    if (tier && ['pro', 'pro_plus', 'cook', 'operator', 'studio'].includes(tier)) {
      $('wisechef-cta-card').classList.remove('hidden');
    }

    // Show key tier note
    const note = $('key-tier-note');
    if (note) note.classList.remove('hidden');

    // quality_1705 Phase E — show tier-appropriate cookbook subtitle
    // loopclose_3005 Phase X — cap numbers come from billing.cookbook_limit
    // (SSOT: config/tiers.yaml via /api/billing/me), never a hardcoded literal.
    const cookbookSubtitle = document.getElementById('cookbook-tier-subtitle');
    const cookbookSubtitleText = document.getElementById('cookbook-tier-subtitle-text');
    if (cookbookSubtitle && cookbookSubtitleText && tier) {
      const isProPlus = ['pro_plus', 'operator', 'studio'].includes(tier);
      const isPro = ['pro', 'cook'].includes(tier);
      const cap = typeof billing.cookbook_limit === 'number' ? billing.cookbook_limit : null;
      if (isProPlus) {
        const capPhrase = cap !== null ? `up to ${cap} cookbooks` : 'multiple cookbooks';
        cookbookSubtitleText.textContent =
          `You have ${capPhrase} available. Each can be named after a client (e.g. acme-corp-cookbook) and deployed to their agent fleet. Use cookbook scoping below to map each API key to a client.`;
        cookbookSubtitle.classList.remove('hidden');
        // Show the Pro+ client-naming hint in the create-key modal
        const proPlusHint = document.getElementById('modal-label-pro-plus-hint');
        if (proPlusHint) proPlusHint.classList.remove('hidden');
      } else if (isPro) {
        const capPhrase = cap !== null ? `up to ${cap} cookbooks` : 'your personal cookbooks';
        cookbookSubtitleText.textContent =
          `You have ${capPhrase}. Use them to bundle your private skills and sync them across your agent fleet. Upgrade to Pro+ for many more client-named cookbooks.`;
        cookbookSubtitle.classList.remove('hidden');
      }
    }
  }

  // ── API Keys table — Phase C ───────────────────────────────────────────
  function _cookbookName(id: string | null): string {
    if (!id) return '—';
    const cb = _cookbooks.find(c => c.id === id);
    return cb ? cb.name : id.slice(0, 8) + '…';
  }

  function renderKeyTable(keys: ApiKey[]): void {
    const tbody = $<HTMLTableSectionElement>('key-table-body');
    const emptyMsg = $('key-table-empty');
    if (!keys.length) {
      tbody.innerHTML = '';
      emptyMsg?.classList.remove('hidden');
      return;
    }
    emptyMsg?.classList.add('hidden');
    tbody.innerHTML = keys.map(k => `
      <tr class="border-b border-border/50 hover:bg-bg-elev/30 transition ${k.is_active ? '' : 'opacity-40'}">
        <td class="py-2.5 px-3 text-text font-medium">${k.label || k.name || '—'}</td>
        <td class="py-2.5 px-3 text-muted hidden sm:table-cell">${_cookbookName(k.cookbook_id)}</td>
        <td class="py-2.5 px-3 font-mono text-muted">${k.prefix}…</td>
        <td class="py-2.5 px-3 text-muted hidden md:table-cell tabular-nums">${k.install_count_total} / ${k.install_count_7d}</td>
        <td class="py-2.5 px-3 text-muted hidden lg:table-cell">${k.created_at ? new Date(k.created_at).toLocaleDateString() : '—'}</td>
        <td class="py-2.5 px-3">
          ${k.is_active
            ? `<button class="revoke-btn text-xs text-red-400 hover:text-red-300 underline" data-id="${k.id}">Revoke</button>`
            : `<span class="text-xs text-muted-soft">revoked</span>`
          }
        </td>
      </tr>
    `).join('');

    // Attach revoke handlers
    tbody.querySelectorAll('.revoke-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id!;
        if (!confirm('Revoke this key? Any agents using it will lose access immediately.')) return;
        await fetchJson(`/api/api-keys/${id}`, { method: 'DELETE' });
        await loadApiKeys();
      });
    });
  }

  async function loadApiKeys(): Promise<void> {
    const data = await fetchJson<{ keys: ApiKey[] }>('/api/api-keys');
    if (!data) return;
    renderKeyTable(data.keys);
  }

  // ── Cookbooks — populate modal dropdown + the visible cookbooks list ───
  async function loadCookbooks(): Promise<void> {
    const data = await fetchJson<{ cookbooks: CookbookItem[] }>('/api/cookbooks');
    if (!data?.cookbooks) return;
    _cookbooks = data.cookbooks;
    const sel = $<HTMLSelectElement>('modal-cookbook');
    if (sel) {
      data.cookbooks.forEach(cb => {
        const opt = document.createElement('option');
        opt.value = cb.id;
        opt.textContent = cb.name;
        sel.appendChild(opt);
      });
    }

    // loopclose_3005 Phase E — render a linked list of cookbooks so a user can
    // open /cookbooks/view?id=<id> and see the skills inside, zero-CLI.
    const list = $('cookbooks-list');
    const empty = $('cookbooks-empty');
    if (list && data.cookbooks.length) {
      if (empty) empty.remove();
      list.innerHTML = '';
      data.cookbooks.forEach(cb => {
        const a = document.createElement('a');
        a.href = `/cookbooks/view?id=${encodeURIComponent(cb.id)}`;
        a.className = 'flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-bg-elev border border-border-soft hover:border-accent/40 transition mb-2';
        const left = document.createElement('span');
        left.className = 'font-medium text-text';
        left.textContent = cb.name;
        const right = document.createElement('span');
        right.className = 'text-xs text-accent';
        right.textContent = 'Open →';
        a.appendChild(left);
        a.appendChild(right);
        list.appendChild(a);
      });
    }
  }

  // ── New key modal ──────────────────────────────────────────────────────
  function openModal(): void {
    $('new-key-modal').classList.remove('hidden');
    ($('modal-label') as HTMLInputElement).focus();
    $('modal-error').classList.add('hidden');
  }
  function closeModal(): void {
    $('new-key-modal').classList.add('hidden');
    ($('modal-label') as HTMLInputElement).value = '';
    ($('modal-cookbook') as HTMLSelectElement).value = '';
    $('modal-error').classList.add('hidden');
  }

  $('new-key-btn')?.addEventListener('click', openModal);
  $('close-modal-btn')?.addEventListener('click', closeModal);
  $('modal-cancel-btn')?.addEventListener('click', closeModal);

  // Close modal on backdrop click
  $('new-key-modal')?.addEventListener('click', (e) => {
    if (e.target === $('new-key-modal')) closeModal();
  });

  $('modal-submit-btn')?.addEventListener('click', async () => {
    const labelInput = $<HTMLInputElement>('modal-label');
    const cookbookSel = $<HTMLSelectElement>('modal-cookbook');
    const errorDiv = $('modal-error');
    const submitBtn = $<HTMLButtonElement>('modal-submit-btn');

    const label = labelInput.value.trim();
    if (!label) {
      errorDiv.textContent = 'Label is required.';
      errorDiv.classList.remove('hidden');
      labelInput.focus();
      return;
    }

    const body: Record<string, string> = { label };
    if (cookbookSel.value) body.cookbook_id = cookbookSel.value;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Generating…';
    errorDiv.classList.add('hidden');

    try {
      const res = await fetch('/api/api-keys', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.status === 403) {
        const detail = (await res.json()).detail as string;
        errorDiv.textContent = detail.includes('key_cap_exceeded')
          ? `Key cap reached. ${detail.replace('key_cap_exceeded — ', '')}`
          : detail;
        errorDiv.classList.remove('hidden');
        return;
      }
      if (!res.ok) {
        errorDiv.textContent = 'Could not generate key. Please try again.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const data = await res.json();
      closeModal();

      // Show the plaintext key
      $('api-key-just-created').classList.remove('hidden');
      $('plaintext-key').textContent = data.key;

      // Refresh key table
      await loadApiKeys();

      // Also clear any cap error
      $('key-cap-error').classList.add('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Generate key';
    }
  });

  $('dismiss-plaintext-btn')?.addEventListener('click', () => {
    $('api-key-just-created').classList.add('hidden');
  });

  $('copy-key-btn')?.addEventListener('click', async () => {
    const txt = $('plaintext-key').textContent || '';
    try {
      await navigator.clipboard.writeText(txt);
      $('copy-key-btn').textContent = 'Copied ✓';
      setTimeout(() => ($('copy-key-btn').textContent = 'Copy'), 2000);
    } catch { /* fallback: select */ }
  });

  $('manage-billing-btn')?.addEventListener('click', async () => {
    const data = await fetchJson<{ url: string }>(
      '/api/billing/portal-session', { method: 'POST' }
    );
    if (data?.url) window.location.href = data.url;
    else alert('Could not open billing portal. Please try again.');
  });

  // WiseChef demo CTA — WIS-648
  $('demo-cta-btn')?.addEventListener('click', async () => {
    const btn = $('demo-cta-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Booking…';
    try {
      await fetch('/api/wisechef/demo-request', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source: 'library_card_cta' }),
      });
    } catch { /* tracked best-effort */ }
    window.open('https://calendar.app.google/P9J9oaiemtHdsvG99', '_blank', 'noopener');
    btn.classList.add('hidden');
    $('demo-cta-confirmed').classList.remove('hidden');
  });

  // Sign out
  $('library-signout')?.addEventListener('click', async () => {
    try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch {}
    document.cookie = 'wr_jwt=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    window.location.href = '/';
  });

  // livefix_0601: referral loader + copy handler removed — the referral card
  // was de-duplicated to a link-out to /referrals, which owns the dashboard.

  // ── Boot sequence ───────────────────────────────────────────────────
  (async () => {
    const user = await fetchJson<User>('/api/auth/me');
    if (!user) {
      window.location.href = '/signin?next=/account';
      return;
    }

    const params = new URLSearchParams(window.location.search);
    if (params.get('auth') === 'success') {
      $('auth-success-toast').classList.remove('hidden');
      const url = new URL(window.location.href);
      url.searchParams.delete('auth');
      window.history.replaceState({}, '', url.toString());
    }

    $('welcome-line').textContent = `Welcome back, ${user.display_name || 'friend'}`;
    const subtitleEl = document.querySelector<HTMLElement>('header p.text-muted');
    if (subtitleEl && user.subscription_tier && (user.subscription_status === 'active' || user.subscription_status === 'trialing')) {
      const planName = (user.subscription_tier as string).charAt(0).toUpperCase() + (user.subscription_tier as string).slice(1);
      subtitleEl.innerHTML = `<span class="text-accent font-semibold">${planName} plan</span> · manage your subscription, API keys, and skills.`;
    }
    $('auth-checking').classList.add('hidden');
    $('library-main').classList.remove('hidden');

    await Promise.all([loadBilling(), loadApiKeys(), loadCookbooks()]);
  })();
</script>

