---
import { getCollection } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<AppShell mode="public" title="Blog — LoopSkill" description="Engineering notes, architecture decisions, and product updates from the LoopSkill team.">
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-24">
    <h1 class="text-3xl font-semibold tracking-tight mb-2">Blog</h1>
    <p class="text-muted text-sm mb-10">Engineering notes and product updates from the LoopSkill team.</p>

    <ul class="space-y-8">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block">
            <time class="text-xs text-muted font-mono" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <h2 class="text-lg font-semibold mt-1 group-hover:text-accent transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-muted mt-1">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</AppShell>
