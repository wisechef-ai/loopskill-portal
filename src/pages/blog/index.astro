---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog — WiseChef Recipes" description="AI agent skills, automation tips, and agency workflows.">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Blog</h1>
    <p class="text-lg text-gray-600 mb-12">AI agent skills, automation tips, and agency workflows from the WiseChef team.</p>

    <div class="space-y-10">
      {posts.map((post) => (
        <article class="border-b border-gray-200 pb-8">
          <a href={`/blog/${post.id}`} class="group">
            <h2 class="text-2xl font-semibold text-gray-900 group-hover:text-orange-600 transition-colors mb-2">
              {post.data.title}
            </h2>
          </a>
          <time datetime={post.data.pubDate.toISOString()} class="text-sm text-gray-500">
            {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <p class="text-gray-600 mt-2">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="flex gap-2 mt-3 flex-wrap">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded">{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="text-gray-500 text-center py-12">Coming soon — first posts arriving shortly.</p>
    )}
  </section>
</Base>
