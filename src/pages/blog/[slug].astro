---
import { getCollection, render } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';
import { buildBlogPostingSchema, buildFaqPageSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// JSON-LD: BlogPosting, sourced ONLY from this post's own content-collection
// frontmatter (post.data — src/content.config.ts `blog` schema). Never
// invented — headline/dates/author are exactly what the .md frontmatter
// declares (gap/schema; AGENTS.md claim-drift discipline extended to
// structured data, not just visible prose).
const siteURL = 'https://app.loopskill.io';
const postURL = `${siteURL}/blog/${post.id}`;
const blogSchema = buildBlogPostingSchema(post.data, postURL, siteURL);

// JSON-LD: FAQPage, built FROM post.data.faqs — the SAME array rendered as
// the visible <details>/<summary> list below (pricing.astro /
// docs/referrals.astro pattern, src/lib/schema.ts). Posts with no faqs in
// frontmatter emit no FAQPage block rather than an empty one.
const faqSchema = post.data.faqs.length > 0 ? buildFaqPageSchema(post.data.faqs) : null;
---

<AppShell mode="public"
  title={post.data.title}
  description={post.data.description}
  pageType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)}></script>
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
  </Fragment>
  <article class="max-w-3xl mx-auto px-6 pt-12 pb-24">
    <header class="mb-10">
      <time class="text-xs text-muted font-mono" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toISOString().slice(0, 10)}
      </time>
      <h1 class="text-3xl font-semibold tracking-tight mt-2 mb-3">{post.data.title}</h1>
      <p class="text-muted text-sm">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 mt-4 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full border border-border text-muted font-mono">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert prose-sm max-w-none">
      <Content />
    </div>

    {post.data.faqs.length > 0 && (
      <section class="mt-12 pt-8 border-t border-border">
        <h2 class="text-xl font-semibold text-text mb-6">FAQ</h2>
        <div class="flex flex-col gap-3">
          {post.data.faqs.map((faq) => (
            <details class="group bg-bg-card border border-border rounded-xl px-5 py-4 open:border-accent/40 transition">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-text">
                <span>{faq.q}</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-muted-soft transition-transform group-open:rotate-180" aria-hidden="true">
                  <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <p class="text-sm text-muted leading-relaxed mt-3">{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <footer class="mt-12 pt-8 border-t border-border">
      <a href="/blog" class="text-sm text-muted hover:text-text transition-colors">← All posts</a>
    </footer>
  </article>
</AppShell>
