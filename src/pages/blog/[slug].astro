---
import { getCollection, render } from 'astro:content';
import AppShell from '../../layouts/AppShell.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<AppShell mode="public"
  title={post.data.title}
  description={post.data.description}
  pageType="article"
>
  <article class="max-w-3xl mx-auto px-6 pt-12 pb-24">
    <header class="mb-10">
      <time class="text-xs text-muted font-mono" datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toISOString().slice(0, 10)}
      </time>
      <h1 class="text-3xl font-semibold tracking-tight mt-2 mb-3">{post.data.title}</h1>
      <p class="text-muted text-sm">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="flex gap-2 mt-4 flex-wrap">
          {post.data.tags.map((tag) => (
            <span class="text-xs px-2 py-0.5 rounded-full border border-border text-muted font-mono">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert prose-sm max-w-none">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t border-border">
      <a href="/blog" class="text-sm text-muted hover:text-text transition-colors">← All posts</a>
    </footer>
  </article>
</AppShell>
