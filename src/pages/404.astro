---
import AppShell from '../layouts/AppShell.astro';

// Phase D (top1pct_1105) — custom 404 with did-you-mean suggestions.
// Static list of top-visited paths; Phase G could swap to analytics-driven.
const POPULAR_PATHS: { path: string; label: string; description: string }[] = [
  { path: '/skills', label: 'Skills catalog', description: 'Browse every skill — free, Pro, Pro+.' },
  { path: '/pricing', label: 'Pricing', description: 'Pro ($20/mo) and Pro+ ($100/mo) plans.' },
  { path: '/docs/getting-started', label: 'Getting started', description: 'Install the meta-skill in 60 seconds.' },
  { path: '/docs/mcp', label: 'MCP setup', description: 'Wire Recipes into any MCP-aware agent.' },
  { path: '/library', label: 'Your library', description: 'Sign in to manage cookbooks + API keys.' },
];
---

<AppShell mode="public" title="Page not found — Recipes" description="That page doesn't exist (yet). Here's where most people are headed.">
  <section class="max-w-2xl mx-auto px-6 pt-20 pb-24 text-center">
    <p class="eyebrow mb-3">Error · 404</p>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight mb-4">That page doesn't exist.</h1>
    <p class="text-muted text-lg leading-relaxed mb-12">
      The URL you tried isn't part of Recipes (yet). If you arrived from a link
      we promoted, that's our bug — please tell us via
      <a href="https://github.com/wisechef-ai/recipes-portal/issues" class="text-accent underline hover:opacity-80">an issue</a>.
    </p>

    <h2 class="text-sm uppercase tracking-wider text-muted-soft mb-4 text-left">Did you mean…?</h2>
    <ul class="flex flex-col gap-2 text-left">
      {POPULAR_PATHS.map(({ path, label, description }) => (
        <li>
          <a
            href={path}
            class="group block bg-bg-card border border-border rounded-xl px-5 py-4 hover:border-accent transition"
          >
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-text font-semibold group-hover:text-accent transition">{label}</p>
                <p class="text-muted text-sm mt-0.5">{description}</p>
              </div>
              <code class="text-xs text-muted-soft bg-bg-elev rounded px-2 py-1 hidden sm:inline">{path}</code>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-12 text-sm text-muted-soft">
      Or just <a href="/" class="text-accent underline hover:opacity-80">go home</a>.
    </div>
  </section>
</AppShell>
