---
// /signin — neutral sign-in / sign-up card (qa1018 C08). All markup and the
// client script (mode switch, auth-error banner, ?ref= / ?next= / utm_*
// passthrough, already-authed short-circuit) live in AuthPanel.astro so
// /signin and /signup can never drift apart.
//
// This page is statically pre-rendered: Astro.url.searchParams is EMPTY at
// build time, so ?mode=signup is handled client-side inside AuthPanel.
import AuthEdge from '../layouts/AuthEdge.astro';
import AuthPanel from '../components/AuthPanel.astro';
---
<AuthEdge title="Sign in or create an account — LoopSkill" description="Sign in to LoopSkill, or create a free account, with Google or GitHub.">
  <AuthPanel initialMode="signin" />
</AuthEdge>
