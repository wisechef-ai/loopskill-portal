---
// P0 fix (2026-07-05, feat/bundles-public-pages) — PUBLIC bundle page: /bundles/p
//
// Fixes the P0 defect: the homepage's two bundle cards linked to the path
// form /bundles/p/{slug}, which 404'd because no /bundles pages existed at
// all in this portal. This page is the query-param permalink target
// (mirrors cookbooks/p.astro exactly) — the homepage cards now link here as
// /bundles/p?slug={slug} (see index.astro change in this same PR).
//
// Data source: GET /api/bundles/public/{slug} (anonymous; verified live
// 2026-07-05 — HTTP 200 JSON {slug,name,description,skill_count,skills[],
// ref,...} for dev-agent-essentials and research-and-report, the exact two
// slugs the homepage cards reference). 404 unless the bundle's
// visibility='public'.
//
// Static Astro can't pre-render per-slug routes without a build-time fetch
// (AGENTS.md build-time fetch ban — no getStaticPaths enumeration here), so
// the page lives at /bundles/p/?slug=<slug>. A Caddy rewrite
// (/bundles/p/<slug> → /bundles/p/?slug=<slug>) would additionally support
// the OLD path-form URL for any already-shared links (see PR body for the
// exact Caddyfile lines — out of repo scope). The client also resolves the
// slug from the trailing path segment as a fallback.

import AppShell from "../../layouts/AppShell.astro";

const API_BASE = import.meta.env.PUBLIC_LOOPSKILL_API_BASE || import.meta.env.PUBLIC_RECIPES_API_BASE || "https://app.loopskill.io";
---

<AppShell mode="public"
  title="Bundle — LoopSkill"
  description="A public skill bundle for AI agents. Install the whole bundle by pasting one sentence into your agent's chat."
  pageType="product"
>
  <main class="bd-pub max-w-3xl mx-auto px-6 pt-12 pb-20">
    <a href="/bundles" class="text-xs text-muted hover:text-accent transition inline-flex items-center gap-1.5 mb-6">← Discover bundles</a>

    <!-- States -->
    <section id="state-loading" class="text-muted text-sm py-10">Loading bundle…</section>

    <section id="state-notfound" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center">
      <h1 class="text-2xl font-semibold mb-2">Bundle not found</h1>
      <p class="text-sm text-muted mb-5">This bundle doesn't exist or isn't public.</p>
      <a href="/bundles" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Browse public bundles</a>
    </section>

    <!-- Honest failure state — never fabricate bundle content when the fetch fails. -->
    <section id="state-error" hidden class="bg-bg-card border border-red-500/40 rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-2">Couldn't load bundle</h2>
      <p id="error-detail" class="text-sm text-muted"></p>
    </section>

    <!-- Loaded -->
    <div id="content" hidden>
      <header class="flex flex-col gap-3 mb-8">
        <div class="flex items-center gap-2">
          <span class="badge badge-public">Public bundle</span>
          <!-- first-impression fix (8): shown only when every skill in this
               bundle is a GitHub deep-link (zero hosted) — computed client-side
               from the bundle payload, see render()/deepLinkBadge below. -->
          <span id="bd-by" class="text-xs text-muted-soft"></span>
        </div>
        <!-- first-impression fix (8) + qa1018 (MOB-9/NNS-12): plain words instead of
             the "Deep-link bundle" jargon badge. Shown only when no member is hosted. -->
        <p id="bd-deeplink-badge" class="bd-origin-note text-xs text-muted" hidden>Skills install straight from their original GitHub repos (LoopSkill does not host a copy).</p>
        <h1 id="bd-name" class="text-3xl md:text-4xl font-semibold tracking-tight">Bundle</h1>
        <p id="bd-desc" class="text-muted leading-relaxed"></p>
        <div id="bd-stats" class="text-sm text-muted-soft flex items-center gap-4 flex-wrap"></div>
      </header>

      <!-- THE GTM GATE — qa1018 C06 (IMP-5, MOB-1, MOB-10, MOB-11, NNS-12, SKP-07).
           The PRIMARY install is now the agent phrase (freshAgentPhrase('bundle', slug)
           from src/lib/agentInstall.ts — mirrored inline in the script below because
           define:vars forces is:inline). It is what a visitor pastes into their
           agent's chat and it works with no key for free/public bundles.
           bundles_0811 P1 (F1/F2) still holds: the auth-free shell command
           (`install_command`, api#226) renders BEFORE the key-gated MCP line, but
           it is now the SECONDARY path under "Prefer a terminal?". -->
      <section id="bd-install" class="bg-bg-card border border-accent/30 rounded-2xl p-6 mb-10">
        <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
          <h2 class="text-base font-semibold">Install this bundle with your agent</h2>
          <span class="text-[11px] text-muted-soft">no account needed</span>
        </div>
        <p class="text-sm text-text mb-3">Paste this into your agent's chat (Claude Code, Codex, Cursor…) and press Enter.</p>
        <div class="bd-cmd">
          <pre class="bd-pre bg-[#0d0d0d] border border-border rounded-xl p-4 text-sm text-accent"><code id="agent-line">Install the loopskill skill from https://app.loopskill.io/skill, then use it to install the "…" bundle.</code></pre>
          <button id="copy-agent-btn" class="bd-copy" type="button" aria-label="Copy the install sentence for your agent">Copy</button>
        </div>
        <!-- Pro-gated bundles: the phrase needs a Pro key, say so (shown only when the API reports requires_pro). -->
        <p id="bd-pro-note" hidden class="text-xs text-muted mt-3">
          Every skill in this bundle needs a Pro plan. Your agent will ask for a LoopSkill API key — <a href="/pricing" class="text-accent hover:underline">see plans</a>.
        </p>
        <!-- Honesty (SKP-07): community members are NOT reviewed by LoopSkill. Shown
             only when the bundle actually carries such members (computed in render()). -->
        <p id="bd-community-note" hidden class="bd-community-note text-xs mt-3"></p>

        <div class="mt-6 pt-5 border-t border-border-soft">
          <h3 class="text-sm font-semibold text-text mb-2">Prefer a terminal?</h3>
          <div class="bd-cmd">
            <pre class="bd-pre bg-[#0d0d0d] border border-border rounded-xl p-4 text-sm text-accent"><code id="install-line" class="bd-break">curl -fsSL https://app.loopskill.io/api/bundles/install.sh | bash -s -- …</code></pre>
            <button id="copy-install-btn" class="bd-copy" type="button" aria-label="Copy the terminal command">Copy</button>
          </div>
          <p class="text-xs text-muted-soft mt-3">
            Run this in a terminal (not in your agent's chat). It writes the skills to <code>~/.claude/skills</code> and needs <code>bash</code> and <code>python3</code>. Free skills install with <strong>no account and no API key</strong>; paid-tier members are reported by name rather than silently skipped.
          </p>
        </div>

        <!-- MOB-11 / BRK-11: a real >=44px disclosure with a visible chevron; the
             main path above is OUTSIDE it. render() hides the whole <details> if
             no option inside ends up visible, so it is never an empty heading. -->
        <details id="bd-other-ways" class="bd-other mt-5">
          <summary class="bd-other-summary">Other ways to install</summary>

          <!-- Authenticated MCP install — honestly labelled as key-gated. -->
          <div class="mt-4" data-install-option>
            <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
              <h3 class="text-sm font-semibold text-text">Already have LoopSkill connected (API key)?</h3>
              <span id="clone-auth-badge" class="text-[11px] px-2 py-0.5 rounded-md border border-border text-muted-soft">requires a free API key</span>
            </div>
            <div class="bd-cmd">
              <pre class="bd-pre bg-[#0d0d0d] border border-border rounded-xl p-4 text-sm text-accent"><code id="clone-line" class="bd-break">loopskill_bundle_install from "bundle://…"</code></pre>
              <button id="copy-btn" class="bd-copy" type="button" aria-label="Copy the MCP install line">Copy</button>
            </div>
            <p class="text-xs text-muted-soft mt-3">
              If LoopSkill is already connected to your agent over MCP (StreamableHTTP at <code>app.loopskill.io/api/mcp/http</code>), this pulls every skill below in a single call. The MCP endpoint <strong>authenticates every request</strong> — <a href="/pricing" class="text-accent hover:underline">get a free key</a> first, or use the sentence at the top, which needs no account.
            </p>
          </div>

          <!-- Native skill-bundle install (agentskills.io / .well-known) -->
          <div class="mt-5 pt-5 border-t border-border-soft" data-install-option>
            <div class="flex items-center justify-between gap-3 mb-2 flex-wrap">
              <h3 class="text-sm font-semibold text-text">Your agent supports the agentskills.io standard?</h3>
              <span class="text-[11px] text-muted-soft">Hermes · Claude Code · any agentskills.io agent</span>
            </div>
            <div class="bd-cmd">
              <pre class="bd-pre bg-[#0d0d0d] border border-border rounded-xl p-4 text-sm text-cool"><code id="wellknown-line">Install the agentskills.io skill bundle from app.loopskill.io/api/bundles/public/…</code></pre>
              <button id="copy-wk-btn" class="bd-copy" type="button" aria-label="Copy the agentskills.io install sentence">Copy</button>
            </div>
            <p class="text-xs text-muted-soft mt-3">
              Standards-based install via the open <a href="https://agentskills.io/specification" class="text-cool hover:underline" target="_blank" rel="noopener">agentskills.io</a> <code>.well-known/skills</code> convention — the whole bundle lands as native skills in your agent. Free catalog skills install in full; paid skills, and some community skills LoopSkill cannot redistribute, arrive as a short locked pointer file until you install with a LoopSkill key.
            </p>
          </div>
        </details>
      </section>

      <!-- Skill list -->
      <section id="skills-section">
        <h2 class="text-sm font-medium text-muted-soft uppercase tracking-wide mb-3">Skills in this bundle</h2>
        <div id="bd-empty" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center text-sm text-muted">
          This bundle has no skills yet.
        </div>
        <ul id="skills-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></ul>
      </section>

      <!-- Personality list. Hidden by default and revealed only when the API
           returns declared personalities, so a skills-only bundle renders
           exactly as before (self-hiding shelf, same convention as the other
           real-data sections). -->
      <section id="personalities-section" hidden class="mt-10">
        <h2 class="text-sm font-medium text-muted-soft uppercase tracking-wide mb-3">Personalities in this bundle</h2>
        <ul id="personalities-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></ul>
      </section>

      <!-- CTA footer -->
      <section class="mt-12 bg-bg-card border border-border rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="font-semibold mb-1">Build your own bundle</p>
          <p class="text-sm text-muted">Pick the skills you want and share them as one link.</p>
        </div>
        <a href="/pricing" class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Get started</a>
      </section>
    </div>
  </main>
</AppShell>

<!-- qa1018: is:global + a .bd-pub prefix. The skill/personality rows are built
     by client JS (createElement), so Astro's default attribute-scoped selectors
     ([data-astro-cid-*]) never matched them — the stretched-link and badge styles
     were silently dead on the live page. Prefixing keeps them page-local. -->
<style is:global>
  .bd-pub .badge { display: inline-flex; align-items: center; gap: .25rem; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; padding: .15rem .5rem; border-radius: 999px; border: 1px solid; }
  .bd-pub .badge-public { color: #4ade80; background: rgba(74,222,128,.1); border-color: rgba(74,222,128,.3); }
  .bd-pub .badge-scan { color: #5b9bf5; background: rgba(91,155,245,.1); border-color: rgba(91,155,245,.35); }
  /* qa1018: plain-words trust label, sentence case (no uppercase jargon pill). */
  .bd-pub .badge-community { font-size: 11px; text-transform: none; letter-spacing: 0; color: #fbbf24; background: rgba(251,191,36,.08); border-color: rgba(251,191,36,.35); }
  .bd-pub .bd-community-note { color: #fbbf24; }
  /* MOB-10: long commands WRAP at 375px — never a side-scrolling <pre>. */
  .bd-pub .bd-pre { white-space: pre-wrap; overflow-wrap: anywhere; overflow-x: hidden; margin: 0; }
  .bd-pub .bd-pre code { white-space: pre-wrap; overflow-wrap: anywhere; }
  .bd-pub .bd-pre code.bd-break { word-break: break-all; }
  .bd-pub .bd-cmd { display: flex; flex-direction: column; gap: .5rem; }
  /* MOB-5: every Copy button is a >=44px tap target. */
  .bd-pub .bd-copy { align-self: flex-start; min-height: 44px; min-width: 96px; padding: .6rem 1.1rem; border-radius: .6rem; font-size: .875rem; font-weight: 600; background: var(--accent, #ffd166); color: var(--bg, #0a0a0a); border: 1px solid var(--accent, #ffd166); cursor: pointer; }
  .bd-pub .bd-copy:hover { filter: brightness(1.08); }
  /* MOB-11: the disclosure is a real >=44px control with a clear chevron. */
  .bd-pub .bd-other-summary { display: flex; align-items: center; gap: .6rem; min-height: 44px; padding: .6rem .9rem; border: 1px solid var(--border, #2a2f3a); border-radius: .75rem; font-size: .9rem; font-weight: 600; color: var(--text, #e6e9ef); cursor: pointer; list-style: none; }
  .bd-pub .bd-other-summary::-webkit-details-marker { display: none; }
  .bd-pub .bd-other-summary::before { content: "▸"; display: inline-block; transition: transform .15s ease; color: var(--accent, #ffd166); }
  .bd-pub .bd-other[open] > .bd-other-summary::before { transform: rotate(90deg); }
  .bd-pub .skill-row { position: relative; display: flex; flex-direction: column; gap: .5rem; padding: .9rem 1rem; background: var(--bg-card, #14171d); border: 1px solid var(--border, #2a2f3a); border-radius: .85rem; transition: border-color .15s ease, transform .1s ease; }
  .bd-pub .skill-row:hover { border-color: var(--accent, #5b9bf5); transform: translateY(-1px); }
  /* Stretched-link pattern: the primary <a> covers the whole card so the
     entire card is clickable, while the secondary "View on LoopSkill" <a>
     stays independently clickable above it (no nested <a>, which is invalid
     HTML and unreliable across browsers). */
  .bd-pub .skill-row-link { position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .bd-pub .skill-row > * { position: relative; z-index: 2; pointer-events: none; }
  .bd-pub .skill-row > .skill-row-link { position: absolute; z-index: 1; pointer-events: auto; }
  .bd-pub .skill-row a.skill-loopskill-link { pointer-events: auto; }
  .bd-pub .skill-source-badge { display: inline-flex; align-items: center; font-size: 10px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted-soft, #9aa3b2); background: var(--bg-elev, #1b1f27); border: 1px solid var(--border-soft, #2a2f3a); border-radius: 999px; padding: .1rem .5rem; }
  /* MOB-8 / SKP-07 / BRK-11: owner/repo subtitle disambiguates duplicate names. */
  .bd-pub .skill-origin { font-size: 12px; color: var(--muted, #9aa3b2); overflow-wrap: anywhere; }
  .bd-pub .skill-view-source { font-size: 11px; color: var(--accent, #5b9bf5); }
  .bd-pub .skill-loopskill-link { font-size: 11px; color: var(--muted-soft, #9aa3b2); text-decoration: none; }
  .bd-pub .skill-loopskill-link:hover { color: var(--accent, #5b9bf5); }
</style>

<script define:vars={{ API_BASE }}>
  // qa1018 C06 — MIRROR of META_INSTALL_PHRASE + freshAgentPhrase() in
  // src/lib/agentInstall.ts. This script is define:vars (=> is:inline) and
  // CANNOT import, so the canonical string is copied here byte-for-byte.
  // tests/qa1018-bundle-install.test.ts extracts and executes this mirror and
  // asserts it equals freshAgentPhrase('bundle', …). Change agentInstall.ts first.
  const META_INSTALL_PHRASE = "Install the loopskill skill from https://app.loopskill.io/skill";
  function freshAgentPhrase(kind, slug) {
    return `${META_INSTALL_PHRASE}, then use it to install the "${slug}" ${kind}.`;
  }

  // One copy helper for every Copy button: copies EXACTLY the shown text.
  function wireCopy(btn, getText) {
    if (!btn || btn.__wired) return;
    btn.__wired = true;
    btn.addEventListener("click", async () => {
      const text = getText();
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied ✓";
        setTimeout(() => { btn.textContent = "Copy"; }, 1600);
      } catch {
        btn.textContent = "Select & copy";
      }
    });
  }

  // "github.com/<owner>/<repo>/…" -> "owner/repo"; any other URL -> hostname.
  // Returns "" for relative/invalid URLs. Rendered via textContent only.
  function sourceLabel(url) {
    if (typeof url !== "string" || !/^https?:\/\//i.test(url)) return "";
    try {
      const u = new URL(url);
      const host = u.hostname.replace(/^www\./, "");
      if (host === "github.com") {
        const seg = u.pathname.split("/").filter(Boolean);
        if (seg.length >= 2) return `${seg[0]}/${seg[1]}`;
      }
      return host;
    } catch {
      return "";
    }
  }

  // Resolve slug: ?slug=<slug> (primary, via query-param URL or a future
  // Caddy rewrite) or trailing path segment (fallback).
  const slug = (() => {
    const q = new URLSearchParams(location.search).get("slug");
    if (q) return q.trim();
    const parts = location.pathname.split("/").filter(Boolean);
    const last = parts[parts.length - 1];
    return last && last !== "p" && last !== "bundles" ? last : "";
  })();

  const $ = (id) => document.getElementById(id);
  const show = (id) => { const e = $(id); if (e) e.hidden = false; };
  const hide = (id) => { const e = $(id); if (e) e.hidden = true; };

  function fail(state, detail) {
    hide("state-loading");
    if (detail) { const d = $("error-detail"); if (d) d.textContent = detail; }
    show(state);
  }

  async function load() {
    if (!slug) { fail("state-notfound"); return; }
    let res;
    try {
      res = await fetch(`${API_BASE}/api/bundles/public/${encodeURIComponent(slug)}`);
    } catch (e) {
      fail("state-error", "Network error: " + (e && e.message ? e.message : e));
      return;
    }
    if (res.status === 404) { hide("state-loading"); show("state-notfound"); return; }
    if (!res.ok) { fail("state-error", `API returned ${res.status}.`); return; }
    let bd;
    try { bd = await res.json(); } catch { fail("state-error", "Malformed API response."); return; }
    render(bd);
  }

  function renderPersonalities(personalities) {
    const section = $("personalities-section");
    const list = $("personalities-list");
    if (!section || !list) return;

    // Self-hiding shelf: no declared personalities → the section never
    // appears, so skills-only bundles look exactly as they did before.
    if (!Array.isArray(personalities) || personalities.length === 0) {
      section.hidden = true;
      return;
    }

    list.innerHTML = "";
    for (const p of personalities) {
      if (!p || !p.slug) continue;

      const li = document.createElement("li");
      li.className = "skill-row";

      // Stretched-link pattern, same as the skill rows above: one full-card
      // anchor, no nested <a>. Personality detail pages are internal.
      const cardLink = document.createElement("a");
      cardLink.className = "skill-row-link";
      cardLink.href = `/personalities/${encodeURIComponent(p.slug)}`;
      cardLink.setAttribute("aria-label", p.title || p.slug);
      li.appendChild(cardLink);

      const top = document.createElement("div");
      top.className = "flex items-start justify-between gap-2";

      const nameEl = document.createElement("span");
      nameEl.className = "font-medium text-text";
      // textContent, never innerHTML — these strings come from the API.
      nameEl.textContent = p.title || p.slug;
      top.appendChild(nameEl);

      const badge = document.createElement("span");
      badge.className = "skill-source-badge shrink-0";
      badge.textContent = "personality";
      top.appendChild(badge);
      li.appendChild(top);

      if (p.description) {
        const desc = document.createElement("div");
        desc.className = "text-sm text-muted line-clamp-2";
        desc.textContent = p.description;
        li.appendChild(desc);
      }

      const bottom = document.createElement("div");
      bottom.className = "flex items-center justify-between gap-2 flex-wrap";

      const view = document.createElement("span");
      view.className = "skill-view-source";
      view.textContent = "view persona →";
      bottom.appendChild(view);

      if (p.pinned_version) {
        const pin = document.createElement("span");
        pin.className = "text-xs text-muted-soft";
        pin.textContent = `v${p.pinned_version}`;
        bottom.appendChild(pin);
      }
      li.appendChild(bottom);

      list.appendChild(li);
    }

    section.hidden = false;
  }

  // A member LoopSkill does not host or scan (community bookmark / custom-added
  // GitHub skill). Same predicate as the row label below.
  function isCommunity(s) {
    const scan = (s && s.scan_status ? String(s.scan_status) : "").toLowerCase();
    if (scan && scan !== "unscanned") return false;
    return s && (s.is_public === false || !s.loopskill_url);
  }

  function render(bd) {
    hide("state-loading");
    show("content");

    document.title = (bd.name || "Bundle") + " — LoopSkill";
    $("bd-name").textContent = bd.name || "Bundle";
    if (bd.description) $("bd-desc").textContent = bd.description;
    if (bd.ref) $("bd-by").textContent = "shared by a creator on LoopSkill";

    const skills = bd.skills || [];
    const personalities = bd.personalities || [];
    // Count what the bundle actually carries. A personalities-only bundle
    // reporting "0 skills" reads as empty to a first-time visitor — the same
    // first-impression failure the install-count fix below addresses.
    const parts = [];
    if (skills.length > 0 || personalities.length === 0) {
      parts.push(`${skills.length} skill${skills.length === 1 ? "" : "s"}`);
    }
    if (personalities.length > 0) {
      parts.push(`${personalities.length} personalit${personalities.length === 1 ? "y" : "ies"}`);
    }
    // first-impression fix: a literal "0 installs" reads as a dead/abandoned
    // bundle to a first-time visitor — every one of the 10 public bundles
    // showed this on 2026-08-19. Only surface a real install count (>0);
    // below that threshold render "New" instead, same convention as the
    // skill-detail install badge (polish_1805 item — never a badge of shame).
    if (typeof bd.installs_total === "number" && bd.installs_total > 0) {
      parts.push(`${bd.installs_total} install${bd.installs_total === 1 ? "" : "s"}`);
    } else {
      parts.push("New");
    }
    if (typeof bd.installs_7d === "number" && bd.installs_7d > 0) parts.push(`${bd.installs_7d} this week`);
    $("bd-stats").textContent = parts.join("  ·  ");

    // first-impression fix (8): deep-link-only bundles (e.g. coreys-marketing:
    // 49 GitHub deep-link skills, zero hosted) install straight from the
    // origin repo rather than being rehosted — a visitor comparing bundles
    // needs to know that before they click install. Computed from data
    // already in the payload (every skill lacks a loopskill_url), no new API.
    const deepLinkBadge = $("bd-deeplink-badge");
    if (deepLinkBadge) {
      const allDeepLink = skills.length > 0 && skills.every((s) => !s.loopskill_url);
      deepLinkBadge.hidden = !allDeepLink;
    }

    const bundleSlug = bd.slug || slug;

    // qa1018 C06 — PRIMARY: the agent phrase. Shown text === copied text.
    const agentLine = freshAgentPhrase("bundle", bundleSlug);
    const agentEl = $("agent-line");
    if (agentEl) agentEl.textContent = agentLine;
    wireCopy($("copy-agent-btn"), () => agentLine);
    if (bd.requires_pro === true) show("bd-pro-note");

    // SKP-07: say near the install that community members are unreviewed.
    const community = skills.filter(isCommunity).length;
    const communityNote = $("bd-community-note");
    if (communityNote && community > 0) {
      communityNote.textContent = community === skills.length
        ? "Heads-up: these are community skills from other people's GitHub repos. LoopSkill has not reviewed them — open each one below to read it before you install."
        : `Heads-up: ${community} of these ${skills.length} skills are community skills from other people's GitHub repos. LoopSkill has not reviewed them — open each one below to read it before you install.`;
      communityNote.hidden = false;
    }

    // bundles_0811 P1 (F1/F2) — the auth-free shell command, now SECONDARY
    // ("Prefer a terminal?"). Prefer the server-provided install_command; only
    // fall back to constructing it if an older API build did not send one.
    const installLine =
      bd.install_command ||
      `curl -fsSL https://app.loopskill.io/api/bundles/install.sh | bash -s -- ${bd.slug}`;
    const installEl = $("install-line");
    if (installEl) installEl.textContent = installLine;
    wireCopy($("copy-install-btn"), () => installLine);

    // The one-line clone — prefer the server-provided clone_line (carries ?ref),
    // fall back to a constructed line if the API didn't send one. Lives inside
    // "Other ways to install" under "Already have LoopSkill connected (API key)?".
    const cloneLine = bd.clone_line || `loopskill_bundle_install from "bundle://${bd.slug}"`;
    $("clone-line").textContent = cloneLine;

    // Label the MCP line with the TRUTH the API reports. Presenting an
    // auth-requiring line as though it were open is the F1 defect itself, so the
    // badge is driven by the server flag rather than hardcoded copy.
    const cloneBadge = $("clone-auth-badge");
    if (cloneBadge && bd.clone_line_requires_auth === false) {
      cloneBadge.textContent = "no key required";
    } else if (cloneBadge) {
      cloneBadge.textContent = "requires a free API key";
    }
    wireCopy($("copy-btn"), () => cloneLine);

    // Open-standard bundle install (agentskills.io). Plain-English, cross-vendor —
    // no leaked "well-known:" token, no vendor-locked CLI. Any agentskills.io-aware
    // agent resolves the /.well-known/skills bundle from this base URL.
    const wkLine = `Install the agentskills.io skill bundle from app.loopskill.io/api/bundles/public/${bd.slug}`;
    const wkEl = $("wellknown-line");
    if (wkEl) wkEl.textContent = wkLine;
    wireCopy($("copy-wk-btn"), () => wkLine);

    // BRK-11: never leave "Other ways to install" as an empty heading.
    const otherWays = $("bd-other-ways");
    if (otherWays) {
      const anyOption = Array.from(otherWays.querySelectorAll("[data-install-option]")).some((el) => !el.hidden);
      otherWays.hidden = !anyOption;
      otherWays.style.display = anyOption ? "" : "none";
    }

    renderPersonalities(bd.personalities || []);

    // A bundle can legitimately carry ZERO skills and still be non-empty —
    // agent-bench declares 3 personalities and no skills. The old early
    // `return` here fired before any other section rendered, so such a bundle
    // showed "no skills yet" and nothing else. Only the SKILLS section is
    // empty in that case; render it as such and keep going.
    if (skills.length === 0) {
      show("bd-empty");
      return;
    }

    const list = $("skills-list");
    list.innerHTML = "";
    for (const s of skills) {
      // Primary CLICKABLE target: source_url (always non-null per the API
      // contract — external skills resolve to their GitHub tree URL, internal
      // skills to their own origin or /skills/<slug>). Falls back to the
      // LoopSkill detail page only if source_url is somehow absent (defensive;
      // the API guarantees it's always truthy).
      const href = s.source_url || s.loopskill_url || `/skills/${s.slug}`;
      const isExternalHref = /^https?:\/\//.test(href);

      const li = document.createElement("li");
      li.className = "skill-row";

      // Full-card clickable overlay (stretched-link pattern — no nested <a>).
      const cardLink = document.createElement("a");
      cardLink.className = "skill-row-link";
      cardLink.href = href;
      cardLink.setAttribute("aria-label", s.title || s.slug);
      if (isExternalHref) {
        cardLink.target = "_blank";
        cardLink.rel = "noopener";
      }
      li.appendChild(cardLink);

      const top = document.createElement("div");
      top.className = "flex items-start justify-between gap-2";

      // MOB-8 / SKP-07 / BRK-11: name + owner/repo subtitle, so two members
      // both titled "ai-seo" are told apart by where they come from. All
      // upstream-controlled strings go through textContent (never innerHTML).
      const nameWrap = document.createElement("div");
      nameWrap.className = "flex flex-col min-w-0";
      const nameEl = document.createElement("span");
      nameEl.className = "font-medium text-text";
      nameEl.textContent = s.title || s.slug;
      nameWrap.appendChild(nameEl);
      const origin = sourceLabel(s.source_url);
      if (origin) {
        const originEl = document.createElement("span");
        originEl.className = "skill-origin";
        originEl.textContent = `from ${origin}`;
        nameWrap.appendChild(originEl);
        cardLink.setAttribute("aria-label", `${s.title || s.slug} — from ${origin}`);
      }
      top.appendChild(nameWrap);

      // qa1018 (NNS-12): "custom-added" is internal jargon and every member of a
      // community bundle carries it — no badge. Other sources keep a plain label.
      const sourceText = s.source === "custom-added" ? "" : s.source === "catalog" ? "LoopSkill catalog" : (s.source || "");
      if (sourceText) {
        const badge = document.createElement("span");
        badge.className = "skill-source-badge shrink-0";
        badge.textContent = sourceText;
        top.appendChild(badge);
      }
      li.appendChild(top);

      const bottom = document.createElement("div");
      bottom.className = "flex items-center justify-between gap-2 flex-wrap";

      const viewSource = document.createElement("span");
      viewSource.className = "skill-view-source";
      viewSource.textContent = isExternalHref ? "read the source ↗" : "view skill →";
      bottom.appendChild(viewSource);

      // Trust badge — Ph C scan status when present; otherwise say in plain
      // words that LoopSkill has not reviewed it (replaces the old "as-is" jargon pill).
      const scan = (s.scan_status || "").toLowerCase();
      if (scan && scan !== "unscanned") {
        const b = document.createElement("span");
        b.className = "badge badge-scan";
        b.textContent = scan === "clean" ? "scanned" : scan;
        bottom.appendChild(b);
      } else if (isCommunity(s)) {
        const b = document.createElement("span");
        b.className = "badge badge-community";
        b.textContent = "Community skill — not reviewed by LoopSkill";
        bottom.appendChild(b);
      }
      li.appendChild(bottom);

      // Secondary "View on LoopSkill" link — rendered ONLY when loopskill_url
      // is non-null. Hard "never 404" rule: no affordance at all when null
      // (external skills have no LoopSkill detail page yet). Sits ABOVE the
      // full-card overlay (z-index + pointer-events) so it's independently
      // clickable without triggering the primary source_url navigation.
      if (s.loopskill_url) {
        const lsLink = document.createElement("a");
        lsLink.className = "skill-loopskill-link";
        lsLink.href = s.loopskill_url;
        lsLink.textContent = "View on LoopSkill →";
        li.appendChild(lsLink);
      }

      list.appendChild(li);
    }
  }

  load();

  // gap/pages: /bundles/{slug} is now a REAL static, indexable page (see
  // src/pages/bundles/[slug].astro). This query-param route stays fully
  // functional — D6 says never hard-404 a formerly-live URL, and it is the
  // form every already-shared link uses — but crawlers should attribute the
  // content to the canonical path, not to ?slug=. Point the canonical link at
  // the static page once we know the slug.
  //
  // Deliberately NOT a redirect: this page is a working surface with its own
  // tested install block, and replacing it with a forwarding stub would delete
  // shipped behaviour (10 tests in bundles0811-p1-install-block.test.ts and
  // spotify-0608-f-cookbooks.test.ts assert on exactly that markup).
  (function pointCanonicalAtStaticPage() {
    try {
      const q = new URLSearchParams(location.search).get("slug");
      const seg = location.pathname.replace(/\/+$/, "").split("/").pop();
      const slug = q || (seg && seg !== "p" ? seg : "");
      if (!slug) return;
      const link =
        document.querySelector('link[rel="canonical"]') ||
        document.head.appendChild(Object.assign(document.createElement("link"), { rel: "canonical" }));
      link.setAttribute("href", `https://app.loopskill.io/bundles/${slug}`);
    } catch {
      /* canonical is an optimisation, never a reason to break the page */
    }
  })();
</script>
