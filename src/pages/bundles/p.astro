---
// gap/pages — /bundles/p/?slug=<slug> is now a REDIRECT to the canonical
// static /bundles/{slug} page (see src/pages/bundles/[slug].astro).
//
// D6 page-cut policy: never hard-404 a formerly-live URL. This query-param
// route was the only reachable bundle URL before gap/pages — it is not
// removed, it now forwards to the real per-slug page so old shared links
// keep working while new links/citations use the indexable canonical path.
import AppShell from "../../layouts/AppShell.astro";
---

<AppShell mode="public"
  title="Bundle — LoopSkill"
  description="Redirecting to the bundle page."
  pageType="product"
>
  <main class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    <section id="state-redirecting" class="text-muted text-sm py-10">Redirecting to the bundle page…</section>
    <section id="state-notfound" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center">
      <h1 class="text-2xl font-semibold mb-2">Bundle not found</h1>
      <p class="text-sm text-muted mb-5">No bundle slug was given in this link.</p>
      <a href="/browse?type=bundles" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Browse public bundles</a>
    </section>
  </main>
</AppShell>

<script>
  // Resolve slug the same way the old handler did: ?slug=<slug> primary,
  // trailing path segment fallback (belt-and-suspenders for any link form
  // that predates this redirect).
  const slug = (() => {
    const q = new URLSearchParams(location.search).get("slug");
    if (q) return q.trim();
    const parts = location.pathname.split("/").filter(Boolean);
    const last = parts[parts.length - 1];
    return last && last !== "p" && last !== "bundles" ? last : "";
  })();

  if (slug) {
    window.location.replace(`/bundles/${encodeURIComponent(slug)}`);
  } else {
    const loading = document.getElementById("state-redirecting");
    const notfound = document.getElementById("state-notfound");
    if (loading) loading.hidden = true;
    if (notfound) notfound.hidden = false;
  }
</script>
