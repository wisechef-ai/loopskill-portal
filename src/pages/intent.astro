---
import AppShell from '../layouts/AppShell.astro';

const title = 'Would you deploy your AI agent stack to 20 small businesses for $100/mo?';
const description = 'Two-minute survey for solo AI operators and integrators. We ship the platform if 3 of 20 of you would actually pay.';
---
<AppShell mode="public" title={title} description={description}>
  <main class="max-w-2xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-10">
      <a href="/" class="text-xs text-muted hover:text-text transition inline-flex items-center gap-1.5 mb-6">
        <span aria-hidden="true">←</span> LoopSkill
      </a>
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-4">
        Would you deploy your AI agent stack to 20 small businesses for <span class="text-accent">$100/mo</span>?
      </h1>
      <p class="text-base md:text-lg text-muted leading-relaxed">
        We're building a deployment layer for solo AI operators — fork your skill stack, scope it
        to a client with a sub-key, push updates to all 20 from one subscription. Before we ship,
        we want to know if anyone would actually pay. Two minutes, anonymous, five questions.
      </p>
    </header>

    <form id="intent-form" class="space-y-8">
      <fieldset class="space-y-3">
        <legend class="text-sm font-semibold text-text">
          1. Would you pay $100/mo for the Operator plan as described above? <span class="text-accent">*</span>
        </legend>
        <div class="space-y-2">
          {[
            { v: 'yes', label: 'Yes — that\u2019s the price I would pay' },
            { v: 'maybe', label: 'Maybe — depends on what\u2019s included' },
            { v: 'no', label: 'No — too expensive, or the use case isn\u2019t mine' },
          ].map(o => (
            <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent/50 hover:bg-bg-card/50 cursor-pointer transition">
              <input type="radio" name="q1" value={o.v} required class="mt-1 accent-accent" />
              <span class="text-sm text-text">{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="text-sm font-semibold text-text">
          2. What do you do today that this would replace? <span class="text-muted-soft text-xs font-normal">(optional)</span>
        </legend>
        <textarea name="q2" rows="3" maxlength="2000" placeholder="e.g. I deploy bespoke n8n workflows to 4 clients and patch them by hand."
          class="w-full px-3 py-2 rounded-lg border border-border bg-bg-card/40 text-sm text-text placeholder:text-muted-soft focus:border-accent focus:outline-none transition"></textarea>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="text-sm font-semibold text-text">
          3. What's the deal-breaker for you? <span class="text-muted-soft text-xs font-normal">(optional)</span>
        </legend>
        <textarea name="q3" rows="3" maxlength="2000" placeholder="e.g. needs white-label, or HIPAA, or works with Codex not just Claude."
          class="w-full px-3 py-2 rounded-lg border border-border bg-bg-card/40 text-sm text-text placeholder:text-muted-soft focus:border-accent focus:outline-none transition"></textarea>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="text-sm font-semibold text-text">
          4. Which best describes you? <span class="text-accent">*</span>
        </legend>
        <div class="space-y-2">
          {[
            { v: 'solo', label: 'Solo AI operator / integrator (deploy to 1–20 clients)' },
            { v: 'integrator', label: 'AI integrator / build-in-public operator' },
            { v: 'dev', label: 'Developer building agents for one product' },
            { v: 'curious', label: 'Just curious — not deploying anything yet' },
          ].map(o => (
            <label class="flex items-start gap-3 p-3 rounded-lg border border-border hover:border-accent/50 hover:bg-bg-card/50 cursor-pointer transition">
              <input type="radio" name="q4" value={o.v} required class="mt-1 accent-accent" />
              <span class="text-sm text-text">{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <input type="hidden" name="q5" id="q5" />

      <button type="submit" id="submit-btn"
        class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-accent text-bg font-semibold text-sm hover:opacity-90 transition disabled:opacity-50 disabled:cursor-not-allowed">
        Send (anonymous)
      </button>

      <p id="form-status" role="status" aria-live="polite" class="text-sm text-muted hidden"></p>
    </form>

    <aside class="mt-16 pt-8 border-t border-border text-xs text-muted-soft leading-relaxed">
      <p class="mb-2"><strong class="text-text">Why we're asking:</strong> We've built half of v7 already. If under 15% of you say yes, we drop the $100 tier and rescope. We'd rather kill it before launch than after.</p>
      <p>No email collected. One row per submission. Aggregate counts visible to Adam and the team only.</p>
    </aside>
  </main>

  <script is:inline>
    (function () {
      var form = document.getElementById('intent-form');
      var btn = document.getElementById('submit-btn');
      var status = document.getElementById('form-status');
      var q5 = document.getElementById('q5');

      // Capture distribution source from ?source=reddit / linkedin / hn / etc.
      try {
        var u = new URL(window.location.href);
        var src = u.searchParams.get('source') || '';
        var ref = document.referrer ? new URL(document.referrer).hostname : '';
        var ts = new Date().toISOString().slice(0, 10);
        q5.value = (src ? 'src=' + src.slice(0, 32) + ';' : '') +
                   (ref ? 'ref=' + ref.slice(0, 64) + ';' : '') +
                   'ts=' + ts;
      } catch (e) {}

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Sending\u2026';
        status.classList.remove('hidden');
        status.classList.remove('text-red-400');
        status.classList.add('text-muted');
        status.textContent = '';

        var fd = new FormData(form);
        var payload = {
          q1: fd.get('q1'),
          q2: (fd.get('q2') || '').toString().trim() || null,
          q3: (fd.get('q3') || '').toString().trim() || null,
          q4: fd.get('q4'),
          q5: (fd.get('q5') || '').toString().slice(0, 512) || null,
        };

        try {
          var resp = await fetch('/api/intent-survey', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (resp.ok) {
            form.style.display = 'none';
            status.classList.remove('text-muted');
            status.classList.add('text-text');
            status.innerHTML = '<strong class="text-accent">Thanks.</strong> That\u2019s exactly the signal we needed. ' +
              '<a href="/" class="underline hover:text-accent transition">Back to LoopSkill</a>.';
          } else {
            var msg = 'Something went wrong (HTTP ' + resp.status + '). Try again in a moment.';
            try { var j = await resp.json(); if (j && j.detail) msg = 'Validation: ' + JSON.stringify(j.detail); } catch (_) {}
            status.classList.remove('text-muted');
            status.classList.add('text-red-400');
            status.textContent = msg;
            btn.disabled = false;
            btn.textContent = 'Send (anonymous)';
          }
        } catch (err) {
          status.classList.remove('text-muted');
          status.classList.add('text-red-400');
          status.textContent = 'Network error. Check your connection and try again.';
          btn.disabled = false;
          btn.textContent = 'Send (anonymous)';
        }
      });
    })();
  </script>
</AppShell>
