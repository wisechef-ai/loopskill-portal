---
import AppShell from '../layouts/AppShell.astro';
import CrossSell from '../components/CrossSell.astro';
import Icon from '../components/Icon.astro';
import AgentLogos from '../components/AgentLogos.astro';
import NeuronAnimation from '../components/NeuronAnimation.astro';
import InstallWidget from '../components/InstallWidget.astro';
import SkillCover from '../components/SkillCover.astro';
import { fetchApi } from '../lib/api';

// Pull live skill count for the stats strip (retry+jitter; fallback below if API unreachable).
// CANONICAL NUMBER = 72 = the BROWSABLE catalog (marketing SSOT).
//   - /api/marketing/snapshot → counts.skills_total = 72  (the marketing source of truth)
//   - /api/skills/search      → total = 72                (what /skills actually lists; this fetch)
//   - /api/stats              → total_skills = 76         (total INCL. 4 private/unlisted pro skills)
// DO NOT "fix" this fallback to 76. The hero links "Browse {N}+ skills → /skills", and /skills
// only exposes the 72 public skills; marketing 76 would overstate the browsable catalog and break
// claim-grounded-marketing. The 4-skill gap is private pro skills not reachable from the catalog.
// The `+` suffix keeps "72+" honest even as the public count grows. Verified 2026-06-08.
// 2026-06-07: bumped fallback 59 → 72 to match the marketing SSOT (/api/marketing/snapshot).
// 2026-05-20: API rate limiter now exempts authenticated callers (per-IP cap
// was busting on 116-page parallel builds even with our retry+cache); this
// fetch reliably gets the live total now. Fallback retained as belt-and-suspenders.
let liveSkillCount = 72;
try {
  const result = await fetchApi<{ total: number }>('/api/skills/search?page_size=1');
  if (result.ok && result.data && typeof result.data.total === 'number' && result.data.total > 0) {
    liveSkillCount = result.data.total;
  }
} catch {}

// first-impression fix (5): the hero/stats-strip/spotlight copy hardcoded
// "80,000+" / "80k-skill universe" in five places while the live federation
// count (/api/skills/external, public/no-key — the same endpoint llms.txt
// already binds to) had grown to 91,170. Bind the headline the same way
// llms.txt does: round DOWN to a defensible "+" figure so the claim stays
// true as the count drifts between crawler walks, and degrade to the last
// verified honest floor (80,000+, still true — 91k > 80k) rather than a
// hardcoded literal if the build-time fetch fails.
let federatedSkillCount = 80000;
try {
  const result = await fetchApi<{ counts?: { external_indexed?: number } }>('/api/skills/external', { authed: false });
  const indexed = result.ok ? result.data?.counts?.external_indexed : undefined;
  if (typeof indexed === 'number' && indexed >= 80000) {
    federatedSkillCount = Math.floor(indexed / 1000) * 1000;
  }
} catch {}
const federatedSkillLabel = `${federatedSkillCount.toLocaleString()}+`;

// Agent-proof bar (landing_0821): the numbers that prove machine-readiness,
// each bound to a live public endpoint at build time with the same
// fail-closed discipline as federatedSkillCount above — a stat that can't
// be fetched is OMITTED, never invented. mcpToolCount comes from the same
// healthz the #216 re-rot guard audits, so this can never drift from live.
let mcpToolCount: number | null = null;
try {
  const r = await fetchApi<{ tools?: string[] }>('/api/mcp/healthz', { authed: false });
  if (r.ok && Array.isArray(r.data?.tools) && r.data.tools.length > 0) {
    mcpToolCount = r.data.tools.length;
  } else {
    console.log('[proof-bar] mcp healthz miss:', JSON.stringify({ ok: r.ok, status: r.status, error: r.error, keys: r.data ? Object.keys(r.data) : null }));
  }
} catch (e) { console.log('[proof-bar] mcp healthz threw:', (e as Error).message); }
let hostedSkillCount: number | null = null;
try {
  const r = await fetchApi<{ total_skills?: number }>('/api/stats', { authed: false });
  if (r.ok && typeof r.data?.total_skills === 'number' && r.data.total_skills > 0) {
    hostedSkillCount = r.data.total_skills;
  }
} catch {}
const agentProofStats: { value: string; label: string; href: string }[] = [];
if (mcpToolCount) agentProofStats.push({ value: String(mcpToolCount), label: 'MCP tools — search, install, publish', href: '/docs/mcp' });
if (hostedSkillCount) agentProofStats.push({ value: String(hostedSkillCount), label: 'hosted skills, versioned + signed', href: '/skills' });
agentProofStats.push({ value: federatedSkillLabel, label: 'community skills federated', href: '/federation/' });
agentProofStats.push({ value: '0 humans', label: 'agents enrol themselves (Ed25519)', href: '/docs/new-agent' });

// Cook-tier strip — gated public skills, surfaces what Pro unlocks.
// Live filter on tier=cook AND is_public=true. identity-guards fix
// (2026-07-05): the hardcoded fallback list below was FICTIONAL —
// install_count_total: 0 on every row, several slugs unverifiable against
// the live catalog. An honest empty/omitted state beats invented entries:
// if the fetch fails or returns nothing, cookSkills simply stays empty and
// downstream consumers (cookStrip) render nothing rather than fiction.
type CookSkill = { slug: string; title: string; description?: string | null; tagline?: string | null; install_count_total?: number; install_count?: number; category?: string | null };
let cookSkills: CookSkill[] = [];
try {
  const result = await fetchApi<{ results: CookSkill[] }>('/api/skills/search?tier=cook&is_public=true&page_size=24');
  if (result.ok && result.data?.results) {
    cookSkills = result.data.results;
  }
} catch {}
// Pin larry first (when present); sort the rest by install_count desc so the
// most-used cook skills surface. No fictional fallback — empty stays empty.
const installCount = (s: CookSkill) => s.install_count_total ?? s.install_count ?? 0;
const larryRow = cookSkills.find(s => s.slug === 'larry');
const restCook = cookSkills.filter(s => s.slug !== 'larry').sort((a, b) => installCount(b) - installCount(a));
const cookStrip: CookSkill[] = (larryRow ? [larryRow, ...restCook] : restCook).slice(0, 8);

// Spotlight — Pro skill highlights in the hero grid.
// Phase H (recipes_2005): replaced hardcoded array with live API fetch to eliminate
// the web-scraper-pro 404. identity-guards fix (2026-07-05): the "spotlightFallback"
// hardcoded array this used to fall back to was itself fictional/unverifiable
// against the live catalog and was rendered with real-looking PRO/PRO+ tier
// badges — indistinguishable from genuine catalog data to a visitor. Removed:
// when the API is unreachable at build time, spotlight (and everything derived
// from it) is simply empty and the section is omitted — never invented.
type SpotlightSkill = { slug: string; title?: string; name?: string; tier?: string; tagline?: string; description?: string; badge?: string | null; icon?: string; category?: string };
let spotlight: SpotlightSkill[] = [];
try {
  const result = await fetchApi<{ results: SpotlightSkill[] }>('/api/skills/search?tier=pro&is_public=true&page_size=4');
  if (result.ok && result.data?.results) spotlight = result.data.results;
} catch {} // Rationale: offline build or API down — section below is omitted, no invented fallback

// ─── Popular-skills rail (content-led hero, Spotify-shelf style) ────────────
// Build-time fetch: mixed tiers, sorted by install_count. When the fetch
// fails/returns empty, popularSkills stays empty and the whole rail section
// is omitted (gated by `popularSkills.length > 0` below) — no invented cards.
type RailSkill = { slug: string; title?: string; name?: string; description?: string; category?: string; tier?: string; install_count_total?: number };
let popularSkills: RailSkill[] = [];
try {
  const result = await fetchApi<{ results: RailSkill[] }>('/api/skills/search?limit=12');
  if (result.ok && result.data?.results) popularSkills = result.data.results;
} catch {}

// ─── Public-bundles rail (the shareable playlists) ───────────────────────
// GET /api/cookbooks/discover is public + ranked by real installs.
// NOTE: `theme` is an OBJECT ({label, accent, icon}) or null on the live API,
// not a string — SkillCover's `category` prop expects a string it can
// .toLowerCase(). Passing the raw theme object crashed the prerender build
// (qa0208 residue-lane build-gate fix). Derive a plain string via theme.icon.
type DiscoverCb = {
  slug?: string;
  name?: string;
  description?: string;
  skill_count?: number;
  theme?: { label?: string; accent?: string; icon?: string } | null;
};
let publicCookbooks: DiscoverCb[] = [];
try {
  const result = await fetchApi<{ cookbooks?: DiscoverCb[]; items?: DiscoverCb[] }>('/api/cookbooks/discover?sort=installs&limit=8');
  const rows = result.ok && result.data ? (result.data.cookbooks || result.data.items || []) : [];
  publicCookbooks = rows.filter(c => c.slug);
} catch {} // Rationale: offline build — rail simply omits

// ─── Agent Bootcamp — live fetch at build time ───────────────────────────────
// GET /api/bootcamp is PUBLIC (no auth required). We pass authed:false to skip
// the x-api-key header. Tracks are stable (low churn) so build-time bake is safe.
// 2026-06-07: Bootcamp shipped as PRs #472+#473. Three tracks, each starting on
// the free on-ramp (super-memory) and crossing free→Pro at a documented step.
type BootcampTrack = {
  id: string;
  title: string;
  subtitle: string;
  audience: string;
  outcome: string;
  step_count: number;
  free_steps: number;
  paid_steps: number;
};
type BootcampTrackResponse = { tracks: BootcampTrack[] };

type BootcampStep = {
  position: number;
  slug: string;
  title: string;
  tier: string;
  is_free: boolean | null;
  available: boolean;
  install_link: string;
  why: string;
};
type BootcampTrackDetail = BootcampTrack & { steps: BootcampStep[] };

// Fallback uses ONLY verified-real slugs (all confirmed 200 on /api/bootcamp endpoints, 2026-06-07).
const bootcampFallback: BootcampTrackDetail[] = [
  {
    id: 'zero-to-agent',
    title: 'Zero to Agent',
    subtitle: 'Stand up a production-grade agent from scratch — memory first, then capability.',
    audience: 'Builders who want the canonical setup, not 50 tabs of trial-and-error.',
    outcome: 'A persistent-memory agent that survives restarts and runs a daily operating loop.',
    step_count: 5, free_steps: 2, paid_steps: 3,
    steps: [
      { position: 1, slug: 'super-memory', title: 'super-memory', tier: 'free', is_free: true, available: true, why: 'Start here. Full memory stack in one command. Free on-ramp — zero spend on day one.', install_link: '/skills/super-memory?ref=bootcamp-zero-to-agent-step-1' },
      { position: 2, slug: 'hyperspace-matrix', title: 'hyperspace-matrix', tier: 'free', is_free: true, available: true, why: 'Discover more skills as your agent needs them. Free on-ramp — search 100k+ indexed capabilities.', install_link: '/skills/hyperspace-matrix?ref=bootcamp-zero-to-agent-step-2' },
      { position: 3, slug: 'cognee', title: 'cognee', tier: 'pro', is_free: false, available: true, why: 'Self-hosted graph retrieval at scale. First Pro skill.', install_link: '/skills/cognee?ref=bootcamp-zero-to-agent-step-3' },
      { position: 4, slug: 'maestro', title: 'maestro', tier: 'pro', is_free: false, available: true, why: 'Morning brief, marketing, code delegation. Turns an agent into an operating loop.', install_link: '/skills/maestro?ref=bootcamp-zero-to-agent-step-4' },
      { position: 5, slug: 'framework-v0', title: 'framework-v0', tier: 'pro', is_free: false, available: true, why: 'One-call bootstrap for the full Maestro stack.', install_link: '/skills/framework-v0?ref=bootcamp-zero-to-agent-step-5' },
    ],
  },
  {
    id: 'content-engine',
    title: 'Content Engine',
    subtitle: 'A self-hosted media + distribution pipeline your agent drives end-to-end.',
    audience: 'Operators who want their agent to produce and ship media without per-call API bills.',
    outcome: 'An agent that scrapes, generates video + audio — zero per-generation API spend.',
    step_count: 5, free_steps: 1, paid_steps: 4,
    steps: [
      { position: 1, slug: 'super-memory', title: 'super-memory', tier: 'free', is_free: true, available: true, why: 'Memory of what it has produced — avoids duplicate work. Free on-ramp.', install_link: '/skills/super-memory?ref=bootcamp-content-engine-step-1' },
      { position: 2, slug: 'scrapling-official', title: 'scrapling-official', tier: 'pro', is_free: false, available: true, why: 'Headless scraping for JS-heavy / Cloudflare-protected pages — the input side.', install_link: '/skills/scrapling-official?ref=bootcamp-content-engine-step-2' },
      { position: 3, slug: 'comfyui', title: 'comfyui', tier: 'pro', is_free: false, available: true, why: 'Generate images, video, audio locally — no per-frame API spend.', install_link: '/skills/comfyui?ref=bootcamp-content-engine-step-3' },
      { position: 4, slug: 'local-tts-kokoro', title: 'local-tts-kokoro', tier: 'pro', is_free: false, available: true, why: 'Local TTS at 2.6× realtime — voiceover without an ElevenLabs bill.', install_link: '/skills/local-tts-kokoro?ref=bootcamp-content-engine-step-4' },
      { position: 5, slug: 'manim-video', title: 'manim-video', tier: 'pro', is_free: false, available: true, why: '3Blue1Brown-style animations — the high-retention capstone of a local-first media stack.', install_link: '/skills/manim-video?ref=bootcamp-content-engine-step-5' },
    ],
  },
  {
    id: 'agent-fleet',
    title: 'Run a Fleet',
    subtitle: 'Coordinate multiple agents without infinite loops or split-brain.',
    audience: 'Operators graduating from one agent to a coordinated team.',
    outcome: 'Shared memory, loop-safe Discord coordination, per-client reporting.',
    step_count: 4, free_steps: 1, paid_steps: 3,
    steps: [
      { position: 1, slug: 'super-memory', title: 'super-memory', tier: 'free', is_free: true, available: true, why: 'Shared memory is the substrate a fleet coordinates on. Free on-ramp.', install_link: '/skills/super-memory?ref=bootcamp-agent-fleet-step-1' },
      { position: 2, slug: 'multi-agent-discord-coordination', title: 'multi-agent-discord-coordination', tier: 'pro', is_free: false, available: true, why: 'Loop-safe protocol for 2+ agents on Discord — the exact failure mode that kills naive fleets.', install_link: '/skills/multi-agent-discord-coordination?ref=bootcamp-agent-fleet-step-2' },
      { position: 3, slug: 'chef', title: 'Chef', tier: 'pro', is_free: false, available: true, why: 'Per-agent operating template: morning brief, marketing, code delegation.', install_link: '/skills/chef?ref=bootcamp-agent-fleet-step-3' },
      { position: 4, slug: 'client-reporter', title: 'Client Reporter', tier: 'pro', is_free: false, available: true, why: 'GA4, GSC, Meta + TikTok Ads → branded PDF. Turns a fleet into billable client work.', install_link: '/skills/client-reporter?ref=bootcamp-agent-fleet-step-4' },
    ],
  },
];

let bootcampTracks: BootcampTrackDetail[] = [];
try {
  // Step 1: fetch the track list
  const listResult = await fetchApi<BootcampTrackResponse>('/api/bootcamp', { authed: false });
  if (listResult.ok && listResult.data?.tracks?.length) {
    // Step 2: fetch each track detail in parallel
    const trackIds = listResult.data.tracks.map((t: BootcampTrack) => t.id);
    const detailResults = await Promise.all(
      trackIds.map((id: string) => fetchApi<BootcampTrackDetail>(`/api/bootcamp/${id}`, { authed: false }))
    );
    const resolved = detailResults.filter(r => r.ok && r.data).map(r => r.data as BootcampTrackDetail);
    if (resolved.length > 0) bootcampTracks = resolved;
  }
} catch {}
if (bootcampTracks.length === 0) bootcampTracks = bootcampFallback;

// ROT GUARD (2026-08-20) — see the same fix in bootcamp.astro.
// `bootcampFallback` hardcodes `available: true` under a comment claiming its
// slugs were "all confirmed 200 ... 2026-06-07". That verification EXPIRED:
// 6 of the 12 slugs (scrapling-official, cognee, comfyui, chef, maestro,
// framework-v0) now 404 and are absent from the live 57-skill catalog. Because
// the fallback only fires when the API is unreachable at build time, it turned
// a degraded build into a FAILED one — `audit-links` rightly refuses dead links.
// A dated "verified" comment is not a guarantee; it is a guarantee with an
// expiry date nobody checks.
//
// Resolve `available` against the real catalog, fail CLOSED when it can't be
// read. `available: false` renders the step as text (see the template's
// `step.available && step.install_link` gate), so the curriculum copy always
// survives — only the link does not.
{
  const catalogSlugs = new Set<string>();
  try {
    const cat = await fetchApi<{ results?: { slug?: string }[] }>(
      '/api/skills/search?page_size=100',
      { authed: false, maxAttempts: 2, timeoutMs: 8000 },
    );
    for (const s of cat.data?.results ?? []) if (s?.slug) catalogSlugs.add(s.slug);
  } catch {
    /* Rationale: fail closed — empty set means nothing links, never a 404 */
  }
  bootcampTracks = bootcampTracks.map((t) => ({
    ...t,
    steps: t.steps.map((s) => ({ ...s, available: !!s.slug && catalogSlugs.has(s.slug) })),
  }));
}

// Track accent colors — visual differentiation per track
const trackAccents: Record<string, { badge: string; dot: string; label: string }> = {
  'zero-to-agent':   { badge: 'bg-accent/10 border-accent/30 text-accent', dot: 'bg-accent', label: 'Foundation' },
  'content-engine':  { badge: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400', dot: 'bg-emerald-400', label: 'Media' },
  'agent-fleet':     { badge: 'bg-violet-500/10 border-violet-500/30 text-violet-400', dot: 'bg-violet-400', label: 'Fleet' },
};

const howItWorks = [
  { num: '01', title: 'You describe the goal', body: 'Plain language, in your existing AI agent. No searches, no docs, no copy-paste.', icon: 'lightning' },
  { num: '02', title: 'LoopSkill finds the skill', body: 'The meta-skill makes your agent aware of every LoopSkill skill. It picks the perfect match.', icon: 'search' },
  { num: '03', title: 'Installs locally in seconds', body: 'Skill files written to your machine. Your credentials, your data, your control.', icon: 'box' },
  { num: '04', title: 'Results delivered', body: 'A report. A scrape. A calendar. A patch. Done — and ready to ship.', icon: 'check' },
];

const stats = [
  { num: federatedSkillLabel, label: 'Skills across federated registries' },
  { num: `${liveSkillCount}`, label: 'Curated & signed in our catalog' },
  { num: 'pass / fail', label: 'Every loop run, objective + bounded' },
];

const heroPillars = [
  { title: 'Runnable + verified', body: 'Every loop runs under enforced bounds and returns an objective pass/fail. Proof, not a prompt.', icon: 'lightning' },
  { title: 'MCP-native', body: 'Dedicated tools. Your agent runs loops, searches, and installs from inside its own conversation.', icon: 'box' },
  { title: 'Open source', body: 'MPL-2.0. Self-host the whole registry for free. Pro is hosted convenience, never a feature gate.', icon: 'check' },
  { title: 'Curated + signed', body: `Small trusted core, audited every push, ed25519-signed delivery — inside the ${federatedSkillLabel} skill universe.`, icon: 'calendar' },
];

const verticals = [
  { label: 'Marketing', icon: 'chart', desc: 'Reports, calendars, audits, proposals' },
  { label: 'Code', icon: 'terminal', desc: 'Code review, refactors, test scaffolds' },
  { label: 'Web scraping', icon: 'search', desc: 'Stealth scrapers, structured extraction' },
  { label: 'Ops', icon: 'box', desc: 'Onboarding, invoicing, standups' },
  { label: 'Sales', icon: 'mail', desc: 'Outreach, CRM ops, proposals' },
  { label: 'Sim & robotics', icon: 'lightning', desc: 'ROS workflows, simulation pipelines' },
];
---
<AppShell
  mode="public"
  title="LoopSkill — the open skill registry for AI agents"
  description="LoopSkill is the open-source skill registry and MCP server for AI agents. Install versioned skills into Claude Code, Cursor, Cline, OpenClaw, Hermes or Windsurf, keep every agent in sync with bundles and fleet locks, and let agents discover, enrol and publish over MCP — no human in the loop. Free tier, Pro $9.95/mo, self-hostable."
>
  <script is:inline>
    // onechrome_0611 seam #1: returning members land on THEIR home, not marketing.
    // Client-side (static SSG, no server). location.replace = no history entry.
    fetch('/api/auth/me', { credentials: 'include' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (u) { if (u && u.id) window.location.replace('/home'); })
      .catch(function () { /* anon stays */ });
  </script>
  <section class="relative overflow-hidden min-h-[88vh] md:min-h-screen flex items-center">
    <NeuronAnimation />
    <div class="absolute inset-0 -z-20 opacity-[0.025] pointer-events-none"
         style="background-image: linear-gradient(to right, #fafafa 1px, transparent 1px), linear-gradient(to bottom, #fafafa 1px, transparent 1px); background-size: 64px 64px;"></div>

    <div class="max-w-6xl mx-auto px-6 pt-20 md:pt-28 pb-16 relative w-full">
      <div class="flex flex-col items-center text-center gap-6 max-w-3xl mx-auto">
        <a href="/skills" class="group inline-flex items-center gap-2 px-3 py-1 rounded-full border border-accent/40 text-xs text-accent hover:text-text hover:border-accent/60 transition backdrop-blur-sm bg-accent/5">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          Open-source skill registry + MCP server for AI agents
          <Icon name="arrow-right" size={11} class="opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" />
        </a>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter leading-[1.05]" style="letter-spacing: -0.04em;">
          One skill stack across every client agent —<br/><span class="text-gradient hero-glow">version-locked, drift-visible, synced</span> without logging into each machine.
        </h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed max-w-2xl">
          The open skill registry for <strong class="text-text font-semibold">AI agents</strong>. Install versioned, signed skills into Claude Code, Cursor, Cline, OpenClaw, Hermes or Windsurf — one command or one MCP call — and keep every agent you run converged on the same stack with bundles and fleet locks.
        </p>
        <p class="text-sm text-muted-soft leading-relaxed max-w-xl -mt-1">
          Agents are first-class citizens: yours can discover this registry, enrol itself (Ed25519 — no OAuth, no human), install, compose and publish bundles entirely over MCP. And every skill that matters ships with a runnable loop — press run, get an objective pass / fail.
        </p>
        <div class="flex items-center gap-3 mt-1">
          <a href="/skills" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">
            Browse the registry
          </a>
          <a href="/docs/new-agent" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-text font-semibold text-sm hover:border-accent transition">
            🤖 Point your agent here
          </a>
        </div>

        {/* ── Agent-proof bar (landing_0821): the four machine-readiness facts,
             every number bound to a live endpoint at build time (fail-closed —
             an unfetchable stat is omitted, never invented). This is the
             "what you actually get" strip the verdict hero was missing. ── */}
        <div class="w-full max-w-4xl mt-8 grid grid-cols-2 md:grid-cols-4 gap-3 text-left">
          {agentProofStats.map(st => (
            <a href={st.href} class="group rounded-xl border border-border bg-bg-card px-4 py-3 hover:border-accent transition">
              <p class="text-xl font-bold text-text group-hover:text-accent transition">{st.value}</p>
              <p class="text-[11px] text-muted-soft leading-snug mt-0.5">{st.label}</p>
            </a>
          ))}
        </div>

        {/* ── Share-skills trio (landing_0821): the core-pitch use case
             ("share Claude skills between agents") stated as three concrete
             verbs, each linking to a real surface. Static copy, no data deps. ── */}
        <div class="w-full max-w-4xl mt-6 grid md:grid-cols-3 gap-3 text-left">
          <div class="rounded-xl border border-border bg-bg-card px-4 py-4">
            <p class="text-sm font-semibold text-text mb-1">📦 One skill, every agent</p>
            <p class="text-xs text-muted leading-relaxed">Install the same versioned skill into Claude Code, Cursor, Cline, OpenClaw, Hermes or Windsurf — one command or one MCP call, no per-vendor rewrites. <a href="/docs" class="text-accent hover:underline">How installs work →</a></p>
          </div>
          <div class="rounded-xl border border-border bg-bg-card px-4 py-4">
            <p class="text-sm font-semibold text-text mb-1">🔄 Drift-proof by default</p>
            <p class="text-xs text-muted leading-relaxed">Bundles pin exact versions with locks; fleet sync converges every machine to the same stack on a schedule. Stop copy-pasting SKILL.md files. <a href="/bundles/loopskill-essentials" class="text-accent hover:underline">See a bundle →</a></p>
          </div>
          <div class="rounded-xl border border-border bg-bg-card px-4 py-4">
