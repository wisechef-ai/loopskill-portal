  <section class="border-t border-border" id="carousel-section" data-fetch-url="/api/carousel/today">
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 mb-12">
        <div class="max-w-xl">
          <p class="eyebrow text-accent">Today's 7</p>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2" style="letter-spacing: -0.03em;">A new skill, every<br/>5 AM London time.</h2>
          <p class="text-muted mt-3 text-lg">The carousel is how Recipes keeps the catalog honest. Each card runs against incumbent skills for 7 days. Telemetry decides what graduates to core.</p>
        </div>
        <a href="/carousel" class="text-sm text-accent hover:opacity-80 inline-flex items-center gap-1.5 shrink-0">
          See today's lineup <Icon name="arrow-right" size={11} />
        </a>
      </div>
      {/* Skeleton loader — replaced by real cards once client-side fetch completes */}
      <div class="carousel-skeleton grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-2.5" id="carousel-strip">
        {[1,2,3,4,5,6,7].map(i => (
          <div class="carousel-strip-card bg-bg-card border border-border rounded-xl p-3 animate-pulse"
               data-archives-at="">
            <div class="flex items-center justify-between gap-1 mb-1.5">
              <span class="text-[9px] font-mono text-muted-soft">SLOT {String(i).padStart(2, '0')}</span>
              <span class="strip-countdown text-[9px] font-mono text-muted-soft">—</span>
            </div>
            <div class="h-3 bg-border rounded w-3/4 mb-1.5"></div>
            <div class="h-2 bg-border-soft rounded w-full mt-1"></div>
            <div class="h-2 bg-border-soft rounded w-2/3 mt-1"></div>
          </div>
        ))}
      </div>
    </div>
    <script is:inline>
      (function() {
        // Phase I: Client-side carousel fetch. cache: 'no-store' ensures every page
        // load reflects today's 7 cards without waiting for a portal rebuild.
        var section = document.getElementById('carousel-section');
        var strip = document.getElementById('carousel-strip');
        if (!section || !strip) return;
        var url = section.dataset.fetchUrl;
        if (!url) return;

        function fmt(sec) {
          if (sec <= 0) return 'rotating';
          var d = Math.floor(sec / 86400), h = Math.floor((sec % 86400) / 3600);
          if (d >= 1) return d + 'd ' + h + 'h';
          var m = Math.floor((sec % 3600) / 60);
          return h + 'h ' + m + 'm';
        }

        function tick() {
          var now = Date.now();
          document.querySelectorAll('.carousel-strip-card').forEach(function(c) {
            var at = c.dataset.archivesAt;
            if (!at) return;
            var sec = Math.max(0, Math.floor((new Date(at).getTime() - now) / 1000));
            var el = c.querySelector('.strip-countdown');
            if (el) el.textContent = fmt(sec) + ' left';
          });
        }

        function normalizeEntry(raw) {
          var slug = raw.skill_slug || (raw.skill && raw.skill.slug) || '';
          var title = raw.skill_title || (raw.skill && raw.skill.title) || '';
          var tagline = raw.tagline || (raw.skill && raw.skill.description) || '';
          var slotRaw = typeof raw.slot === 'number' ? raw.slot
            : (typeof raw.position === 'number' ? raw.position + 1 : null);
          var slot = (typeof slotRaw === 'number' && isFinite(slotRaw)) ? slotRaw : null;
          return { slug: slug, title: title, tagline: tagline, slot: slot,
                   archivesAt: raw.archives_at || '' };
        }

        function renderCards(entries) {
          var normalized = entries.slice(0, 7).map(normalizeEntry);
          var html = normalized.map(function(n, i) {
            var slotNum = n.slot != null ? n.slot : (i + 1);
            var slotStr = String(slotNum).padStart(2, '0');
            return '<a href="/skills/' + n.slug + '"'
              + ' data-archives-at="' + (n.archivesAt || '') + '"'
              + ' class="carousel-strip-card bg-bg-card border border-border rounded-xl p-3 card-lift block">'
              + '<div class="flex items-center justify-between gap-1 mb-1.5">'
              + '<span class="text-[9px] font-mono text-muted-soft">SLOT ' + slotStr + '</span>'
              + '<span class="strip-countdown text-[9px] font-mono text-muted-soft">—</span>'
              + '</div>'
              + '<div class="text-sm font-semibold text-text leading-tight line-clamp-2">' + n.title + '</div>'
              + (n.tagline ? '<div class="text-[10px] text-muted-soft mt-1 line-clamp-2">' + n.tagline + '</div>' : '')
              + '</a>';
          }).join('');
          strip.innerHTML = html;
          strip.classList.remove('carousel-skeleton');
          tick();
          setInterval(tick, 60000);
        }

        fetch(url, { cache: 'no-store' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(data) {
            if (!data) return;
            var raw = Array.isArray(data) ? data : (data.entries || []);
            if (raw.length > 0) renderCards(raw);
          })
          .catch(function() { /* silently keep skeleton on network error */ });
      })();
    </script>
  </section>

