---
import Base from '../layouts/Base.astro';
import CrossSell from '../components/CrossSell.astro';
import Icon from '../components/Icon.astro';
import AgentLogos from '../components/AgentLogos.astro';
import NeuronAnimation from '../components/NeuronAnimation.astro';

let carouselToday: any[] = [];
try {
  const res = await fetch('https://recipes.wisechef.ai/api/carousel/today', {
    headers: { 'x-api-key': import.meta.env.RECIPES_API_KEY || 'rec_dev_internal' }
  });
  if (res.ok) carouselToday = await res.json();
} catch {}

// Pull live skill count for the stats strip (fallback to 80 if API unreachable at build).
let liveSkillCount = 80;
try {
  const res = await fetch('https://recipes.wisechef.ai/api/skills/search?page_size=1', {
    headers: { 'x-api-key': import.meta.env.RECIPES_API_KEY || 'rec_dev_internal' }
  });
  if (res.ok) {
    const data = await res.json();
    if (typeof data.total === 'number' && data.total > 0) liveSkillCount = data.total;
  }
} catch {}

const spotlight = [
  { slug: 'client-reporter', name: 'Client Reporter', tier: 'free', tagline: 'Replaces 4h/week of manual reporting',
    description: 'Pull GA4, GSC, Meta Ads, TikTok Ads → branded PDF for any client. White-label-ready.', badge: 'Free forever', icon: 'chart' },
  { slug: 'web-scraper-pro', name: 'Web Scraper Pro', tier: 'pro', tagline: 'Stealth scraping with proxy rotation',
    description: 'Extract data from any site — JS-rendered SPAs, Cloudflare-protected pages, paginated tables. Built-in rate limiting and headless browser sandbox.', badge: null, icon: 'search' },
  { slug: 'seo-audit-engine', name: 'SEO Audit Engine', tier: 'pro', tagline: 'Replaces SEMrush spot audits',
    description: 'Full technical + content SEO audit. Lighthouse + Screaming Frog + competitor gap analysis. Client-ready PDF in 3 minutes.', badge: null, icon: 'document' },
  { slug: 'proposal-builder', name: 'Proposal Builder', tier: 'pro', tagline: 'Replaces Bonsai · PandaDoc',
    description: 'Discovery call transcript → branded SOW with scope, pricing tiers, case-study inserts. Converts at 40% above average.', badge: null, icon: 'calendar' },
];

const howItWorks = [
  { num: '01', title: 'You describe the goal', body: 'Plain language, in your existing AI agent. No searches, no docs, no copy-paste.', icon: 'lightning' },
  { num: '02', title: 'Recipes finds the skill', body: 'The meta-skill makes your agent aware of every Recipes skill. It picks the perfect match.', icon: 'search' },
  { num: '03', title: 'Installs locally in seconds', body: 'Skill files written to your machine. Your credentials, your data, your control.', icon: 'box' },
  { num: '04', title: 'Results delivered', body: 'A report. A scrape. A calendar. A patch. Done — and ready to ship.', icon: 'check' },
];

const stats = [
  { num: `${liveSkillCount}+`, label: 'Production skills, live' },
  { num: '7', label: 'Carousel slots, refreshed daily' },
  { num: '< 30s', label: 'Install to first run' },
  { num: '50%', label: 'Creator share, usage-attributed' },
];

const verticals = [
  { label: 'Marketing', icon: 'chart', desc: 'Reports, calendars, audits, proposals' },
  { label: 'Code', icon: 'terminal', desc: 'Code review, refactors, test scaffolds' },
  { label: 'Web scraping', icon: 'search', desc: 'Stealth scrapers, structured extraction' },
  { label: 'Ops', icon: 'box', desc: 'Onboarding, invoicing, standups' },
  { label: 'Sales', icon: 'mail', desc: 'Outreach, CRM ops, proposals' },
  { label: 'Sim & robotics', icon: 'lightning', desc: 'ROS workflows, simulation pipelines' },
];
---
<Base
  title="Recipes — The recipe book for AI agents"
  description="Production-grade skills for AI agents. Client reporting, code writing, web scraping, SEO audits, content calendars, proposals — installed by your agent in seconds. From $5/mo. By WiseChef."
>
  <section class="relative overflow-hidden min-h-[88vh] md:min-h-screen flex items-center">
    <NeuronAnimation />
    <div class="absolute inset-0 -z-20 opacity-[0.025] pointer-events-none"
         style="background-image: linear-gradient(to right, #fafafa 1px, transparent 1px), linear-gradient(to bottom, #fafafa 1px, transparent 1px); background-size: 64px 64px;"></div>

    <div class="max-w-6xl mx-auto px-6 pt-20 md:pt-28 pb-16 relative w-full">
      <div class="flex flex-col items-center text-center gap-6 max-w-3xl mx-auto">
        <a href="https://wisechef.ai" class="group inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border text-xs text-muted hover:text-text hover:border-accent/40 transition backdrop-blur-sm bg-bg/40">
          <span class="w-1.5 h-1.5 rounded-full bg-accent group-hover:animate-pulse"></span>
          A new product from WiseChef
          <Icon name="arrow-right" size={11} class="opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all" />
        </a>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tighter leading-[1.02]" style="letter-spacing: -0.04em;">
          The <span class="text-gradient hero-glow">recipe book</span><br/>for AI agents.
        </h1>
        <p class="text-lg md:text-xl text-muted leading-relaxed max-w-2xl">
          We've burned through years of trial-and-error so your agent doesn't have to.
          Production-grade skills — client reporting, SEO audits, content calendars, proposals,
          code writing, web scraping — installed in seconds.
          <strong class="text-text font-semibold">Run locally. Credentials stay home.</strong>
        </p>
        <div class="flex flex-col sm:flex-row gap-3 mt-2">
          <!-- Anon CTA: signup -->
          <a href="/signin?mode=signup&plan=cook" data-auth-anon
             class="group inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
            Get access · from $5/mo
            <Icon name="arrow-right" size={14} class="group-hover:translate-x-0.5 transition-transform" />
          </a>
          <!-- Authed CTA: go to library (hidden until /api/auth/me confirms) -->
          <a href="/library" data-auth-authed
             class="group hidden items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
            Open your library
            <Icon name="arrow-right" size={14} class="group-hover:translate-x-0.5 transition-transform" />
          </a>
          <a href="/skills/client-reporter"
             class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm border border-border hover:border-accent text-text transition backdrop-blur-sm bg-bg/40">
            <Icon name="play" size={14} class="text-accent" />
            Try Client Reporter free
          </a>
        </div>
        <p class="text-xs text-muted-soft mt-2" data-auth-anon>Cancel anytime · Open-source meta-skill · EU VAT MOSS handled</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-20 pt-12 border-t border-border" id="stats-strip">
        {stats.map(s => (
          <div class="flex flex-col gap-1">
            <div class="text-3xl md:text-5xl font-bold text-text tracking-tight" style="letter-spacing: -0.03em;">{s.num}</div>
            <div class="text-xs text-muted">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-bg-card/30">
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="eyebrow text-center mb-8">Built for every team running agents</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
        {verticals.map(v => (
          <div class="flex flex-col items-center gap-2 p-4 bg-bg-card border border-border-soft rounded-xl hover:border-border transition group">
            <div class="w-10 h-10 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent group-hover:bg-accent/20 transition">
              <Icon name={v.icon as any} size={18} />
            </div>
            <span class="text-sm font-semibold text-text">{v.label}</span>
            <span class="text-[10px] text-muted-soft text-center leading-relaxed">{v.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <AgentLogos />

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 opacity-[0.015]" style="background-image: linear-gradient(to right, #fafafa 1px, transparent 1px), linear-gradient(to bottom, #fafafa 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="flex flex-col gap-5">
          <p class="eyebrow text-accent">How it works</p>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight" style="letter-spacing: -0.03em;">Your agent already does this — it just doesn't know about us yet.</h2>
          <p class="text-muted text-lg leading-relaxed">Recipes is a single Markdown file. Drop it into your agent's skills directory. From that point on, every time you ask for something Recipes covers, your agent searches the catalog, installs the right skill, and runs it locally.</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-3">
            {howItWorks.map(s => (
              <div class="flex flex-col gap-2 p-4 bg-bg-card/50 border border-border-soft rounded-xl hover:border-border transition">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent">
                    <Icon name={s.icon as any} size={16} />
                  </div>
                  <span class="font-mono text-[10px] text-muted-soft">{s.num}</span>
                </div>
                <span class="text-sm font-semibold text-text">{s.title}</span>
                <span class="text-xs text-muted leading-relaxed">{s.body}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-[#0d0d0d] border border-border rounded-2xl overflow-hidden shadow-2xl shadow-black/50">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-bg-elev">
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
            </div>
            <span class="text-xs text-muted-soft ml-2 font-mono">~/clients/X — agent session</span>
          </div>
          <div class="p-5 font-mono text-xs leading-relaxed">
            <div class="text-success">$ you</div>
            <div class="text-text mb-3">install the recipes skill from recipes.wisechef.ai</div>
            <div class="text-accent">$ agent</div>
            <div class="text-muted mb-1">→ Fetching SKILL.md (188 lines)</div>
            <div class="text-muted mb-3">✓ Recipes installed. <span class="text-text">{liveSkillCount}+ skills</span> across reporting · code · scraping · ops · sales.</div>
            <div class="text-success">$ you</div>
            <div class="text-text mb-3">pull last 30 days for client X across GA4 + Meta Ads</div>
            <div class="text-accent">$ agent</div>
            <div class="text-muted mb-1">→ Searching marketplace... <span class="text-text">match: client-reporter (free, 4.8★)</span></div>
            <div class="text-muted mb-1">→ Installing skills/client-reporter/...</div>
            <div class="text-muted mb-1">→ Pulling GA4 — <span class="text-success">5,213 sessions, +18% MoM</span></div>
            <div class="text-muted mb-1">→ Pulling Meta Ads — <span class="text-success">€2,140 spend, 3.2x ROAS</span></div>
            <div class="text-muted mb-1">→ Generating PDF...</div>
            <div class="text-success font-semibold">✓ Report ready: <span class="text-accent">~/clients/X/2026-04-25.pdf</span></div>
            <div class="mt-3 inline-flex items-center text-xs">
              <span class="text-muted">elapsed:</span> <span class="text-success ml-1.5 font-semibold">42s</span>
              <span class="ml-1.5 inline-block w-1.5 h-3 bg-accent animate-pulse"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-bg-card/30">
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="flex flex-col gap-3 mb-12 max-w-2xl">
        <p class="eyebrow text-accent">Skill spotlight</p>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight" style="letter-spacing: -0.03em;">These are not prompts.<br/>They are <span class="text-accent">products</span>.</h2>
        <p class="text-muted text-lg">Every skill replaces a SaaS subscription or a freelancer hour. Real working software, run locally by your agent.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {spotlight.map(s => {
          const tierClass = s.tier === 'free' ? 'badge-free' : 'badge-pro';
          return (
            <a href={`/skills/${s.slug}`} class="group bg-bg-card border border-border rounded-2xl p-6 card-lift flex flex-col gap-4 relative overflow-hidden">
              {s.badge && <span class="absolute top-4 right-4 text-[10px] font-semibold uppercase tracking-wider text-success border border-success/40 rounded-full px-2 py-0.5">{s.badge}</span>}
              <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent shrink-0">
                  <Icon name={s.icon as any} size={20} />
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2">
                    <h3 class="text-xl font-semibold text-text group-hover:text-accent transition tracking-tight">{s.name}</h3>
                    <span class={`inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold tracking-wider ${tierClass}`}>{s.tier.toUpperCase()}</span>
                  </div>
                  <p class="text-xs text-muted-soft mt-0.5">{s.tagline}</p>
                </div>
              </div>
              <p class="text-sm text-muted leading-relaxed">{s.description}</p>
              <span class="text-xs text-accent inline-flex items-center gap-1 mt-auto group-hover:gap-2 transition-all">
                View skill <Icon name="arrow-right" size={11} />
              </span>
            </a>
          );
        })}
      </div>
      <div class="text-center mt-10">
        <a href="/skills" class="text-sm text-muted hover:text-accent inline-flex items-center gap-1.5 transition">
          See all {liveSkillCount}+ skills <Icon name="arrow-right" size={11} />
        </a>
      </div>
    </div>
  </section>

  {carouselToday.length > 0 && (
    <section class="border-t border-border">
      <div class="max-w-6xl mx-auto px-6 py-24">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 mb-12">
          <div class="max-w-xl">
            <p class="eyebrow text-accent">Today's 7</p>
            <h2 class="text-3xl md:text-5xl font-bold tracking-tight mt-2" style="letter-spacing: -0.03em;">A new skill, every<br/>5 AM London time.</h2>
            <p class="text-muted mt-3 text-lg">The carousel is how Recipes keeps the catalog honest. Each card runs against incumbent skills for 7 days. Telemetry decides what graduates to core.</p>
          </div>
          <a href="/carousel" class="text-sm text-accent hover:opacity-80 inline-flex items-center gap-1.5 shrink-0">
            See today's lineup <Icon name="arrow-right" size={11} />
          </a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-2.5" id="carousel-strip">
          {carouselToday.slice(0, 7).map((e: any) => (
            <a href={`/skills/${e.skill_slug}`}
               data-archives-at={e.archives_at || ''}
               class="carousel-strip-card bg-bg-card border border-border rounded-xl p-3 card-lift block">
              <div class="flex items-center justify-between gap-1 mb-1.5">
                <span class="text-[9px] font-mono text-muted-soft">SLOT {String(e.position + 1).padStart(2, '0')}</span>
                <span class="strip-countdown text-[9px] font-mono text-muted-soft">—</span>
              </div>
              <div class="text-sm font-semibold text-text leading-tight line-clamp-2">{e.skill_title}</div>
              {e.tagline && <div class="text-[10px] text-muted-soft mt-1 line-clamp-2">{e.tagline}</div>}
            </a>
          ))}
        </div>
      </div>
      <script is:inline>
        (function() {
          function fmt(sec) {
            if (sec <= 0) return 'rotating';
            const d = Math.floor(sec / 86400), h = Math.floor((sec % 86400) / 3600);
            if (d >= 1) return d + 'd ' + h + 'h';
            const m = Math.floor((sec % 3600) / 60);
            return h + 'h ' + m + 'm';
          }
          function tick() {
            const now = Date.now();
            document.querySelectorAll('.carousel-strip-card').forEach(function(c) {
              const at = c.dataset.archivesAt;
              if (!at) return;
              const sec = Math.max(0, Math.floor((new Date(at).getTime() - now) / 1000));
              const el = c.querySelector('.strip-countdown');
              if (el) el.textContent = fmt(sec) + ' left';
            });
          }
          tick();
          setInterval(tick, 60000);
        })();
      </script>
    </section>
  )}

  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="bg-gradient-to-br from-bg-card via-bg-card to-bg-elev border border-accent/30 rounded-3xl p-8 md:p-14 glow-amber relative overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 -z-0 opacity-30 pointer-events-none"
             style="background: radial-gradient(ellipse at center, rgba(255,209,102,0.5) 0%, transparent 70%);"></div>
        <div class="absolute -bottom-20 -left-20 w-80 h-80 -z-0 opacity-20 pointer-events-none"
             style="background: radial-gradient(ellipse at center, rgba(125,211,192,0.3) 0%, transparent 70%);"></div>
        <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
          <div class="md:col-span-2 flex flex-col gap-4">
            <div class="flex items-center gap-2">
              <span class="badge-free inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider">FREE FOREVER</span>
              <span class="text-[10px] uppercase tracking-wider text-accent">Founding skill</span>
            </div>
            <h2 class="text-3xl md:text-5xl font-bold tracking-tight" style="letter-spacing: -0.03em;">Start with<br/>Client Reporter.</h2>
            <p class="text-muted leading-relaxed">
              The skill every agency wishes they had. Connects GA4, GSC, Meta Ads, TikTok Ads. Generates branded PDFs. White-label-ready. Saves four hours per week per client. <strong class="text-text">Free, forever, no subscription required.</strong>
            </p>
            <div class="flex flex-col sm:flex-row gap-3 mt-2">
              <a href="/skills/client-reporter" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition">
                View skill <Icon name="arrow-right" size={14} />
              </a>
              <a href="/docs/install" class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg font-semibold text-sm border border-border hover:border-accent text-text transition">
                Install free
              </a>
            </div>
          </div>
          <div class="hidden md:flex items-center justify-center">
            <img src="/brand/mark-256.png" alt="" width="180" height="180" class="opacity-95 drop-shadow-[0_0_40px_rgba(255,209,102,0.35)]" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CrossSell variant="banner" title="Need it run for you?" body="WiseChef Framework gives you a managed AI employee — same skills as Recipes, but operated end-to-end. From €199/month." />
</Base>
