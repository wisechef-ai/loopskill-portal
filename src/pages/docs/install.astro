---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
// qa1018 NNS-14: the ONE recommended path is the canonical keyless phrase.
// Rendered from the shared constant so shown text === copied text.
import { META_INSTALL_PHRASE } from '../../lib/agentInstall';
---
<AppShell mode="public" title="Install guide — LoopSkill Docs" description="Install LoopSkill in any AI coding agent. One paste for Claude Code, Codex or Cursor. Free skills need no key; MCP tools need a free API key.">
  <section class="max-w-3xl mx-auto px-6 pt-16 pb-12">
    <p class="eyebrow mb-2">Documentation · Install guide</p>
    <h1 class="text-4xl font-semibold tracking-tight mb-4">Install in seconds.</h1>
    <p class="text-muted mb-6 leading-relaxed" id="docs-install-keys">
      <strong class="text-text">Free skills: no key. MCP tools: need a free API key.</strong>
      Start with the one paste below — it needs no account at all.
    </p>

<!-- qa1018 NNS-14: ONE recommended path at the top. The keyless phrase is the
     honest static default (free skills install with no key at all); the keyed
     variant is generated per-user on /library (one-time key reveal). Every
     other way to connect lives under "Other ways" below. -->
<div class="bg-bg-card border border-accent/40 rounded-2xl p-6 mb-10" id="recommended">
  <p class="eyebrow text-accent mb-2">Recommended · one paste</p>
  <h2 class="text-xl font-semibold tracking-tight mb-3">Using Claude Code, Codex or Cursor? Paste this into the chat</h2>
  <pre class="install-cmd text-sm bg-[#0d0d0d] border border-border rounded-lg px-4 py-3 mb-3"><code id="docs-install-phrase">{META_INSTALL_PHRASE}</code></pre>
  <button type="button" id="docs-install-phrase-copy" class="min-h-[44px] px-4 py-2.5 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">Copy</button>
  <p class="text-sm text-text mt-4 leading-relaxed">
    Paste this into your agent's chat (Claude Code, Codex, Cursor…) and press Enter.
  </p>
  <p class="text-sm text-muted mt-2 leading-relaxed">
    Your agent downloads the LoopSkill skill file (plain Markdown) and can then find and install
    free skills for you — no key, no config files. Works the same in Hermes, OpenClaw and any agent
    that can read a web page.
  </p>
  <p class="text-xs text-muted-soft mt-3 leading-relaxed">
    Signed in? <a href="/library" class="text-accent hover:underline">Your library</a> shows the same
    phrase with your API key already in it. You only need the key for MCP tools, saving to bundles,
    private content and fleets.
  </p>
</div>

    <h2 class="text-2xl font-semibold tracking-tight mb-2" id="other-ways">Other ways</h2>
    <p class="text-sm text-muted mb-6 leading-relaxed">
      You do not need these if the paste above worked. Pick one only if your setup needs it.
    </p>

    <!-- MCP path -->
    <div class="bg-bg-card border border-border rounded-2xl p-6 mb-10" id="mcp-server">
      <div class="flex items-center justify-between gap-3 mb-3 flex-wrap">
        <p class="eyebrow">MCP server · needs a free API key</p>
      </div>
      <h2 class="text-xl font-semibold tracking-tight mb-3">Connect your agent to the LoopSkill server</h2>
      <p class="text-sm text-muted mb-4 leading-relaxed">
        MCP is a standard way for an AI app to use outside tools. Cursor, Claude Desktop, Cline,
        Continue.dev, Zed — every MCP-aware app connects the same way: you give it a URL and your key.
        Your agent then gets <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">loopskill_search</code>,
        <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">loopskill_install</code>,
        and <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">loopskill_recall</code>
        as tools it can call mid-conversation.
      </p>
      <p class="text-xs text-muted-soft leading-relaxed mb-4">
        <strong class="text-text">The MCP server requires an API key for all operations</strong> — including
        free-tier skill lookups. The key is free. If you want no key at all, use the one paste above,
        the skill file or the plain HTTP calls below.
      </p>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Claude Desktop / Cursor / Cline</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>{`{
  "mcpServers": {
    "loopskill": {
      "url": "https://app.loopskill.io/api/mcp/http/",
      "headers": { "x-api-key": "rec_live_…" }
    }
  }
}`}</code></pre>
      <p class="text-xs text-muted-soft leading-relaxed">
        Get your key from <a href="/library" class="text-accent hover:underline">your library</a> — free signup
        gives you a free-tier key immediately.
      </p>
      <p class="text-xs text-muted-soft leading-relaxed mt-3">
        Your app can only start a local program, not connect to a URL? Run
        <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">uvx loopskill-mcp</code>
        instead — a small helper program (published on PyPI, the Python package index) that forwards
        every call to the same hosted server. See
        <a href="/docs/mcp" class="text-accent hover:underline">MCP setup</a> for the config block.
      </p>
      <div class="mt-4 pt-4 border-t border-border-soft">
        <a href="/docs/mcp" class="text-xs text-accent hover:underline inline-flex items-center gap-1">
          Full MCP setup (Continue.dev, Zed, custom clients) →
        </a>
      </div>
    </div>

    <!-- Claude Code plugin marketplace — keyless, one command (plugmkt_1009) -->
    <div class="bg-bg-card border border-border rounded-2xl p-6 mb-10" id="claude-code-plugin">
      <p class="eyebrow mb-3">Claude Code · Plugin marketplace (no key)</p>
      <h2 class="text-xl font-semibold tracking-tight mb-3">Add the LoopSkill marketplace to Claude Code</h2>
      <p class="text-sm text-muted mb-4 leading-relaxed">
        LoopSkill publishes a Claude Code plugin marketplace at
        <a href="https://github.com/wisechef-ai/loopskill-marketplace" class="text-accent hover:underline">wisechef-ai/loopskill-marketplace</a>.
        Add it once, then install plugins by name. No signup and no key for the search plugin.
      </p>
      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Inside a Claude Code session</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>/plugin marketplace add wisechef-ai/loopskill-marketplace
/plugin install loopskill-search@loopskill</code></pre>
      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">From a shell</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>claude plugin marketplace add wisechef-ai/loopskill-marketplace
claude plugin install loopskill-search@loopskill</code></pre>
      <p class="text-xs text-muted-soft leading-relaxed">
        <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">loopskill-search</code> runs one
        query across the curated catalog and the federated sources, so your agent can find an existing skill before
        writing one. <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">loopskill@loopskill</code>
        installs the LoopSkill skill file. Run <code class="text-[11px] bg-bg-elev border border-border-soft rounded px-1 py-0.5">/plugin</code>
        to browse the rest of the marketplace.
      </p>
    </div>

    <!-- Skill file by hand — what the one paste does for you -->
    <div class="bg-bg-card border border-border rounded-2xl p-6 mb-10" id="skill-file">
      <p class="eyebrow mb-3">By hand · Skill file (no key)</p>
      <h2 class="text-xl font-semibold tracking-tight mb-3">Save the skill file yourself</h2>
      <p class="text-sm text-muted mb-4 leading-relaxed">
        This is what the one paste does for you. The LoopSkill skill is one Markdown file
        that tells your agent how to search and install skills. Save it in your agent's skills folder:
      </p>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Claude Code</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>mkdir -p ~/.claude/skills/loopskill
curl -sL https://app.loopskill.io/skill -o ~/.claude/skills/loopskill/SKILL.md</code></pre>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Hermes / Codex / OpenClaw</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>mkdir -p ~/.hermes/skills/loopskill  # or ~/.codex/skills, ~/.openclaw/skills
curl -sL https://app.loopskill.io/skill -o ~/.hermes/skills/loopskill/SKILL.md</code></pre>

      <p class="text-sm text-muted leading-relaxed">
        Then in any session ask: <em class="text-text">"read the loopskill skill and follow it. List free skills."</em>
        Your agent will hit the public catalog endpoints — no key needed.
      </p>
    </div>

    <!-- Pure HTTP path — for scripts/automation -->
    <div class="bg-bg-card border border-border rounded-2xl p-6 mb-10" id="raw-http">
      <p class="eyebrow mb-3">For scripts · Plain HTTP</p>
      <h2 class="text-xl font-semibold tracking-tight mb-3">curl works too</h2>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Browse free skills (no auth)</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>curl -sS "https://app.loopskill.io/api/skills/search?tier=free&page_size=50"</code></pre>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Install a free skill (no auth)</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-4"><code>curl -sS "https://app.loopskill.io/api/skills/install?slug=super-memory"</code></pre>

      <p class="text-xs text-muted-soft uppercase tracking-wider font-semibold mb-2">Install with a key (bundle-scoped or private skills)</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4"><code>curl -sS -H "x-api-key: $LOOPSKILL_API_KEY" \
  "https://app.loopskill.io/api/skills/install?slug=super-memory"</code></pre>
      <p class="text-xs text-muted-soft leading-relaxed mt-2">
        The catalog carries no paid-tier skills today, so no free skill actually needs this
        header — pass a key when installing from a <strong class="text-text">private or
        bundle-scoped</strong> catalog instead.
      </p>
    </div>

    <!-- Verify -->
    <div class="bg-bg-card border border-border rounded-2xl p-6">
      <p class="eyebrow mb-3">Verify the install</p>
      <pre class="install-cmd text-xs bg-[#0d0d0d] border border-border rounded-lg p-4 mb-3"><code>curl https://app.loopskill.io/api/healthz</code></pre>
      <p class="text-xs text-muted-soft leading-relaxed">
        Should return <code class="text-text">{`{"status":"ok"}`}</code>. If your agent connected via MCP, ask it: <em class="text-text">"call loopskill_search with query=test and show me the top 3 results."</em>
      </p>
    </div>

  </section>

<style>
  /* qa1018 MOB-10 / NNS-14: long commands wrap at 375px instead of side-scrolling. */
  .install-cmd {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
</style>

<script is:inline>
  // One-paste install phrase copy button. Copies exactly the shown text.
  (function () {
    var btn = document.getElementById('docs-install-phrase-copy');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var txt = (document.getElementById('docs-install-phrase')?.textContent || '').trim();
      var original = btn.textContent;
      function flash(label) {
        btn.textContent = label;
        setTimeout(function () { btn.textContent = original; }, 1500);
      }
      if (!navigator.clipboard) { flash('Select the text and copy'); return; }
      navigator.clipboard.writeText(txt).then(function () { flash('Copied ✓'); })
        .catch(function () { flash('Select the text and copy'); });
    });
  })();
</script>
</AppShell>
