---
import AppShell from '../../layouts/AppShell.astro';
import CrossSell from '../../components/CrossSell.astro';

// Typed explicitly rather than inferred. Every card used to carry a `badge`,
// so the inferred union happened to have one; when mesh0408 W3 removed the two
// stale badges ("Coming soon" on bundles, which are live, and "Not shipped" on
// the rewritten delivery page) the inference collapsed and `s.badge` stopped
// type-checking. The badge affordance is worth keeping for the next genuinely
// unshipped page — an annotation keeps it available without a value.
type DocCard = {
  title: string;
  href: string;
  body: string;
  badge?: string | null;
};

const onboarding: DocCard[] = [
  {
    title: 'Getting started',
    href: '/docs/getting-started',
    body: 'Install the LoopSkill meta-skill in your agent. One curl command, agent gains marketplace awareness for life.',
  },
  {
    title: 'Install guide',
    href: '/docs/install',
    body: 'Per-agent install instructions: Claude Code, Codex, OpenClaw, Hermes, plus MCP setup for Cursor/Cline/Continue/Zed.',
  },
  {
    title: 'VS Code integration',
    href: '/docs/vscode',
    body: 'Three paths: Continue extension, Cline extension, or Claude Code CLI in VS Code\'s integrated terminal.',
  },
  {
    title: 'MCP server setup',
    href: '/docs/mcp',
    body: 'Wire LoopSkill into Claude Desktop, Cursor, Cline, Continue, or Zed via the Model Context Protocol.',
  },
];

const concepts: DocCard[] = [
  {
    title: 'How it works',
    href: '/docs/how-it-works',
    body: 'Search → install → telemetry. The three-level loading model that makes a marketplace work without bloating your context.',
  },
  {
    title: 'Skill sync',
    href: '/docs/sync',
    body: 'What gets synced (skill files, manifest, install state), what doesn\'t (your data), and how sync works offline.',
  },
  {
    title: 'Bundles',
    // The page lives at /docs/cookbooks — the file kept its pre-rename slug.
    // /docs/bundles has never existed and 404'd here for months.
    href: '/docs/cookbooks',
    body: 'Stack skills into a named, versioned bundle. Personal or org-scoped. Agents pull it and converge — LoopSkill never pushes.',
  },
  {
    title: 'Client delivery',
    href: '/docs/deployment',
    body: 'Scope a key to a bundle, hand a client one install command, and their agent reconciles itself on its own cron. Pull-only — LoopSkill never reaches a machine, so there is no apply job to watch.',
  },
  {
    title: 'What LoopSkill does & does not do',
    href: '/docs/scope',
    body: 'The honest scope: what is proven and running, what is partial, and what is not built. Read this before you plan around a capability.',
    badge: null,
  },
];

const api: DocCard[] = [
  {
    title: 'API keys',
    href: '/docs/api-keys',
    body: 'rec_live_ prefix, x-api-key header, per-bundle scoping, rotation, and install-count visibility.',
  },
  {
    title: 'API reference',
    href: '/docs/api-reference',
    body: 'Endpoints, auth, rate limits, error codes. The marketplace is just a markdown file plus an HTTP API.',
  },
  {
    title: 'Referral program',
    href: '/docs/referrals',
    body: 'Earn 50% recurring rev-share on every Pro subscriber you refer. Monthly payouts, $25 min.',
  },
  {
    title: 'Security',
    href: '/docs/security',
    body: 'Plain-text skills, credentials local, single-publisher curation, architecture-aware install, optional sandbox.',
  },
  {
    title: 'Request a skill',
    href: '/docs/publishing',
    body: 'We are a single-publisher catalog. Tell us what\'s broken in your fleet, we ship a skill that fixes it.',
  },
];
---

<AppShell mode="public" title="Documentation — LoopSkill" description="Install, integrate, configure. Everything you need to use LoopSkill from any AI coding agent.">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <div class="flex flex-col gap-3 mb-12">
      <p class="eyebrow">Documentation</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Install in seconds. Integrate forever.</h1>
      <p class="text-muted max-w-2xl">LoopSkill is a markdown file plus an HTTP API. No SDK to learn, no platform to lock into. Works with every major AI coding agent.</p>
    </div>

    <!-- Onboarding -->
    <p class="text-xs text-muted-soft uppercase tracking-widest font-semibold mb-4">Onboarding</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      {onboarding.map(s => (
        <a href={s.href} class="bg-bg-card border border-border rounded-2xl p-5 card-lift block">
          <h3 class="text-base font-semibold text-text">{s.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{s.body}</p>
          <span class="text-xs text-accent mt-3 inline-flex items-center gap-1">Read →</span>
        </a>
      ))}
    </div>

    <!-- Concepts -->
    <p class="text-xs text-muted-soft uppercase tracking-widest font-semibold mb-4">Concepts</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      {concepts.map(s => (
        <a href={s.href} class="bg-bg-card border border-border rounded-2xl p-5 card-lift block relative">
          {s.badge && (
            <span class="absolute top-3 right-3 text-[9px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-yellow-500/15 text-yellow-400 border border-yellow-500/30">
              {s.badge}
            </span>
          )}
          <h3 class="text-base font-semibold text-text">{s.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{s.body}</p>
          <span class="text-xs text-accent mt-3 inline-flex items-center gap-1">Read →</span>
        </a>
      ))}
    </div>

    <!-- API & Account -->
    <p class="text-xs text-muted-soft uppercase tracking-widest font-semibold mb-4">API &amp; Account</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      {api.map(s => (
        <a href={s.href} class="bg-bg-card border border-border rounded-2xl p-5 card-lift block">
          <h3 class="text-base font-semibold text-text">{s.title}</h3>
          <p class="text-sm text-muted mt-2 leading-relaxed">{s.body}</p>
          <span class="text-xs text-accent mt-3 inline-flex items-center gap-1">Read →</span>
        </a>
      ))}
    </div>

    <div class="mt-6 bg-bg-card border border-border rounded-2xl p-6 md:p-8">
      <p class="eyebrow mb-3">One-line install</p>
      <pre class="text-xs md:text-sm overflow-x-auto bg-[#0d0d0d] border border-border rounded-lg p-4"><code>curl -sL https://app.loopskill.io/skill -o ~/.claude/skills/loopskill/SKILL.md</code></pre>
      <p class="text-xs text-muted-soft mt-3">Then ask your agent: "Install the loopskill skill, then list available skills." Done.</p>
    </div>
  </section>
  <CrossSell />
</AppShell>
