---
// /library — portal_0610 J1: "Your Library" = your cookbooks (made + saved).
// Re-homed from the old billing/API-keys page (now /account). This is the
// retention surface (Spotify's "Your Library"): the cookbooks you authored and
// the ones you saved/cloned, plus your installed skills. D2 lean: made + saved.
import AppShell from '../layouts/AppShell.astro';
---
<AppShell title="Your Library — LoopSkill" active="library">
  <section class="max-w-6xl mx-auto px-6 py-10">
    <header class="mb-8 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Your Library</h1>
        <p class="text-sm text-muted mt-1">Bundles you've made and saved, and the skills you run.</p>
      </div>
      <a href="/composer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
        + Compose a bundle
      </a>
    </header>

    <!-- Cookbooks -->
    <div class="mb-12">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-soft mb-3">Bundles</h2>
      <div id="library-cookbooks" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="col-span-full text-sm text-muted py-8 text-center" id="library-cookbooks-loading">Loading…</div>
      </div>
    </div>

    <!-- Installed skills -->
    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-soft">Installed skills</h2>
        <a href="/skills" class="text-xs text-accent hover:opacity-80">Browse catalog →</a>
      </div>
      <div id="library-skills" class="text-sm">
        <p class="text-muted py-4" id="library-skills-empty">
          No skills installed yet. <a href="/skills/super-memory" class="text-accent hover:opacity-80 underline">Install Super Memory</a> — free, the gateway skill.
        </p>
      </div>
    </div>
  </section>

  <script>
    (async () => {
      const fetchJson = async (u: string) => {
        try { const r = await fetch(u, { credentials: 'include' }); return r.ok ? await r.json() : null; }
        catch { return null; }
      };

      // Cookbooks (made + saved). /api/cookbooks returns the caller's owned set;
      // saved/cloned land here too once the save action ships (D2).
      const wrap = document.getElementById('library-cookbooks');
      const loading = document.getElementById('library-cookbooks-loading');
      const data = await fetchJson('/api/cookbooks');
      const cbooks = (data && data.cookbooks) || [];
      loading?.remove();
      if (wrap) {
        if (!cbooks.length) {
          wrap.innerHTML = `<a href="/composer" class="col-span-full flex flex-col items-center justify-center gap-2 py-12 rounded-2xl border border-dashed border-border hover:border-accent/50 transition text-center">
            <span class="text-3xl text-muted-soft">+</span>
            <span class="text-sm text-text font-medium">Compose your first cookbook</span>
            <span class="text-xs text-muted">Multi-select skills from the catalog, set visibility, share one link.</span>
          </a>`;
        } else {
          wrap.innerHTML = cbooks.map((cb: any) => {
            const vis = (cb.visibility || 'private');
            const visBadge = vis === 'public'
              ? '<span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-accent/40 text-accent">public</span>'
              : '<span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-border text-muted-soft">private</span>';
            return `<a href="/cookbooks/view?id=${encodeURIComponent(cb.id)}" class="flex flex-col gap-2 p-5 rounded-2xl bg-bg-card border border-border hover:border-accent/40 transition">
              <span class="flex items-center justify-between gap-2">
                <span class="font-semibold text-text truncate">${(cb.name || 'Untitled')}</span>
                ${visBadge}
              </span>
              <span class="text-xs text-muted line-clamp-2">${(cb.description || 'No description')}</span>
              <span class="text-xs text-accent mt-1">Open →</span>
            </a>`;
          }).join('');
        }
      }

      // Installed skills — best-effort; endpoint may be empty for new users.
      const skillsWrap = document.getElementById('library-skills');
      const skillsEmpty = document.getElementById('library-skills-empty');
      const installed = await fetchJson('/api/skills/installed');
      const items = (installed && (installed.skills || installed.items)) || [];
      if (skillsWrap && items.length) {
        skillsEmpty?.remove();
        skillsWrap.innerHTML = items.map((s: any) =>
          `<a href="/skills/${encodeURIComponent(s.slug)}" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-bg-card border border-border hover:border-accent/40 transition mb-2">
            <span class="font-medium text-text">${s.slug}</span>
            <span class="text-xs text-accent">Open →</span>
          </a>`).join('');
      }
    })();
  </script>
</AppShell>
