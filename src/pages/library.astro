---
import Base from '../layouts/Base.astro';
---

<Base title="Library — Recipes" description="Your subscription, API key, and installed skills.">
  <section class="max-w-5xl mx-auto px-6 pt-12 pb-24">
    <!-- Auth-success toast (dismissable) -->
    <div id="auth-success-toast" class="hidden mb-6 p-4 rounded-xl bg-accent/10 border border-accent/40 text-sm text-text flex items-center justify-between">
      <span>✓ Signed in successfully.</span>
      <button class="text-muted hover:text-text" onclick="this.parentElement.classList.add('hidden')">✕</button>
    </div>

    <!-- Auth gate state — shown while we check JWT -->
    <div id="auth-checking" class="text-center py-24 text-muted">
      <p class="text-sm">Loading your library…</p>
    </div>

    <!-- Main content (hidden until authed) -->
    <div id="library-main" class="hidden">
      <header class="mb-10">
        <h1 class="text-3xl font-semibold tracking-tight" id="welcome-line">Welcome back</h1>
        <p class="text-muted mt-1 text-sm">Manage your subscription, API key, and skills.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Subscription card -->
        <div class="bg-bg-card border border-border rounded-2xl p-6">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">Subscription</h2>
              <p class="text-xs text-muted mt-1">Tier, status, and billing.</p>
            </div>
            <span id="sub-status-badge" class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full border border-border text-muted-soft">…</span>
          </div>

          <!-- Active plan summary (shown only when a paid sub is active) -->
          <div id="sub-active-card" class="hidden mb-4 p-4 rounded-xl bg-accent/10 border border-accent/40">
            <div class="flex items-baseline justify-between gap-3">
              <span id="sub-tier-name" class="text-2xl font-semibold text-text">—</span>
              <span id="sub-tier-price" class="text-xs text-muted-soft font-mono">—</span>
            </div>
            <p id="sub-renews-line" class="text-xs text-muted mt-1.5">—</p>
          </div>

          <!-- Detail rows (always rendered for completeness) -->
          <div id="sub-body" class="space-y-3 text-sm">
            <div class="flex items-baseline justify-between">
              <span class="text-muted">Tier</span>
              <span id="sub-tier" class="font-mono text-text">—</span>
            </div>
            <div class="flex items-baseline justify-between">
              <span class="text-muted">Renews</span>
              <span id="sub-renews" class="text-text">—</span>
            </div>
          </div>

          <div class="mt-5 flex flex-col gap-2">
            <button id="manage-billing-btn" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-accent text-text text-sm font-medium transition">
              Manage billing →
            </button>
            <a id="upgrade-plan-link" href="/pricing" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-border hover:border-accent text-text text-sm font-medium transition">
              See other plans →
            </a>
            <a id="choose-plan-link" href="/pricing" class="hidden inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              Choose a plan →
            </a>
          </div>
        </div>

        <!-- API Key card -->
        <div class="bg-bg-card border border-border rounded-2xl p-6">
          <h2 class="text-lg font-semibold tracking-tight">API key</h2>
          <p class="text-xs text-muted mt-1">For the Recipes meta-skill and direct API access.</p>

          <div id="api-key-empty" class="mt-5">
            <p class="text-sm text-muted mb-3">No key yet. Generate one to start installing skills.</p>
            <button id="generate-key-btn" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              Generate API key
            </button>
          </div>

          <div id="api-key-existing" class="hidden mt-5 space-y-3 text-sm">
            <div>
              <p class="text-muted text-xs uppercase tracking-wider mb-1">Prefix</p>
              <code id="api-key-prefix" class="font-mono text-xs bg-bg-elev border border-border rounded px-2 py-1 inline-block">—</code>
            </div>
            <div>
              <p class="text-muted text-xs uppercase tracking-wider mb-1">Created</p>
              <span id="api-key-created" class="text-text text-xs">—</span>
            </div>
            <button id="regen-key-btn" class="text-xs text-muted hover:text-accent underline mt-2">Regenerate (revokes old key)</button>
          </div>

          <div id="api-key-just-created" class="hidden mt-5 space-y-3">
            <div class="bg-accent/10 border border-accent/40 rounded-lg p-4">
              <p class="text-xs font-semibold text-accent mb-2">⚠ Save this key now — it will not be shown again.</p>
              <div class="flex items-center gap-2">
                <code id="plaintext-key" class="font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2 flex-1 break-all"></code>
                <button id="copy-key-btn" class="px-3 py-2 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition shrink-0">Copy</button>
              </div>
            </div>
            <button id="dismiss-plaintext-btn" class="text-xs text-muted hover:text-text underline">I've saved it</button>
          </div>
        </div>

        <!-- WiseChef cross-sell (cook+ tier only) — WIS-648 -->
        <div id="wisechef-cta-card" class="hidden md:col-span-2 bg-gradient-to-br from-accent/10 to-cool/10 border border-accent/40 rounded-2xl p-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1">
              <h2 class="text-lg font-semibold tracking-tight">Want an AI agent that <em>does</em> the work, not just provides recipes?</h2>
              <p class="text-sm text-muted mt-2">WiseChef's managed AI employee plan starts at $199/mo. Cook & Operator customers save 40% on the first 3 months.</p>
            </div>
            <div class="shrink-0">
              <button id="demo-cta-btn" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
                Book a 30-min demo →
              </button>
              <p id="demo-cta-confirmed" class="hidden text-xs text-accent mt-2">Demo requested ✓ check your inbox.</p>
            </div>
          </div>
        </div>

        <!-- Referral card — WIS-660 -->
        <div class="md:col-span-2 bg-bg-card border border-border rounded-2xl p-6">
          <div class="flex items-start justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">Refer & Earn</h2>
              <p class="text-xs text-muted mt-1">Share your link. Earn 50% of their first payment.</p>
            </div>
          </div>
          <div class="space-y-3 text-sm">
            <!-- Referral link -->
            <div>
              <p class="text-muted text-xs uppercase tracking-wider mb-1">Your referral link</p>
              <div class="flex items-center gap-2">
                <code id="referral-link" class="font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2 flex-1 break-all">Loading…</code>
                <button id="copy-referral-btn" class="px-3 py-2 rounded-lg bg-accent text-bg text-xs font-semibold hover:bg-accent-soft transition shrink-0">Copy</button>
              </div>
            </div>
            <!-- Referral stats -->
            <div class="grid grid-cols-2 gap-4 mt-3">
              <div class="p-3 rounded-xl bg-bg-elev border border-border">
                <p class="text-muted text-[10px] uppercase tracking-wider">Referred</p>
                <p id="referral-count" class="text-xl font-semibold text-text mt-1">0</p>
              </div>
              <div class="p-3 rounded-xl bg-bg-elev border border-border">
                <p class="text-muted text-[10px] uppercase tracking-wider">Lifetime earned</p>
                <p id="referral-earnings" class="text-xl font-semibold text-text mt-1">€0.00</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Installed skills -->
        <div class="md:col-span-2 bg-bg-card border border-border rounded-2xl p-6">
          <div class="flex items-center justify-between gap-3 mb-4">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">Installed skills</h2>
              <p class="text-xs text-muted mt-1">Skills you've installed via the Recipes meta-skill.</p>
            </div>
            <a href="/skills" class="text-sm text-accent hover:opacity-80">Browse catalog →</a>
          </div>
          <div id="skills-list" class="text-sm">
            <p id="skills-empty" class="text-muted">No skills installed yet. <a href="/skills/client-reporter" class="text-accent hover:opacity-80 underline">Try Client Reporter</a> — free with any plan.</p>
          </div>
        </div>
      </div>

      <!-- Footer actions -->
      <div class="mt-10 pt-6 border-t border-border flex justify-between text-sm">
        <a href="/skills" class="text-muted hover:text-text transition">← Browse skills</a>
        <button id="library-signout" class="text-muted hover:text-accent transition">Sign out</button>
      </div>
    </div>
  </section>
</Base>

<script>
  // ────────────────────────────────────────────────────────────────────
  // /library hydration — vanilla JS, no framework
  // ────────────────────────────────────────────────────────────────────
  type User = { id: string; display_name?: string; email?: string; avatar_url?: string;
                 subscription_tier?: string | null; subscription_status?: string | null;
                 subscription_current_period_end?: string | null };
  type Billing = { user_id: string; stripe_customer_id: string | null;
                   subscription_status: string | null; subscription_tier: string | null;
                   subscription_current_period_end: string | null };
  type ApiKey = { id: string; prefix: string; name: string | null; is_active: boolean;
                  created_at: string | null; last_used_at: string | null };

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  // Tier slugs in DB stay `cook` (=Cook) and `studio` (=Operator) per RCP-1.
  // `operator` is retired but kept here in case legacy rows surface.
  const TIER_BADGE_COPY: Record<string, string> = {
    cook: 'COOK', operator: 'OPERATOR', studio: 'OPERATOR',
  };
  const TIER_PRICE: Record<string, string> = {
    cook: '$20/mo', operator: 'retired', studio: '$100/mo',
  };
  const TIER_NAME: Record<string, string> = {
    cook: 'Cook', operator: 'Operator', studio: 'Operator',
  };

  function fmtRenewsIn(iso: string | null): string {
    if (!iso) return '—';
    const ts = new Date(iso).getTime();
    if (isNaN(ts)) return '—';
    const days = Math.max(0, Math.round((ts - Date.now()) / 86400000));
    if (days === 0) return 'today';
    if (days === 1) return 'tomorrow';
    return `in ${days} days`;
  }

  function fmtRenewsDate(iso: string | null): string {
    if (!iso) return '';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '';
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  async function fetchJson<T>(url: string, opts: RequestInit = {}): Promise<T | null> {
    try {
      const res = await fetch(url, { credentials: 'include', ...opts });
      if (!res.ok) return null;
      return await res.json() as T;
    } catch {
      return null;
    }
  }

  async function loadBilling(): Promise<void> {
    const billing = await fetchJson<Billing>('/api/billing/me');
    if (!billing) return;

    const status = billing.subscription_status || 'none';
    const tier = billing.subscription_tier;
    const isPaidActive = !!tier && (status === 'active' || status === 'trialing' || status === 'past_due');

    $('sub-status-badge').textContent = status === 'none' ? 'FREE' : status.toUpperCase();
    $('sub-tier').textContent = tier ? (TIER_BADGE_COPY[tier] || tier) : 'Free';
    $('sub-renews').textContent = isPaidActive ? fmtRenewsIn(billing.subscription_current_period_end) : '—';

    if (isPaidActive) {
      // Active paid sub — show big tier card + manage billing + (optional) upgrade link
      $('sub-active-card').classList.remove('hidden');
      $('sub-tier-name').textContent = TIER_NAME[tier!] || tier!;
      $('sub-tier-price').textContent = TIER_PRICE[tier!] || '';
      const renewsDate = fmtRenewsDate(billing.subscription_current_period_end);
      $('sub-renews-line').textContent = renewsDate
        ? `Renews ${renewsDate} (${fmtRenewsIn(billing.subscription_current_period_end)})`
        : 'Active subscription';

      $('manage-billing-btn').classList.remove('hidden');
      $('sub-status-badge').classList.add('text-accent', 'border-accent/40');

      // Show "See other plans" only if not on the highest tier
      if (tier !== 'studio') {
        $('upgrade-plan-link').classList.remove('hidden');
      }

      // CRITICAL: never show "Choose a plan" alongside an active sub
      $('choose-plan-link').classList.add('hidden');
    } else {
      // No active sub — Free user. Show Choose a plan CTA.
      $('choose-plan-link').classList.remove('hidden');
    }

    // Cross-sell card visibility (cook+ only)
    if (tier && ['cook', 'operator', 'studio'].includes(tier)) {
      $('wisechef-cta-card').classList.remove('hidden');
    }
  }

  async function loadApiKeys(): Promise<void> {
    const data = await fetchJson<{ keys: ApiKey[] }>('/api/api-keys');
    if (!data) return;
    const active = data.keys.filter(k => k.is_active);
    if (active.length > 0) {
      $('api-key-empty').classList.add('hidden');
      $('api-key-existing').classList.remove('hidden');
      $('api-key-prefix').textContent = active[0].prefix + '…';
      $('api-key-created').textContent = active[0].created_at
        ? new Date(active[0].created_at).toLocaleDateString()
        : '—';
    }
  }

  async function generateKey(regenerate = false): Promise<void> {
    const data = await fetchJson<{ id: string; key: string; prefix: string }>(
      '/api/api-keys', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }
    );
    if (!data) {
      alert('Could not generate key. Please try again.');
      return;
    }
    $('api-key-empty').classList.add('hidden');
    $('api-key-existing').classList.add('hidden');
    $('api-key-just-created').classList.remove('hidden');
    $('plaintext-key').textContent = data.key;
  }

  $('generate-key-btn').addEventListener('click', () => generateKey(false));
  $('regen-key-btn').addEventListener('click', () => {
    if (confirm('Regenerating will revoke your current key. Continue?')) generateKey(true);
  });
  $('dismiss-plaintext-btn').addEventListener('click', async () => {
    $('api-key-just-created').classList.add('hidden');
    await loadApiKeys();
  });
  $('copy-key-btn').addEventListener('click', async () => {
    const txt = $('plaintext-key').textContent || '';
    try {
      await navigator.clipboard.writeText(txt);
      $('copy-key-btn').textContent = 'Copied ✓';
      setTimeout(() => ($('copy-key-btn').textContent = 'Copy'), 2000);
    } catch { /* fallback: select */ }
  });

  $('manage-billing-btn').addEventListener('click', async () => {
    const data = await fetchJson<{ url: string }>(
      '/api/billing/portal-session', { method: 'POST' }
    );
    if (data?.url) window.location.href = data.url;
    else alert('Could not open billing portal. Please try again.');
  });

  // WiseChef demo CTA — WIS-648
  $('demo-cta-btn').addEventListener('click', async () => {
    const btn = $('demo-cta-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Booking…';
    try {
      await fetch('/api/wisechef/demo-request', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source: 'library_card_cta' }),
      });
    } catch { /* tracked best-effort */ }
    window.open('https://calendar.app.google/P9J9oaiemtHdsvG99', '_blank', 'noopener');
    btn.classList.add('hidden');
    $('demo-cta-confirmed').classList.remove('hidden');
  });

  // Sign out
  $('library-signout').addEventListener('click', async () => {
    try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch {}
    document.cookie = 'wr_jwt=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
    window.location.href = '/';
  });

  // ── Referral loading — WIS-660 ────────────────────────────────────────
  async function loadReferrals(): Promise<void> {
    const data = await fetchJson<{ referral_code: string; referred_count: number; lifetime_earnings_cents: number }>(
      '/api/me/referrals'
    );
    if (!data) return;
    const base = window.location.origin;
    const link = `${base}/?ref=${data.referral_code}`;
    $('referral-link').textContent = link;
    $('referral-count').textContent = String(data.referred_count);
    const euros = (data.lifetime_earnings_cents / 100).toFixed(2);
    $('referral-earnings').textContent = `€${euros}`;
  }

  $('copy-referral-btn').addEventListener('click', async () => {
    const txt = $('referral-link').textContent || '';
    try {
      await navigator.clipboard.writeText(txt);
      $('copy-referral-btn').textContent = 'Copied ✓';
      setTimeout(() => ($('copy-referral-btn').textContent = 'Copy'), 2000);
    } catch { /* fallback */ }
  });

  // ── Boot sequence ───────────────────────────────────────────────────
  (async () => {
    const user = await fetchJson<User>('/api/auth/me');
    if (!user) {
      // Not authed — bounce to /signin?next=/library
      window.location.href = '/signin?next=/library';
      return;
    }

    // Show success toast if redirected from OAuth callback
    const params = new URLSearchParams(window.location.search);
    if (params.get('auth') === 'success') {
      $('auth-success-toast').classList.remove('hidden');
      // Clean URL
      const url = new URL(window.location.href);
      url.searchParams.delete('auth');
      window.history.replaceState({}, '', url.toString());
    }

    $('welcome-line').textContent = `Welcome back, ${user.display_name || 'friend'}`;
    // Personalize subtitle with current plan once known (loadBilling will refine)
    const subtitleEl = document.querySelector<HTMLElement>('header p.text-muted');
    if (subtitleEl && user.subscription_tier && (user.subscription_status === 'active' || user.subscription_status === 'trialing')) {
      const planName = (user.subscription_tier as string).charAt(0).toUpperCase() + (user.subscription_tier as string).slice(1);
      subtitleEl.innerHTML = `<span class="text-accent font-semibold">${planName} plan</span> · manage your subscription, API key, and skills.`;
    }
    $('auth-checking').classList.add('hidden');
    $('library-main').classList.remove('hidden');

    await Promise.all([loadBilling(), loadApiKeys(), loadReferrals()]);
  })();
</script>
