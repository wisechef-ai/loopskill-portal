---
import Base from '../layouts/Base.astro';

// Comparison rows. Each row's cells are typed with a status + label so we can
// color the cell uniformly (✅ green-tinted, ❌ red-tinted, ⚠️ amber-tinted, n/a muted).
// "highlight" rows are Recipes-only wins — rendered with a subtle accent background
// across the row so the eye lands on them first on both desktop and mobile.

type Status = 'yes' | 'no' | 'partial' | 'na';
interface Cell {
  status: Status;
  label?: string; // optional extra text after the icon
}
interface Row {
  capability: string;
  diy: Cell;
  larrybrain: Cell;
  gpts: Cell;
  recipes: Cell;
  highlight?: boolean; // Recipes-only win → row gets accent treatment
}

const rows: Row[] = [
  {
    capability: 'Premium curated skills',
    diy:        { status: 'no' },
    larrybrain: { status: 'yes',     label: '102, single curator' },
    gpts:       { status: 'partial', label: 'no curation' },
    recipes:    { status: 'yes',     label: '54 today, vertical, scanned' },
  },
  {
    capability: 'Open-source gateway skill (no signup)',
    diy:        { status: 'na' },
    larrybrain: { status: 'no',  label: 'paywalled' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'super-memory · MIT' },
    highlight: true,
  },
  {
    capability: 'Personal cookbooks',
    diy:        { status: 'no' },
    larrybrain: { status: 'no',  label: 'flat catalog' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'unlimited' },
    highlight: true,
  },
  {
    capability: 'Sync skills across your own agents',
    diy:        { status: 'no' },
    larrybrain: { status: 'no' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'Claude Code · Cursor · Hermes · OpenClaw' },
    highlight: true,
  },
  {
    capability: 'Deploy cookbooks to client agents',
    diy:        { status: 'no' },
    larrybrain: { status: 'no' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: '20 endpoints (Pro+)' },
    highlight: true,
  },
  {
    capability: 'Resell skills to clients at YOUR rate',
    diy:        { status: 'na' },
    larrybrain: { status: 'no' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'Pro+ · we keep zero' },
    highlight: true,
  },
  {
    capability: '50% recurring rev share on referrals',
    diy:        { status: 'na' },
    larrybrain: { status: 'no' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'live now · /creators' },
    highlight: true,
  },
  {
    capability: 'Cryptographic skill signing (ed25519)',
    diy:        { status: 'no' },
    larrybrain: { status: 'no' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'verified at install' },
    highlight: true,
  },
  {
    capability: 'Public install-count drift probe',
    diy:        { status: 'no' },
    larrybrain: { status: 'no',  label: 'opaque metrics' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'hourly · /stats' },
    highlight: true,
  },
  {
    capability: 'Built for the AI integrator',
    diy:        { status: 'no' },
    larrybrain: { status: 'no', label: 'horizontal' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes' },
    highlight: true,
  },
  {
    capability: 'Local execution, your keys',
    diy:        { status: 'na' },
    larrybrain: { status: 'yes' },
    gpts:       { status: 'no', label: 'runs on OpenAI' },
    recipes:    { status: 'yes' },
  },
  {
    capability: 'Open registry',
    diy:        { status: 'na' },
    larrybrain: { status: 'partial', label: 'mixed' },
    gpts:       { status: 'no' },
    recipes:    { status: 'yes', label: 'free OSS skills' },
  },
  {
    capability: 'Price',
    diy:        { status: 'na', label: 'dev time' },
    larrybrain: { status: 'na', label: '$29.99/mo flat' },
    gpts:       { status: 'na', label: '$20/mo (Plus)' },
    recipes:    { status: 'na', label: '$20 Pro · $100 Pro+' },
  },
];

const columns = [
  { key: 'diy',        label: 'Build it yourself', sub: 'DIY scripts' },
  { key: 'larrybrain', label: 'LarryBrain',        sub: 'Horizontal skill marketplace' },
  { key: 'gpts',       label: 'ChatGPT GPTs',      sub: 'OpenAI ecosystem' },
  { key: 'recipes',    label: 'Recipes',           sub: 'Built for AI integrators', accent: true },
];

// Per-status text color (kept dim for "no"/"n/a" so the eye lands on the green ✓ wins).
function labelClass(status: Status): string {
  if (status === 'yes') return 'text-text';
  if (status === 'partial') return 'text-muted';
  return 'text-muted-soft';
}

function defaultLabel(status: Status): string {
  if (status === 'yes') return 'Yes';
  if (status === 'no') return 'No';
  if (status === 'partial') return 'Partial';
  return 'n/a';
}

const COLUMN_KEYS = ['diy', 'larrybrain', 'gpts', 'recipes'] as const;
type ColumnKey = typeof COLUMN_KEYS[number];
---

<Base
  title="Recipes vs. the rest — comparison"
  description="How Recipes compares to LarryBrain, ChatGPT GPTs, and DIY skill stacks. Personal cookbooks, cross-agent sync, deploy to clients — only Recipes ships the kitchen, not just the ingredients."
>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-10">
    <div class="flex flex-col gap-4 max-w-3xl mx-auto text-center">
      <p class="eyebrow">Comparison</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">
        Recipes <span class="text-muted-soft">vs.</span> <span class="text-gradient">the rest</span>
      </h1>
      <p class="text-lg text-muted leading-relaxed">
        Skill marketplaces sell ingredients. Recipes gives you the kitchen — your cookbook,
        every agent you run, every client you ship to.
      </p>
    </div>
  </section>

  <!-- ===========================================================
       Desktop table (md+) — full grid view
       =========================================================== -->
  <section class="hidden md:block max-w-6xl mx-auto px-6 pb-10">
    <div class="bg-bg-card border border-border rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border bg-bg-elev">
            <th scope="col" class="text-left px-5 py-4 font-semibold text-muted-soft text-xs uppercase tracking-wider w-[28%]">
              Capability
            </th>
            {columns.map(c => (
              <th scope="col" class={`text-left px-4 py-4 align-bottom ${c.accent ? 'bg-accent/[0.06]' : ''}`}>
                <div class={`text-sm font-semibold ${c.accent ? 'text-accent' : 'text-text'}`}>{c.label}</div>
                <div class="text-[10.5px] text-muted-soft mt-0.5 font-normal">{c.sub}</div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class={`border-b border-border-soft last:border-b-0 ${row.highlight ? 'bg-accent/[0.025]' : ''}`}>
              <th scope="row" class={`text-left px-5 py-4 align-top text-sm ${row.highlight ? 'font-semibold text-text' : 'font-medium text-text'}`}>
                {row.capability}
              </th>
              {COLUMN_KEYS.map((key) => {
                const cell = row[key];
                const isAccent = key === 'recipes';
                return (
                  <td class={`px-4 py-4 align-top ${isAccent ? 'bg-accent/[0.04]' : ''}`}>
                    <div class={`flex items-start gap-2 ${isAccent && row.highlight ? 'font-semibold' : ''}`}>
                      {cell.status === 'yes'     && <span class="text-success shrink-0 mt-px" aria-label="Yes">✓</span>}
                      {cell.status === 'no'      && <span class="text-muted-soft shrink-0 mt-px" aria-label="No">✕</span>}
                      {cell.status === 'partial' && <span class="text-amber-300 shrink-0 mt-px" aria-label="Partial">◐</span>}
                      {cell.status === 'na'      && <span class="text-muted-soft shrink-0 mt-px text-[11px]" aria-label="Not applicable">—</span>}
                      <span class={labelClass(cell.status)}>
                        {cell.label || defaultLabel(cell.status)}
                      </span>
                    </div>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-muted-soft mt-4 text-center">
      ✓ supported · ◐ partial · ✕ not supported · — not applicable
    </p>
  </section>

  <!-- ===========================================================
       Mobile stack (<md) — one card per capability, four mini-rows
       =========================================================== -->
  <section class="md:hidden max-w-md mx-auto px-6 pb-10 flex flex-col gap-3">
    {rows.map((row) => (
      <div class={`rounded-xl border p-4 ${row.highlight ? 'border-accent/30 bg-accent/[0.04]' : 'border-border bg-bg-card'}`}>
        <div class="text-sm font-semibold text-text mb-3">{row.capability}</div>
        <dl class="grid grid-cols-1 gap-1.5 text-xs">
          {columns.map((c) => {
            const cell = row[c.key as ColumnKey];
            return (
              <div class={`flex items-center justify-between gap-3 px-2 py-1.5 rounded ${c.accent ? 'bg-accent/[0.07]' : ''}`}>
                <dt class={`${c.accent ? 'text-accent font-medium' : 'text-muted'} shrink-0`}>{c.label}</dt>
                <dd class="flex items-center gap-1.5 text-right">
                  {cell.status === 'yes'     && <span class="text-success" aria-label="Yes">✓</span>}
                  {cell.status === 'no'      && <span class="text-muted-soft" aria-label="No">✕</span>}
                  {cell.status === 'partial' && <span class="text-amber-300" aria-label="Partial">◐</span>}
                  {cell.status === 'na'      && <span class="text-muted-soft text-[10px]" aria-label="Not applicable">—</span>}
                  <span class={labelClass(cell.status)}>
                    {cell.label || defaultLabel(cell.status)}
                  </span>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    ))}
  </section>

  <!-- ===========================================================
       Why this matters — narrative for the AI integrator
       =========================================================== -->
  <section class="border-t border-border bg-bg-card/30">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <div class="flex flex-col gap-3 mb-8 text-center">
        <p class="eyebrow">Why this matters</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Built for the integrator who runs more than one agent.</h2>
      </div>
      <div class="prose">
        <p>
          If you're an AI integrator — building agents for clients, deploying them across stacks,
          maintaining them past launch — every existing option treats you like an end-user.
          LarryBrain ships a flat catalog of 102 skills, no way to bundle them into a private cookbook,
          no way to sync your curated set across the agents you operate.
          ChatGPT GPTs are locked inside one vendor's runtime. DIY scripts mean you maintain forever.
          The integrator's actual workflow — pick the skills that matter, package them once, ship them
          to every agent and every client — has no real product.
        </p>
        <p>
          Recipes is that product. Personal cookbooks let you curate a slice of the catalog
          (your slice — different from the next builder's). Cross-agent sync means the same cookbook
          installs cleanly into Claude Code, Cursor, Hermes, OpenClaw — anywhere you run agents.
          Pro+ deploy endpoints let you ship those cookbooks straight into your clients' agents,
          and resell at YOUR rate (we keep zero of the markup).
          The 50% recurring rev share on referrals is live now at <a href="/creators">/creators</a> —
          the cookbooks you build for one client can become recurring revenue once they generalise.
        </p>
        <p>
          Try it before you pay: <a href="/skills/super-memory">super-memory</a> (MIT) is the open-source
          gateway skill — install it free, see how we ship, then upgrade to Pro for the rest of the catalog.
          Skill marketplaces sell ingredients. Recipes ships the kitchen. Pick Pro if you're running
          your own fleet, step up to Pro+ the day you ship a cookbook to a paying client.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 mt-10">
        <a href="/signin?next=/api/checkout/cook"
           class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition">
          Start with Pro → $20/mo
        </a>
        <a href="/pricing"
           class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg text-sm border border-border hover:border-accent text-text transition">
          See Pro+ → 20 endpoints
        </a>
      </div>

      <p class="text-xs text-muted-soft mt-10 leading-relaxed">
        <span class="font-semibold text-muted">Footnote.</span>
        LarryBrain figures (102 skills, $29.99/mo flat, single curator OllieWazza)
        retrieved 2026-05-08. Recipes catalog count refreshed live from <a href="/api/stats" class="text-accent hover:underline">/api/stats</a>;
        as of 2026-05-10 we ship 54 production skills (38 Pro tier, 14 Pro+, 2 free).
        Pricing and skill counts for third-party platforms refresh quarterly;
        if any number on this page is stale, please <a href="mailto:hi@wisechef.ai" class="text-accent hover:underline">tell us</a>
        and we'll correct it.
      </p>
    </div>
  </section>
</Base>
