---
// /browse — search-first unified catalog (feat/spotify-ia, council report §3).
//
// Replaces the four scattered aggregator pages (/skills, /loops, /bundles,
// /personalities) with ONE search-first surface: tabs All/Loops/Skills/
// Bundles/Personalities via ?type=, live GET /api/search?q= debounced
// 180-250ms, grouped sections on the All tab (max 6 desktop/4 mobile per
// group, "See all <type>" preserving q), keyboard nav (/ focus, Esc clear,
// arrows move tabs), aria-live count announcements.
//
// AGENTS.md: NO build-time user-data fetch — this is entirely client-fetched
// (anonymous, public endpoints only). Static shell renders instantly; JS
// hydrates results. mode="public" — anon-OK, indexable.
//
// Canonical handling (council §8): each tab sets its OWN canonical — either
// /browse?type=<x> explicitly, or plain /browse for the All tab only. We do
// NOT collapse every tab to bare /browse (that would tell search engines
// four different pages are the same page).

import AppShell from '../layouts/AppShell.astro';
import { fetchApi } from '../lib/api';
import { artifactCardHTML as libArtifactCardHTML, artifactMeta as libArtifactMeta, type ArtifactType } from '../lib/artifactCard';

const API_BASE = import.meta.env.PUBLIC_LOOPSKILL_API_BASE || import.meta.env.PUBLIC_RECIPES_API_BASE || 'https://app.loopskill.io';
// NOTE: this is a static (SSG) page — Astro.request.url carries no query
// string at build time, so the AppShell-emitted <link rel="canonical"> is
// always the bare /browse origin for the file dist/browse/index.html. That
// IS the correct "plain /browse for the All tab" behavior (council §8); the
// per-tab canonical (/browse?type=X) is set client-side by updateCanonical()
// below when the visitor switches tabs, since Astro can't fork static output
// on a query string. We deliberately do NOT emit a second static
// <link rel="canonical"> here — AppShell already emits exactly one, and
// scripts/assert-dist.sh's canonical guard expects exactly one per page.

// ── Build-time catalog prerender (bugfix, 2026-08-20) ──────────────────────
// This is a STATIC site — there is no server-render-per-request, so the ONLY
// way for a non-JS reader (curl, a crawler that does not execute JS, or a
// visitor whose JS is slow/blocked) to see a real catalog is to bake the
// first screen of it into the built HTML, same sanctioned pattern as
// src/pages/index.astro and skills/[slug].astro's getStaticPaths (see
// AGENTS.md "Build-time fetch ban" — public catalog data only, WITH
// fallback, never user data). This mirrors exactly the "All tab, empty
// query" defaults the client script computes in fetchBrowseDefaults() below,
// so what a non-JS visitor sees matches what JS immediately re-fetches and
// replaces (progressive enhancement, not a fork of behavior).
//
// Previously #browse-loading/#browse-error shipped their real "Loading…" /
// "Couldn't load results." text in the static HTML, hidden only via the
// `hidden` attribute — a tag-stripping reader (curl, most crawlers) doesn't
// respect CSS/attribute-driven visibility and saw those literal strings as
// the page's entire visible content. Fixed by (a) prerendering real cards
// into #browse-results, and (b) moving the loading/error TEXT itself out of
// the static markup entirely — it is now injected by client JS only at the
// moment it becomes true, never baked in ahead of time.
type RawItem = Record<string, any>;

async function fetchLoopsPrebuilt(): Promise<RawItem[]> {
  const composite = await fetchApi<any>('/api/composite-loops', { authed: false });
  if (composite.ok && composite.data) {
    const rows = Array.isArray(composite.data)
      ? composite.data
      : (composite.data.composite_loops || composite.data.loops || composite.data.results || []);
    if (rows.length) return rows;
  }
  const verifiers = await fetchApi<any>('/api/loops', { authed: false });
  if (verifiers.ok && verifiers.data) {
    const rows = Array.isArray(verifiers.data) ? verifiers.data : (verifiers.data.loops || verifiers.data.results || []);
    return rows.map((v: RawItem) => ({ ...v, is_fallback_verifier: true }));
  }
  return [];
}

let byType: Record<string, RawItem[]> = { loops: [], skills: [], bundles: [], personalities: [] };
try {
  const [loopsRows, skillsR, bundlesR, persR] = await Promise.all([
    fetchLoopsPrebuilt(),
    fetchApi<any>('/api/skills/search?page_size=24', { authed: false }),
    fetchApi<any>('/api/cookbooks/discover?sort=installs&limit=6', { authed: false }),
    fetchApi<any>('/api/personalities', { authed: false }),
  ]);
  byType = {
    loops: loopsRows,
    skills: skillsR.ok && skillsR.data ? (skillsR.data.results || []) : [],
    bundles: bundlesR.ok && bundlesR.data ? (bundlesR.data.cookbooks || bundlesR.data.bundles || bundlesR.data.items || []) : [],
    personalities: persR.ok && persR.data
      ? (Array.isArray(persR.data) ? persR.data : (persR.data.personalities || persR.data.results || []))
      : [],
  };
} catch {
  // Offline build / API unreachable at build time — groups stay empty. The
  // #browse-empty static fallback below covers this; we NEVER ship fictional
  // catalog data (scripts/assert-dist.sh's identity guard forbids it) and we
  // never fall back to the bare "Loading…"/error placeholder either.
}

const GROUP_ORDER_SSR = ['loops', 'skills', 'bundles', 'personalities'] as const;
const TYPE_SINGULAR_SSR: Record<string, ArtifactType> = { loops: 'loop', skills: 'skill', bundles: 'bundle', personalities: 'personality' };
const GROUP_LABEL_SSR: Record<string, string> = { loops: 'Popular loops', skills: 'Curated skills', bundles: 'Public bundles', personalities: 'Personalities' };
const MAX_PREBUILT = 6;

function hrefForSSR(type: string, item: RawItem): string {
  if (type === 'loops') {
    return item.is_fallback_verifier
      ? `/loops/run?slug=${encodeURIComponent(item.slug)}`
      : `/loops/view?slug=${encodeURIComponent(item.slug)}`;
  }
  if (type === 'skills') return `/skills/${encodeURIComponent(item.slug)}`;
  if (type === 'bundles') return `/bundles/p?slug=${encodeURIComponent(item.slug)}`;
  return '/browse?type=personalities';
}

function renderPrebuiltGroup(type: string, items: RawItem[]): string {
  if (!items || !items.length) return '';
  const singular = TYPE_SINGULAR_SSR[type];
  const shown = items.slice(0, MAX_PREBUILT);
  const cards = shown
    .map((raw) => {
      const item = {
        slug: raw.slug || '',
        title: raw.title || raw.name || raw.slug || 'Untitled',
        meta: libArtifactMeta(singular, raw),
        href: hrefForSSR(type, raw),
      };
      return `<div class="artifact-slot">${libArtifactCardHTML(singular, item, 'shelf')}</div>`;
    })
    .join('');
  return `<section class="ls-section">
      <div class="flex items-center justify-between ls-section-header">
        <h2 class="ls-section-title text-text">${GROUP_LABEL_SSR[type]}</h2>
        <a href="/browse?type=${type}" class="text-xs text-accent hover:opacity-80 shrink-0">See all ${type} →</a>
      </div>
      <div class="shelf-row">${cards}</div>
    </section>`;
}

const prebuiltGroupsHtml = GROUP_ORDER_SSR.map((t) => renderPrebuiltGroup(t, byType[t])).join('');
const hasPrebuilt = prebuiltGroupsHtml.trim().length > 0;
---

<AppShell mode="public"
  title="Browse — LoopSkill"
  description="Search loops, skills, bundles, and personalities in one place. Live results, no account needed."
  pageType="website"
  active="browse"
>
  <main class="ls-page max-w-6xl mx-auto pb-24">
    <header class="mb-6">
      <h1 class="ls-page-title text-text">Browse</h1>
    </header>

    <!-- Search-first: full-width input is the first control. -->
    <div class="mb-4">
      <div class="relative">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"
             class="absolute left-4 top-1/2 -translate-y-1/2 text-muted-soft pointer-events-none">
          <path d="M8.5 14a5.5 5.5 0 100-11 5.5 5.5 0 000 11zM17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input id="browse-search" type="search" placeholder="Search loops, skills, bundles, personalities"
               autocomplete="off"
               class="w-full pl-11 pr-10 py-3 rounded-lg bg-bg-card border border-border text-base text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
        <button id="browse-search-clear" type="button" aria-label="Clear search"
                class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-muted-soft hover:text-text p-1">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 4L14 14M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </div>
      <p id="browse-live-count" class="sr-only" aria-live="polite"></p>
    </div>

    <!-- Segmented tab bar -->
    <div class="mb-8">
      <div class="seg-tabs" role="tablist" aria-label="Filter by type" id="browse-tabs">
        <button type="button" role="tab" class="seg-tab" data-type="all">All</button>
        <button type="button" role="tab" class="seg-tab" data-type="loops">Loops</button>
        <button type="button" role="tab" class="seg-tab" data-type="skills">Skills</button>
        <button type="button" role="tab" class="seg-tab" data-type="bundles">Bundles</button>
        <button type="button" role="tab" class="seg-tab" data-type="personalities">Personalities</button>
      </div>
    </div>

    <!-- bugfix 2026-08-20: #browse-loading/#browse-error used to carry their
         literal "Loading…" / "Couldn't load results." text in static HTML,
         only ever hidden via the `hidden` attribute. A tag-stripping reader
         (curl, most non-JS crawlers) ignores that attribute and saw those
         strings as the page's ENTIRE visible content — the "apparently
         broken catalog" defect. Both containers now ship EMPTY in static
         HTML; the client script injects the actual text only at the moment
         each state becomes true (see show()/hide() and the load() error
         branch below), so a non-JS reader never sees error/loading copy at
         all, only the real pre-rendered cards below. -->
    <div id="browse-loading" class="ls-body text-muted py-12 text-center" hidden></div>
    <div id="browse-tag-chips" hidden class="tag-chips mb-6" role="group" aria-label="Filter loops by tag"></div>
    <div id="browse-error" hidden class="ls-body text-muted py-12 text-center"></div>
    <div id="browse-empty" hidden class="ls-body text-muted py-16 text-center"></div>
    <!-- Build-time prerendered "All tab, empty query" catalog (bugfix
         2026-08-20 — see frontmatter above). This is real public catalog
         data baked at build time so curl/non-JS crawlers see an actual
         catalog, not a spinner or an error string. The client-side load()
         below OVERWRITES this innerHTML as soon as it resolves (progressive
         enhancement — same content, freshened) via Trap-C-safe replacement:
         both the prebuilt markup and the JS-fill target are the SAME node,
         never a build-time ternary branching JS away from it. When the
         build-time fetch itself failed/returned nothing, this is empty and
         #browse-empty is NOT statically shown either (Trap C) — the client
         load() decides the terminal state the same as it always did. -->
    <div id="browse-results" set:html={prebuiltGroupsHtml}></div>
  </main>
</AppShell>

<script define:vars={{ API_BASE, hasPrebuilt }}>
  const $ = (id) => document.getElementById(id);
  const TYPES = ['all', 'loops', 'skills', 'bundles', 'personalities'];
  const TYPE_LABEL = { all: 'All', loops: 'Loops', skills: 'Skills', bundles: 'Bundles', personalities: 'Personalities' };
  const TYPE_SINGULAR = { loops: 'Loop', skills: 'Skill', bundles: 'Bundle', personalities: 'Personality' };
  // Fixed group order for the All tab (council §3).
  const GROUP_ORDER = ['loops', 'skills', 'bundles', 'personalities'];
  const MAX_DESKTOP = 6;
  const MAX_MOBILE = 4;

  function isMobile() { return window.innerWidth < 640; }
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

  // ── deterministic gradient (mirrors src/lib/artifactCard.ts — same
  // ArtifactCard visual system, string-templated here since this is a
  // define:vars inline script, not a module import). ──
  const GRAD = [['#1fb6c0','#0d7d77'],['#a06bff','#6d28d9'],['#c084fc','#7c3aed'],['#ffb446','#c2410c'],['#ff6e50','#b91c1c'],['#34d399','#0f766e'],['#60a5fa','#1d4ed8']];
  function hashIdx(s, n) { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h % n; }

  // Identicon blocks (mirrors src/lib/identicon.ts — string-templated here
  // because browse.astro uses a define:vars inline script, no module imports).
  function identiconSVG(s) {
    let h1 = 0x811c9dc5, h2 = 0x01000193;
    for (let i = 0; i < s.length; i++) {
      h1 = ((h1 ^ s.charCodeAt(i)) * 0x01000193) >>> 0;
      h2 = ((h2 * 31 + s.charCodeAt(i)) ^ (h2 >>> 7)) >>> 0;
    }
    const bytes = [];
    let x = h1 || 1, y = h2 || 2;
    for (let i = 0; i < 16; i++) {
      x ^= x << 13; x >>>= 0; x ^= x >> 17; x ^= x << 5; x >>>= 0;
      y ^= y << 7; y >>>= 0; y ^= y >> 9; y ^= y << 8; y >>>= 0;
      bytes.push(((x ^ y) >>> (i % 3)) & 0xff);
    }
    const rects = [];
    for (let row = 0; row < 5; row++) {
      for (let col = 0; col < 3; col++) {
        const b = bytes[row * 3 + col];
        if (b % 2 !== 0) continue;
        const op = b % 4 === 0 ? 0.5 : 0.28;
        rects.push(`<rect x="${col*20}" y="${row*20}" width="20" height="20" fill="#fff" fill-opacity="${op}"/>`);
        if (col < 2) rects.push(`<rect x="${(4-col)*20}" y="${row*20}" width="20" height="20" fill="#fff" fill-opacity="${op}"/>`);
      }
    }
    return `<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;">${rects.join('')}</svg>`;
  }

  function artifactHref(type, item) {
    // Federated community cards are rendered via artifactCardHTML('skill', ...)
    // — SINGULAR 'skill', not the plural 'skills' this function matches below.
    // That singular/plural mismatch is deliberate-ish: the fedGroupHTML call site
    // (search "artifactCardHTML('skill'" in this file) uses 'skill' as a type tag
    // for badge/aria text, not as a route type. Left unhandled, 'skill' falls
    // through every branch here and hits the default '/browse?type=personalities'
    // — every community card silently misrouted to the Personalities tab.
    // Community skills also have NO local detail page (only the ~53 curated
    // skills get a statically-generated /skills/{slug}), so routing federated
    // items through the plural 'skills' branch would 404 instead. The correct
    // destination for a federated item is its own origin_url, passed through
    // from fetchFederated() as item.href — so check that FIRST, before the
    // type-based branches, and deep-link out to the source registry.
    if (item && item.href && item.href !== '#') return item.href;
    // feat/composite-loops-surface: the loops tab now renders COMPOSITE loops
    // (deployable autonomous work units), not the old verifier registry — so
    // the detail route is /loops/view (client-fetched GET /api/composite-loops/
    // {slug}), not /loops/run (which now only previews the loop's verifier
    // quality-gate, demoted — see loops/run.astro). The verifier-registry
    // fallback path (used only when /api/composite-loops fails/empty and we
    // degrade to /api/loops) still routes to /loops/run since those items ARE
    // verifiers, not composite loops — item.is_fallback_verifier flags that.
    if (type === 'loops') {
      if (item.is_fallback_verifier) return `/loops/run?slug=${encodeURIComponent(item.slug)}`;
      return `/loops/view?slug=${encodeURIComponent(item.slug)}`;
    }
    if (type === 'skills') return `/skills/${encodeURIComponent(item.slug)}`;
    if (type === 'bundles') return `/bundles/p?slug=${encodeURIComponent(item.slug)}`;
    return '/browse?type=personalities'; // personalities have no detail page yet
  }
  function artifactMeta(type, item) {
    if (type === 'loops') {
      // Fallback verifier items keep their old run_count meta; composite
      // loops show schedule + install_count instead (what actually matters
      // for "should I deploy this").
      // atomic-habits 2026-07-20 rank-8 REVENUE/CATALOG: all 10 fallback-verifier
      // loops show rating_count:0/rating_avg:null (no stars = weak conversion
      // signal) but several have real run_count already returned by /api/loops.
      // Surface that as a "Battle-tested" trust line instead of a bare number —
      // same data, stronger social proof, no API/schema change.
      if (item.is_fallback_verifier) { const n = item.run_count || 0; return n > 0 ? `Battle-tested · ${n} run${n === 1 ? '' : 's'}` : 'Not yet run'; }
      const parts = [];
      if (item.schedule) parts.push(item.schedule === 'manual' ? 'Manual' : 'Scheduled');
      const inst = item.install_count || 0;
      parts.push(`${inst} install${inst === 1 ? '' : 's'}`);
      return parts.join(' · ');
    }
    if (type === 'skills') {
      const n = item.install_count_total || item.install_count || 0;
      const cat = item.category || '';
      if (n > 0 && cat) return `${cat} · ${n.toLocaleString()} installs`;
      if (n > 0) return `${n.toLocaleString()} installs`;
      return cat;
    }
    if (type === 'bundles') { const n = item.skill_count; return typeof n === 'number' ? `${n} skill${n === 1 ? '' : 's'}` : ''; }
    if (type === 'personalities') return item.source || item.role || item.category || '';
    return '';
  }
  // feat/loop-deploy-cta (atomic-habits 2026-07-22 rank-1): composite-loop cards
  // on the Loops tab get a "Deploy →" button that links to the deploy panel on
  // /loops/view. The POST /api/composite-loops/{slug}/deploy endpoint is shipped
  // and the deploy panel exists on the detail page, but the browse card was a
  // plain link with no deploy affordance — the fleet-deploy write path was
  // invisible to every browse visitor. This surfaces it as a primary CTA.

  // ── Like ("heart") control — ponytail_0724 ────────────────────────────────
  // Adam 2026-07-24: "I want to add skill to favourite but there is no menu
  // similar to spotify on skills". The like BACKEND already shipped
  // (liked_0711) — POST/DELETE /api/skills/{slug}/like — but no surface ever
  // called it (zero matches for `api/library|/like` across src/ before this).
  //
  // NOTE ON DUPLICATION: this script carries `define:vars`, which forces
  // Astro's `is:inline` mode — ESM imports are UNAVAILABLE here. So the logic
  // is mirrored from src/lib/likeControl.ts rather than imported. That module
  // is the CANONICAL implementation and is unit-tested; keep the two in sync.
  // home.astro (a processed <script>) imports it properly.
  //
  // Track identity: local skills use their bare slug; FEDERATED skills use the
  // `source__slug` form the API's _resolve_track_identity expects (double
  // underscore). Getting this wrong 404s every federated like.
  //
  // The card root is an <a>, so the button is a SIBLING inside .artifact-slot,
  // never nested — a <button> inside an <a> is invalid HTML and breaks
  // keyboard activation in every browser.
  const HEART_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>';

  function likeTrackId(item) {
    const src = item && (item.like_source || item.source);
    const slug = (item && item.slug) || '';
    return src && src !== 'local' ? `${src}__${slug}` : slug;
  }

  // spotify_2607 Phase D: like now works on all four artifact types (the
  // Phase B backend shipped slug-based POST/DELETE
  // /api/{personalities|loops|bundles}/{slug}/like specifically for this).
  // Mirrors src/lib/likeControl.ts's LIKEABLE_TYPES/likeEndpointSegment —
  // keep both in sync (ponytail-0724-like-control.test.ts pins the drift).
  function isLikeable(type, item) {
    const t = String(type || '');
    const likeable = t === 'skills' || t === 'skill'
      || t === 'personalities' || t === 'personality'
      || t === 'loops' || t === 'loop'
      || t === 'bundles' || t === 'bundle';
    return likeable && !!(item && item.slug);
  }

  function likeEndpointSegment(type) {
    const t = String(type || '');
    if (t === 'personality' || t === 'personalities') return 'personalities';
    if (t === 'loop' || t === 'loops') return 'loops';
    if (t === 'bundle' || t === 'bundles') return 'bundles';
    return 'skills';
  }

  function likeButtonHTML(type, item) {
    if (!isLikeable(type, item)) return '';
    const name = item.title || item.slug;
    return `<button type="button" class="artifact-like" data-like-id="${esc(likeTrackId(item))}"`
      + ` data-like-type="${esc(likeEndpointSegment(type))}"`
      + ` aria-pressed="false" title="Save to your library"`
      + ` aria-label="Save ${esc(name)} to your library">${HEART_SVG}</button>`;
  }

  function artifactCardHTML(type, item, mode) {
    const grad = GRAD[hashIdx(item.slug || item.title || 'x', GRAD.length)];
    const mono = ((item.title || item.slug || 'L').trim()[0] || 'L').toUpperCase();
    const meta = artifactMeta(type, item);
    const desc = mode === 'grid' ? (item.description || '') : '';
    const ariaLabel = `${TYPE_SINGULAR[type] || 'Item'}: ${item.title || item.slug}${meta ? '. ' + meta : ''}`;
    const href = artifactHref(type, item);
    // External (federated/community) hrefs point off-site at the source
    // registry — open those in a new tab so browsing /browse never navigates
    // the user away entirely. Internal routes (/skills/…, /loops/run…,
    // /bundles/p…, /browse?type=…) are unaffected — same-tab as before.
    const isExternal = /^https?:\/\//i.test(href);
    const externalAttrs = isExternal ? ' target="_blank" rel="noopener"' : '';
    // Composite loops get a Deploy CTA in the card footer (links to the deploy
    // panel on /loops/view). Fallback verifiers (old /api/loops registry) don't
    // have a deploy path — they route to /loops/run preview only.
    const isCompositeLoop = type === 'loops' && !item.is_fallback_verifier;
    const deployCTA = isCompositeLoop
      ? `<span class="artifact-deploy" role="button" tabindex="-1" aria-hidden="true">Deploy →</span>`
      : '';
    const card = `<a href="${esc(href)}" class="artifact-card${isCompositeLoop ? ' artifact-card--deployable' : ''}" data-artifact-type="${type}" data-artifact-slug="${esc(item.slug)}" aria-label="${esc(ariaLabel)}"${externalAttrs}>
      <span class="artifact-cover" style="background:linear-gradient(135deg, ${grad[0]} 0%, ${grad[1]} 100%);">
        ${identiconSVG(item.slug || item.title || 'loopskill')}
        <span class="artifact-badge">${TYPE_SINGULAR[type] || ''}</span>
        <span class="artifact-mono" aria-hidden="true">${esc(mono)}</span>
      </span>
      <span class="artifact-title">${esc(item.title || item.slug)}</span>
      ${meta ? `<span class="artifact-meta">${esc(meta)}</span>` : ''}
      ${desc ? `<span class="artifact-desc">${esc(desc)}</span>` : ''}
      ${deployCTA}
    </a>`;
    return `<div class="artifact-slot">${card}${likeButtonHTML(type, item)}</div>`;
  }

  // ── URL state ──────────────────────────────────────────────────────────
  function currentParams() {
    const p = new URLSearchParams(location.search);
    let type = (p.get('type') || 'all').toLowerCase();
    if (!TYPES.includes(type)) type = 'all';
    const q = p.get('q') || '';
    const tag = (type === 'loops') ? (p.get('tag') || '') : '';
    return { type, q, tag };
  }
  function pushState(type, q, replace) {
    const p = new URLSearchParams();
    if (type && type !== 'all') p.set('type', type);
    if (q) p.set('q', q);
    if (type === 'loops' && state.tag) p.set('tag', state.tag);
    const qs = p.toString();
    const url = qs ? `${location.pathname}?${qs}` : location.pathname;
    const fn = replace ? 'replaceState' : 'pushState';
    history[fn]({}, '', url);
    updateCanonical(type);
  }
  function updateCanonical(type) {
    let link = document.querySelector('link[rel="canonical"]');
    if (!link) { link = document.createElement('link'); link.rel = 'canonical'; document.head.appendChild(link); }
    link.href = type === 'all' ? 'https://app.loopskill.io/browse' : `https://app.loopskill.io/browse?type=${type}`;
  }

  let state = currentParams();
  let seq = 0;

  // ── Tabs ───────────────────────────────────────────────────────────────
  const tabsWrap = $('browse-tabs');
  const tabButtons = Array.from(tabsWrap.querySelectorAll('.seg-tab'));
  function syncTabsUI() {
    tabButtons.forEach((b) => {
      const on = b.dataset.type === state.type;
      b.setAttribute('aria-selected', on ? 'true' : 'false');
      b.setAttribute('tabindex', on ? '0' : '-1');
    });
  }
  tabButtons.forEach((b) => {
    b.addEventListener('click', () => {
      if (state.type === b.dataset.type) return;
      state.type = b.dataset.type;
      if (state.type !== 'loops') state.tag = '';
      pushState(state.type, state.q);
      syncTabsUI();
      load();
    });
  });
  // Arrow-key tab navigation.
  tabsWrap.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault();
    const idx = TYPES.indexOf(state.type);
    const next = e.key === 'ArrowRight' ? (idx + 1) % TYPES.length : (idx - 1 + TYPES.length) % TYPES.length;
    state.type = TYPES[next];
    if (state.type !== 'loops') state.tag = '';
    pushState(state.type, state.q);
    syncTabsUI();
    tabButtons[next].focus();
    load();
  });

  // Tag-chip filter (Loops tab only). Delegated so it survives the
  // innerHTML re-render each time load() rebuilds the chip row.
  $('browse-tag-chips').addEventListener('click', (ev) => {
    const btn = ev.target && ev.target.closest ? ev.target.closest('.tag-chip') : null;
    if (!btn) return;
    const tag = btn.dataset.tag || '';
    state.tag = state.tag === tag ? '' : tag; // click active chip again to clear
    pushState(state.type, state.q);
    load();
  });

  // ── Search input ───────────────────────────────────────────────────────
  const input = $('browse-search');
  const clearBtn = $('browse-search-clear');
  let debounceTimer;
  input.value = state.q;
  clearBtn.classList.toggle('hidden', !state.q);

  input.addEventListener('input', () => {
    const q = input.value.trim();
    clearBtn.classList.toggle('hidden', !q);
    state.q = q;
    pushState(state.type, state.q, true);
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(load, 220); // 180-250ms window
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (input.value) { input.value = ''; input.dispatchEvent(new Event('input')); }
      else { input.blur(); }
    }
  });
  clearBtn.addEventListener('click', () => {
    input.value = ''; input.focus();
    input.dispatchEvent(new Event('input'));
  });

  // Global "/" focuses search unless another input is focused.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/') return;
    const el = document.activeElement;
    const tag = el && el.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || (el && el.isContentEditable)) return;
    e.preventDefault();
    input.focus();
  });

  // ── Fetch + render ─────────────────────────────────────────────────────
  function show(id) { const e = $(id); if (e) e.hidden = false; }
  function hide(id) { const e = $(id); if (e) e.hidden = true; }

  // bugfix 2026-08-20: #browse-loading/#browse-error ship EMPTY in static
  // HTML (see the frontmatter + markup comments above) — the "Loading…" and
  // "Couldn't load results." strings are injected HERE, client-side, only at
  // the instant each state actually becomes true. A curl/non-JS reader never
  // executes this script, so it never sees either string; a real visitor
  // whose JS runs still gets the exact same UX as before.
  function showLoading() {
    const e = $('browse-loading');
    if (!e) return;
    e.textContent = 'Loading…';
    e.hidden = false;
  }
  function hideLoading() {
    const e = $('browse-loading');
    if (!e) return;
    e.hidden = true;
    e.textContent = '';
  }
  function showError() {
    const e = $('browse-error');
    if (!e) return;
    e.innerHTML = "Couldn't load results. <button id=\"browse-retry\" type=\"button\" class=\"text-accent hover:underline\">Retry</button>";
    e.hidden = false;
    const btn = $('browse-retry');
    if (btn) btn.addEventListener('click', load);
  }
  function hideError() {
    const e = $('browse-error');
    if (!e) return;
    e.hidden = true;
    e.innerHTML = '';
  }

  async function fetchSearch(q) {
    // API caps limit at 20 (le=20) — limit=50 422'd EVERY search on this page
    // since the Spotify-IA restructure (fc0d01f). Silent-broken: the page
    // showed the generic error state, no console error.
    const url = `${API_BASE}/api/search?q=${encodeURIComponent(q || '')}&limit=20`;
    const r = await fetch(url);
    if (!r.ok) throw new Error(`API ${r.status}`);
    return r.json();
  }

  // feat/fleet-console-ui — FEDERATION on Browse. The internal catalog is
  // curated (~dozens); the 84k+ live in the 7 federated sources that the
  // Composer already queries. Browse only ever hit the internal search, which
  // read as "not all skills are shown". Community results render as their own
  // group with source badges; failures degrade to internal-only (no spinner
  // hostage).
  //
  // feat/browse-federated-defaults: empty-query browse ALSO shows the
  // federated index. The API serves cached per-source first pages on an
  // empty q (~400ms, no live walk), so a first-time visitor sees the breadth
  // of the catalog instead of only the ~dozens of curated skills — the
  // "where are all the skills?" fix. Curated stays FIRST; community renders
  // below it, clearly badged.
  const FED_SOURCES = 'hermes-hub,skills-sh,well-known,clawhub,lobehub,browse-sh,github-oss';
  // issue #82: live counts for the Community-skills header. MIRRORED from
  // src/lib/federatedCounts.ts (the CANONICAL, unit-tested implementation)
  // because define:vars forces is:inline — ESM imports are unavailable in
  // this script. Keep the two in sync (same pattern as likeControl.ts).
  function positiveInt(v) {
    const n = Number(v);
    if (!Number.isFinite(n) || n <= 0 || !Number.isInteger(n)) return null;
    return n;
  }
  function federatedHeaderSuffix(counts) {
    if (!counts || !(counts.sourceCount > 0)) return 'federated · install as-is';
    const reg = `${counts.sourceCount.toLocaleString('en-US')} ${counts.sourceCount === 1 ? 'registry' : 'registries'}`;
    const skills = counts.skillCount && counts.skillCount > 0
      ? ` · ${counts.skillCount.toLocaleString('en-US')} ${counts.skillCount === 1 ? 'skill' : 'skills'}`
      : '';
    return `federated · ${reg}${skills} · install as-is`;
  }
  async function fetchFederated(q, limit = 24) {
    try {
      const r = await fetch(`${API_BASE}/api/skills/external?sources=${FED_SOURCES}&limit=${limit}&q=${encodeURIComponent(q || '')}`);
      if (!r.ok) return [];
      const d = await r.json();
      const raw = (d.external || []).map((s) => ({
        slug: s.slug,
        title: s.title || s.slug,
        description: s.description,
        meta: `${s.source || 'community'}${s.license ? ' · ' + s.license : ''}`,
        href: s.origin_url || '#',
        // ponytail_0724: carry the federation source through so the like
        // control can mint the `source__slug` track identity the API's
        // _resolve_track_identity expects. Dropping it here made every
        // federated heart resolve as a LOCAL slug and 404.
        like_source: s.source || null,
      }));
      // issue #82: bind header counts to the payload envelope — registry
      // count from enabled_sources (a source can be enabled yet return zero
      // rows, so rows alone undercount), installable total from
      // counts.external_installable. Both fail closed to omission, never to
      // a fabricated literal. Validated numbers only — nothing from the
      // payload reaches the DOM as a raw string.
      let sourceCount = positiveInt(Array.isArray(d.enabled_sources) ? d.enabled_sources.length : null);
      if (sourceCount === null) {
        const seen = new Set();
        raw.forEach((it) => seen.add(it.like_source || 'community'));
        sourceCount = positiveInt(seen.size) ?? 0;
      }
      const skillCount = positiveInt(d && d.counts ? d.counts.external_installable : null);
      return { rows: raw, counts: { sourceCount, skillCount } };
    } catch { return { rows: [], counts: null }; }
  }
  // feat/composite-loops-surface: the Loops tab now shows COMPOSITE loops
  // (deployable autonomous work units: schedule + skills + sub-agents + a
  // verifier gate) fetched from GET /api/composite-loops, instead of the old
  // verifier registry (GET /api/loops). We fall back to the verifier registry
  // ONLY if the composite fetch fails or returns empty — degrade, don't blank
  // (council §3 doctrine). Fallback items are tagged is_fallback_verifier so
  // artifactHref/artifactMeta route+label them correctly (old /loops/run
  // behavior), rather than silently misrouting verifier items to /loops/view
  // where they'd 404 against the composite-loops API.
  async function fetchLoopsTabData() {
    let composite = [];
    try {
      const r = await fetch(`${API_BASE}/api/composite-loops`);
      if (r.ok) {
        const d = await r.json();
        composite = Array.isArray(d) ? d : (d.composite_loops || d.loops || d.results || []);
      }
    } catch { /* fall through to verifier fallback below */ }
    if (composite.length) return composite;

    try {
      const r = await fetch(`${API_BASE}/api/loops`);
      if (!r.ok) return [];
      const d = await r.json();
      const verifiers = Array.isArray(d) ? d : (d.loops || d.results || []);
      return verifiers.map((v) => ({ ...v, is_fallback_verifier: true }));
    } catch { return []; }
  }

  // Empty-query browse defaults per type (council §3): fall back to the
  // existing per-type endpoints when q is empty.
  async function fetchBrowseDefaults() {
    const [loopsR, skillsR, bundlesR, persR] = await Promise.allSettled([
      fetchLoopsTabData(),
      fetch(`${API_BASE}/api/skills/search?page_size=24`).then((r) => (r.ok ? r.json() : null)),
      fetch(`${API_BASE}/api/bundles/discover?sort=installs&limit=24`).then((r) => (r.ok ? r.json() : null)),
      fetch(`${API_BASE}/api/personalities`).then((r) => (r.ok ? r.json() : null)),
    ]);
    const loops = loopsR.status === 'fulfilled' && Array.isArray(loopsR.value) ? loopsR.value : [];
    const skills = skillsR.status === 'fulfilled' && skillsR.value ? (skillsR.value.results || []) : [];
    const bundles = bundlesR.status === 'fulfilled' && bundlesR.value ? (bundlesR.value.cookbooks || bundlesR.value.bundles || []) : [];
    const personalities = persR.status === 'fulfilled' && persR.value ? (Array.isArray(persR.value) ? persR.value : (persR.value.personalities || persR.value.results || [])) : [];
    return { loops, skills, bundles, personalities };
  }

  // issue #277 FIX 3 — Federated results group, sourced from the NEW
  // `federated` key on GET /api/search (API PR in flight in parallel; rows
  // shaped { slug, title, description, source, install_ref, origin_url,
  // deployable } + a sibling federated_cache_status of 'warm'|'cold').
  // Strictly defensive/additive, mirroring the exact patterns already used
  // by fedGroupHTML above (artifactCardHTML, esc, group container markup):
  //   - `federated` key absent (old API shape) → render nothing (returns
  //     '') — zero regression against the current API.
  //   - present and non-empty → a "Federated results" group whose cards
  //     link to /skills/external/view?ref=<install_ref> (URL-encoded; the
  //     canonical install_ref format is the colon form "source:slug").
  //   - present but empty AND cache status is cold → a single muted line
  //     noting the index is still warming up, instead of nothing at all.
  //   - present but empty and NOT cold (e.g. warm-but-genuinely-empty) →
  //     nothing, same as the absent case.
  // The council review flagged that the API PR may land the cache-status
  // field under either name — checked defensively; whichever key is
  // present wins, absent means no note is shown.
  function federatedApiGroupHTML(rows, cacheStatus) {
    if (!Array.isArray(rows)) return ''; // key absent or malformed → old-API no-op
    if (rows.length === 0) {
      if (cacheStatus === 'cold') {
        return `<p class="text-xs text-muted-soft py-2">Federated index warming up — check back shortly.</p>`;
      }
      return '';
    }
    const cards = rows
      .map((r) => {
        const ref = r && r.install_ref ? String(r.install_ref) : '';
        const item = {
          slug: (r && r.slug) || '',
          title: (r && (r.title || r.slug)) || 'Untitled',
          description: (r && r.description) || '',
          meta: (r && r.source) || 'community',
          href: ref ? `/skills/external/view?ref=${encodeURIComponent(ref)}` : '#',
        };
        return artifactCardHTML('skill', item, 'grid');
      })
      .join('');
    return `<section class="ls-section">
        <div class="flex items-center justify-between ls-section-header">
          <h2 class="ls-section-title text-text">Federated results</h2>
        </div>
        <div class="artifact-grid">
          ${cards}
        </div>
      </section>`;
  }

  function renderGroup(type, items, mode, seeAllQ) {
    if (!items.length) return '';
    const max = isMobile() ? MAX_MOBILE : MAX_DESKTOP;
    const shown = items.slice(0, max);
    const label = state.q
      ? TYPE_LABEL[type]
      : ({ loops: 'Popular loops', skills: 'Curated skills', bundles: 'Public bundles', personalities: 'Personalities' })[type];
    const seeAll = items.length > max || mode === 'all'
      ? `<a href="/browse?type=${type}${seeAllQ ? '&q=' + encodeURIComponent(seeAllQ) : ''}" class="text-xs text-accent hover:opacity-80 shrink-0">See all ${TYPE_LABEL[type].toLowerCase()} →</a>`
      : '';
    return `<section class="ls-section">
      <div class="flex items-center justify-between ls-section-header">
        <h2 class="ls-section-title text-text">${esc(label)}</h2>
        ${seeAll}
      </div>
      <div class="${mode === 'grid-only' ? 'artifact-grid' : 'shelf-row'}">
        ${shown.map((it) => artifactCardHTML(type, it, mode === 'grid-only' ? 'grid' : 'shelf')).join('')}
      </div>
    </section>`;
  }

  async function load() {
    const mySeq = ++seq;
    hideError(); hide('browse-empty');
    showLoading();
    $('browse-results').innerHTML = '';

    let data;
    let federated = [];
    let fedCounts = null;
    const [dataR, fedR] = await Promise.allSettled([
      state.q ? fetchSearch(state.q) : fetchBrowseDefaults(),
      (state.type === 'all' || state.type === 'skills') ? fetchFederated(state.q, state.type === 'skills' ? 48 : 24) : Promise.resolve({ rows: [], counts: null }),
    ]);
    if (mySeq !== seq) return;
    // issue #82: fetchFederated now returns { rows, counts } — rows feed the
    // cards, counts feed the header. AllSettled rejection or a non-object
    // value degrades to empty rows + null counts (header omits numbers).
    const fedValue = fedR.status === 'fulfilled' && fedR.value && Array.isArray(fedR.value.rows)
      ? fedR.value
      : { rows: [], counts: null };
    federated = fedValue.rows;
    fedCounts = fedValue.counts;
    if (dataR.status === 'fulfilled') {
      data = dataR.value;
    } else if (federated.length) {
      // Internal search failed but federation answered — degrade, don't blank.
      data = { loops: [], skills: [], bundles: [], personalities: [] };
    } else {
      hideLoading();
      showError();
      return;
    }
    hideLoading();

    // issue #277 FIX 3 — read the new `federated` group defensively straight
    // off whatever /api/search (or the empty-query defaults object, which
    // never carries this key) returned. Absent on the current API shape —
    // apiFederatedRows stays null and federatedApiGroupHTML() below is a
    // guaranteed no-op, so this is zero-regression until the API PR ships.
    const apiFederatedRows = data && Array.isArray(data.federated) ? data.federated : null;
    const apiFederatedCacheStatus = data
      ? (data.federated_cache_status || data.federated_status || null)
      : null;
    const apiFederatedGroupHTML = federatedApiGroupHTML(apiFederatedRows, apiFederatedCacheStatus);

    const byType = {
      loops: data.loops || [],
      skills: data.skills || [],
      bundles: data.bundles || data.cookbooks || [],
      personalities: data.personalities || [],
    };

    const totalCount = Object.values(byType).reduce((a, arr) => a + arr.length, 0) + federated.length + (apiFederatedRows ? apiFederatedRows.length : 0);
    const countMsg = state.q
      ? `${totalCount} result${totalCount === 1 ? '' : 's'} for "${state.q}"${federated.length ? ` (${federated.length} community)` : ''}`
      : `${totalCount} item${totalCount === 1 ? '' : 's'}`;
    $('browse-live-count').textContent = countMsg;

    const results = $('browse-results');
    const fedGroupHTML = federated.length
      ? `<section class="ls-section">
          <div class="flex items-center justify-between ls-section-header">
            <h2 class="ls-section-title text-text">Community skills <span class="text-xs text-muted-soft font-normal">${federatedHeaderSuffix(fedCounts)}</span></h2>
          </div>
          <div class="artifact-grid">
            ${federated.map((it) => artifactCardHTML('skill', it, 'grid')).join('')}
          </div>
        </section>`
      : '';

    if (state.type === 'all') {
      hide('browse-tag-chips');
      $('browse-tag-chips').innerHTML = '';
      if (totalCount === 0 && !apiFederatedGroupHTML) {
        show('browse-empty');
        $('browse-empty').textContent = state.q ? `No results for "${state.q}"` : 'Nothing is available right now.';
        return;
      }
      results.innerHTML = GROUP_ORDER.map((t) => renderGroup(t, byType[t], 'all', state.q)).join('') + fedGroupHTML + apiFederatedGroupHTML;
      refreshLikes();
      return;
    }

    // Single-type tab → grid of results for that type only.
    const items = byType[state.type] || [];

    // feat/loop-tag-filter-ui (atomic-habits 2026-07-29 rank-8): the
    // Loops tab is the only surface with a `tags` array per item (from
    // GET /api/composite-loops — see fetchLoopsTabData). The API has
    // supported ?tag= server-side since ah0723, but browse.astro never
    // rendered any filter UI, so composite loops were undiscoverable by
    // tag. Chips are built client-side from whatever loops tab data we
    // already fetched (no extra API call) and filter `items` in place —
    // cheap, reversible, no schema/API change.
    let loopChipItems = items;
    if (state.type === 'loops') {
      const tagCounts = new Map();
      items.forEach((it) => (Array.isArray(it.tags) ? it.tags : []).forEach((t) => {
        tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
      }));
      const chipsEl = $('browse-tag-chips');
      if (tagCounts.size) {
        const chips = Array.from(tagCounts.keys()).sort();
        chipsEl.innerHTML = chips.map((t) => {
          const on = state.tag === t;
          return `<button type="button" class="tag-chip" data-tag="${esc(t)}" aria-pressed="${on ? 'true' : 'false'}">${esc(t)} <span class="text-muted-soft">${tagCounts.get(t)}</span></button>`;
        }).join('');
        chipsEl.hidden = false;
        if (state.tag) loopChipItems = items.filter((it) => Array.isArray(it.tags) && it.tags.includes(state.tag));
      } else {
        chipsEl.hidden = true;
        chipsEl.innerHTML = '';
      }
    } else {
      const chipsEl = $('browse-tag-chips');
      chipsEl.hidden = true;
      chipsEl.innerHTML = '';
    }

    if (!loopChipItems.length && !federated.length && !(apiFederatedRows && apiFederatedRows.length) && !apiFederatedGroupHTML) {
      show('browse-empty');
      // feat/composite-loops-surface: the Loops empty state explains what a
      // loop actually IS (most visitors have never heard the term) instead of
      // the generic "nothing available" copy.
      if (state.type === 'loops' && !state.q) {
        $('browse-empty').textContent = state.tag
          ? `No loops tagged "${state.tag}" right now.`
          : 'A loop = schedule + skills + sub-agents + a verifier gate — deployable to your own agent. Nothing is available right now.';
      } else {
        $('browse-empty').textContent = state.q ? `No results for "${state.q}"` : 'Nothing is available right now.';
      }
      return;
    }
    const grid = loopChipItems.map((it) => artifactCardHTML(state.type, it, 'grid')).join('');
    const curatedHeader = state.type === 'skills' && federated.length
      ? `<div class="ls-section-header"><h2 class="ls-section-title text-text">LoopSkill catalog <span class="text-xs text-muted-soft font-normal">verified · signed</span></h2></div>`
      : '';
    results.innerHTML = (loopChipItems.length ? `${curatedHeader}<div class="artifact-grid">${grid}</div>` : '') + fedGroupHTML + apiFederatedGroupHTML;
    refreshLikes();
  }

  // Retry button is created dynamically by showError() (it does not exist
  // in static HTML — bugfix 2026-08-20); its click listener is wired there.

  // ── Like wiring — ponytail_0724 ───────────────────────────────────────────
  // Delegated so it survives every innerHTML re-render in load(). Optimistic
  // toggle with rollback: the heart must never lie about what the server did.
  const likedIds = new Set();
  let likedHydrated = false;

  function paintLikes(root) {
    (root || document).querySelectorAll('.artifact-like').forEach((btn) => {
      const segment = btn.dataset.likeType || 'skills';
      const id = btn.dataset.likeId || '';
      const on = likedIds.has(`${segment}:${id}`);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.title = on ? 'Remove from your library' : 'Save to your library';
    });
  }

  async function hydrateLikes() {
    // GET /api/library carries several skill sources, all deliberately separate:
    //   shelves.skills          — the DEPLOYABLE Liked bundle (local catalog
    //                             skills; frozen {id, slug, title, liked_at}
    //                             shape, no source)
    //   shelves.personalities   — typed Liked shelf for personalities
    //   shelves.loops           — typed Liked shelf for composite loops
    //   federated_skills        — hub/skills.sh/ClawHub bookmarks
    //                             ({slug, title, source, liked_at}, NOT deployable)
    //   followed_bundles        — bundles the caller follows (= liked, per §7 Q3)
    // Read ALL of them so a heart paints pressed regardless of which shelf it
    // lives on (spotify_2607 Phase D — mirrors src/lib/likeControl.ts).
    try {
      const r = await fetch(`${API_BASE}/api/library`, { credentials: 'include' });
      if (!r.ok) {
        // Anonymous (401): latch so refreshLikes() does not re-issue this call
        // on every render for the rest of the session.
        likedHydrated = true;
        return;
      }
      const d = await r.json();
      likedIds.clear();
      const shelves = (d && d.shelves) || {};
      // MUST-FIX 1 (Codex R1, verified): key by ARTIFACT TYPE + id, never a
      // bare slug — a liked skill "foo" must not collide with an unliked
      // personality "foo". Mirrors src/lib/likeControl.ts's
      // likeHydrationKey()/likedIdsFromLibrary(); keep both in sync.
      ((shelves.skills) || []).forEach((row) => {
        if (row && row.slug) likedIds.add(`skills:${row.slug}`);
      });
      ((shelves.personalities) || []).forEach((row) => {
        if (row && row.slug) likedIds.add(`personalities:${row.slug}`);
      });
      ((shelves.loops) || []).forEach((row) => {
        if (row && row.slug) likedIds.add(`loops:${row.slug}`);
      });
      ((d && d.federated_skills) || []).forEach((row) => {
        if (!row || !row.slug) return;
        const trackId = row.source && row.source !== 'local' ? `${row.source}__${row.slug}` : row.slug;
        likedIds.add(`skills:${trackId}`);
      });
      ((d && d.followed_bundles) || []).forEach((row) => {
        if (row && row.slug) likedIds.add(`bundles:${row.slug}`);
      });
      likedHydrated = true;
      paintLikes();
    } catch {
      // Offline / CORS — hearts stay unpressed, no console noise. Latched.
      likedHydrated = true;
    }
  }

  // Called at the end of EVERY render path in load(). Hydrates the liked set
  // once (first render), then repaints cheaply from the cached set thereafter,
  // so hearts survive tab switches, search, and re-renders.
  function refreshLikes() {
    if (likedHydrated) { paintLikes(); return; }
    hydrateLikes();
  }

  document.addEventListener('click', async (ev) => {
    const btn = ev.target && ev.target.closest ? ev.target.closest('.artifact-like') : null;
    if (!btn) return;
    // The heart sits inside .artifact-slot next to the card <a>. Stop the event
    // so clicking it never navigates to the skill.
    ev.preventDefault();
    ev.stopPropagation();
    if (btn.getAttribute('aria-busy') === 'true') return;

    const id = btn.dataset.likeId || '';
    // spotify_2607 Phase D: route to the type-specific like endpoint (see
    // likeEndpointSegment above — mirrors src/lib/likeControl.ts's toggle()).
    const segment = btn.dataset.likeType || 'skills';
    const wasLiked = btn.getAttribute('aria-pressed') === 'true';
    const nowLiked = !wasLiked;

    // Optimistic paint.
    btn.setAttribute('aria-pressed', nowLiked ? 'true' : 'false');
    btn.setAttribute('aria-busy', 'true');

    try {
      const r = await fetch(`${API_BASE}/api/${segment}/${encodeURIComponent(id)}/like`, {
        method: nowLiked ? 'POST' : 'DELETE',
        credentials: 'include',
      });
      if (r.status === 401 || r.status === 403) {
        // Anonymous visitor — roll back and send them to sign-in, preserving
        // where they were so they land back on the same browse state.
        btn.setAttribute('aria-pressed', wasLiked ? 'true' : 'false');
        location.href = `/signin?next=${encodeURIComponent(location.pathname + location.search)}`;
        return;
      }
      if (!r.ok) throw new Error(`like failed: ${r.status}`);
      const key = `${segment}:${id}`;
      if (nowLiked) likedIds.add(key); else likedIds.delete(key);
      btn.title = nowLiked ? 'Remove from your library' : 'Save to your library';
    } catch {
      // Roll back — never leave a heart claiming a state the server rejected.
      btn.setAttribute('aria-pressed', wasLiked ? 'true' : 'false');
    } finally {
      btn.removeAttribute('aria-busy');
    }
  });

  syncTabsUI();
  updateCanonical(state.type);
  load();
  window.addEventListener('resize', () => { /* recompute max on next load */ });
</script>
