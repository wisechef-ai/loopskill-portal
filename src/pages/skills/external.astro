---
// evergreen_0206 Phase F2/F3 — the external (federated) catalog page.
//
// The "404 → real results" seam. Renders the OFF state at build time (honest
// indexed teaser from the cheap cached Hermes Hub catalog), then client-side JS
// lights up real results when a source toggle is switched on. External skills
// are a SEPARATE, second-class namespace ("community · as-is"), visually
// distinct from the curated Pro catalog and gated behind the per-source toggle
// (off by default) so the curated experience stays clean.
//
// Same-origin: the portal IS app.loopskill.io, so /api/skills/external is a
// same-origin public fetch (no auth, no CORS). The route never surfaces
// internal/private skills — it is external-only by construction.
import AppShell from '../../layouts/AppShell.astro';
import { fetchApi } from '../../lib/api';
import AddToCookbookScript from '../../components/AddToCookbookScript.astro';

// Build-time: pull the honest indexed teaser for the OFF state. This is the
// cheap cached Hermes Hub catalog count — never a conflated "88k installable".
const teaser = await fetchApi<{
  per_source: Record<string, { enabled: boolean; indexed: number | null; installable: number | null }>;
  available_sources: string[];
}>('/api/skills/external', { authed: false });

const perSource = teaser.ok && teaser.data ? teaser.data.per_source : {};
const availableSources = (teaser.ok && teaser.data?.available_sources) ||
  ['hermes-hub', 'skills-sh', 'well-known', 'clawhub', 'lobehub', 'browse-sh', 'github-oss'];
const hermesIndexed = perSource['hermes-hub']?.indexed ?? null;

// Source display metadata (label + blurb). Indexed counts come from the API.
// Mirrors the canonical Hermes Skills Hub source set (federation_0604) plus the
// superset_0606 Phase C provider facets (Anthropic/OpenAI/HuggingFace/NVIDIA/
// gstack/superpowers) — named, curated-source toggles that mirror the Hub's
// provider-facet UI.
const SOURCE_META: Record<string, { label: string; blurb: string }> = {
  'hermes-hub': {
    label: 'Hermes Hub',
    blurb: 'Nous Research bundled skills (MIT) — install straight from origin.',
  },
  'skills-sh': {
    label: 'skills.sh',
    blurb: 'Community skill directory aggregating GitHub repos. Deep-links to origin.',
  },
  'well-known': {
    label: 'Well-Known',
    blurb: 'Any site exposing /.well-known/skills/index.json — install real SKILL.md from origin.',
  },
  'clawhub': {
    label: 'ClawHub',
    blurb: 'Community registry (clawhub.ai). Deep-link only — supply-chain unvetted, as-is.',
  },
  'lobehub': {
    label: 'LobeHub',
    blurb: 'LobeHub agent marketplace (prompt templates). Deep-links to the agent page.',
  },
  'browse-sh': {
    label: 'browse.sh',
    blurb: 'Browserbase site-automation skills. Public SKILL.md — installs from origin.',
  },
  'github-oss': {
    label: 'GitHub OSS',
    blurb: 'Open-source SKILL.md repos. Redistributable licenses install; others deep-link.',
  },
  // superset_0606 Phase C provider facets — curated-source taps. Each is a
  // single repo (or org) read via the GitHub Contents API; redistributable
  // skills install from origin, source-available ones deep-link.
  'github-anthropic': {
    label: 'Anthropic',
    blurb: 'Official anthropics/skills. Apache-2.0 skills install; source-available (docx/pdf/…) deep-link.',
  },
  'github-openai': {
    label: 'OpenAI',
    blurb: 'Curated OpenAI agent skills. Redistributable subset installs from origin.',
  },
  'github-huggingface': {
    label: 'Hugging Face',
    blurb: 'Hugging Face Hub skills (Apache-2.0) — install straight from origin.',
  },
  'github-nvidia': {
    label: 'NVIDIA',
    blurb: 'NVIDIA agent skills (Apache-2.0 / CC-BY-4.0) — install from origin.',
  },
  'github-gstack': {
    label: 'gstack',
    blurb: 'gstack community skills (MIT) — install straight from origin.',
  },
  'github-superpowers': {
    label: 'Superpowers',
    blurb: 'obra/superpowers skill pack (MIT) — install straight from origin.',
  },
};

// superset_0606 Phase E — group the toggles into "provider facets" (named,
// curated-source taps that mirror the Hub's facet UI) and "community hubs"
// (open aggregators). Facets are a notch above raw community: a known provider,
// a known license posture. The grouping is purely presentational — the API
// treats every source identically.
const FACET_SOURCES = [
  'github-anthropic',
  'github-openai',
  'github-huggingface',
  'github-nvidia',
  'github-gstack',
  'github-superpowers',
];
const facetSources = availableSources.filter((s) => FACET_SOURCES.includes(s));
const hubSources = availableSources.filter((s) => !FACET_SOURCES.includes(s));
---

<AppShell mode="public" active="search"
  title="External skills — community catalog"
  description="Browse community-contributed agent skills federated from Hermes Hub, GitHub OSS, and more. Community · as-is. The curated, supported catalog is at /skills."
>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-sm text-muted mb-2">
        <a href="/skills" class="hover:text-text transition">Skills</a>
        <span>/</span>
        <span class="text-text">External</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">External skill catalog</h1>
      <p class="text-muted max-w-2xl leading-relaxed">
        Community-contributed skills federated from other hubs. These are
        <strong class="text-text">second-class, as-is, and not quality-gated</strong> —
        the curated, supported catalog lives at
        <a href="/skills" class="text-accent hover:underline">/skills</a>.
        Sources are <strong class="text-text">off by default</strong>; flip a toggle to browse.
      </p>
    </div>

    <!-- "community · as-is" banner -->
    <div class="rounded-lg border border-amber-500/30 bg-amber-500/5 px-4 py-3 mb-8 flex items-start gap-3">
      <span class="text-amber-400 mt-0.5">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 9v4M12 17h.01M10.3 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.7 3.86a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <div class="text-sm text-muted">
        <span class="text-amber-300 font-semibold">Community · as-is.</span>
        External skills carry their upstream license and install from origin (or
        deep-link when redistribution isn't permitted). No support, no SLA, no
        bundle guarantee — that's what <a href="/pricing" class="text-accent hover:underline">Pro</a> is for.
      </div>
    </div>

    <!-- Source toggles + search (client-hydrated) -->
    <div class="rounded-xl border border-border-soft bg-bg-card p-5 mb-8">
      <div class="flex flex-col gap-4">
        {/* superset_0606 Phase E — provider facets: named, curated-source taps
            (Anthropic/OpenAI/HuggingFace/NVIDIA/gstack/Superpowers) mirroring
            the Hub's facet UI. A notch above raw community: known provider,
            known license posture. */}
        {facetSources.length > 0 && (
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[11px] uppercase tracking-wider text-emerald-300/90 font-semibold">Provider facets</span>
              <span class="text-[11px] text-muted">· community · curated-source</span>
            </div>
            <div class="flex flex-wrap gap-3">
              {facetSources.map((src) => {
                const meta = SOURCE_META[src] || { label: src, blurb: '' };
                const indexed = perSource[src]?.indexed;
                const installable = perSource[src]?.installable;
                return (
                  <label
                    class="flex items-center gap-3 rounded-lg border border-emerald-500/20 px-4 py-3 cursor-pointer hover:border-emerald-400/50 transition flex-1 min-w-[240px]"
                    data-source-card={src}
                  >
                    <input type="checkbox" class="source-toggle w-4 h-4 accent-accent" data-source={src} />
                    <div class="flex-1">
                      <div class="flex items-center justify-between gap-2">
                        <span class="font-semibold text-text">{meta.label}</span>
                        {indexed != null && (
                          <span class="text-xs text-muted whitespace-nowrap">
                            {indexed.toLocaleString()} indexed{installable != null ? ` · ${installable.toLocaleString()} installable` : ''}
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-muted mt-0.5">{meta.blurb}</p>
                    </div>
                  </label>
                );
              })}
            </div>
          </div>
        )}

        {/* Community hubs: open aggregators (Hermes/skills.sh/ClawHub/…). */}
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[11px] uppercase tracking-wider text-amber-300/90 font-semibold">Community hubs</span>
            <span class="text-[11px] text-muted">· as-is · not quality-gated</span>
          </div>
          <div class="flex flex-wrap gap-3" id="source-toggles">
            {hubSources.map((src) => {
              const meta = SOURCE_META[src] || { label: src, blurb: '' };
              const indexed = perSource[src]?.indexed;
              return (
                <label
                  class="flex items-center gap-3 rounded-lg border border-border-soft px-4 py-3 cursor-pointer hover:border-accent/50 transition flex-1 min-w-[240px]"
                  data-source-card={src}
                >
                  <input
                    type="checkbox"
                    class="source-toggle w-4 h-4 accent-accent"
                    data-source={src}
                  />
                  <div class="flex-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-semibold text-text">{meta.label}</span>
                      {indexed != null && (
                        <span class="text-xs text-muted whitespace-nowrap">~{indexed.toLocaleString()} indexed</span>
                      )}
                    </div>
                    <p class="text-xs text-muted mt-0.5">{meta.blurb}</p>
                  </div>
                </label>
              );
            })}
          </div>
        </div>

        <div class="flex gap-2">
          <input
            id="ext-query"
            type="text"
            placeholder="Search enabled sources…"
            class="flex-1 min-w-0 rounded-lg border border-border-soft bg-bg px-4 py-2.5 text-text placeholder:text-muted focus:border-accent focus:outline-none"
          />
          <button
            id="ext-search-btn"
            class="rounded-lg bg-accent text-bg font-semibold px-5 py-2.5 hover:opacity-90 transition disabled:opacity-40"
            disabled
          >
            Search
          </button>
        </div>
      </div>
    </div>

    <!-- Honest counts strip -->
    <div id="counts-strip" class="text-sm text-muted mb-4 hidden">
      <span id="counts-text"></span>
    </div>

    <!-- Results / empty / loading -->
    <div id="ext-status" class="text-center py-16 text-muted">
      <p class="text-lg mb-2">No source enabled.</p>
      <p class="text-sm">
        {hermesIndexed != null
          ? `~${hermesIndexed.toLocaleString()} skills indexed on Hermes Hub alone. Toggle a source above to browse them.`
          : 'Toggle a source above to browse the external catalog.'}
      </p>
    </div>

    <div id="ext-results" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
  </section>

  <script is:inline>
    (function () {
      const toggles = Array.from(document.querySelectorAll('.source-toggle'));
      const queryInput = document.getElementById('ext-query');
      const searchBtn = document.getElementById('ext-search-btn');
      const statusEl = document.getElementById('ext-status');
      const resultsEl = document.getElementById('ext-results');
      const countsStrip = document.getElementById('counts-strip');
      const countsText = document.getElementById('counts-text');

      function enabledSources() {
        return toggles.filter((t) => t.checked).map((t) => t.dataset.source);
      }

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }

      function renderCard(s) {
        const installable = s.install_path === 'fetch_origin' || s.install_path === 'register_mcp';
        const licenseLabel = s.license ? esc(s.license) : 'license unknown';
        const cta = installable
          ? '<span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-400">● installable</span>'
          : '<span class="inline-flex items-center gap-1 text-xs font-semibold text-muted">↗ deep-link only</span>';
        const action = installable
          ? '<code class="text-xs bg-bg border border-border-soft rounded px-2 py-1 block mt-3 overflow-x-auto">loopskill add --source ' +
            esc(s.source) + ' ' + esc(s.slug) + '</code>'
          : '<a href="' + esc(s.origin_url) + '" target="_blank" rel="noopener noreferrer" ' +
            'class="text-xs text-accent hover:underline block mt-3">View at origin →</a>';
        // fedui_0604 Unit C — only fetch-origin skills can be cooked (deep-link
        // skills are never rehosted, so there's nothing to add). The picker
        // markup mirrors AddToCookbook.astro; AddToCookbookScript wires it.
        const picker = installable ? (
          '<div class="atc-wrap relative inline-block mt-3" data-atc-root>' +
            '<button type="button" class="atc-btn inline-flex items-center gap-1.5 rounded-lg border border-border-soft text-text hover:border-accent hover:text-accent transition font-semibold px-3 py-1.5 text-xs" ' +
              'data-atc-slug="' + esc(s.slug) + '" data-atc-external="' + esc(s.source) + '" aria-haspopup="true" aria-expanded="false">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>' +
              '<span class="atc-label">Add to bundle</span>' +
              '<svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="atc-caret transition-transform" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '</button>' +
            '<div class="atc-menu hidden absolute right-0 z-30 mt-1 w-64 rounded-xl border border-border bg-bg-card shadow-xl p-1.5" role="menu">' +
              '<div class="atc-list flex flex-col gap-0.5 max-h-56 overflow-y-auto"></div>' +
              '<div class="atc-loading px-3 py-2 text-xs text-muted">Loading your bundles…</div>' +
              '<div class="atc-signin hidden px-3 py-3 text-xs text-muted"><a href="/signin?next=' + encodeURIComponent(location.pathname + location.search) + '" class="atc-signin-link text-accent hover:underline font-semibold">Sign in</a> to save skills to a bundle.</div>' +
              '<div class="atc-empty hidden px-3 py-2 text-xs text-muted">No bundles yet — create one below.</div>' +
              '<div class="atc-cap hidden px-3 py-2 text-xs text-amber-300">Skill cap reached. <a href="/pricing" class="text-accent hover:underline">Upgrade</a>.</div>' +
              '<div class="border-t border-border-soft mt-1 pt-1"><form class="atc-new flex items-center gap-1.5 px-1.5 py-1">' +
                '<input type="text" class="atc-new-name flex-1 rounded-md border border-border-soft bg-bg px-2 py-1 text-xs text-text placeholder:text-muted focus:border-accent focus:outline-none" placeholder="＋ New bundle…" maxlength="80"/>' +
                '<button type="submit" class="atc-new-btn rounded-md bg-accent text-bg text-xs font-semibold px-2.5 py-1 hover:opacity-90 transition">Add</button>' +
              '</form></div>' +
            '</div>' +
          '</div>'
        ) : '';
        return (
          '<div class="rounded-xl border border-border-soft bg-bg-card p-4 flex flex-col">' +
            '<div class="flex items-start justify-between gap-2 mb-1">' +
              '<span class="font-semibold text-text">' + esc(s.title) + '</span>' +
              '<span class="text-[10px] uppercase tracking-wide text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5 whitespace-nowrap">' +
                esc(s.source) + '</span>' +
            '</div>' +
            '<p class="text-sm text-muted flex-1">' + esc(s.description || 'No description.') + '</p>' +
            '<div class="flex items-center justify-between gap-2 mt-3 pt-3 border-t border-border-soft">' +
              cta +
              '<span class="text-xs text-muted">' + licenseLabel + '</span>' +
            '</div>' +
            action +
            picker +
          '</div>'
        );
      }

      function setStatus(html, show) {
        statusEl.innerHTML = html;
        statusEl.classList.toggle('hidden', !show);
      }

      async function run() {
        const srcs = enabledSources();
        searchBtn.disabled = srcs.length === 0;
        resultsEl.innerHTML = '';
        countsStrip.classList.add('hidden');

        if (srcs.length === 0) {
          setStatus(
            '<p class="text-lg mb-2">No source enabled.</p>' +
            '<p class="text-sm">Toggle a source above to browse the external catalog.</p>',
            true
          );
          return;
        }

        setStatus('<p class="text-sm">Loading external skills…</p>', true);
        const q = (queryInput.value || '').trim();
        const params = new URLSearchParams({ sources: srcs.join(','), limit: '100' });
        if (q) params.set('q', q);

        let data;
        try {
          const res = await fetch('/api/skills/external?' + params.toString());
          if (!res.ok) throw new Error('API ' + res.status);
          data = await res.json();
        } catch (e) {
          setStatus('<p class="text-sm text-red-400">Could not reach the external catalog. Try again.</p>', true);
          return;
        }

        const rows = data.external || [];
        const c = data.counts || {};
        // Honest, never-conflated counts.
        countsText.textContent =
          (c.external_indexed || 0).toLocaleString() + ' indexed · ' +
          (c.external_installable || 0).toLocaleString() + ' installable across ' +
          srcs.length + ' source' + (srcs.length === 1 ? '' : 's');
        countsStrip.classList.remove('hidden');

        if (rows.length === 0) {
          setStatus('<p class="text-sm">No external skills matched. Try a broader query.</p>', true);
          return;
        }
        setStatus('', false);
        resultsEl.innerHTML = rows.map(renderCard).join('');
        // fedui_0604 Unit C — wire the freshly-rendered picker buttons.
        if (typeof window.__atcWire === 'function') window.__atcWire();
      }

      toggles.forEach((t) => t.addEventListener('change', run));
      searchBtn.addEventListener('click', run);
      queryInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') run();
      });
    })();
  </script>
  <AddToCookbookScript />
</AppShell>
