---
import Base from '../../layouts/Base.astro';
import CrossSell from '../../components/CrossSell.astro';
import Icon from '../../components/Icon.astro';
import AuditRow from '../../components/AuditRow.astro';
import { marked } from 'marked';
import { fetchApi } from '../../lib/api';

export async function getStaticPaths() {
  const result = await fetchApi<{ results: any[]; total: number }>(
    '/api/skills/search?page_size=100',
  );
  let skills = (result.ok && result.data?.results) || [];
  // Walk additional pages serially if the catalog is bigger than 100
  if (skills.length === 100 && result.data?.total && result.data.total > 100) {
    const lastPage = Math.ceil(result.data.total / 100);
    for (let p = 2; p <= lastPage; p++) {
      const r = await fetchApi<{ results: any[] }>(
        `/api/skills/search?page_size=100&page=${p}`,
      );
      if (r.ok && r.data?.results) skills = skills.concat(r.data.results);
      else break;
    }
  }

  // Always include a base set so pages exist even if API is briefly down at build
  const seedSlugs = ['client-reporter', 'web-scraper-pro', 'email-composer', 'invoice-automator', 'standup-bot', 'gohighlevel-cli', 'onboarding-wizard', 'seo-audit-engine', 'content-calendar', 'proposal-builder', 'cold-outreach', 'whitelabel-dashboard'];
  const seedSkills = seedSlugs.map(s => ({ slug: s, title: s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) }));
  const all = [...skills];
  for (const s of seedSkills) {
    if (!all.find(x => x.slug === s.slug)) all.push(s);
  }

  // Build-time graph fetch (Stage 3): pull the full graph ONCE and pre-compute
  // the per-slug adjacency map so each skill page doesn't fire its own fetch
  // (which would 80x the build time and trip the rate limiter).
  const graphRes = await fetchApi<{
    nodes: { slug: string; title: string; category: string; tier: string; install_count: number }[];
    edges: { source: string; target: string; weight: number }[];
  }>('/api/skills/graph', { authed: false });
  const nodesBySlug = new Map<string, any>();
  if (graphRes.ok && graphRes.data) {
    for (const n of graphRes.data.nodes) nodesBySlug.set(n.slug, n);
  }
  const adjacency = new Map<string, { slug: string; weight: number }[]>();
  if (graphRes.ok && graphRes.data) {
    for (const e of graphRes.data.edges) {
      (adjacency.get(e.source) ?? adjacency.set(e.source, []).get(e.source)!).push({ slug: e.target, weight: e.weight });
      (adjacency.get(e.target) ?? adjacency.set(e.target, []).get(e.target)!).push({ slug: e.source, weight: e.weight });
    }
    // Sort each adjacency list by weight desc
    for (const list of adjacency.values()) list.sort((a, b) => b.weight - a.weight);
  }

  return all.map(skill => {
    const neighbours = (adjacency.get(skill.slug) || []).slice(0, 12);
    const related = neighbours
      .map(({ slug }) => nodesBySlug.get(slug))
      .filter(Boolean);
    return {
      params: { slug: skill.slug },
      props: {
        initialSkill: skill,
        related,
      },
    };
  });
}

const { slug } = Astro.params;
const { initialSkill, related: relatedFromBuild } = Astro.props;

let skill: any = initialSkill;
const detail = await fetchApi<any>(`/api/skills/${slug}`);
if (detail.ok && detail.data) {
  skill = { ...initialSkill, ...detail.data };
}

// Stage 3 (G17) related-skills rail. Data already fetched in getStaticPaths
// (one graph dump for the whole build) and passed via props.
interface RelatedSkill {
  slug: string; title: string; category?: string | null; tier?: string | null;
}
const related: RelatedSkill[] = (relatedFromBuild as RelatedSkill[]) || [];

// Mark which related-rail entries were author-declared (Stage 1) vs derived (Stage 2)
// — the per-skill /api/skills/{slug}/graph endpoint exposes this distinction at
// runtime (skill.related field). Use it when present, fall back to an empty set.
const declaredSlugs = new Set<string>(
  ((skill?.related || []) as { slug: string }[]).map((s) => s.slug),
);

// Repo URL mapping — all free skills live in awesome-agent-recipes monorepo
const REPO_BASE = 'https://github.com/wisechef-ai/awesome-agent-recipes';
const monorepoSkills = ['client-reporter', 'web-scraper', 'web-scraper-pro', 'email-composer', 'standup-bot', 'onboarding-wizard', 'invoice-automator', 'gohighlevel-cli'];
const repoMap: Record<string, string> = Object.fromEntries(
  monorepoSkills.map(s => [s, `${REPO_BASE}/tree/main/skills/${s.replace(/-pro$/, '')}`])
);
const repoUrl = repoMap[slug as string] || null;

const fallbackBySlug: Record<string, any> = {
  'client-reporter': {
    title: 'Client Reporter',
    tagline: 'Replaces 4h/week of manual client reporting',
    tier: 'free',
    description: 'Pull GA4, Google Search Console, Meta Ads, and TikTok Ads data for any client and generate a branded PDF report. White-label-ready.',
    license: 'MIT',
    requires_env: ['GA4_PROPERTY_ID', 'GSC_SITE', 'META_ADS_ACCOUNT_ID', 'TIKTOK_ADS_ACCOUNT_ID', 'OPENAI_API_KEY'],
    icon: 'chart',
  },
};

const tagline = skill?.tagline || fallbackBySlug[slug as string]?.tagline || '';
const f = fallbackBySlug[slug as string] || {};

const display = {
  slug,
  title: skill?.title || f.title || (slug as string).replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()),
  tagline,
  tier: skill?.tier || f.tier || 'pro',
  description: skill?.description || f.description || 'A Recipes skill.',
  install_count: skill?.install_count ?? 0,
  rating: skill?.rating ?? null,
  version: skill?.latest_version || skill?.version || '0.1.0',
  author: skill?.creator_name || skill?.author || 'Recipes',
  repo_url: repoUrl,
  requires_env: skill?.requires_env || f.requires_env || [],
  category: skill?.category || 'general',
  license: skill?.license || f.license || null,
  readme: skill?.readme || null,
  versions: skill?.versions || [],
  // Audit metadata (Phase B): these may be absent until the audit-backfill script
  // (scripts/backfill_audit_metadata.py) populates them via PATCH /api/skills/{slug}/audit.
  source_url: skill?.source_url || skill?.audit?.source_url || repoUrl || null,
  sha256: skill?.sha256 || skill?.checksum_sha256 || skill?.audit?.sha256 || null,
  last_reviewed_at: skill?.last_reviewed_at || skill?.audit?.last_reviewed_at || null,
};

// Render the readme markdown to HTML server-side
let readmeHtml: string | null = null;
if (display.readme && typeof display.readme === 'string') {
  // Strip the YAML frontmatter from the readme — it's already rendered as structured data above
  const stripped = display.readme.replace(/^---\s*\n[\s\S]*?\n---\s*\n/, '');
  marked.setOptions({ gfm: true, breaks: false });
  readmeHtml = marked.parse(stripped) as string;
}

const tierBadgeClass = display.tier === 'free' ? 'badge-free' : display.tier === 'studio' ? 'badge-studio' : 'badge-pro';
const isFree = display.tier === 'free';
---

<Base title={`${display.title} — Recipes`} description={display.description}>
  <section class="max-w-6xl mx-auto px-6 pt-12 pb-12">
    <a href="/skills" class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition mb-8">
      <Icon name="chevron-left" size={12} />
      All skills
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Main -->
      <div class="lg:col-span-2 flex flex-col gap-8">
        <header class="flex flex-col gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider ${tierBadgeClass}`}>
              {display.tier.toUpperCase()}
            </span>
            <span class="text-[10px] text-muted-soft uppercase tracking-wider">{display.category}</span>
            <span class="text-[10px] text-muted-soft font-mono">v{display.version}</span>
            {display.license && <span class="text-[10px] text-muted-soft uppercase tracking-wider">· {display.license}</span>}
          </div>
          <h1 class="text-3xl md:text-5xl font-bold tracking-tight" style="letter-spacing: -0.03em;">{display.title}</h1>
          {display.tagline && <p class="text-lg md:text-xl text-muted">{display.tagline}</p>}
          <p class="text-text leading-relaxed mt-2">{display.description}</p>
        </header>

        <!-- Audit row (Phase B trust) — provenance + integrity above install -->
        <AuditRow
          source_url={display.source_url}
          sha256={display.sha256}
          last_reviewed_at={display.last_reviewed_at}
        />

        <!-- Quick install banner -->
        <div class="bg-[#0d0d0d] border border-border rounded-xl p-5 flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <Icon name="terminal" size={14} class="text-accent" />
            <p class="eyebrow">Install in your agent</p>
          </div>
          <div class="font-mono text-xs text-muted leading-relaxed">
            <span class="text-success">→</span> Tell your agent: <span class="text-accent">"install the recipes skill, then add {display.slug}"</span>
          </div>
          <div class="font-mono text-xs text-muted-soft">
            Or via curl: <code class="bg-bg-card border border-border-soft rounded px-1.5 py-0.5">curl -sL https://recipes.wisechef.ai/skill -o ~/.claude/skills/recipes/SKILL.md</code>
          </div>
        </div>

        <!-- Auth-aware install gate (WIS-647) — hidden by default, populated by client-side script -->
        <div id="install-auth-gate" data-skill-slug={display.slug} data-skill-tier={display.tier} class="hidden bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Your install command</p>

          <!-- State A: not authed -->
          <div data-state="anon" class="hidden">
            <p class="text-sm text-muted mb-3">Sign in to get your API key and the personalized install command.</p>
            <a id="install-signin-link" href="/signin" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              Sign in to install →
            </a>
          </div>

          <!-- State B: authed, tier insufficient -->
          <div data-state="locked" class="hidden">
            <p class="text-sm text-muted mb-3">This skill requires <span data-required-tier class="text-accent font-semibold">Cook</span>. Upgrade to install.</p>
            <a href="/pricing" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              See plans →
            </a>
          </div>

          <!-- State C: authed + tier OK — show install command -->
          <div data-state="ready" class="hidden">
            <p class="text-sm text-muted mb-3">Copy and paste into your agent's environment:</p>
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <code class="font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2 flex-1">export RECIPES_API_KEY=<span data-key-prefix>rec_live_…</span></code>
                <a href="/library" class="text-xs text-accent hover:opacity-80 underline shrink-0">Get key →</a>
              </div>
              <code class="block font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2">recipes install <span data-skill-slug-display>{display.slug}</span></code>
            </div>
            <p class="text-[11px] text-muted-soft mt-3">First time? <a href="/library" class="text-accent hover:opacity-80 underline">Generate your API key</a> on the Library page.</p>
          </div>

          <div data-state="loading" class="text-xs text-muted">Checking…</div>
        </div>

        <!-- Required environment variables -->
        {display.requires_env && display.requires_env.length > 0 && (
          <section class="bg-bg-card border border-border rounded-2xl p-6">
            <div class="flex items-center gap-2 mb-3">
              <Icon name="shield" size={14} class="text-success" />
              <p class="eyebrow">Required environment variables</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {display.requires_env.map((env: string) => (
                <code class="text-xs bg-[#0d0d0d] border border-border rounded-lg px-2.5 py-1 text-accent-soft font-mono">{env}</code>
              ))}
            </div>
            <p class="text-xs text-muted-soft mt-3">These stay on your machine. Recipes never sees them.</p>
          </section>
        )}

        <!-- Full skill markdown — the WHOLE point Adam called out -->
        {readmeHtml ? (
          <section class="bg-bg-card border border-border rounded-2xl p-6 md:p-8">
            <div class="flex items-center justify-between gap-3 mb-5 flex-wrap">
              <div class="flex items-center gap-2">
                <Icon name="document" size={14} class="text-accent" />
                <p class="eyebrow">Full skill source · SKILL.md</p>
              </div>
              {display.repo_url && (
                <a href={display.repo_url} target="_blank" rel="noopener" class="text-xs text-muted hover:text-accent inline-flex items-center gap-1.5 transition">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.4c-2.23.48-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.66 3.96.29.25.55.74.55 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg>
                  View on GitHub
                </a>
              )}
            </div>
            <article class="prose" set:html={readmeHtml}></article>
          </section>
        ) : (
          <section class="bg-bg-card border border-border rounded-2xl p-6 text-center">
            <p class="text-muted text-sm">Full skill documentation coming soon.</p>
            <p class="text-muted-soft text-xs mt-1">This skill is part of the Day-1 catalog. Detailed SKILL.md is being authored.</p>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="flex flex-col gap-4">
        <div class="bg-bg-card border border-border rounded-2xl p-5 flex flex-col gap-4 sticky top-20">
          {isFree ? (
            <a href="/docs/install"
               class="block text-center px-4 py-2.5 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
              Install free
            </a>
          ) : (
            <a href="/pricing"
               class="block text-center px-4 py-2.5 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
              Subscribe to install
            </a>
          )}
          <div class="text-[11px] text-muted-soft text-center">
            {isFree ? 'Free forever. No subscription required.' : `Requires ${display.tier} subscription`}
          </div>
        </div>

        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Details</p>
          <dl class="text-sm flex flex-col gap-3">
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Author</dt>
              <dd class="text-text text-right">{display.author}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Version</dt>
              <dd class="text-text font-mono text-xs">{display.version}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Tier</dt>
              <dd class="text-text capitalize">{display.tier}</dd>
            </div>
            {display.license && (
              <div class="flex justify-between gap-2">
                <dt class="text-muted">License</dt>
                <dd class="text-text">{display.license}</dd>
              </div>
            )}
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Installs</dt>
              <dd class="text-text">{(display.install_count || 0).toLocaleString()}</dd>
            </div>
            <div class="pt-3 border-t border-border-soft">
              <dt class="text-muted text-xs mb-2">Compatible</dt>
              <dd class="text-xs text-muted-soft leading-relaxed">Claude Code · Cursor · OpenClaw · Hermes · Cline · Windsurf</dd>
            </div>
          </dl>
        </div>

        {display.repo_url && (
          <div class="bg-bg-card border border-border rounded-2xl p-5">
            <p class="eyebrow mb-3">Source</p>
            <a href={display.repo_url} target="_blank" rel="noopener" class="text-sm text-accent hover:opacity-80 inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.4c-2.23.48-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.66 3.96.29.25.55.74.55 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg>
              View on GitHub
            </a>
          </div>
        )}

        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Want it run for you?</p>
          <p class="text-xs text-muted leading-relaxed mb-3">WiseChef Framework operates this skill end-to-end as a managed AI employee.</p>
          <a href="https://wisechef.ai/framework" class="text-xs text-accent hover:opacity-80 inline-flex items-center gap-1.5">
            See WiseChef <Icon name="arrow-right" size={11} />
          </a>
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <div class="mt-12 pt-8 border-t border-border">
        <div class="flex items-end justify-between gap-4 mb-5">
          <div>
            <p class="eyebrow">Skill graph</p>
            <h2 class="text-2xl font-semibold tracking-tight">Works well with</h2>
            <p class="text-xs text-muted-soft mt-1">
              Recommended by tag overlap, category, and co-install patterns.
              <a href="/graph" class="text-accent hover:underline">See full graph →</a>
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {related.map((r) => {
            const tier = r.tier || 'cook';
            const tierClass = tier === 'free' ? 'badge-free' : tier === 'studio' ? 'badge-studio' : 'badge-pro';
            const isDeclared = declaredSlugs.has(r.slug);
            return (
              <a
                href={`/skills/${r.slug}`}
                class="group bg-bg-card border border-border rounded-xl p-4 card-lift flex flex-col gap-2"
              >
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-sm font-semibold text-text group-hover:text-accent transition leading-tight">{r.title}</h3>
                  <div class="flex items-center gap-1.5 shrink-0">
                    {isDeclared && (
                      <span class="text-[9px] uppercase tracking-wider text-muted-soft" title="Hand-picked by the author">handpicked</span>
                    )}
                    <span class={`inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold tracking-wider ${tierClass}`}>{tier.toUpperCase()}</span>
                  </div>
                </div>
                {r.category && (
                  <span class="text-[10px] text-muted-soft capitalize">{r.category}</span>
                )}
              </a>
            );
          })}
        </div>
      </div>
    )}
  </section>
</Base>

<script>
  // Auth-aware install gate (WIS-647)
  // Tier hierarchy: free < cook < operator < studio
  const TIER_RANK: Record<string, number> = { free: 0, cook: 1, operator: 2, studio: 3 };

  (async () => {
    const gate = document.getElementById('install-auth-gate');
    if (!gate) return;
    gate.classList.remove('hidden');

    const slug = gate.getAttribute('data-skill-slug') || '';
    const reqTier = gate.getAttribute('data-skill-tier') || 'free';
    const setState = (state: 'anon' | 'locked' | 'ready' | 'loading') => {
      gate.querySelectorAll<HTMLElement>('[data-state]').forEach(el => {
        el.classList.toggle('hidden', el.getAttribute('data-state') !== state);
      });
    };

    setState('loading');

    try {
      const meRes = await fetch('/api/auth/me', { credentials: 'include' });
      if (!meRes.ok) {
        const link = document.getElementById('install-signin-link') as HTMLAnchorElement | null;
        if (link) link.href = `/signin?next=/skills/${slug}`;
        setState('anon');
        return;
      }

      // Authed — check tier
      const billingRes = await fetch('/api/billing/me', { credentials: 'include' });
      const billing = billingRes.ok ? await billingRes.json() : null;
      const userTier = billing?.subscription_tier || 'free';
      const userRank = TIER_RANK[userTier] ?? 0;
      const reqRank = TIER_RANK[reqTier] ?? 0;

      if (userRank < reqRank) {
        const reqEl = gate.querySelector('[data-required-tier]');
        if (reqEl) reqEl.textContent = reqTier.charAt(0).toUpperCase() + reqTier.slice(1);
        setState('locked');
        return;
      }

      // Authed + tier OK — fetch user's API key prefix
      let prefix = 'rec_live_…';
      try {
        const keysRes = await fetch('/api/api-keys', { credentials: 'include' });
        if (keysRes.ok) {
          const data = await keysRes.json();
          const active = (data.keys || []).find((k: any) => k.is_active);
          if (active) prefix = active.prefix + '…';
        }
      } catch { /* prefix stays as placeholder */ }

      const prefixEl = gate.querySelector('[data-key-prefix]');
      if (prefixEl) prefixEl.textContent = prefix;
      setState('ready');
    } catch {
      setState('anon');
    }
  })();
</script>
