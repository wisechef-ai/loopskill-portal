<script>
  // Auth-aware install gate (WIS-647)
  // Tier hierarchy: free < pro < pro_plus (with legacy slug shims)
  // RCP-INCIDENT-2026-05-11: 'cook', 'operator', 'studio' are legacy aliases.
  const TIER_RANK: Record<string, number> = {
    free: 0,
    pro: 1, cook: 1,       // cook is legacy alias for pro
    pro_plus: 2, operator: 2, studio: 2,  // operator/studio are legacy aliases for pro_plus
  };

  (async () => {
    const gate = document.getElementById('install-auth-gate');
    if (!gate) return;
    gate.classList.remove('hidden');

    const slug = gate.getAttribute('data-skill-slug') || '';
    const reqTier = gate.getAttribute('data-skill-tier') || 'free';
    const setState = (state: 'anon' | 'locked' | 'ready' | 'loading') => {
      gate.querySelectorAll<HTMLElement>('[data-state]').forEach(el => {
        el.classList.toggle('hidden', el.getAttribute('data-state') !== state);
      });
    };

    setState('loading');

    try {
      const meRes = await fetch('/api/auth/me', { credentials: 'include' });
      if (!meRes.ok) {
        const link = document.getElementById('install-signin-link') as HTMLAnchorElement | null;
        if (link) link.href = `/signin?next=/skills/${slug}`;
        setState('anon');
        return;
      }

      // Authed — check tier
      const billingRes = await fetch('/api/billing/me', { credentials: 'include' });
      const billing = billingRes.ok ? await billingRes.json() : null;
      const userTier = billing?.subscription_tier || 'free';
      const userRank = TIER_RANK[userTier] ?? 0;
      const reqRank = TIER_RANK[reqTier] ?? 0;

      if (userRank < reqRank) {
        const reqEl = gate.querySelector('[data-required-tier]');
        if (reqEl) reqEl.textContent = reqTier.charAt(0).toUpperCase() + reqTier.slice(1);
        setState('locked');
        return;
      }

      // Authed + tier OK — fetch user's API key prefix
      let prefix = 'rec_live_…';
      try {
        const keysRes = await fetch('/api/api-keys', { credentials: 'include' });
        if (keysRes.ok) {
          const data = await keysRes.json();
          const active = (data.keys || []).find((k: any) => k.is_active);
          if (active) prefix = active.prefix + '…';
        }
      } catch { /* prefix stays as placeholder */ }

      const prefixEl = gate.querySelector('[data-key-prefix]');
      if (prefixEl) prefixEl.textContent = prefix;
      setState('ready');
    } catch {
      setState('anon');
    }
  })();
</script>

