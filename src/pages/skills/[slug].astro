---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import AuditRow from '../../components/AuditRow.astro';
import TrustPills from '../../components/TrustPills.astro';
import { fetchApi } from '../../lib/api';
import { tierBadge as tierBadgeText, tierBadgeClass } from '../../lib/tiers';
import { SkillFileExplorer } from '../../components/skill/SkillFileExplorer';
import { RuntimePanel } from '../../components/skill/RuntimePanel';
import { AuditBars } from '../../components/skill/AuditBars';
import AddToCookbook from '../../components/AddToCookbook.astro';
import AddToCookbookScript from '../../components/AddToCookbookScript.astro';
import QuickInstall from '../../components/QuickInstall.astro';

export async function getStaticPaths() {
  const result = await fetchApi<{ results: any[]; total: number }>(
    '/api/skills/search?page_size=100',
  );
  let skills = (result.ok && result.data?.results) || [];
  // Walk additional pages serially if the catalog is bigger than 100
  if (skills.length === 100 && result.data?.total && result.data.total > 100) {
    const lastPage = Math.ceil(result.data.total / 100);
    for (let p = 2; p <= lastPage; p++) {
      const r = await fetchApi<{ results: any[] }>(
        `/api/skills/search?page_size=100&page=${p}`,
      );
      if (r.ok && r.data?.results) skills = skills.concat(r.data.results);
      else break;
    }
  }

  // Always include a base set so pages exist even if API is briefly down at build
  const seedSlugs = ['super-memory', 'ruthless-mentor', 'plan-for-goal', 'llm-wiki-hermes', 'hub-search-claude-code', 'loopskill', 'client-reporter', 'web-scraper-pro', 'email-composer', 'invoice-automator', 'standup-bot', 'gohighlevel-cli', 'onboarding-wizard', 'seo-audit-engine', 'content-calendar', 'proposal-builder', 'cold-outreach', 'whitelabel-dashboard', 'larry'];
  const seedSkills = seedSlugs.map(s => ({ slug: s, title: s.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) }));
  const all = [...skills];
  for (const s of seedSkills) {
    if (!all.find(x => x.slug === s.slug)) all.push(s);
  }

  // Build-time graph fetch (Stage 3): pull the full graph ONCE and pre-compute
  // the per-slug adjacency map so each skill page doesn't fire its own fetch
  // (which would 80x the build time and trip the rate limiter).
  const graphRes = await fetchApi<{
    nodes: { slug: string; title: string; category: string; tier: string; install_count: number }[];
    edges: { source: string; target: string; weight: number }[];
  }>('/api/skills/graph', { authed: false });
  const nodesBySlug = new Map<string, any>();
  if (graphRes.ok && graphRes.data) {
    for (const n of graphRes.data.nodes) nodesBySlug.set(n.slug, n);
  }
  const adjacency = new Map<string, { slug: string; weight: number }[]>();
  if (graphRes.ok && graphRes.data) {
    for (const e of graphRes.data.edges) {
      (adjacency.get(e.source) ?? adjacency.set(e.source, []).get(e.source)!).push({ slug: e.target, weight: e.weight });
      (adjacency.get(e.target) ?? adjacency.set(e.target, []).get(e.target)!).push({ slug: e.source, weight: e.weight });
    }
    // Sort each adjacency list by weight desc
    for (const list of adjacency.values()) list.sort((a, b) => b.weight - a.weight);
  }

  return all.map(skill => {
    const neighbours = (adjacency.get(skill.slug) || []).slice(0, 12);
    const related = neighbours
      .map(({ slug }) => nodesBySlug.get(slug))
      .filter(Boolean);
    return {
      params: { slug: skill.slug },
      props: {
        initialSkill: skill,
        related,
      },
    };
  });
}

const { slug } = Astro.params;
const { initialSkill, related: relatedFromBuild } = Astro.props;

let skill: any = initialSkill;
// quality_1705 Phase B — paywall the static build.
// We deliberately fetch WITHOUT the master API key so the static HTML never
// bakes the readme body into the page. The body is fetched client-side via
// the user's session token if they are Pro/Pro+.
const detail = await fetchApi<any>(`/api/skills/${slug}`, { authed: false });
if (detail.ok && detail.data) {
  skill = { ...initialSkill, ...detail.data };
}

// Stage 3 (G17) related-skills rail. Data already fetched in getStaticPaths
// (one graph dump for the whole build) and passed via props.
interface RelatedSkill {
  slug: string; title: string; category?: string | null; tier?: string | null;
}
const related: RelatedSkill[] = (relatedFromBuild as RelatedSkill[]) || [];

// Mark which related-rail entries were author-declared (Stage 1) vs derived (Stage 2)
// — the per-skill /api/skills/{slug}/graph endpoint exposes this distinction at
// runtime (skill.related field). Use it when present, fall back to an empty set.
const declaredSlugs = new Set<string>(
  ((skill?.related || []) as { slug: string }[]).map((s) => s.slug),
);

// Repo URL mapping — all free skills live in awesome-agent-recipes monorepo
const REPO_BASE = 'https://github.com/wisechef-ai/awesome-agent-recipes';
const monorepoSkills = ['client-reporter', 'web-scraper', 'web-scraper-pro', 'email-composer', 'standup-bot', 'onboarding-wizard', 'invoice-automator', 'gohighlevel-cli'];
const repoMap: Record<string, string> = Object.fromEntries(
  monorepoSkills.map(s => [s, `${REPO_BASE}/tree/main/skills/${s.replace(/-pro$/, '')}`])
);
const repoUrl = repoMap[slug as string] || null;

const fallbackBySlug: Record<string, any> = {
  'client-reporter': {
    title: 'Client Reporter',
    tagline: 'Replaces 4h/week of manual client reporting',
    tier: 'free',
    description: 'Pull GA4, Google Search Console, Meta Ads, and TikTok Ads data for any client and generate a branded PDF report. White-label-ready.',
    license: 'MIT',
    requires_env: ['GA4_PROPERTY_ID', 'GSC_SITE', 'META_ADS_ACCOUNT_ID', 'TIKTOK_ADS_ACCOUNT_ID', 'OPENAI_API_KEY'],
    icon: 'chart',
  },
  'larry': {
    title: 'Larry',
    tagline: 'Autonomous TikTok slideshow marketing — generate, post, learn, iterate.',
    tier: 'pro',
    description: 'Onboarding, browser-based competitor research, AI image generation (gpt-image-1.5 / Stability / Replicate / local), text overlays, Postiz multi-platform posting, and a daily analytics feedback loop that flags winning hooks and drops dead ones. Optional RevenueCat conversion attribution.',
    license: 'MIT',
    requires_env: ['POSTIZ_BASE_URL', 'POSTIZ_API_KEY', 'OPENAI_API_KEY'],
    icon: 'lightning',
  },
};

const tagline = skill?.tagline || fallbackBySlug[slug as string]?.tagline || '';
const f = fallbackBySlug[slug as string] || {};

const display = {
  slug,
  title: skill?.title || f.title || (slug as string).replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()),
  tagline,
  tier: skill?.tier || f.tier || 'pro',
  description: skill?.description || f.description || 'A LoopSkill skill.',
  install_count: skill?.install_count_total ?? skill?.install_count ?? 0,
  install_count_7d: skill?.install_count_7d ?? 0,
  rating: skill?.rating ?? null,
  version: skill?.latest_version || skill?.version || '0.1.0',
  // polish_1805 item 4 — author identity. Falls back to a brand name when
  // creator_name is null. creator_handle + creator_url are populated by the
  // recipes-api Phase B migration (alembic abc123…); when present they
  // render as a clickable "by <name> @<handle>" block.
  author: skill?.creator_name || skill?.author || 'WiseChef',
  author_handle: skill?.creator_handle || null,
  author_url: skill?.creator_url || null,
  repo_url: repoUrl,
  requires_env: skill?.requires_env || f.requires_env || [],
  category: skill?.category || 'general',
  license: skill?.license || f.license || null,
  readme: skill?.readme || null,
  versions: skill?.versions || [],
  // Trust pills sources (polish_1805 item 9 — all real signals, no static decoration)
  quality_score: typeof skill?.quality_score === 'number' ? skill.quality_score : null,
  last_verified: skill?.last_verified || null,
  tarball_size_bytes: (skill?.versions && skill.versions.length > 0)
    ? (skill.versions[0]?.tarball_size_bytes ?? null)
    : null,
  // Audit metadata (Phase B): these may be absent until the audit-backfill script
  // (scripts/backfill_audit_metadata.py) populates them via PATCH /api/skills/{slug}/audit.
  source_url: skill?.source_url || skill?.audit?.source_url || repoUrl || null,
  sha256: skill?.sha256 || skill?.checksum_sha256 || skill?.audit?.sha256 || null,
  last_reviewed_at: skill?.last_reviewed_at || skill?.audit?.last_reviewed_at || null,
};

// Phase Q: Server-side readme render removed — FileRenderer handles rendering client-side.

const tierBadgeClassName = tierBadgeClass(display.tier);
const tierDisplayText = tierBadgeText(display.tier);
const isFree = display.tier === 'free';

// Phase A: skill_variant + external_resources
const skillVariant: string = skill?.skill_variant || '';
const isOriginalVariant = skillVariant === 'original';
const originalSourceUrl: string | null = skill?.original_source_url || null;
const externalResources: Array<{ slug?: string; url: string; relation?: string; description?: string }> =
  Array.isArray(skill?.external_resources) ? skill.external_resources : [];

// JSON-LD: SoftwareApplication with interactionStatistic (real install_count).
// install_count comes from the API response (Skill.install_count_total backed
// by the denormalised counter updated on every install telemetry event).
// We emit interactionStatistic only when the count is ≥ 1 so we never write
// a zero-install UserInteractionCount into search-engine markup.
// aggregateRating is intentionally omitted — there is no review/rating source
// and fabricating one would violate schema.org guidelines and risk penalties.
const siteURL = 'https://app.loopskill.io';
const skillSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: display.title,
  description: display.description,
  url: `${siteURL}/skills/${display.slug}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: display.tier === 'free' ? '0' : '20',
    priceCurrency: 'USD',
    url: display.tier === 'free'
      ? `${siteURL}/skills/${display.slug}`
      : `${siteURL}/pricing`,
  },
  ...(display.install_count >= 1 ? {
    interactionStatistic: {
      '@type': 'InteractionCounter',
      interactionType: 'https://schema.org/DownloadAction',
      userInteractionCount: display.install_count,
    },
  } : {}),
};
---

<AppShell title={`${display.title} — LoopSkill`} description={display.description} mode="public" active="search">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(skillSchema)}></script>
  </Fragment>
  <section class="max-w-6xl mx-auto px-6 pt-12 pb-12">
    <a href="/skills" class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition mb-8">
      <Icon name="chevron-left" size={12} />
      All skills
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Main -->
      <div class="lg:col-span-2 flex flex-col gap-8">
        <header class="flex flex-col gap-3">
          <div class="flex items-center gap-2 flex-wrap">
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider ${tierBadgeClassName}`}>
              {tierDisplayText}
            </span>
            {isOriginalVariant && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider border border-border-soft text-muted-soft bg-bg-card">
                Original
                {originalSourceUrl && (
                  <a href={originalSourceUrl} target="_blank" rel="noopener" class="hover:text-accent transition">↗</a>
                )}
              </span>
            )}
            <span class="text-[10px] text-muted-soft uppercase tracking-wider">{display.category}</span>
            <span class="text-[10px] text-muted-soft font-mono">v{display.version}</span>
            {display.license && <span class="text-[10px] text-muted-soft uppercase tracking-wider">· {display.license}</span>}
            {/* polish_1805 item 7 — install count badge. Real signal from
                Skill.install_count (backfilled from telemetry_events by
                scripts/backfill_install_count.py). Renders only when >= 1
                so we never show a "0 installs" badge of shame. For brand-new
                skills (< 7 days old AND zero installs) the badge becomes "New" instead. */}
            {display.install_count >= 1 ? (
              <span class="inline-flex items-center gap-1 text-[10px] text-muted font-medium" data-install-badge title="Total installs since publish (telemetry-backed)">
                <svg width="9" height="9" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M8 2v9M8 11l3-3M8 11L5 8" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M2 13h12" stroke-linecap="round" />
                </svg>
                {display.install_count.toLocaleString()} install{display.install_count === 1 ? '' : 's'}
                {display.install_count_7d > 0 && (
                  <span class="text-success ml-1" title="Installs in the last 7 days">· +{display.install_count_7d}/wk</span>
                )}
              </span>
            ) : (
              <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[9px] font-semibold tracking-wider bg-accent/10 text-accent border border-accent/20" data-install-badge="new" title="Published recently, no install telemetry yet">
                NEW
              </span>
            )}
          </div>
          <h1 class="text-3xl md:text-5xl font-bold tracking-tight" style="letter-spacing: -0.03em;">{display.title}</h1>
          {/* polish_1805 item 4 — author identity. Renders as "by <Author>"
              with an optional X/GitHub link when creator_handle / creator_url
              are populated. Falls back to plain "by WiseChef" for skills the
              backfill cron hasn't reached yet (no broken state). */}
          <p class="text-xs text-muted-soft inline-flex items-center gap-1.5" data-author-block>
            <span>by</span>
            {display.author_url ? (
              <a href={display.author_url} target="_blank" rel="noopener" class="text-muted hover:text-accent transition font-medium">{display.author}</a>
            ) : (
              <span class="text-muted font-medium">{display.author}</span>
            )}
            {display.author_handle && (
              <a href={display.author_url || `https://x.com/${display.author_handle.replace(/^@/, '')}`}
                 target="_blank" rel="noopener"
                 class="text-muted-soft hover:text-accent transition">
                @{display.author_handle.replace(/^@/, '')}
              </a>
            )}
          </p>
          {display.tagline && <p class="text-lg md:text-xl text-muted">{display.tagline}</p>}
          <p class="text-text leading-relaxed mt-2">{display.description}</p>

          {/* polish_1805 item 9 — trust pills sourced from REAL signals only.
              quality_score, unhappy_paths count (read from readme YAML at build),
              last_verified freshness, tarball size, install count. Each pill is
              dropped if its signal is missing/zero — no placeholder decoration. */}
          <div class="mt-2">
            <TrustPills
              quality_score={display.quality_score}
              readme={display.readme}
              tarball_size_bytes={display.tarball_size_bytes}
              last_verified={display.last_verified}
              install_count={display.install_count}
            />
          </div>
        </header>

        <!-- Audit row (Phase B trust) — provenance + integrity above install -->
        <AuditRow
          source_url={display.source_url}
          sha256={display.sha256}
          last_reviewed_at={display.last_reviewed_at}
        />

        <!-- Quick install banner -->
        <div class="bg-[#0d0d0d] border border-border rounded-xl p-5 flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <Icon name="terminal" size={14} class="text-accent" />
            <p class="eyebrow">Install in your agent</p>
          </div>
          <div class="font-mono text-xs text-muted leading-relaxed mb-3">
            <span class="text-success">→</span> First time? Tell your agent: <span class="text-accent">"install the loopskill skill from app.loopskill.io/skill"</span> — then the lines below add this skill.
          </div>
          {/* portal_0610 J5 — omnipresent ?ref-attributed quick-install (real motions only). */}
          <QuickInstall kind="skill" slug={display.slug} ref="skill-page" />
        </div>

        <!-- Auth-aware install gate (WIS-647) — hidden by default, populated by client-side script -->
        <div id="install-auth-gate" data-skill-slug={display.slug} data-skill-tier={display.tier} class="hidden bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Your install command</p>

          <!-- State A: not authed -->
          <div data-state="anon" class="hidden">
            <p class="text-sm text-muted mb-3">Sign in to get your API key and the personalized install command.</p>
            <a id="install-signin-link" href="/signin" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              Sign in to install →
            </a>
          </div>

          <!-- State B: authed, tier insufficient -->
          <div data-state="locked" class="hidden">
            <p class="text-sm text-muted mb-3">This skill requires <span data-required-tier class="text-accent font-semibold">Pro</span>. Upgrade to install.</p>
            <a href="/pricing" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition">
              See plans →
            </a>
          </div>

          <!-- State C: authed + tier OK — show install command -->
          <div data-state="ready" class="hidden">
            <p class="text-sm text-muted mb-3">Copy and paste into your agent's environment:</p>
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <code class="font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2 flex-1">export RECIPES_API_KEY=<span data-key-prefix>rec_live_…</span></code>
                <a href="/library" class="text-xs text-accent hover:opacity-80 underline shrink-0">Get key →</a>
              </div>
              <code class="block font-mono text-xs bg-bg-elev border border-border rounded px-3 py-2">loopskill install <span data-skill-slug-display>{display.slug}</span></code>
            </div>
            <p class="text-[11px] text-muted-soft mt-3">First time? <a href="/library" class="text-accent hover:opacity-80 underline">Generate your API key</a> on the Library page.</p>
          </div>

          <div data-state="loading" class="text-xs text-muted">Checking…</div>
        </div>

        <!-- Required environment variables -->
        {display.requires_env && display.requires_env.length > 0 && (
          <section class="bg-bg-card border border-border rounded-2xl p-6">
            <div class="flex items-center gap-2 mb-3">
              <Icon name="shield" size={14} class="text-success" />
              <p class="eyebrow">Required environment variables</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {display.requires_env.map((env: string) => (
                <code class="text-xs bg-[#0d0d0d] border border-border rounded-lg px-2.5 py-1 text-accent-soft font-mono">{env}</code>
              ))}
            </div>
            <p class="text-xs text-muted-soft mt-3">These stay on your machine. LoopSkill never sees them.</p>
          </section>
        )}

        <!-- Phase Q: File explorer (SKILL.md + scripts/ + references/ + templates/)
             client:visible = lazy hydration — only boots when scrolled into view.
             SkillFileExplorer owns shared selectedPath state between FileBrowser + FileRenderer. -->
        <section
          class="bg-bg-card border border-border rounded-2xl overflow-hidden"
          data-skill-body-section
          data-slug={display.slug}
          data-is-free={isFree ? '1' : '0'}
        >
          <div class="flex items-center justify-between gap-3 px-5 py-3 border-b border-border-soft flex-wrap">
            <div class="flex items-center gap-2">
              <Icon name="document" size={14} class="text-accent" />
              <p class="eyebrow">Skill files</p>
            </div>
            {display.repo_url && (
              <a href={display.repo_url} target="_blank" rel="noopener" class="text-xs text-muted hover:text-accent inline-flex items-center gap-1.5 transition">
                <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.4c-2.23.48-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.66 3.96.29.25.55.74.55 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg>
                View on GitHub
              </a>
            )}
          </div>
          <!-- React island: lazy-hydrated via client:visible (only boots when scrolled into view) -->
          <SkillFileExplorer
            slug={display.slug}
            defaultPath="SKILL.md"
            skillTier={display.tier}
            client:visible
          />
        </section>
      </div>

      <!-- Sidebar (right rail) -->
      <aside class="flex flex-col gap-4">
        <div class="bg-bg-card border border-border rounded-2xl p-5 flex flex-col gap-4 sticky top-20">
          {isFree ? (
            <a href="/docs/install"
               class="block text-center px-4 py-2.5 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
              Install free
            </a>
          ) : (
            <a href="/pricing"
               class="block text-center px-4 py-2.5 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition glow-amber">
              Subscribe to install
            </a>
          )}
          <div class="text-[11px] text-muted-soft text-center">
            {isFree ? 'Free forever. No subscription required.' : `Requires ${display.tier} subscription`}
          </div>
          <!-- fedui_0604 Unit C — save this catalog skill to a bundle -->
          <div class="pt-3 border-t border-border-soft flex justify-center">
            <AddToCookbook slug={display.slug} size="md" class="w-full" />
          </div>
        </div>

        <!-- Audit bars (Phase Q) — 4 horizontal bars showing quality dimensions.
             client:visible so they lazy-hydrate when the sidebar scrolls into view. -->
        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Skill audit</p>
          <AuditBars
            qualityScore={display.quality_score}
            hasReadme={Boolean(display.readme)}
            lastVerifiedAt={display.last_verified}
            sourceUrl={display.source_url}
            client:visible
          />
        </div>

        <!-- Runtime panel (Phase Q) — fetches /runtime + /install-events client-side.
             client:visible so the fetch only fires when the panel is visible. -->
        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Runtime</p>
          <RuntimePanel slug={display.slug} client:visible />
        </div>

        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <p class="eyebrow mb-3">Details</p>
          <dl class="text-sm flex flex-col gap-3">
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Author</dt>
              <dd class="text-text text-right">{display.author}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Version</dt>
              <dd class="text-text font-mono text-xs">{display.version}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Tier</dt>
              <dd class="text-text capitalize">{display.tier}</dd>
            </div>
            {display.license && (
              <div class="flex justify-between gap-2">
                <dt class="text-muted">License</dt>
                <dd class="text-text">{display.license}</dd>
              </div>
            )}
            <div class="flex justify-between gap-2">
              <dt class="text-muted">Installs</dt>
