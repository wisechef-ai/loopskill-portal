---
import AppShell from '../../layouts/AppShell.astro';
import CrossSell from '../../components/CrossSell.astro';
import Icon from '../../components/Icon.astro';
import AddToCookbookScript from '../../components/AddToCookbookScript.astro';
import SkillCover from '../../components/SkillCover.astro';
import { fetchApi } from '../../lib/api';
import { VERTICALS, skillVertical } from '../../lib/verticals';
import { tierBadge as tierBadgeText, tierBadgeClass } from '../../lib/tiers';

const result = await fetchApi<{ results: any[]; total: number }>(
  '/api/skills/search?page_size=100',
);
let pageOne: any[] = [];
let total = 0;
let fetchError: string | null = null;
if (result.ok && result.data) {
  pageOne = result.data.results || [];
  total = result.data.total || pageOne.length;
} else {
  fetchError = result.error;
}

// Pagination: walk additional pages serially so we keep the rate limiter happy.
let skills = [...pageOne];
if (pageOne.length === 100 && total > 100) {
  const lastPage = Math.ceil(total / 100);
  for (let p = 2; p <= lastPage; p++) {
    const r = await fetchApi<{ results: any[] }>(
      `/api/skills/search?page_size=100&page=${p}`,
    );
    if (r.ok && r.data?.results) {
      skills = skills.concat(r.data.results);
    } else {
      break;
    }
  }
}

if (skills.length === 0) {
  skills = [
    { slug: 'super-memory', title: 'Super Memory', description: 'Persistent memory for any AI agent — cognee + Postgres + pgvector. The free way in.', category: 'automation', tier: 'free', install_count_total: 0, install_count_7d: 0 },
  ];
  total = 1;
}

// Tag every skill with a vertical (server-side classification when the
// API hasn't backfilled the column yet). Used for the new vertical pills.
for (const s of skills) {
  s.__vertical = skillVertical(s);
}

const categories = Array.from(new Set(skills.map(s => s.category || 'general'))).filter(Boolean).sort();

// fedui_0604 Unit B — build-time honest community (federation) count for the
// header dual-count. Sum per_source.indexed across available sources; omit any
// source whose indexed is null (never fabricate). This is the INDEXED teaser,
// not a conflated "installable" number.
let communityIndexed = 0;
let communitySources = 0;
const fed = await fetchApi<{
  per_source: Record<string, { indexed: number | null }>;
}>('/api/skills/external', { authed: false });
if (fed.ok && fed.data?.per_source) {
  for (const meta of Object.values(fed.data.per_source)) {
    if (meta && typeof meta.indexed === 'number' && meta.indexed > 0) {
      communityIndexed += meta.indexed;
      communitySources += 1;
    }
  }
}

// fedui_0604 superset fix — render the community superset AT REST.
// The previous build only showed curated cards on cold load; the community
// section was `hidden` and only revealed by the q>=2 search handler, so a
// first-time visitor (and any curl of the static HTML) saw curated-only.
// Here we fetch the first page of the federation browse seam at BUILD time
// (public/unauthed, all live sources, empty query = browse) and render those
// cards server-side beneath the curated grid. Bounded teaser: the limit is
// per-source so a handful of sources yields a sane payload; the full firehose
// stays one click away at /skills/external.
const COMMUNITY_SOURCES = 'hermes-hub,skills-sh,well-known,clawhub,lobehub,browse-sh,github-oss';
const COMMUNITY_LIMIT = 50; // per-source cap (route now allows up to 100)
const COMMUNITY_INITIAL_VISIBLE = 24; // cards shown before "show more"
let communitySkills: any[] = [];
// Try the broad federated set first (best case = many sources). The per-query
// live sources (clawhub/lobehub/browse-sh/github-oss) make real outbound HTTP
// from the API and can return [] under build-time concurrency, so give this a
// generous timeout. NOTE: at build time ~127 pages fetch concurrently and the
// API rate-limits at 60 req/min — this call WILL hit 429 storms, so it needs
// many attempts with a high backoff cap to outlast the build's fetch burst
// (build-time only; latency here is irrelevant to end users).
const fedBrowse = await fetchApi<{ external: any[] }>(
  `/api/skills/external?sources=${COMMUNITY_SOURCES}&limit=${COMMUNITY_LIMIT}`,
  { authed: false, timeoutMs: 30000, maxAttempts: 12, initialDelayMs: 800, maxDelayMs: 20000 },
);
if (fedBrowse.ok && fedBrowse.data?.external) {
  communitySkills = fedBrowse.data.external || [];
}
// Guaranteed floor: hermes-hub is the CHEAP, CACHED catalog (always fast,
// always non-empty). If the broad firehose came back empty at build time,
// fall back to it so the at-rest superset is NEVER blank. The client-side
// search still spans the full firehose regardless.
if (communitySkills.length === 0) {
  const fedFloor = await fetchApi<{ external: any[] }>(
    `/api/skills/external?sources=hermes-hub&limit=${COMMUNITY_LIMIT}`,
    { authed: false, timeoutMs: 30000, maxAttempts: 12, initialDelayMs: 800, maxDelayMs: 20000 },
  );
  if (fedFloor.ok && fedFloor.data?.external) {
    communitySkills = fedFloor.data.external || [];
  }
}

// ─── Federation rails — marquee sources (WIS-737 pattern) ──────────────────
// Build-time fetch with try/catch — the build NEVER fails on API error.
// 4 marquee sources → 4 horizontal-scroll SkillCover rails surfaced above the
// curated catalog. If the fetch returns 0 results, the entire rails block is
// simply omitted; the curated catalog and existing community-section still render.
// DO NOT fetch user/auth data here — frontmatter runs at build time (Trap B).
type ExtRailSkill = {
  slug: string;
  title?: string;
  source?: string;
  description?: string;
  category?: string;
  origin_url?: string;
};
const RAIL_DEFS = [
  { source: 'github-anthropic', label: 'From Anthropic' },
  { source: 'github-openai',    label: 'From OpenAI' },
  { source: 'clawhub',          label: 'Trending on ClawHub' },
  { source: 'skills-sh',        label: 'From skills.sh' },
] as const;
const fedRailMap: Record<string, ExtRailSkill[]> = {};
try {
  const railSrcCsv = RAIL_DEFS.map(r => r.source).join(',');
  const fedRailRes = await fetchApi<{ external: ExtRailSkill[] }>(
    `/api/skills/external?sources=${railSrcCsv}&limit=48`,
    { authed: false, timeoutMs: 30000, maxAttempts: 8, initialDelayMs: 600, maxDelayMs: 15000 },
  );
  if (fedRailRes.ok && fedRailRes.data?.external) {
    for (const row of fedRailRes.data.external) {
      if (!row.source) continue;
      if (!fedRailMap[row.source]) fedRailMap[row.source] = [];
      if (fedRailMap[row.source].length < 12) fedRailMap[row.source].push(row);
    }
  }
} catch {} // WIS-737: API unavailable at build time → fedRailMap stays {}; build succeeds

// Phase 5 (RCP-INCIDENT-2026-05-11): 'pro' and 'pro_plus' are the canonical slugs.
// Canonical tier slugs only. Legacy aliases (cook/operator/studio) are
// normalized to these via canonicalTier() so the filter shows ONE chip per
// real tier (no duplicate "Pro"). RCP-INCIDENT-2026-05-11 shim collapse.
const tiers = ['free', 'pro', 'pro_plus'];

// Collapse any legacy alias to its canonical slug.
function canonicalTier(t: string | null | undefined): string {
  const s = (t || 'pro').toLowerCase();
  if (s === 'free') return 'free';
  if (s === 'pro_plus' || s === 'operator' || s === 'studio') return 'pro_plus';
  return 'pro';  // pro, cook + anything unknown
}

const TIER_LABEL: Record<string, string> = {
  free: 'Free',
  pro: 'Pro · $9.95/mo',
  pro_plus: 'Pro+ (legacy)',
};
const tierCount: Record<string, number> = {};
for (const s of skills) {
  const t = canonicalTier(s.tier);  // collapse cook→pro etc. before counting
  tierCount[t] = (tierCount[t] || 0) + 1;
}

// Subset filter — maps skill_variant to subset names
// variant=original → pantry, variant=custom → menu, bundle handled client-side
const subsets = ['pantry', 'menu', 'cookbook'] as const;
const subsetLabel: Record<string, string> = {
  pantry: 'Pantry',
  menu: 'Menu',
  bundle: 'Bundle',
};

// Derive subset from skill_variant
function skillSubset(s: any): string {
  if (s.skill_variant === 'original') return 'pantry';
  if (s.skill_variant === 'custom') return 'menu';
  return 'menu'; // default for unlabeled skills
}
for (const s of skills) {
  s.__subset = skillSubset(s);
}
const subsetCount: Record<string, number> = {};
for (const s of skills) {
  const sub = s.__subset;
  subsetCount[sub] = (subsetCount[sub] || 0) + 1;
}
---

<AppShell title="Skills — LoopSkill" description="Browse the full catalog. Production-grade skills for AI integrators and operators. Free Super Memory to start." mode="public" active="search">
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div class="flex flex-col gap-2">
        <p class="eyebrow">Catalog</p>
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight" id="skills-heading">{total} curated skills + the whole ecosystem.</h1>
        <p class="text-muted">Production-grade skills for AI integrators, solo operators, and agent fleets. Free to self-host the whole platform (MPL-2.0). Pro ($9.95/mo) is the fully-hosted registry + managed runner — convenience, never a feature gate.</p>
        {fetchError && <p class="text-xs text-muted-soft">(showing seed data — API: {fetchError})</p>}
        {/* fedui_0604 Unit B + rail-rework: dual count made prominent — the 84k+
            community number is the product's biggest differentiator; show it as
            a badge CTA, not buried muted text. Counts remain honest (never fabricated). */}
        <div class="flex flex-wrap items-center gap-3 mt-2">
          <a
            href="/skills/external"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-accent/40 bg-accent/5 text-xs font-semibold text-accent hover:border-accent hover:bg-accent/10 transition"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
            {communityIndexed > 0
              ? `${communityIndexed.toLocaleString()}+ community skills · ${communitySources} registries`
              : '84,000+ community skills · 13 registries'}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <span class="text-[11px] text-muted-soft">Federation rails below · curated core further down</span>
        </div>
      </div>
    </div>

    {/* ─── FEDERATION RAILS ───────────────────────────────────────────────────
        These are surfaced ABOVE the curated catalog because 84,000+ federated
        skills across 13 registries is the product's biggest differentiator.
        Each rail = horizontal scroll row using SkillCover (same Spotify-shelf
        pattern as the homepage). Falls back to omitting the rail section when
        no skills were fetched (WIS-737-safe). External cards link to origin_url
        (target=_blank) matching the view-source fallback in the community section
        (line 661+ resolveSourceLink pattern), or /skills/external when no URL. */}
    {RAIL_DEFS.some(r => (fedRailMap[r.source]?.length ?? 0) > 0) && (
      <div class="mb-12">
        {/* Section header — same style as homepage 'Popular skills' rail header */}
        <div class="flex items-center justify-between mb-5">
          <div>
            <p class="text-[10px] font-semibold uppercase tracking-widest text-muted-soft mb-1">Community · Federation</p>
            <h2 class="text-xl font-semibold tracking-tight text-text">
              {communityIndexed > 0
                ? `${communityIndexed.toLocaleString()}+ skills across ${communitySources} registries`
                : '84,000+ skills across 13 registries'}
            </h2>
          </div>
          <a href="/skills/external" class="text-xs text-accent hover:opacity-80 shrink-0">Browse all →</a>
        </div>

        {RAIL_DEFS.map(railDef => {
          const railSkills = fedRailMap[railDef.source] ?? [];
          if (railSkills.length === 0) return null;
          return (
            <div class="mb-8">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-sm font-semibold uppercase tracking-widest text-muted-soft">{railDef.label}</h3>
                <a href="/skills/external" class="text-[11px] text-accent hover:opacity-80">More →</a>
              </div>
              <div class="flex gap-3 overflow-x-auto pb-2 -mx-1 px-1 snap-x">
                {railSkills.map((s: ExtRailSkill) => {
                  // Link: use origin_url (opens externally, matches resolveSourceLink
                  // fallback at line 673+). Fall back to /skills/external when none.
                  const href = s.origin_url || '/skills/external';
                  const isExternal = !!s.origin_url;
                  return (
                    <a
                      href={href}
                      class="skill-rail-card group shrink-0 w-[140px] sm:w-[160px] snap-start"
                      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      <SkillCover
                        slug={s.slug}
                        title={s.title}
                        category={s.category}
                        tier="free"
                        source={s.source}
                      />
                      <div class="mt-2 px-0.5">
                        <p class="text-sm font-semibold text-text group-hover:text-accent transition truncate">{s.title || s.slug}</p>
                        <p class="text-[11px] text-muted-soft capitalize truncate">{s.source}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          );
        })}

        <div class="h-px bg-border-soft mb-12"></div>
      </div>
    )}

    {/* A4 (rev 7.2): super-memory featured card — open-source pro_open gateway skill.
        MIT-licensed, install in 60s, hands-off agent memory stack. Drives trust by
        showing a fully OSS pro-tier-grade skill anyone can install today. */}
    <a
      href="/skills/super-memory"
      class="block mb-8 group rounded-2xl border-2 border-accent/40 hover:border-accent transition-all bg-gradient-to-br from-bg-card via-bg-card to-accent/10 p-6 md:p-7 relative overflow-hidden"
      data-featured="super-memory"
    >
      <div class="absolute top-3 right-3 flex items-center gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-accent text-bg">
          ⭐ Featured · Open Source
        </span>
      </div>
      <div class="flex flex-col md:flex-row gap-5 md:items-center">
        <div class="flex-1 flex flex-col gap-2">
          <div class="flex items-center gap-3 flex-wrap">
            <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-text group-hover:text-accent transition">
              super-memory
            </h2>
            <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-bg-card border border-border text-muted-soft">
              MIT · INSTALL IN 60s
            </span>
          </div>
          <p class="text-muted leading-relaxed">
            One-command installer for the full agent memory stack: cognee + Postgres + pgvector + cross-session recall.
            Open source, no signup, no API key. The pro_open gateway — install it free, see if LoopSkill is for you,
            then upgrade to Pro for the rest of the catalog.
          </p>
          <div class="flex items-center gap-4 mt-1 text-xs text-muted-soft">
            <span class="flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6"/>
              </svg>
              <code class="font-mono text-text">curl -fsSL app.loopskill.io/i/super-memory | bash</code>
            </span>
          </div>
        </div>
        <div class="md:flex-shrink-0 flex items-center gap-3 text-xs text-muted-soft">
          <div class="text-right">
            <div class="text-3xl font-mono text-accent leading-none">$0</div>
            <div class="mt-1">forever · MIT license</div>
          </div>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent group-hover:translate-x-1 transition">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </div>
      </div>
    </a>

    {/* Vertical pills — link out to the 6 vertical landing pages */}
    <div class="flex flex-wrap gap-2 items-center mb-4">
      <span class="text-[10px] uppercase tracking-wider text-muted-soft">Vertical:</span>
      <button data-vert-filter="all" class="vert-pill text-[11px] px-2.5 py-1 rounded-full border border-accent text-accent bg-accent/10 transition inline-flex items-center gap-1.5">All</button>
      {VERTICALS.map(v => (
        <button data-vert-filter={v.slug} class="vert-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition inline-flex items-center gap-1.5">
          <Icon name={v.icon as any} size={10} />
          {v.label}
        </button>
      ))}
    </div>

    {/* Tier + search filter row */}
    <div class="flex flex-col gap-3 mb-6">
      {/* Subset filter chips — Pantry / Menu / Bundle */}
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[10px] uppercase tracking-wider text-muted-soft">Subset:</span>
        <button data-subset-filter="all" class="subset-pill text-[11px] px-2.5 py-1 rounded-full border border-accent text-accent bg-accent/10 transition">All</button>
        {subsets.filter(s => subsetCount[s]).map(s => (
          <button data-subset-filter={s} class="subset-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition capitalize">
            {subsetLabel[s]} · {subsetCount[s]}
          </button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <input
          id="skill-search"
          type="search"
          placeholder="Search all skills — curated + community…"
          class="px-4 py-2 rounded-lg bg-bg-card border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition flex-1 min-w-[180px] max-w-md"
        />
        <button data-tier-filter="all" class="tier-pill text-xs px-3 py-1.5 rounded-full border border-accent text-accent bg-accent/10 transition">All · {total}</button>
        {tiers.filter(t => tierCount[t]).map(t => (
          <button data-tier-filter={t} class="tier-pill text-xs px-3 py-1.5 rounded-full border border-border text-muted hover:border-muted hover:text-text transition">
            {TIER_LABEL[t] ?? t} · {tierCount[t]}
          </button>
        ))}
      </div>
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-[10px] uppercase tracking-wider text-muted-soft">Category:</span>
        <button data-cat-filter="all" class="cat-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition active-cat" style="border-color:var(--accent);color:var(--accent)">All</button>
        {categories.map(c => (
          <button data-cat-filter={c} class="cat-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition capitalize">{c}</button>
        ))}
      </div>
    </div>

    <div id="skill-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {skills.map(s => {
        const tier = canonicalTier(s.tier);  // normalize so the canonical Pro chip matches cook cards
        const tierClass = tierBadgeClass(tier);
        const tierDisplay = tierBadgeText(tier);
        const cat = s.category || 'general';
        const isOriginal = s.skill_variant === 'original';
        const extRes: any[] = Array.isArray(s.external_resources) ? s.external_resources : [];
        return (
          <a
            href={`/skills/${s.slug}`}
            class="skill-card group bg-bg-card border border-border rounded-2xl p-5 card-lift flex flex-col gap-3"
            data-tier={tier}
            data-category={cat}
            data-vertical={s.__vertical}
            data-subset={s.__subset}
            data-search={`${s.title} ${s.description} ${s.slug} ${cat}`.toLowerCase()}
          >
            <div class="flex items-start justify-between gap-2 flex-wrap gap-y-1">
              <h3 class="text-base font-semibold text-text group-hover:text-accent transition leading-tight">{s.title}</h3>
              <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                {isOriginal && s.original_source_url ? (
                  <a
                    href={s.original_source_url}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider border border-border-soft text-muted-soft hover:text-accent transition"
                    onclick="event.stopPropagation()"
                  >
                    Original ↗
                  </a>
                ) : isOriginal ? (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider border border-border-soft text-muted-soft">Original</span>
                ) : null}
                <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider ${tierClass}`}>{tierDisplay}</span>
              </div>
            </div>
            <p class="text-sm text-muted leading-relaxed line-clamp-3">{s.description}</p>
            {extRes.length > 0 && (
              <details class="text-xs" onclick="event.stopPropagation()">
                <summary class="cursor-pointer text-muted-soft hover:text-text transition list-none flex items-center gap-1">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" class="transition-transform details-open:rotate-90"><path d="M3 2L7 5L3 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                  Related external ({extRes.length})
                </summary>
                <ul class="mt-2 flex flex-col gap-1.5 pl-1">
                  {extRes.map((r: any) => (
                    <li>
                      <a href={r.url} target="_blank" rel="noopener" class="text-accent hover:underline" onclick="event.stopPropagation()">{r.slug || r.url}</a>
                      {r.relation && <span class="text-muted-soft ml-1">· {r.relation}</span>}
                      {r.description && <p class="text-muted-soft mt-0.5">{r.description}</p>}
                    </li>
                  ))}
                </ul>
              </details>
            )}
            <div class="flex items-center justify-between pt-3 border-t border-border-soft text-xs">
              <span class="text-muted-soft capitalize">{cat}</span>
              {typeof s.install_count_total === 'number' && (
                <span class="text-muted-soft">{s.install_count_total.toLocaleString()} installs</span>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <p id="skill-empty" class="hidden text-center text-muted py-12">No skills match those filters. Try clearing them.</p>

    {/* fedui_0604 superset fix — unified community (federation) results,
        VISIBLE AT REST. The first page is fetched + rendered server-side
        (build time) so a cold load and a curl both show the superset; the
        client-side search re-fetches by query to span the full firehose.
        Visually demarcated + second-class ("community · as-is"); curated
        ALWAYS ranks above this block (it's rendered after #skill-grid). */}
    <div id="community-section" class="mt-12">
      <div class="flex items-center gap-3 mb-1">
        <div class="h-px flex-1 bg-border-soft"></div>
        <span class="text-[11px] uppercase tracking-wider text-amber-300 whitespace-nowrap">Community · as-is</span>
        <div class="h-px flex-1 bg-border-soft"></div>
      </div>
      <p class="text-center text-xs text-muted-soft mb-5">
        Federated from other hubs — not quality-gated.
        {communityIndexed > 0 && (
          <span id="community-count">{communityIndexed.toLocaleString()}+ indexed across {communitySources} source{communitySources === 1 ? '' : 's'}. </span>
        )}
        <a href="/skills/external" class="text-accent hover:underline">Browse all · advanced source filters →</a>
      </p>
      <div id="community-status" class="text-center py-6 text-sm text-muted hidden"></div>
      {/* portal_0610 J4 — SOURCE FACET. Federation is no longer scroll-only:
          filter the community grid by source so a user can scope to hermes-hub
          (the procedural class) vs lobehub (persona) etc. without scrolling. */}
      {communitySkills.length > 0 && (
        <div class="flex flex-wrap gap-2 items-center justify-center mb-5" id="community-source-facet">
          <span class="text-[10px] uppercase tracking-wider text-muted-soft">Source:</span>
          <button data-csrc-filter="all" class="csrc-pill text-[11px] px-2.5 py-1 rounded-full border border-accent text-accent bg-accent/10 transition">All</button>
          {Array.from(new Set(communitySkills.map((s: any) => s.source).filter(Boolean))).sort().map((src: any) => (
            <button data-csrc-filter={src} class="csrc-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition">{src}</button>
          ))}
        </div>
      )}
      {/* Server-rendered default community grid (visible at rest). The client
          search swaps this grid's innerHTML for query results and restores it
          on clear (defaultCommunity snapshot in the script below). */}
      <div id="community-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {communitySkills.map((s, i) => {
          const installable = s.install_path === 'fetch_origin' || s.install_path === 'register_mcp';
          // portal_0610 J4 / §6.5 DEFECT-2: honest license + two-class badge.
          const hasLicense = !!s.license;
          const licText = hasLicense ? s.license : 'license: none';
          const isProcedural = hasLicense && s.redistributable !== false && s.install_path === 'fetch_origin';
          const hiddenInit = i >= COMMUNITY_INITIAL_VISIBLE;
          return (
            <div
              class={`community-card bg-bg-card border border-border-soft rounded-2xl p-5 flex flex-col gap-2${hiddenInit ? ' hidden' : ''}`}
              data-community-card
              data-community-extra={hiddenInit ? 'true' : 'false'}
              data-source={s.source}
              data-search={`${s.title} ${s.description ?? ''} ${s.slug} ${s.source ?? ''}`.toLowerCase()}
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-base font-semibold text-text leading-tight">{s.title}</h3>
                <span class="text-[10px] uppercase tracking-wide text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5 whitespace-nowrap">{s.source}</span>
              </div>
              <p class="text-sm text-muted leading-relaxed line-clamp-3 flex-1">{s.description || 'No description.'}</p>
              <div class="flex items-center justify-between gap-2 pt-2 text-xs">
                <span class={hasLicense ? 'text-muted-soft' : 'text-amber-300/80'}>{licText}</span>
                {isProcedural ? (
                  <span class="text-[10px] uppercase tracking-wide text-emerald-400/90 bg-emerald-500/10 border border-emerald-500/25 rounded px-1.5 py-0.5">skill</span>
                ) : (
                  <span class="text-[10px] uppercase tracking-wide text-amber-300/80 bg-amber-500/10 border border-amber-500/25 rounded px-1.5 py-0.5">persona · as-is</span>
                )}
              </div>
              {installable ? (
                <a href="/skills/external" class="text-xs text-emerald-400 font-semibold mt-3 inline-block">● installable</a>
              ) : (
                <button type="button" class="view-source-btn text-xs text-accent hover:underline mt-3 inline-block" data-src={s.source} data-slug={s.slug} data-origin={s.origin_url || ''}>View source →</button>
              )}
              {installable && (
                <div class="atc-wrap relative inline-block mt-3" data-atc-root>
                  <button type="button" class="atc-btn inline-flex items-center gap-1.5 rounded-lg border border-border-soft text-text hover:border-accent hover:text-accent transition font-semibold px-3 py-1.5 text-xs" data-atc-slug={s.slug} data-atc-external={s.source} aria-haspopup="true" aria-expanded="false">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="atc-label">Add to bundle</span>
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="atc-caret transition-transform" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <div class="atc-menu hidden absolute right-0 z-30 mt-1 w-64 rounded-xl border border-border bg-bg-card shadow-xl p-1.5" role="menu">
                    <div class="atc-list flex flex-col gap-0.5 max-h-56 overflow-y-auto"></div>
                    <div class="atc-loading px-3 py-2 text-xs text-muted">Loading your bundles…</div>
                    <div class="atc-signin hidden px-3 py-3 text-xs text-muted"><a href="/signup" class="text-accent hover:underline font-semibold">Sign in</a> to save skills to a cookbook.</div>
                    <div class="atc-empty hidden px-3 py-2 text-xs text-muted">No bundles yet — create one below.</div>
                    <div class="atc-cap hidden px-3 py-2 text-xs text-amber-300">Skill cap reached. <a href="/pricing" class="text-accent hover:underline">Upgrade</a>.</div>
                    <div class="border-t border-border-soft mt-1 pt-1"><form class="atc-new flex items-center gap-1.5 px-1.5 py-1">
                      <input type="text" class="atc-new-name flex-1 rounded-md border border-border-soft bg-bg px-2 py-1 text-xs text-text placeholder:text-muted focus:border-accent focus:outline-none" placeholder="＋ New bundle…" maxlength="80"/>
                      <button type="submit" class="atc-new-btn rounded-md bg-accent text-bg text-xs font-semibold px-2.5 py-1 hover:opacity-90 transition">Add</button>
                    </form></div>
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
      {communitySkills.length === 0 && (
        <p class="text-center text-sm text-muted py-6">Community sources are quiet right now — <a href="/skills/external" class="text-accent hover:underline">browse external skills directly →</a></p>
      )}
      {communitySkills.length > COMMUNITY_INITIAL_VISIBLE && (
        <div class="text-center mt-6">
          <button id="community-more" type="button" class="text-xs px-4 py-2 rounded-full border border-border text-muted hover:border-accent hover:text-accent transition">
            Show more community skills ({communitySkills.length - COMMUNITY_INITIAL_VISIBLE} more) — or <a href="/skills/external" class="text-accent hover:underline">browse all {communityIndexed > 0 ? communityIndexed.toLocaleString() + '+' : ''} →</a>
          </button>
        </div>
      )}
    </div>
  </section>
  <AddToCookbookScript />
  <CrossSell />
</AppShell>

<script>
  // Client-side filter — operates on already-rendered cards. No new fetches.
  (() => {
    const cards = document.querySelectorAll<HTMLElement>('.skill-card');
    const heading = document.getElementById('skills-heading')!;
    const empty = document.getElementById('skill-empty')!;
    const search = document.getElementById('skill-search') as HTMLInputElement;
    const totalCount = cards.length;

    let activeTier = 'all';
    let activeCat = 'all';
    let activeVert = 'all';
    let activeSubset = 'all';
    let activeQuery = '';

    function apply() {
      let visible = 0;
      cards.forEach(c => {
        const t = c.dataset.tier;
        const cat = c.dataset.category;
        const vert = c.dataset.vertical;
        const subset = c.dataset.subset;
        const haystack = c.dataset.search ?? '';
        const matchTier = activeTier === 'all' || t === activeTier;
        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchVert = activeVert === 'all' || vert === activeVert;
        const matchSubset = activeSubset === 'all' || subset === activeSubset;
        const matchQ = activeQuery === '' || haystack.includes(activeQuery);
        const show = matchTier && matchCat && matchVert && matchSubset && matchQ;
        c.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      heading.textContent = visible === totalCount
        ? `${totalCount} curated skills + the whole ecosystem.`
        : `${visible} of ${totalCount} skills.`;
      empty.classList.toggle('hidden', visible > 0);
    }

    function setActivePill(group: string, value: string) {
      document.querySelectorAll<HTMLButtonElement>(`[data-${group}-filter]`).forEach(b => {
        const key = `${group}Filter` as keyof DOMStringMap;
        const isActive = b.dataset[key] === value;
        if (group === 'tier' || group === 'vert' || group === 'subset') {
          b.classList.toggle('border-accent', isActive);
          b.classList.toggle('text-accent', isActive);
          b.classList.toggle('bg-accent/10', isActive);
          b.classList.toggle('border-border', !isActive);
          b.classList.toggle('text-muted', !isActive);
        } else {
          if (isActive) {
            b.style.borderColor = 'var(--accent)';
            b.style.color = 'var(--accent)';
          } else {
            b.style.borderColor = '';
            b.style.color = '';
          }
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-tier-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeTier = btn.dataset.tierFilter ?? 'all';
        setActivePill('tier', activeTier);
        apply();
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.catFilter ?? 'all';
        setActivePill('cat', activeCat);
        apply();
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-vert-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeVert = btn.dataset.vertFilter ?? 'all';
        setActivePill('vert', activeVert);
        apply();
      });
    });
    document.querySelectorAll<HTMLButtonElement>('[data-subset-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeSubset = btn.dataset.subsetFilter ?? 'all';
        setActivePill('subset', activeSubset);
        apply();
      });
    });
    search?.addEventListener('input', () => {
      activeQuery = search.value.toLowerCase().trim();
      apply();
      queueCommunitySearch(search.value.trim());
    });

    // ── fedui_0604 Unit B — unified community (federation) search ─────────
    const API_BASE = (import.meta as any).env?.PUBLIC_RECIPES_API_BASE || 'https://app.loopskill.io';
    const ALL_SOURCES = 'hermes-hub,skills-sh,well-known,clawhub,lobehub,browse-sh,github-oss';
    const communitySection = document.getElementById('community-section');
    const communityGrid = document.getElementById('community-grid');
    const communityStatus = document.getElementById('community-status');
    const communityCount = document.getElementById('community-count');
    const communityMoreBtn = document.getElementById('community-more');
    let communityTimer: number | undefined;
    let communitySeq = 0;
    // fedui_0604 superset fix — snapshot the server-rendered default grid so
    // clearing the search restores the at-rest superset instead of an empty
    // grid. `defaultCommunity` is the canonical at-rest HTML.
    const defaultCommunity = communityGrid ? communityGrid.innerHTML : '';
    let communityExpanded = false;

    // "Show more" reveals the server-rendered extra cards (those past the
    // initial cap, hidden via data-community-extra). The full firehose stays
    // one click away at /skills/external (linked inside the button).
    communityMoreBtn?.addEventListener('click', () => {
      communityExpanded = true;
      communityGrid?.querySelectorAll<HTMLElement>('[data-community-extra="true"]').forEach(c => {
        c.classList.remove('hidden');
      });
      communityMoreBtn.classList.add('hidden');
    });

    // Restore the at-rest superset (default server-rendered cards) and re-wire
    // their Add-to-bundle pickers. Called when the search query is cleared.
    function restoreDefaultCommunity() {
      if (!communityGrid) return;
      communityGrid.innerHTML = defaultCommunity;
      communityExpanded = false;
      if (communityStatus) { communityStatus.classList.add('hidden'); communityStatus.textContent = ''; }
      // Show-more returns iff there were extra (capped) cards in the default set.
      const hasExtra = communityGrid.querySelector('[data-community-extra="true"]') !== null;
      if (communityMoreBtn) communityMoreBtn.classList.toggle('hidden', !hasExtra);
      if (typeof (window as any).__atcWire === 'function') (window as any).__atcWire();
    }

    function escHtml(s: any): string {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
    }

    function communityCard(s: any): string {
      const installable = s.install_path === 'fetch_origin' || s.install_path === 'register_mcp';
      // portal_0610 J4 / §6.5 DEFECT-2: honest license + two-class badge.
      const hasLicense = !!s.license;
      const licText = hasLicense ? escHtml(s.license) : 'license: none';
      const licClass = hasLicense ? 'text-muted-soft' : 'text-amber-300/80';
      // Class signal mirrors the backend _federation_class: licensed +
      // redistributable + fetch-origin = procedural; else persona/as-is.
      const isProcedural = hasLicense && s.redistributable !== false && s.install_path === 'fetch_origin';
      const classBadge = isProcedural
        ? '<span class="text-[10px] uppercase tracking-wide text-emerald-400/90 bg-emerald-500/10 border border-emerald-500/25 rounded px-1.5 py-0.5">skill</span>'
        : '<span class="text-[10px] uppercase tracking-wide text-amber-300/80 bg-amber-500/10 border border-amber-500/25 rounded px-1.5 py-0.5">persona · as-is</span>';
      // DEFECT-1: "view source" RESOLVES a reachable link on click (origin_url
      // 404s by default for hermes-hub) via /source-link, instead of linking a
      // dead origin_url directly.
      const action = installable
        ? '<a href="/skills/external" class="text-xs text-emerald-400 font-semibold mt-3 inline-block">● installable</a>'
        : '<button type="button" class="view-source-btn text-xs text-accent hover:underline mt-3 inline-block" data-src="' + escHtml(s.source) + '" data-slug="' + escHtml(s.slug) + '" data-origin="' + escHtml(s.origin_url || '') + '">View source →</button>';
      const picker = installable
        ? '<div class="atc-wrap relative inline-block mt-3" data-atc-root>' +
            '<button type="button" class="atc-btn inline-flex items-center gap-1.5 rounded-lg border border-border-soft text-text hover:border-accent hover:text-accent transition font-semibold px-3 py-1.5 text-xs" data-atc-slug="' + escHtml(s.slug) + '" data-atc-external="' + escHtml(s.source) + '" aria-haspopup="true" aria-expanded="false">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span class="atc-label">Add to bundle</span>' +
              '<svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="atc-caret transition-transform" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>' +
            '<div class="atc-menu hidden absolute right-0 z-30 mt-1 w-64 rounded-xl border border-border bg-bg-card shadow-xl p-1.5" role="menu">' +
              '<div class="atc-list flex flex-col gap-0.5 max-h-56 overflow-y-auto"></div>' +
              '<div class="atc-loading px-3 py-2 text-xs text-muted">Loading your bundles…</div>' +
              '<div class="atc-signin hidden px-3 py-3 text-xs text-muted"><a href="/signup" class="text-accent hover:underline font-semibold">Sign in</a> to save skills to a cookbook.</div>' +
              '<div class="atc-empty hidden px-3 py-2 text-xs text-muted">No bundles yet — create one below.</div>' +
              '<div class="atc-cap hidden px-3 py-2 text-xs text-amber-300">Skill cap reached. <a href="/pricing" class="text-accent hover:underline">Upgrade</a>.</div>' +
              '<div class="border-t border-border-soft mt-1 pt-1"><form class="atc-new flex items-center gap-1.5 px-1.5 py-1">' +
                '<input type="text" class="atc-new-name flex-1 rounded-md border border-border-soft bg-bg px-2 py-1 text-xs text-text placeholder:text-muted focus:border-accent focus:outline-none" placeholder="＋ New bundle…" maxlength="80"/>' +
                '<button type="submit" class="atc-new-btn rounded-md bg-accent text-bg text-xs font-semibold px-2.5 py-1 hover:opacity-90 transition">Add</button>' +
              '</form></div></div></div>'
        : '';
      return '<div class="bg-bg-card border border-border-soft rounded-2xl p-5 flex flex-col gap-2" data-source="' + escHtml(s.source) + '">' +
          '<div class="flex items-start justify-between gap-2">' +
            '<h3 class="text-base font-semibold text-text leading-tight">' + escHtml(s.title) + '</h3>' +
            '<span class="text-[10px] uppercase tracking-wide text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded px-1.5 py-0.5 whitespace-nowrap">' + escHtml(s.source) + '</span>' +
          '</div>' +
          '<p class="text-sm text-muted leading-relaxed line-clamp-3 flex-1">' + escHtml(s.description || 'No description.') + '</p>' +
          '<div class="flex items-center justify-between gap-2 pt-2 text-xs"><span class="' + licClass + '">' + licText + '</span>' + classBadge + '</div>' +
          action + picker +
        '</div>';
    }

    // portal_0610 J4 DEFECT-1: resolve a reachable source link on click. The
    // bare origin_url 404s by default for hermes-hub, so we ask the API for the
    // validated link (raw_url-first) and open that. Falls back to the origin_url
    // only if the resolver is unreachable; shows "source unavailable" if neither.
    async function resolveSourceLink(btn: HTMLButtonElement) {
      const src = btn.dataset.src || '';
      const slug = btn.dataset.slug || '';
      const origin = btn.dataset.origin || '';
      const prev = btn.textContent;
      btn.textContent = 'Resolving…';
      btn.disabled = true;
      try {
        const res = await fetch(`${API_BASE}/api/skills/external/${encodeURIComponent(src)}/${encodeURIComponent(slug)}/source-link`);
        if (res.ok) {
          const d = await res.json();
          if (d.reachable && d.url) {
            window.open(d.url, '_blank', 'noopener,noreferrer');
            btn.textContent = d.url_kind === 'raw' ? 'View source (raw) →' : 'View source →';
            btn.disabled = false;
            return;
          }
        }
      } catch { /* fall through */ }
      // Resolver failed — try the raw origin only if present; else honest message.
      if (origin) {
        window.open(origin, '_blank', 'noopener,noreferrer');
        btn.textContent = prev;
      } else {
        btn.textContent = 'source unavailable';
      }
      btn.disabled = false;
    }

    // Delegate clicks for any view-source button (server-rendered or JS-rendered).
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement)?.closest?.('.view-source-btn') as HTMLButtonElement | null;
      if (t) { e.preventDefault(); resolveSourceLink(t); }
    });

    // portal_0610 J4 — SOURCE FACET filter. Show/hide community cards by source
    // so federation is filterable in-place (no more scroll-to-find). Works on the
    // at-rest server-rendered grid; query-mode results are already source-scoped.
    let activeCommunitySource = 'all';
    function applyCommunitySource() {
      document.querySelectorAll<HTMLElement>('#community-grid [data-source]').forEach(card => {
        const matchSrc = activeCommunitySource === 'all' || card.dataset.source === activeCommunitySource;
        // Respect the existing "show more" cap: a card hidden as extra stays
        // hidden unless expanded, but a source filter overrides to reveal matches.
        if (activeCommunitySource === 'all') {
          const isExtra = card.getAttribute('data-community-extra') === 'true';
          card.classList.toggle('hidden', isExtra && !communityExpanded);
        } else {
          card.classList.toggle('hidden', !matchSrc);
        }
      });
    }
    document.querySelectorAll<HTMLButtonElement>('[data-csrc-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeCommunitySource = btn.dataset.csrcFilter ?? 'all';
        document.querySelectorAll<HTMLButtonElement>('[data-csrc-filter]').forEach(b => {
          const on = b.dataset.csrcFilter === activeCommunitySource;
          b.classList.toggle('border-accent', on);
          b.classList.toggle('text-accent', on);
          b.classList.toggle('bg-accent/10', on);
          b.classList.toggle('border-border', !on);
          b.classList.toggle('text-muted', !on);
        });
        // A source filter is an explicit "show all matching" — drop the cap.
        if (activeCommunitySource !== 'all') communityExpanded = true;
        applyCommunitySource();
      });
    });

    function queueCommunitySearch(q: string) {
      if (communityTimer) clearTimeout(communityTimer);
      if (!communitySection || !communityGrid) return;
      // fedui_0604 superset fix — the section is VISIBLE AT REST. A short/empty
      // query restores the server-rendered default superset (it does NOT hide
      // the section). A query >=2 chars re-fetches the full firehose by query.
      if (q.length < 2) {
        if (communityTimer) clearTimeout(communityTimer);
        restoreDefaultCommunity();
        return;
      }
      communityTimer = window.setTimeout(() => runCommunitySearch(q), 350);
    }

    async function runCommunitySearch(q: string) {
      if (!communitySection || !communityGrid || !communityStatus) return;
      const seq = ++communitySeq;
      communitySection.classList.remove('hidden');
      // In query mode the grid shows live results, not the capped default set —
      // hide the "show more" default-expander while a query is active.
      if (communityMoreBtn) communityMoreBtn.classList.add('hidden');
      communityGrid.innerHTML = '';
      communityStatus.classList.remove('hidden');
      communityStatus.textContent = 'Searching community sources…';
      let data: any;
      try {
        const res = await fetch(API_BASE + '/api/skills/external?sources=' + ALL_SOURCES + '&q=' + encodeURIComponent(q) + '&limit=24');
        if (!res.ok) throw new Error('API ' + res.status);
        data = await res.json();
      } catch (e) {
        if (seq !== communitySeq) return;
        communityStatus.textContent = 'Community search unavailable right now.';
        return;
      }
      if (seq !== communitySeq) return; // a newer query superseded this one
      const rows = (data && data.external) || [];
      const c = (data && data.counts) || {};
      if (communityCount) {
        communityCount.textContent = rows.length
          ? `${(c.external_indexed || rows.length).toLocaleString()} indexed · ${(c.external_installable || 0).toLocaleString()} installable. `
          : '';
      }
      if (rows.length === 0) {
        communityStatus.textContent = 'No community skills matched “' + q + '”.';
        communityGrid.innerHTML = '';
        return;
      }
      communityStatus.classList.add('hidden');
      communityGrid.innerHTML = rows.map(communityCard).join('');
      if (typeof (window as any).__atcWire === 'function') (window as any).__atcWire();
    }

    // Honor ?category=X and ?tier=Y and ?subset=X from URL on landing.
    // If the requested category doesn't exist in the rendered set, fall back
    // to "all" with a soft empty-state hint instead of showing zero results.
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    const tierParam = params.get('tier');
    const subsetParam = params.get('subset');
    const validCats = new Set<string>();
    cards.forEach(c => { if (c.dataset.category) validCats.add(c.dataset.category); });

    if (cat) {
      if (validCats.has(cat)) {
        activeCat = cat;
        setActivePill('cat', activeCat);
      } else {
        // Show a soft hint above the grid so the user understands.
        const hint = document.createElement('div');
        hint.className = 'mb-4 px-4 py-3 rounded-lg border border-border bg-bg-card text-sm text-muted';
        hint.innerHTML = `No category called <code class="text-accent">${cat.replace(/[<>"']/g, '')}</code>. Showing all skills — pick a category below.`;
        const grid = document.getElementById('skill-grid');
        grid?.parentElement?.insertBefore(hint, grid);
      }
    }
    if (tierParam && ['free', 'pro', 'pro_plus', 'cook', 'operator', 'studio'].includes(tierParam)) {
      activeTier = tierParam;
      setActivePill('tier', activeTier);
    }
    const vertParam = params.get('vertical');
    const validVerts = ['marketing', 'code', 'web-scraping', 'ops', 'sales', 'sim-robotics'];
    if (vertParam && validVerts.includes(vertParam)) {
      activeVert = vertParam;
      setActivePill('vert', activeVert);
    }
    const validSubsets = ['pantry', 'menu', 'cookbook'];
    if (subsetParam && validSubsets.includes(subsetParam)) {
      activeSubset = subsetParam;
      setActivePill('subset', activeSubset);
    }
    // onechrome_0611 P4 — accept ?q= handoff from the shell's unified search.
    const qParam = params.get('q');
    if (qParam && search) {
      search.value = qParam;
      activeQuery = qParam.toLowerCase().trim();
      queueCommunitySearch(qParam.trim());
    }
    if (cat || tierParam || vertParam || subsetParam || qParam) apply();
  })();
</script>
