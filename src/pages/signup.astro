---
// /signup — renders the sign-up variant of the auth card DIRECTLY.
//
// qa1018 C08: this used to be a meta-refresh + JS redirect to
// /signin?mode=signup — an extra page load (painful on 3G), and the target
// page then showed "Welcome back" anyway because the static build could not
// read ?mode. Skill pages and external sites link here, so it must land.
// ?ref= / ?next= / utm_* are handled by AuthPanel's client script exactly as
// on /signin.
import AuthEdge from '../layouts/AuthEdge.astro';
import AuthPanel from '../components/AuthPanel.astro';
---
<AuthEdge title="Create your free account — LoopSkill" description="Create a free LoopSkill account with Google or GitHub. Free skills install without one; an account adds an API key, a Library, private bundles and fleets.">
  <AuthPanel initialMode="signup" />
</AuthEdge>
