---
// /signup → /signin?mode=signup redirect.
//
// Background: external sites (X posts, blog comments, docs CTAs) sometimes
// link to /signup directly. Before this page that 404'd. This page is
// statically pre-rendered so the redirect target is set client-side; the
// inline script preserves any ?ref=CODE for referral attribution and
// redirects via window.location.replace.
//
// The bare meta-refresh is a fallback for crawlers / no-JS browsers.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/signin?mode=signup" />
    <link rel="canonical" href="https://app.loopskill.io/signin?mode=signup" />
    <title>Get access — LoopSkill</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href="/signin?mode=signup">Get access</a>…</p>
    <script is:inline>
      // Client-side: preserve ?ref= attribution if present.
      // Validates against the same regex as Base.astro stamper to avoid
      // forwarding a malformed code.
      (function () {
        var p = new URLSearchParams(window.location.search);
        var ref = p.get('ref');
        var target = '/signin?mode=signup';
        if (ref && /^[A-Za-z0-9]{4,16}$/.test(ref)) {
          target += '&ref=' + encodeURIComponent(ref);
        }
        window.location.replace(target);
      })();
    </script>
  </body>
</html>
