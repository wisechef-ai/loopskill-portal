---
import Base from '../layouts/Base.astro';
import CrossSell from '../components/CrossSell.astro';

// Mock data — TODO: replace with live api.recipes.wisechef.ai/api/skills/search when API is up
// Subagent A is building the API concurrently — if it 502s, we use this mock
const MOCK_SKILLS = [
  { slug: 'client-reporter', name: 'Client Reporter', category: 'analytics', description: 'Pull GA4, GSC, Meta Ads, TikTok Ads data for any client. Generates a branded PDF report with insights.', is_free: true, install_count: 842, rating_avg: 4.9, tags: ['analytics','reporting','pdf'] },
  { slug: 'proposal-builder', name: 'Proposal Builder', category: 'sales', description: 'Agent-generated agency proposals from a discovery call transcript. Includes scope, timeline, and pricing.', is_free: false, install_count: 234, rating_avg: 4.7, tags: ['proposals','sales','copywriting'] },
  { slug: 'content-calendar', name: 'Content Calendar', category: 'content', description: '30-day content calendar across 4 platforms. Briefing-to-publish pipeline driven by your agent.', is_free: false, install_count: 512, rating_avg: 4.8, tags: ['content','social','scheduling'] },
  { slug: 'seo-audit-engine', name: 'SEO Audit Engine', category: 'seo', description: 'Full technical + content SEO audit for any domain. Prioritised fix list, competitor gap analysis.', is_free: false, install_count: 389, rating_avg: 4.6, tags: ['seo','audit','reporting'] },
  { slug: 'ghl-sync', name: 'GoHighLevel Sync', category: 'crm', description: 'Sync client data, campaigns, and automations between your agent and GoHighLevel CRM.', is_free: false, install_count: 178, rating_avg: 4.5, tags: ['crm','ghl','automation'] },
  { slug: 'white-label-dashboard', name: 'White-Label Dashboard', category: 'reporting', description: 'Local web dashboard showing multi-client performance. Drop your agency logo. Share with clients.', is_free: false, install_count: 156, rating_avg: 4.7, tags: ['dashboard','reporting','white-label'] },
  { slug: 'ad-copy-generator', name: 'Ad Copy Generator', category: 'copywriting', description: 'Generate 10 ad copy variations per platform (Meta, TikTok, Google) from a single brief in 60 seconds.', is_free: false, install_count: 298, rating_avg: 4.6, tags: ['ads','copywriting','meta'] },
  { slug: 'email-sequence-builder', name: 'Email Sequence Builder', category: 'email', description: 'Build full email nurture sequences from a product description. Klaviyo/Mailchimp export ready.', is_free: false, install_count: 201, rating_avg: 4.5, tags: ['email','automation','klaviyo'] },
];

const categories = ['all', 'analytics', 'sales', 'content', 'seo', 'crm', 'reporting', 'copywriting', 'email'];
---

<Base
  title="Skills Marketplace — Recipes by WiseChef"
  description="Browse agency-grade AI skills. Client reporting, proposals, SEO audits, content calendars — installed by your agent in seconds."
>

  <section class="skills-page">
    <div class="skills-page-inner">

      <!-- Header -->
      <div class="skills-header">
        <div class="section-tag">Marketplace</div>
        <h1 class="skills-h1">Agency skills. Agent-installed.</h1>
        <p class="skills-desc">
          Every skill built for the 5–20-person marketing agency.
          Your agent finds the right one, installs it, and delivers.
        </p>
      </div>

      <!-- Filter + Search -->
      <div class="skills-controls">
        <input
          type="text"
          id="skill-search"
          placeholder="Search skills..."
          class="skill-search-input"
          aria-label="Search skills"
        />
        <div class="category-filters" role="group" aria-label="Filter by category">
          {categories.map(cat => (
            <button
              class:list={['cat-btn', cat === 'all' && 'cat-btn-active']}
              data-cat={cat}
            >
              {cat === 'all' ? 'All skills' : cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Live skills notice -->
      <div class="api-notice" id="api-notice" style="display:none">
        <!-- Shown by JS if API fails -->
      </div>

      <!-- Skills Grid -->
      <div class="skills-list" id="skills-grid">
        {MOCK_SKILLS.map(skill => (
          <div class="skill-item" data-cat={skill.category} data-name={skill.name.toLowerCase()} data-desc={skill.description.toLowerCase()}>
            <div class="skill-item-header">
              <h2 class="skill-item-name">{skill.name}</h2>
              <span class:list={['skill-item-tier', skill.is_free ? 'tier-free' : 'tier-pro']}>
                {skill.is_free ? 'FREE' : 'Pro'}
              </span>
            </div>
            <p class="skill-item-desc">{skill.description}</p>
            <div class="skill-item-meta">
              <span class="skill-meta-cat">{skill.category}</span>
              <span class="skill-meta-stat">⬇ {skill.install_count.toLocaleString()}</span>
              <span class="skill-meta-stat">★ {skill.rating_avg}</span>
            </div>
            <div class="skill-item-tags">
              {skill.tags.map(t => <span class="skill-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>

      <div class="skills-empty" id="skills-empty" style="display:none">
        <p>No skills match your search. <a href="/publish">Publish one →</a></p>
      </div>

      <!-- Cross-sell -->
      <CrossSell />

    </div>
  </section>

</Base>

<style>
.skills-page { padding: 4rem 1.5rem; }
.skills-page-inner { max-width: 1100px; margin: 0 auto; }
.section-tag {
  display: inline-block; font-size: 0.75rem; font-weight: 600; color: #f97316;
  text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;
}
.skills-header { margin-bottom: 3rem; }
.skills-h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #f5f5f5; letter-spacing: -0.03em; margin: 0 0 1rem; }
.skills-desc { color: #888; font-size: 1rem; line-height: 1.7; max-width: 560px; }

.skills-controls { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem; }
.skill-search-input {
  background: #111; border: 1px solid #222; border-radius: 0.5rem;
  padding: 0.75rem 1rem; color: #f5f5f5; font-size: 1rem;
  width: 100%; max-width: 480px; outline: none;
  transition: border-color 0.15s;
}
.skill-search-input:focus { border-color: #f97316; }
.skill-search-input::placeholder { color: #444; }

.category-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.cat-btn {
  padding: 0.375rem 0.875rem; border-radius: 999px;
  font-size: 0.8rem; font-weight: 500;
  background: #111; border: 1px solid #222; color: #888;
  cursor: pointer; transition: all 0.15s;
}
.cat-btn:hover { border-color: #f97316; color: #f97316; }
.cat-btn-active { background: rgba(249,115,22,0.15); border-color: #f97316; color: #f97316; }

.api-notice {
  background: rgba(250,204,21,0.08); border: 1px solid rgba(250,204,21,0.2);
  border-radius: 0.5rem; padding: 0.75rem 1rem;
  color: #fbbf24; font-size: 0.875rem; margin-bottom: 1.5rem;
}

.skills-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2rem;
}

.skill-item {
  background: #111; border: 1px solid #1e1e1e; border-radius: 0.75rem;
  padding: 1.5rem; transition: border-color 0.15s;
}
.skill-item:hover { border-color: #333; }
.skill-item-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem; }
.skill-item-name { font-size: 1.05rem; font-weight: 700; color: #f5f5f5; margin: 0; }
.skill-item-tier {
  font-size: 0.65rem; font-weight: 700; padding: 2px 8px;
  border-radius: 999px; white-space: nowrap; flex-shrink: 0;
  margin-top: 2px;
}
.tier-free { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
.tier-pro { background: rgba(249,115,22,0.15); color: #f97316; border: 1px solid rgba(249,115,22,0.3); }
.skill-item-desc { color: #888; font-size: 0.875rem; line-height: 1.6; margin: 0 0 0.75rem; }
.skill-item-meta { display: flex; gap: 0.75rem; margin-bottom: 0.75rem; }
.skill-meta-cat { color: #555; font-size: 0.75rem; text-transform: capitalize; }
.skill-meta-stat { color: #555; font-size: 0.75rem; }
.skill-item-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.skill-tag { font-size: 0.7rem; color: #555; background: #1a1a1a; border: 1px solid #222; padding: 2px 8px; border-radius: 999px; }

.skills-empty { text-align: center; padding: 4rem 0; color: #555; }
.skills-empty a { color: #f97316; }
</style>

<script>
// Live API fetch — falls back to mock data already rendered by Astro SSG
// TODO: replace with live api.recipes.wisechef.ai when Subagent A's API is up
async function fetchLiveSkills() {
  try {
    const res = await fetch('https://api.recipes.wisechef.ai/api/skills/search', {
      signal: AbortSignal.timeout(4000)
    });
    if (!res.ok) throw new Error(`API ${res.status}`);
    const data = await res.json();
    if (!data?.results?.length) return;
    
    const grid = document.getElementById('skills-grid');
    if (!grid) return;
    
    grid.innerHTML = data.results.map((skill: any) => `
      <div class="skill-item" data-cat="${skill.category || ''}" data-name="${skill.name?.toLowerCase() || ''}" data-desc="${skill.description?.toLowerCase() || ''}">
        <div class="skill-item-header">
          <h2 class="skill-item-name">${skill.name}</h2>
          <span class="skill-item-tier ${skill.is_free ? 'tier-free' : 'tier-pro'}">${skill.is_free ? 'FREE' : 'Pro'}</span>
        </div>
        <p class="skill-item-desc">${skill.description}</p>
        <div class="skill-item-meta">
          <span class="skill-meta-cat">${skill.category || ''}</span>
          <span class="skill-meta-stat">⬇ ${(skill.install_count || 0).toLocaleString()}</span>
          <span class="skill-meta-stat">★ ${skill.rating_avg || '–'}</span>
        </div>
      </div>
    `).join('');
  } catch (e) {
    // API not yet live (Subagent A building concurrently) — static mock data already shown
    const notice = document.getElementById('api-notice');
    if (notice) {
      notice.style.display = 'block';
      notice.textContent = '⚠ Live API not yet available — showing curated skill examples. Full marketplace launching soon.';
    }
  }
}

// Filter + search
function filterSkills() {
  const search = (document.getElementById('skill-search') as HTMLInputElement)?.value?.toLowerCase() || '';
  const activeBtn = document.querySelector('.cat-btn-active') as HTMLElement;
  const activeCat = activeBtn?.dataset?.cat || 'all';
  
  const items = document.querySelectorAll('.skill-item') as NodeListOf<HTMLElement>;
  let visible = 0;
  
  items.forEach(item => {
    const cat = item.dataset.cat || '';
    const name = item.dataset.name || '';
    const desc = item.dataset.desc || '';
    const catMatch = activeCat === 'all' || cat === activeCat;
    const searchMatch = !search || name.includes(search) || desc.includes(search);
    item.style.display = (catMatch && searchMatch) ? '' : 'none';
    if (catMatch && searchMatch) visible++;
  });
  
  const empty = document.getElementById('skills-empty');
  if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
}

document.getElementById('skill-search')?.addEventListener('input', filterSkills);

document.querySelectorAll('.cat-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('cat-btn-active'));
    btn.classList.add('cat-btn-active');
    filterSkills();
  });
});

// Attempt live fetch (non-blocking)
fetchLiveSkills();
</script>
