---
import Base from '../layouts/Base.astro';
import { fetchApi } from '../lib/api';

interface GraphNode {
  slug: string;
  title: string;
  category: string;
  tier: string;
  install_count: number;
}
interface GraphEdge {
  source: string;
  target: string;
  weight: number;
}
interface GraphData {
  nodes: GraphNode[];
  edges: GraphEdge[];
  node_count: number;
  edge_count: number;
}

const result = await fetchApi<GraphData>('/api/skills/graph', { authed: false });
const graph: GraphData = (result.ok && result.data) ? result.data : {
  nodes: [], edges: [], node_count: 0, edge_count: 0,
};

const categories = Array.from(new Set(graph.nodes.map(n => n.category))).sort();

// Embed the graph as inline JSON so the client doesn't have to refetch.
const inlineJson = JSON.stringify(graph);
---

<Base
  title="Skill Graph — Recipes"
  description="Force-directed visualisation of how skills in the Recipes marketplace connect. Edges derived from shared tags, category, and co-install patterns."
>
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-8">
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-3 mb-8">
      <p class="eyebrow">Stage 3</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">The skill graph.</h1>
      <p class="text-muted">
        {graph.node_count} skills, {graph.edge_count} edges. Each line connects skills that share tags,
        category, or get installed together. Hover or tap a node to see its neighbourhood.
      </p>
      {!result.ok && (
        <p class="text-xs text-muted-soft">(graph unavailable — API: {result.error})</p>
      )}
    </div>

    {/* Legend */}
    <div class="flex flex-wrap gap-2 items-center mb-4">
      <span class="text-[10px] uppercase tracking-wider text-muted-soft">Category:</span>
      <button data-cat-filter="all" class="cat-pill text-[11px] px-2.5 py-1 rounded-full border border-accent text-accent transition">All · {graph.node_count}</button>
      {categories.map((c) => (
        <button data-cat-filter={c} class="cat-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition capitalize">{c}</button>
      ))}
    </div>

    <div class="flex items-center gap-3 mb-4 text-xs text-muted-soft">
      <span class="hidden md:inline">Drag to pan · scroll to zoom · click a node to highlight neighbours</span>
      <span class="md:hidden">Drag with one finger to pan · pinch to zoom · tap a node to open it</span>
      <span class="ml-auto" id="graph-status">Initialising…</span>
    </div>

    <div
      id="graph-container"
      class="bg-bg-card border border-border rounded-2xl overflow-hidden"
      style="height: 70vh; min-height: 520px; position: relative;"
    >
      <svg
        id="graph-svg"
        width="100%"
        height="100%"
        style="display: block; cursor: grab; user-select: none; touch-action: none; -webkit-user-select: none;"
      ></svg>
      <div
        id="graph-tooltip"
        class="hidden absolute pointer-events-none bg-bg border border-border rounded-lg px-3 py-2 shadow-xl text-xs"
        style="z-index: 10;"
      ></div>
    </div>

    <div class="text-center mt-6 text-xs text-muted-soft">
      Want this data programmatically? Hit
      <code class="font-mono text-muted bg-bg-elev border border-border-soft rounded px-1.5 py-0.5">GET /api/skills/graph</code>
      — no auth required.
    </div>
  </section>

  <script type="application/json" id="graph-data" set:html={inlineJson}></script>

  <script>
    // Lightweight force-directed layout. No external libraries — runs everywhere.
    // Algorithm: classic Verlet-ish iteration with repulsion (Coulomb), spring
    // attraction along edges, and a soft centring pull. Performant up to ~500
    // nodes / ~2k edges, which is well above our current marketplace size.
    interface N {
      slug: string; title: string; category: string; tier: string; install_count: number;
      x: number; y: number; vx: number; vy: number; r: number; color: string;
    }
    interface L { source: string; target: string; weight: number; }

    const raw = JSON.parse(document.getElementById('graph-data')!.textContent!);
    const status = document.getElementById('graph-status')!;
    const svg = document.getElementById('graph-svg') as unknown as SVGSVGElement;
    const tip = document.getElementById('graph-tooltip')!;
    const container = document.getElementById('graph-container')!;

    if (!raw.nodes || raw.nodes.length === 0) {
      status.textContent = 'No graph data — check API.';
    } else {
      // Color palette by category — deterministic hashing into HSL space
      const palette = (cat: string) => {
        let h = 0;
        for (let i = 0; i < cat.length; i++) h = (h * 31 + cat.charCodeAt(i)) >>> 0;
        return `hsl(${h % 360}, 55%, 62%)`;
      };

      const W = container.clientWidth || 1200;
      const H = container.clientHeight || 600;

      // Initialise nodes in a small spread around centre
      const nodes: N[] = raw.nodes.map((n: any, i: number) => {
        const ang = (i / raw.nodes.length) * Math.PI * 2;
        const r0 = Math.min(W, H) * 0.3;
        return {
          slug: n.slug,
          title: n.title,
          category: n.category,
          tier: n.tier,
          install_count: n.install_count || 0,
          x: W / 2 + Math.cos(ang) * r0,
          y: H / 2 + Math.sin(ang) * r0,
          vx: 0, vy: 0,
          r: 4 + Math.min(8, Math.log2(1 + (n.install_count || 0)) * 1.6),
          color: palette(n.category),
        };
      });

      const indexBySlug: Record<string, number> = {};
      nodes.forEach((n, i) => { indexBySlug[n.slug] = i; });

      const links: { src: number; tgt: number; w: number }[] = raw.edges
        .map((e: L) => ({
          src: indexBySlug[e.source],
          tgt: indexBySlug[e.target],
          w: e.weight,
        }))
        .filter((l: any) => l.src !== undefined && l.tgt !== undefined);

      // Adjacency for hover-highlight
      const adj: Record<number, Set<number>> = {};
      links.forEach(({ src, tgt }) => {
        (adj[src] ??= new Set()).add(tgt);
        (adj[tgt] ??= new Set()).add(src);
      });

      // Pre-create SVG elements
      const ns = 'http://www.w3.org/2000/svg';
      const root = document.createElementNS(ns, 'g');
      root.setAttribute('id', 'root');
      svg.appendChild(root);
      const linkGroup = document.createElementNS(ns, 'g');
      linkGroup.setAttribute('stroke-linecap', 'round');
      const nodeGroup = document.createElementNS(ns, 'g');
      root.appendChild(linkGroup);
      root.appendChild(nodeGroup);

      const linkEls: SVGLineElement[] = links.map(({ w }) => {
        const el = document.createElementNS(ns, 'line') as SVGLineElement;
        el.setAttribute('stroke', '#3a3f4a');
        el.setAttribute('stroke-width', String(0.4 + w * 1.4));
        el.setAttribute('stroke-opacity', String(0.18 + w * 0.5));
        linkGroup.appendChild(el);
        return el;
      });

      const nodeEls: SVGCircleElement[] = nodes.map((n, i) => {
        const el = document.createElementNS(ns, 'circle') as SVGCircleElement;
        el.setAttribute('r', String(n.r));
        el.setAttribute('fill', n.color);
        el.setAttribute('stroke', '#0f1115');
        el.setAttribute('stroke-width', '1');
        el.setAttribute('data-idx', String(i));
        el.style.cursor = 'pointer';
        nodeGroup.appendChild(el);
        return el;
      });

      // Force simulation
      const REPEL = 240;
      const SPRING = 0.014;
      const SPRING_LEN = 70;
      const CENTRE = 0.0008;
      const FRICTION = 0.86;

      let alpha = 1.0;
      let frame = 0;

      function step() {
        // Repulsion (O(N²) with early-out — fine for 80 nodes; bump up to N=300+ before quadtree)
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            let dx = b.x - a.x, dy = b.y - a.y;
            let d2 = dx * dx + dy * dy;
            if (d2 < 1) { dx = Math.random() - 0.5; dy = Math.random() - 0.5; d2 = 1; }
            if (d2 > 90000) continue; // ignore far pairs
            const d = Math.sqrt(d2);
            const f = REPEL / d2;
            const fx = (dx / d) * f, fy = (dy / d) * f;
            a.vx -= fx; a.vy -= fy;
            b.vx += fx; b.vy += fy;
          }
        }

        // Spring on edges
        for (const { src, tgt, w } of links) {
          const a = nodes[src], b = nodes[tgt];
          const dx = b.x - a.x, dy = b.y - a.y;
          const d = Math.sqrt(dx * dx + dy * dy) || 1;
          const desired = SPRING_LEN / (0.4 + w);
          const f = (d - desired) * SPRING * (0.5 + w);
          const fx = (dx / d) * f, fy = (dy / d) * f;
          a.vx += fx; a.vy += fy;
          b.vx -= fx; b.vy -= fy;
        }

        // Centring
        for (const n of nodes) {
          n.vx += (W / 2 - n.x) * CENTRE;
          n.vy += (H / 2 - n.y) * CENTRE;
          n.vx *= FRICTION; n.vy *= FRICTION;
          n.x += n.vx * alpha; n.y += n.vy * alpha;
        }

        // Render
        for (let i = 0; i < links.length; i++) {
          const { src, tgt } = links[i];
          const a = nodes[src], b = nodes[tgt];
          linkEls[i].setAttribute('x1', String(a.x));
          linkEls[i].setAttribute('y1', String(a.y));
          linkEls[i].setAttribute('x2', String(b.x));
          linkEls[i].setAttribute('y2', String(b.y));
        }
        for (let i = 0; i < nodes.length; i++) {
          nodeEls[i].setAttribute('cx', String(nodes[i].x));
          nodeEls[i].setAttribute('cy', String(nodes[i].y));
        }

        alpha *= 0.997;
        frame++;
        if (frame < 600 || alpha > 0.05) requestAnimationFrame(step);
        else status.textContent = `${nodes.length} skills · ${links.length} edges · click a node`;
      }
      status.textContent = 'Laying out…';
      requestAnimationFrame(step);

      // Pan & zoom — Pointer Events for unified mouse/touch/pen + pinch zoom
      let tx = 0, ty = 0, scale = 1;
      function applyTransform() {
        root.setAttribute('transform', `translate(${tx} ${ty}) scale(${scale})`);
      }

      // Forward declarations — referenced in endPointer below before being assigned
      let highlighted: number | null = null;
      let touchTooltipShown = false;

      // Active pointers (used for both single-finger pan and two-finger pinch)
      type Pt = {
        id: number; x: number; y: number; startX: number; startY: number;
        startedOnNode: boolean; nodeIdx: number | null;
      };
      const pointers = new Map<number, Pt>();
      let panAnchorX = 0, panAnchorY = 0;        // tx/ty when single-pointer pan started
      let pinchStartDist = 0;                     // initial finger distance
      let pinchStartScale = 1;                    // scale when pinch started
      let pinchStartCx = 0, pinchStartCy = 0;     // midpoint at pinch start (screen coords, relative to svg)
      let pinchStartTx = 0, pinchStartTy = 0;     // tx/ty at pinch start
      let movedSinceDown = false;                 // true if any pointer moved past threshold — used to suppress click-after-drag
      const MOVE_THRESHOLD = 6;                   // px

      function svgPoint(e: PointerEvent): { x: number; y: number } {
        const rect = svg.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
      }

      svg.addEventListener('pointerdown', (e: PointerEvent) => {
        const p = svgPoint(e);
        const targetEl = e.target as Element;
        const onNode = targetEl.tagName === 'circle';
        const nodeIdx = onNode
          ? Number(targetEl.getAttribute('data-idx'))
          : null;
        pointers.set(e.pointerId, {
          id: e.pointerId,
          x: p.x, y: p.y,
          startX: p.x, startY: p.y,
          startedOnNode: onNode,
          nodeIdx: Number.isFinite(nodeIdx) ? nodeIdx : null,
        });
        // Capture so we keep getting events even if the pointer leaves the SVG
        try { svg.setPointerCapture(e.pointerId); } catch { /* ignore */ }

        if (pointers.size === 1) {
          movedSinceDown = false;
          panAnchorX = tx; panAnchorY = ty;
          if (!onNode) svg.style.cursor = 'grabbing';
        } else if (pointers.size === 2) {
          const pts = Array.from(pointers.values());
          const dx = pts[0].x - pts[1].x, dy = pts[0].y - pts[1].y;
          pinchStartDist = Math.hypot(dx, dy) || 1;
          pinchStartScale = scale;
          pinchStartCx = (pts[0].x + pts[1].x) / 2;
          pinchStartCy = (pts[0].y + pts[1].y) / 2;
          pinchStartTx = tx; pinchStartTy = ty;
        }
      });

      svg.addEventListener('pointermove', (e: PointerEvent) => {
        const tracked = pointers.get(e.pointerId);
        if (!tracked) return;
        const p = svgPoint(e);
        tracked.x = p.x; tracked.y = p.y;
        const dxFromStart = p.x - tracked.startX;
        const dyFromStart = p.y - tracked.startY;
        if (Math.abs(dxFromStart) > MOVE_THRESHOLD || Math.abs(dyFromStart) > MOVE_THRESHOLD) {
          movedSinceDown = true;
        }

        if (pointers.size === 1) {
          // Single-pointer pan — but only if we didn't start on a node, OR we've moved past threshold
          // (so a tap on a node still navigates, but a drag that begins on a node also pans)
          if (tracked.startedOnNode && !movedSinceDown) return;
          tx = panAnchorX + dxFromStart;
          ty = panAnchorY + dyFromStart;
          applyTransform();
        } else if (pointers.size >= 2) {
          // Two-pointer pinch — scale around the initial midpoint
          const pts = Array.from(pointers.values());
          const dx = pts[0].x - pts[1].x, dy = pts[0].y - pts[1].y;
          const dist = Math.hypot(dx, dy) || 1;
          const newScale = Math.max(0.3, Math.min(3, pinchStartScale * (dist / pinchStartDist)));
          // Keep the pinch midpoint anchored in graph-space:
          //   newTx = pinchStartCx - (pinchStartCx - pinchStartTx) * (newScale / pinchStartScale)
          const k = newScale / pinchStartScale;
          tx = pinchStartCx - (pinchStartCx - pinchStartTx) * k;
          ty = pinchStartCy - (pinchStartCy - pinchStartTy) * k;
          scale = newScale;
          applyTransform();
        }
      });

      function endPointer(e: PointerEvent) {
        const tracked = pointers.get(e.pointerId);
        if (!tracked) return;
        pointers.delete(e.pointerId);
        try { svg.releasePointerCapture(e.pointerId); } catch { /* ignore */ }

        // Touch-tap detection: pointer lifted without significant movement, no other pointers down.
        // We handle nav at the SVG level (not on each circle) because setPointerCapture redirects
        // pointerup to the capturing element — per-circle pointerup never fires.
        const wasTap = (e.pointerType === 'touch' || e.pointerType === 'pen')
          && !movedSinceDown
          && pointers.size === 0;

        if (wasTap) {
          if (tracked.startedOnNode && tracked.nodeIdx !== null) {
            const i = tracked.nodeIdx;
            if (touchTooltipShown && highlighted === i) {
              // Second tap on the same highlighted node — navigate
              window.location.href = `/skills/${nodes[i].slug}`;
              return;
            }
            // First tap on a node — show tooltip + highlight
            highlight(i);
            showTip(i, e);
            touchTooltipShown = true;
          } else if (touchTooltipShown) {
            // Tap on empty area — dismiss tooltip
            tip.classList.add('hidden');
            highlight(null);
            touchTooltipShown = false;
          }
        }

        if (pointers.size === 0) {
          svg.style.cursor = 'grab';
        } else if (pointers.size === 1) {
          // Dropped from pinch back to single — reseed pan anchor so we don't snap
          const remaining = pointers.values().next().value as Pt;
          remaining.startX = remaining.x;
          remaining.startY = remaining.y;
          panAnchorX = tx; panAnchorY = ty;
        }
      }
      svg.addEventListener('pointerup', endPointer);
      svg.addEventListener('pointercancel', endPointer);

      // Suppress click-after-drag (e.g., user drag-pans starting on a node — don't navigate)
      svg.addEventListener('click', (e: MouseEvent) => {
        if (movedSinceDown) {
          e.stopPropagation();
          e.preventDefault();
          movedSinceDown = false;
        }
      }, true);

      // Desktop mouse wheel zoom (unchanged) — pointer events don't cover scroll-wheel
      svg.addEventListener('wheel', (e: WheelEvent) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.1 : 0.9;
        scale = Math.max(0.3, Math.min(3, scale * factor));
        applyTransform();
      }, { passive: false });

      // Hover + click
      function highlight(i: number | null) {
        highlighted = i;
        if (i === null) {
          nodeEls.forEach((el) => el.style.opacity = '1');
          linkEls.forEach((el) => el.style.opacity = '');
          return;
        }
        const neighbours = adj[i] || new Set();
        nodeEls.forEach((el, j) => {
          el.style.opacity = (j === i || neighbours.has(j)) ? '1' : '0.18';
        });
        linkEls.forEach((el, k) => {
          const { src, tgt } = links[k];
          el.style.opacity = (src === i || tgt === i) ? '1' : '0.05';
        });
      }

      function showTip(i: number, evt: { clientX: number; clientY: number }) {
        const n = nodes[i];
        const degree = (adj[i] || new Set()).size;
        tip.innerHTML = `
          <div style="font-weight:600">${n.title}</div>
          <div style="color:#9ba1ad; margin-top:2px">${n.category} · ${n.tier} · ${n.install_count} installs</div>
          <div style="color:#9ba1ad">${degree} connection${degree === 1 ? '' : 's'}</div>
          <div style="margin-top:6px">
            <a href="/skills/${n.slug}"
               style="color:#f4b942; pointer-events:auto; touch-action:manipulation; display:inline-block; padding:6px 0; min-height:32px;"
            >Open /skills/${n.slug} →</a>
          </div>
        `;
        tip.classList.remove('hidden');
        const rect = container.getBoundingClientRect();
        // Initial position so we can measure
        tip.style.left = '0px';
        tip.style.top = '0px';
        const tipRect = tip.getBoundingClientRect();
        const offset = 14;
        let left = evt.clientX - rect.left + offset;
        let top = evt.clientY - rect.top + offset;
        // Flip to the other side if it would overflow the container
        if (left + tipRect.width > rect.width) left = evt.clientX - rect.left - tipRect.width - offset;
        if (top + tipRect.height > rect.height) top = evt.clientY - rect.top - tipRect.height - offset;
        tip.style.left = `${Math.max(8, left)}px`;
        tip.style.top = `${Math.max(8, top)}px`;
      }

      nodeEls.forEach((el, i) => {
        el.addEventListener('mouseenter', (e: any) => { highlight(i); showTip(i, e); });
        el.addEventListener('mousemove', (e: any) => { if (highlighted === i) showTip(i, e); });
        el.addEventListener('mouseleave', () => {
          if (touchTooltipShown) return; // don't auto-hide a touch-shown tooltip on synthesized mouseleave
          tip.classList.add('hidden');
          highlight(null);
        });
        // Desktop: click navigates immediately. Touch nav is handled in endPointer at the SVG
        // level because setPointerCapture redirects all per-pointer events to the SVG.
        el.addEventListener('click', () => { window.location.href = `/skills/${nodes[i].slug}`; });
      });

      // Category filter
      let activeCat = 'all';
      function applyCat() {
        nodeEls.forEach((el, i) => {
          const show = activeCat === 'all' || nodes[i].category === activeCat;
          el.style.display = show ? '' : 'none';
        });
        linkEls.forEach((el, k) => {
          const { src, tgt } = links[k];
          const show = activeCat === 'all' ||
            (nodes[src].category === activeCat && nodes[tgt].category === activeCat);
          el.style.display = show ? '' : 'none';
        });
      }
      document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCat = btn.dataset.catFilter ?? 'all';
          document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]').forEach((b) => {
            const isActive = b.dataset.catFilter === activeCat;
            b.classList.toggle('border-accent', isActive);
            b.classList.toggle('text-accent', isActive);
            b.classList.toggle('border-border', !isActive);
            b.classList.toggle('text-muted', !isActive);
          });
          applyCat();
        });
      });
    }
  </script>
</Base>
