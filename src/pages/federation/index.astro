---
// /federation/ — G2-federation GEO index page.
//
// PROBLEM (GEO audit 2026-08-19, live-confirmed): LoopSkill's federation
// crawl indexes ~91k external skills across the upstream registries
// configured in loopskill-api's config/federation_sources.yaml — the
// single biggest catalog claim on the site — and it was 100% API-only.
// Zero crawlable URLs; Google/LLM crawlers could not see it, so the "91k+"
// claim was uncitable. This page (+ /federation/{source}/) fixes that.
//
// D-035 (proxy-never-rehost): metadata ONLY — name, description, upstream
// source, license/trust, tags, and a link to the entry's ORIGIN. Never
// rehost external skill content.
//
// COUNT-BINDING: the headline number is bound to a real build-time read of
// GET /api/federation/filter (getFederationOverview() in ../lib/federation).
// When the API is unreachable at build time, `overview.ok` is false and the
// page renders explanatory copy with the count OMITTED — never a hardcoded
// "91k" fallback literal. Per-source counts follow the same rule: a source
// only gets a table row (and only gets a /federation/{source}/ page) when
// it returned BOTH a real total and at least one sample entry with a real
// origin link (see federation.ts's getFederationOverview for the exact
// gate) — this keeps the index table and the emitted detail pages in
// lockstep so audit-links never sees a link to a page the build skipped.
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import LiveCount from '../../components/LiveCount.astro';
import { getFederationOverview } from '../../lib/federation';

const overview = await getFederationOverview();
const siteURL = 'https://app.loopskill.io';

const title = 'Federated skill index — LoopSkill';
const description = overview.ok && overview.total
  ? `Browse the ${overview.total.toLocaleString()} externally indexed agent skills LoopSkill's federation crawl surfaces across ${overview.sources.length} upstream registries.`
  : "Browse the externally indexed agent skills LoopSkill's federation crawl surfaces across multiple upstream registries.";

// JSON-LD: ItemList over the source buckets (real data only — one item per
// source that actually has a page here), + a Dataset node describing the
// federated index as a whole when we have a live, real total to attach to
// it (never emit a Dataset claiming a size we didn't actually measure this
// build).
const itemListSchema = overview.sources.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'LoopSkill federated skill sources',
  numberOfItems: overview.sources.length,
  itemListElement: overview.sources.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.meta.name,
    url: `${siteURL}/federation/${s.slug}/`,
  })),
} : null;

const datasetSchema = (overview.ok && overview.total && overview.sources.length > 0) ? {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'LoopSkill federated agent-skill index',
  description,
  url: `${siteURL}/federation/`,
  creator: { '@type': 'Organization', name: 'LoopSkill', url: siteURL },
  distribution: overview.sources.map((s) => ({
    '@type': 'DataDownload',
    name: s.meta.name,
    contentUrl: `${siteURL}/federation/${s.slug}/`,
  })),
  variableMeasured: 'Indexed external agent skill count',
} : null;
---

<AppShell title={title} description={description} mode="public" active="browse">
  <Fragment slot="head">
    {itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)}></script>}
    {datasetSchema && <script type="application/ld+json" set:html={JSON.stringify(datasetSchema)}></script>}
  </Fragment>
  <main class="max-w-4xl mx-auto px-6 pt-12 pb-20">
    <a href="/browse" class="text-xs text-muted hover:text-accent transition inline-flex items-center gap-1.5 mb-6">
      <Icon name="chevron-left" size={12} />
      Back to Browse
    </a>

    <header class="mb-10">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-3" style="letter-spacing: -0.03em;">Federated skill index</h1>
      <p class="text-text leading-relaxed max-w-2xl">
        LoopSkill's own catalog is curated and quality-gated. Alongside it, our federation
        crawl indexes agent skills published across a set of external community and
        vendor registries — searchable inside LoopSkill (<a href="/browse?type=skills" class="text-accent hover:underline">try the unified search</a>),
        but each one still lives, is licensed, and is maintained at its own origin. We link to that origin, never rehost it.
      </p>
      {overview.ok && overview.total !== null ? (
        <p class="mt-4 text-sm text-muted-soft">
          <strong class="text-text"><LiveCount endpoint="/api/skills/external" path="counts.external_indexed" fallback={overview.total} format="comma" /></strong> externally indexed skills across
          <strong class="text-text"> {overview.sources.length}</strong> upstream {overview.sources.length === 1 ? 'source' : 'sources'} (live count, this build — self-updates client-side without a rebuild).
        </p>
      ) : (
        <p class="mt-4 text-sm text-muted-soft">
          The federation index total is temporarily unavailable — the count below reflects only what this build could verify live. Refresh later for the current number.
        </p>
      )}
    </header>

    {overview.sources.length === 0 ? (
      <div class="bg-bg-card border border-border rounded-2xl p-8 text-center text-sm text-muted">
        The federation index could not be reached at build time. No source pages are listed here right now — this page will repopulate on the next successful build. Nothing below is fabricated; this is an honest "unavailable", not a stale or invented catalog.
      </div>
    ) : (
      <section>
        <h2 class="text-sm font-medium text-muted-soft uppercase tracking-wide mb-3">Upstream sources</h2>
        <div class="overflow-x-auto rounded-2xl border border-border">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border bg-bg-card/50 text-left text-xs uppercase tracking-wide text-muted-soft">
                <th class="px-4 py-3 font-medium">Source</th>
                <th class="px-4 py-3 font-medium">Description</th>
                <th class="px-4 py-3 font-medium text-right">Indexed skills</th>
              </tr>
            </thead>
            <tbody>
              {overview.sources.map((s) => (
                <tr class="border-b border-border-soft last:border-0 hover:bg-bg-card/40 transition">
                  <td class="px-4 py-3 font-medium text-text whitespace-nowrap">
                    <a href={`/federation/${s.slug}/`} class="hover:text-accent transition">{s.meta.name}</a>
                  </td>
                  <td class="px-4 py-3 text-muted-soft">{s.meta.description}</td>
                  <td class="px-4 py-3 text-right text-text tabular-nums">{s.total.toLocaleString()}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Self-serve registry proposal (D-031, install_0902). Backed by the
         live POST /api/federation/propose — anon-allowed, preflight checks
         the repo (exists, SKILL.md count, license) before anything is filed.
         Client island only: no build-time fetch (portal rule). Static HTML
         renders the full form per Trap C; JS adds preflight feedback +
         submit. No-JS fallback: the plain curl line stays visible. -->
    <section id="propose-source" class="mt-8 bg-bg-card border border-accent/30 rounded-2xl p-6">
      <h2 class="text-base font-semibold mb-1">Missing a registry? Propose one</h2>
      <p class="text-sm text-muted mb-4 leading-relaxed">
        Know a public repo or registry of agent skills LoopSkill doesn't index yet? Propose it —
        we pre-flight the repo (does it exist, how many SKILL.md files, what license) and open a
        review issue. Accepted sources become searchable in the federated index.
      </p>
      <div class="flex flex-col gap-3 max-w-xl">
        <div>
          <label for="propose-repo-url" class="text-[10px] uppercase tracking-wider text-muted-soft font-semibold block mb-1">Repo URL <span class="text-accent">*</span></label>
          <input id="propose-repo-url" type="url" inputmode="url" placeholder="https://github.com/owner/repo" required
                 class="w-full px-3 py-2.5 rounded-lg bg-bg-elev border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="propose-contact" class="text-[10px] uppercase tracking-wider text-muted-soft font-semibold block mb-1">Contact (optional)</label>
            <input id="propose-contact" type="text" placeholder="you@example.com or @handle"
                   class="w-full px-3 py-2.5 rounded-lg bg-bg-elev border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
          </div>
          <div>
            <label for="propose-why" class="text-[10px] uppercase tracking-wider text-muted-soft font-semibold block mb-1">Why this source? (optional)</label>
            <input id="propose-why" type="text" placeholder="What makes it worth indexing?"
                   class="w-full px-3 py-2.5 rounded-lg bg-bg-elev border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
          </div>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <button id="propose-submit" type="button" class="px-4 py-2.5 rounded-lg bg-accent text-bg text-sm font-semibold hover:bg-accent-soft transition shrink-0">Propose source</button>
          <span id="propose-status" class="text-xs text-muted-soft" role="status" aria-live="polite"></span>
        </div>
        <p id="propose-result" hidden class="text-sm rounded-lg border px-4 py-3"></p>
        <details class="text-xs text-muted-soft">
          <summary class="cursor-pointer hover:text-text transition">Agent or no-JS? Call the API directly</summary>
          <pre class="mt-2 bg-[#0d0d0d] border border-border rounded-lg p-3 overflow-x-auto"><code>{`curl -X POST https://app.loopskill.io/api/federation/propose \\
  -H "Content-Type: application/json" \\
  -d '{"repo_url":"https://github.com/owner/repo"}'`}</code></pre>
          <p class="mt-1.5">Or from a connected agent: the <code>loopskill_propose_registry</code> MCP tool. Proposals are deduped per 24h per (identity, repo).</p>
        </details>
      </div>
    </section>

    <section class="mt-12 bg-bg-card border border-border rounded-2xl p-6">
      <h2 class="text-base font-semibold mb-2">How this index works</h2>
      <p class="text-sm text-muted leading-relaxed">
        Each source page lists a representative sample of entries with a link to the
        skill's origin (its real hosting repository or registry page) — never a copy of
        its content. Counts are read live from LoopSkill's federation API at build time;
        if a source is briefly unreachable, its row and page are simply omitted from that
        build rather than showing a stale or invented number.
      </p>
    </section>
  </main>

<script is:inline>
  // Registry-proposal island: POST /api/federation/propose (anon-allowed,
  // server-side preflight). Render outcome honestly — review_channel_open
  // tells us whether a GitHub issue actually opened (bundles_0811 lesson:
  // "pending_review" alone over-promised).
  (function () {
    var btn = document.getElementById('propose-submit');
    if (!btn) return;
    var statusEl = document.getElementById('propose-status');
    var resultEl = document.getElementById('propose-result');

    function show(kind, html) {
      resultEl.hidden = false;
      resultEl.className = 'text-sm rounded-lg border px-4 py-3 ' + (
        kind === 'ok' ? 'border-success/40 bg-success/10 text-success' :
        kind === 'warn' ? 'border-accent/40 bg-accent/10 text-text' :
        'border-red-500/40 bg-red-500/10 text-red-400');
      resultEl.innerHTML = html;
    }

    btn.addEventListener('click', function () {
      var repoUrl = (document.getElementById('propose-repo-url')?.value || '').trim();
      if (!repoUrl) { show('err', 'Paste a repo URL first (e.g. https://github.com/owner/repo).'); return; }
      btn.disabled = true;
      statusEl.textContent = 'Checking the repo and filing the proposal…';
      fetch('https://app.loopskill.io/api/federation/propose', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          repo_url: repoUrl,
          contact: (document.getElementById('propose-contact')?.value || '').trim() || null,
          why: (document.getElementById('propose-why')?.value || '').trim() || null
        })
      }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          var d = res.d || {};
          statusEl.textContent = '';
          if (d.ok) {
            var pf = d.preflight || {};
            var pfLine = pf.repo_exists ? (pf.skill_md_count + ' SKILL.md files found') : '';
            if (d.status === 'already_registered') {
              show('warn', 'This repo is already registered in the federation index — nothing to propose.');
            } else if (d.status === 'already_proposed' || d.deduped) {
              show('warn', 'Already proposed recently (deduped per 24h). ' + (d.issue_url ? 'Review issue: <a class="underline" href="' + d.issue_url + '">' + d.issue_url + '</a>' : 'A review issue already tracks it.'));
            } else if (d.review_channel_open && d.issue_url) {
              show('ok', 'Proposal filed ✓ ' + (pfLine ? pfLine + ' · ' : '') + 'Review issue: <a class="underline" href="' + d.issue_url + '">' + d.issue_url + '</a>');
            } else if (d.review_channel_open) {
              // Verified live 2026-09-02: the GitHub issue is opened ASYNC by the
              // dispatch workflow seconds after this response, so issue_url is
              // legitimately empty here while review_channel_open=true. Never
              // claim the channel did not open — that was a lie this branch told.
              show('ok', 'Proposal filed ✓ ' + (pfLine ? pfLine + ' · ' : '') + 'A review issue is opening on GitHub — check <a class="underline" href="https://github.com/wisechef-ai/loopskill-api/issues?q=is%3Aissue+label%3Afederation-registry">federation-registry issues</a> in a few seconds.');
            } else {
              show('warn', 'Proposal recorded ✓ ' + (pfLine ? pfLine + ' · ' : '') + 'status: ' + (d.status || 'pending') + '. No review issue opened automatically — it will be picked up from the proposal queue.');
            }
          } else {
            var detail = (d.detail && typeof d.detail === 'object') ? (d.detail.detail || d.detail.error || '') : (d.detail || 'Proposal rejected.');
            if (detail === 'rate_limit_exceeded') detail = 'Rate limit: too many proposals from this address — try again later (24h dedupe window per repo).';
            show('err', 'Not filed: ' + detail);
          }
        })
        .catch(function () {
          statusEl.textContent = '';
          show('err', 'Network error — try the curl line below, or retry in a moment.');
        })
        .finally(function () { btn.disabled = false; });
    });
  })();
</script>
</AppShell>
