---
// loopskill_portal_0627 — The runnable loop LIBRARY (the hero).
//
// This is LoopSkill's single biggest differentiator made visible: a registry of
// vetted, *runnable* agent loops. Each card shows the safety-bounded contract
// (max_turns, network, tools), live social proof (run_count, rating), and links
// to the detail page where you can press "Run this loop" and watch it return an
// objective pass/fail.
//
// SEO: the static shell (h1, intro, JSON-LD) renders at build time so the page
// is indexable; the ranked list is client-fetched from GET /api/loops (public —
// see loopskill-api PR #21) so live run/rating counts are never baked stale.

import AppShell from "../../layouts/AppShell.astro";

const API_BASE = import.meta.env.PUBLIC_RECIPES_API_BASE || "https://recipes.wisechef.ai";
---

<AppShell mode="public"
  title="Run a loop — LoopSkill"
  description="Browse vetted, runnable agent loops. Press run and get an objective pass/fail under enforced safety bounds. The registry no competitor has."
  pageType="website"
>
  <main class="lp-loops max-w-5xl mx-auto px-6 pt-12 pb-20">
    <header class="flex flex-col gap-3 mb-8">
      <p class="eyebrow">Loops</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">The runnable registry</h1>
      <p class="text-lg text-muted leading-relaxed max-w-2xl">
        Vetted agent loops you can actually <em>run</em>. Each one declares its
        safety bounds up front, then executes its verification under enforced
        confinement and returns an objective pass / fail. No account needed to browse.
      </p>
    </header>

    <!-- Sort toggle -->
    <div class="flex items-center gap-2 mb-6">
      <button id="sort-runs" class="lp-tab lp-tab-active px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Most run</button>
      <button id="sort-newest" class="lp-tab px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Newest</button>
    </div>

    <section id="state-loading" class="text-muted text-sm py-10">Loading loops…</section>

    <section id="state-empty" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center">
      <h2 class="text-lg font-semibold mb-2">No public loops yet</h2>
      <p class="text-sm text-muted mb-5">Publish the first one — a loop is a vetted, runnable task with a verification its runs are graded against.</p>
      <a href="/docs" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Read the docs</a>
    </section>

    <section id="state-error" hidden class="bg-bg-card border border-red-500/40 rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-2">Couldn't load loops</h2>
      <p id="error-detail" class="text-sm text-muted"></p>
    </section>

    <ul id="lp-grid" hidden class="grid grid-cols-1 sm:grid-cols-2 gap-4"></ul>
  </main>
</AppShell>

<style>
  .lp-tab { border: 1px solid var(--border, #2a2f3a); color: var(--muted, #9aa3b2); background: transparent; transition: all .15s; }
  .lp-tab:hover { color: var(--text, #e6e9ef); }
  .lp-tab-active { background: var(--accent, #f5a623); color: var(--bg, #0f1115); border-color: var(--accent, #f5a623); }
  .lp-card { display: flex; flex-direction: column; gap: .55rem; padding: 1.1rem 1.25rem; background: var(--bg-card, #14171d); border: 1px solid var(--border, #2a2f3a); border-radius: 1rem; transition: border-color .15s, transform .15s; text-decoration: none; }
  .lp-card:hover { border-color: var(--accent, #f5a623); transform: translateY(-1px); }
  .lp-chip { display: inline-flex; align-items: center; gap: .25rem; font-size: 11px; padding: .15rem .5rem; border-radius: .4rem; background: var(--bg-elev, #1b1f27); border: 1px solid var(--border, #2a2f3a); color: var(--muted, #9aa3b2); }
  .lp-run { display:inline-flex; align-items:center; gap:.35rem; font-size:12px; font-weight:600; color: var(--accent, #f5a623); }
</style>

<script define:vars={{ API_BASE }}>
  const $ = (id) => document.getElementById(id);
  const show = (id) => { const e = $(id); if (e) e.hidden = false; };
  const hide = (id) => { const e = $(id); if (e) e.hidden = true; };

  let currentSort = "runs";

  function fail(detail) {
    hide("state-loading"); hide("lp-grid"); hide("state-empty");
    const d = $("error-detail"); if (d) d.textContent = detail || "";
    show("state-error");
  }

  function sortLoops(loops, sort) {
    const arr = loops.slice();
    if (sort === "newest") {
      arr.sort((a, b) => new Date(b.created_at || 0) - new Date(a.created_at || 0));
    } else {
      arr.sort((a, b) => (b.run_count || 0) - (a.run_count || 0));
    }
    return arr;
  }

  let _all = [];

  async function load() {
    show("state-loading"); hide("lp-grid"); hide("state-empty"); hide("state-error");
    let res;
    try {
      res = await fetch(`${API_BASE}/api/loops`);
    } catch (e) {
      fail("Network error: " + (e && e.message ? e.message : e));
      return;
    }
    if (!res.ok) { fail(`API returned ${res.status}.`); return; }
    let data;
    try { data = await res.json(); } catch { fail("Malformed API response."); return; }
    _all = Array.isArray(data) ? data : (data.loops || data.results || []);
    render(sortLoops(_all, currentSort));
  }

  function star(avg, count) {
    if (!count) return "Not yet rated";
    const a = Number(avg || 0).toFixed(1);
    return `★ ${a}  ·  ${count} rating${count === 1 ? "" : "s"}`;
  }

  function render(loops) {
    hide("state-loading");
    if (!loops.length) { show("state-empty"); return; }
    const grid = $("lp-grid");
    grid.innerHTML = "";
    for (const lp of loops) {
      const a = document.createElement("a");
      a.className = "lp-card";
      a.href = `/loops/run?slug=${encodeURIComponent(lp.slug)}`;

      const top = document.createElement("div");
      top.className = "flex items-center justify-between gap-2";
      const name = document.createElement("div");
      name.className = "font-semibold text-text";
      name.textContent = lp.title || lp.slug;
      top.appendChild(name);
      const runcta = document.createElement("span");
      runcta.className = "lp-run";
      runcta.textContent = "▶ Run";
      top.appendChild(runcta);
      a.appendChild(top);

      if (lp.description) {
        const desc = document.createElement("p");
        desc.className = "text-sm text-muted leading-snug line-clamp-2";
        desc.textContent = lp.description;
        a.appendChild(desc);
      }

      // Safety-bounded contract chips — the trust signal of a vetted registry.
      const chips = document.createElement("div");
      chips.className = "flex flex-wrap gap-1.5 mt-1";
      const mk = (txt) => { const s = document.createElement("span"); s.className = "lp-chip"; s.textContent = txt; return s; };
      chips.appendChild(mk(`≤ ${lp.max_turns ?? 25} turns`));
      const tools = Array.isArray(lp.tool_allowlist) ? lp.tool_allowlist.length : 0;
      chips.appendChild(mk(tools ? `${tools} tool${tools === 1 ? "" : "s"}` : "no tools"));
      if (lp.budget_usd != null) chips.appendChild(mk(`$${lp.budget_usd} budget`));
      if (lp.tier) chips.appendChild(mk(lp.tier));
      a.appendChild(chips);

      const meta = document.createElement("div");
      meta.className = "text-[11px] text-muted-soft mt-1 flex items-center gap-3";
      const runs = document.createElement("span");
      runs.textContent = `${lp.run_count || 0} run${lp.run_count === 1 ? "" : "s"}`;
      meta.appendChild(runs);
      const rating = document.createElement("span");
      rating.textContent = star(lp.rating_avg, lp.rating_count);
      meta.appendChild(rating);
      a.appendChild(meta);

      grid.appendChild(a);
    }
    show("lp-grid");
  }

  function setupTabs() {
    const tr = $("sort-runs"), tn = $("sort-newest");
    tr.addEventListener("click", () => {
      if (currentSort === "runs") return;
      currentSort = "runs";
      tr.classList.add("lp-tab-active"); tn.classList.remove("lp-tab-active");
      render(sortLoops(_all, currentSort));
    });
    tn.addEventListener("click", () => {
      if (currentSort === "newest") return;
      currentSort = "newest";
      tn.classList.add("lp-tab-active"); tr.classList.remove("lp-tab-active");
      render(sortLoops(_all, currentSort));
    });
  }

  setupTabs();
  load();
</script>
