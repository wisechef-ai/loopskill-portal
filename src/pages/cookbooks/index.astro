---
// spotify_0608 Ph F — Public bundle DISCOVER feed: /bundles
//
// The Spotify "browse" surface: a ranked, anonymous-reachable feed of public
// cookbooks. Data source: GET /api/cookbooks/discover (Ph B — public, ranked
// by real installs with test/CI excluded; sort=installs|newest). Each card
// links to /bundles/p/<slug> (the public bundle page with the one-line
// clone).
//
// SEO note: the static shell (h1, intro, JSON-LD) renders at build time so the
// page is indexable; the ranked list is client-fetched (it changes as installs
// accrue and must not bake stale rankings into dist).

import AppShell from "../../layouts/AppShell.astro";

const API_BASE = import.meta.env.PUBLIC_RECIPES_API_BASE || "https://app.loopskill.io";
---

<AppShell mode="public"
  title="Discover bundles — LoopSkill"
  description="Browse public, security-vetted skill stacks for AI agents. Compose any bundle into your agent with one MCP line."
  pageType="website"
>
  <main class="cb-discover max-w-4xl mx-auto px-6 pt-12 pb-20">
    <header class="flex flex-col gap-3 mb-8">
      <p class="eyebrow">Bundles</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Discover bundles</h1>
      <p class="text-lg text-muted leading-relaxed max-w-2xl">
        Curated, security-vetted skill stacks for AI agents. Open any bundle and
        compose the whole thing into your agent with one MCP line — no account
        needed to install free skills.
      </p>
    </header>

    <!-- Sort toggle -->
    <div class="flex items-center gap-2 mb-6">
      <button id="sort-installs" class="cb-tab cb-tab-active px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Top</button>
      <button id="sort-newest" class="cb-tab px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Newest</button>
    </div>

    <section id="state-loading" class="text-muted text-sm py-10">Loading bundles…</section>

    <section id="state-empty" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center">
      <h2 class="text-lg font-semibold mb-2">No public bundles yet</h2>
      <p class="text-sm text-muted mb-5">Be the first to publish one — compose a skill stack and share it as a link.</p>
      <a href="/pricing" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Get started</a>
    </section>

    <section id="state-error" hidden class="bg-bg-card border border-red-500/40 rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-2">Couldn't load bundles</h2>
      <p id="error-detail" class="text-sm text-muted"></p>
    </section>

    <ul id="cb-grid" hidden class="grid grid-cols-1 sm:grid-cols-2 gap-4"></ul>
  </main>
</AppShell>

<style>
  .cb-tab { border: 1px solid var(--border, #2a2f3a); color: var(--muted, #9aa3b2); background: transparent; transition: all .15s; }
  .cb-tab:hover { color: var(--text, #e6e9ef); }
  .cb-tab-active { background: var(--accent, #f5a623); color: var(--bg, #0f1115); border-color: var(--accent, #f5a623); }
  .cb-card { display: flex; flex-direction: column; gap: .5rem; padding: 1.1rem 1.25rem; background: var(--bg-card, #14171d); border: 1px solid var(--border, #2a2f3a); border-radius: 1rem; transition: border-color .15s, transform .15s; text-decoration: none; }
  .cb-card:hover { border-color: var(--accent, #f5a623); transform: translateY(-1px); }
</style>

<script define:vars={{ API_BASE }}>
  const $ = (id) => document.getElementById(id);
  const show = (id) => { const e = $(id); if (e) e.hidden = false; };
  const hide = (id) => { const e = $(id); if (e) e.hidden = true; };

  let currentSort = "installs";

  function fail(detail) {
    hide("state-loading"); hide("cb-grid"); hide("state-empty");
    const d = $("error-detail"); if (d) d.textContent = detail || "";
    show("state-error");
  }

  async function load(sort) {
    currentSort = sort;
    show("state-loading"); hide("cb-grid"); hide("state-empty"); hide("state-error");
    let res;
    try {
      res = await fetch(`${API_BASE}/api/cookbooks/discover?sort=${encodeURIComponent(sort)}&limit=50`);
    } catch (e) {
      fail("Network error: " + (e && e.message ? e.message : e));
      return;
    }
    if (!res.ok) { fail(`API returned ${res.status}.`); return; }
    let data;
    try { data = await res.json(); } catch { fail("Malformed API response."); return; }
    render(data.cookbooks || []);
  }

  function render(bundles) {
    hide("state-loading");
    if (!bundles.length) { show("state-empty"); return; }
    const grid = $("cb-grid");
    grid.innerHTML = "";
    for (const cb of bundles) {
      const ref = cb.ref ? `?ref=${encodeURIComponent(cb.ref)}` : "";
      const a = document.createElement("a");
      a.className = "cb-card";
      a.href = `/bundles/p/${encodeURIComponent(cb.slug)}${ref}`;

      const name = document.createElement("div");
      name.className = "font-semibold text-text";
      name.textContent = cb.name || cb.slug;
      a.appendChild(name);

      if (cb.description) {
        const desc = document.createElement("p");
        desc.className = "text-sm text-muted leading-snug line-clamp-2";
        desc.textContent = cb.description;
        a.appendChild(desc);
      }

      const meta = document.createElement("div");
      meta.className = "text-[11px] text-muted-soft mt-1";
      const bits = [`${cb.skill_count || 0} skill${(cb.skill_count === 1) ? "" : "s"}`];
      if (typeof cb.installs_total === "number") bits.push(`${cb.installs_total} install${cb.installs_total === 1 ? "" : "s"}`);
      if (typeof cb.installs_7d === "number" && cb.installs_7d > 0) bits.push(`${cb.installs_7d} this week`);
      meta.textContent = bits.join("  ·  ");
      a.appendChild(meta);

      grid.appendChild(a);
    }
    show("cb-grid");
  }

  function setupTabs() {
    const ti = $("sort-installs"), tn = $("sort-newest");
    ti.addEventListener("click", () => {
      if (currentSort === "installs") return;
      ti.classList.add("cb-tab-active"); tn.classList.remove("cb-tab-active");
      load("installs");
    });
    tn.addEventListener("click", () => {
      if (currentSort === "newest") return;
      tn.classList.add("cb-tab-active"); ti.classList.remove("cb-tab-active");
      load("newest");
    });
  }

  setupTabs();
  load("installs");
</script>
