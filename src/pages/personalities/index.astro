---
// loopskill_portal_0627 — Personalities library.
//
// A personality is a reusable agent persona (a vetted system_prompt + config)
// you can install into your agent. Same browse pattern as /loops: static SEO
// shell + client-fetched ranked list from GET /api/personalities (public —
// see loopskill-api PR #22). Detail/install lives on the public skill-style
// flow; this page is the discoverable catalog.

import AppShell from "../../layouts/AppShell.astro";

const API_BASE = import.meta.env.PUBLIC_RECIPES_API_BASE || "https://app.loopskill.io";
---

<AppShell mode="public"
  title="Personalities — LoopSkill"
  description="Browse vetted agent personalities — reusable system prompts + config you install into your agent in one line. Open source, free to self-host."
  pageType="website"
  active="personalities"
>
  <main class="lp-pers max-w-5xl mx-auto px-6 pt-12 pb-20">
    <header class="flex flex-col gap-3 mb-8">
      <p class="eyebrow">Personalities</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Give your agent a personality</h1>
      <p class="text-lg text-muted leading-relaxed max-w-2xl">
        Vetted agent personas — a reusable system prompt plus config — you install
        into your agent in one line. Pick a voice, a discipline, a way of working;
        compose it with loops and skills.
      </p>
    </header>

    <div class="flex items-center gap-2 mb-6">
      <button id="sort-installs" class="lp-tab lp-tab-active px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Most installed</button>
      <button id="sort-newest" class="lp-tab px-3 py-1.5 rounded-lg text-sm font-medium" type="button">Newest</button>
    </div>

    <section id="state-loading" class="text-muted text-sm py-10">Loading personalities…</section>

    <section id="state-empty" hidden class="bg-bg-card border border-border rounded-2xl p-8 text-center">
      <h2 class="text-lg font-semibold mb-2">No personalities yet</h2>
      <p class="text-sm text-muted mb-5">Publish the first one — a personality is a vetted system prompt + config your agent installs in one line.</p>
      <a href="/docs" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Read the docs</a>
    </section>

    <section id="state-error" hidden class="bg-bg-card border border-red-500/40 rounded-2xl p-6">
      <h2 class="text-lg font-semibold mb-2">Couldn't load personalities</h2>
      <p id="error-detail" class="text-sm text-muted"></p>
    </section>

    <ul id="lp-grid" hidden class="grid grid-cols-1 sm:grid-cols-2 gap-4"></ul>
  </main>
</AppShell>

<style>
  .lp-tab { border: 1px solid var(--border, #2a2f3a); color: var(--muted, #9aa3b2); background: transparent; transition: all .15s; }
  .lp-tab:hover { color: var(--text, #e6e9ef); }
  .lp-tab-active { background: var(--accent, #f5a623); color: var(--bg, #0f1115); border-color: var(--accent, #f5a623); }
  .lp-card { display: flex; flex-direction: column; gap: .55rem; padding: 1.1rem 1.25rem; background: var(--bg-card, #14171d); border: 1px solid var(--border, #2a2f3a); border-radius: 1rem; transition: border-color .15s, transform .15s; }
  .lp-card:hover { border-color: var(--accent, #f5a623); transform: translateY(-1px); }
  .lp-chip { display:inline-flex; align-items:center; gap:.25rem; font-size:11px; padding:.15rem .5rem; border-radius:.4rem; background:var(--bg-elev,#1b1f27); border:1px solid var(--border,#2a2f3a); color:var(--muted,#9aa3b2); }
</style>

<script define:vars={{ API_BASE }}>
  const $ = (id) => document.getElementById(id);
  const show = (id) => { const e = $(id); if (e) e.hidden = false; };
  const hide = (id) => { const e = $(id); if (e) e.hidden = true; };
  let currentSort = "installs";
  let _all = [];

  function fail(detail) {
    hide("state-loading"); hide("lp-grid"); hide("state-empty");
    const d = $("error-detail"); if (d) d.textContent = detail || "";
    show("state-error");
  }

  function sortItems(items, sort) {
    const arr = items.slice();
    if (sort === "newest") arr.sort((a, b) => new Date(b.created_at || 0) - new Date(a.created_at || 0));
    else arr.sort((a, b) => (b.install_count || 0) - (a.install_count || 0));
    return arr;
  }

  async function load() {
    show("state-loading"); hide("lp-grid"); hide("state-empty"); hide("state-error");
    let res;
    try { res = await fetch(`${API_BASE}/api/personalities`); }
    catch (e) { fail("Network error: " + (e && e.message ? e.message : e)); return; }
    if (!res.ok) { fail(`API returned ${res.status}.`); return; }
    let data;
    try { data = await res.json(); } catch { fail("Malformed API response."); return; }
    _all = Array.isArray(data) ? data : (data.personalities || data.results || []);
    render(sortItems(_all, currentSort));
  }

  function render(items) {
    hide("state-loading");
    if (!items.length) { show("state-empty"); return; }
    const grid = $("lp-grid");
    grid.innerHTML = "";
    for (const p of items) {
      const card = document.createElement("div");
      card.className = "lp-card";

      const top = document.createElement("div");
      top.className = "flex items-center justify-between gap-2";
      const name = document.createElement("div");
      name.className = "font-semibold text-text";
      name.textContent = p.title || p.slug;
      top.appendChild(name);
      if (p.tier) { const t = document.createElement("span"); t.className = "lp-chip"; t.textContent = p.tier === "free" ? "free" : (p.tier === "pro_plus" ? "PRO+" : "PRO"); top.appendChild(t); }
      card.appendChild(top);

      if (p.description) {
        const desc = document.createElement("p");
        desc.className = "text-sm text-muted leading-snug line-clamp-2";
        desc.textContent = p.description;
        card.appendChild(desc);
      }

      const meta = document.createElement("div");
      meta.className = "text-[11px] text-muted-soft mt-1 flex items-center gap-3";
      const inst = document.createElement("span");
      inst.textContent = `${p.install_count || 0} install${p.install_count === 1 ? "" : "s"}`;
      meta.appendChild(inst);
      if (p.category) { const c = document.createElement("span"); c.className = "capitalize"; c.textContent = p.category; meta.appendChild(c); }
      if (p.creator_handle) { const h = document.createElement("span"); h.textContent = `by @${p.creator_handle}`; meta.appendChild(h); }
      card.appendChild(meta);

      // install command (copy)
      const cmd = document.createElement("code");
      cmd.className = "mt-2 text-[11px] bg-[#0d0d0d] border border-border rounded px-2 py-1.5 block overflow-x-auto cursor-pointer";
      cmd.textContent = `loopskill install personality ${p.slug}`;
      cmd.title = "Click to copy";
      cmd.addEventListener("click", () => { navigator.clipboard?.writeText(cmd.textContent); cmd.textContent = "copied ✓ " + p.slug; setTimeout(() => cmd.textContent = `loopskill install personality ${p.slug}`, 1200); });
      card.appendChild(cmd);

      grid.appendChild(card);
    }
    show("lp-grid");
  }

  function setupTabs() {
    const ti = $("sort-installs"), tn = $("sort-newest");
    ti.addEventListener("click", () => { if (currentSort === "installs") return; currentSort = "installs"; ti.classList.add("lp-tab-active"); tn.classList.remove("lp-tab-active"); render(sortItems(_all, currentSort)); });
    tn.addEventListener("click", () => { if (currentSort === "newest") return; currentSort = "newest"; tn.classList.add("lp-tab-active"); ti.classList.remove("lp-tab-active"); render(sortItems(_all, currentSort)); });
  }

  setupTabs();
  load();
</script>
