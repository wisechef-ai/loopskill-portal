---
// /home — Spotify-model IA (feat/spotify-ia, council report §2).
// Compact header + real-data shelves ONLY, in fixed order:
//   1. Popular loops    (GET /api/loops)
//   2. Curated skills   (GET /api/skills/search)
//   3. Public bundles   (GET /api/bundles/discover, compat /api/cookbooks/discover)
//   4. Personalities    (GET /api/personalities)
// A shelf with zero rows renders NEITHER its cards NOR its header. If every
// shelf is empty, render one centered empty state with Retry + Browse — never
// fictional fallback cards (assert-dist guards this).
//
// Rail spec (council §1) lists Home as "anon + member" — unlike Library,
// anonymous visitors must NOT be bounced here. mode="public": no anon
// bounce, no gate splash; both anon and member subline copy exist in
// static HTML (AGENTS.md Trap C) and the boot script below swaps the
// subline once /api/auth/me resolves client-side (Trap B — never a
// build-time user-data fetch).
import AppShell from '../layouts/AppShell.astro';
---
<AppShell mode="public" title="Home — LoopSkill" description="Explore runnable AI-agent artifacts — loops, skills, bundles, and personalities." active="home">
  <main class="ls-page max-w-6xl mx-auto pb-24">
    <header class="mb-8">
      <h1 class="ls-page-title text-text">Home</h1>
      <p class="ls-body text-muted mt-1" id="home-subline">Explore runnable AI-agent artifacts.</p>
    </header>

    <div id="home-shelves"></div>

    <!-- All-empty system state (council §2) -->
    <div id="home-empty-all" hidden class="ls-body text-muted py-20 text-center flex flex-col items-center gap-4">
      <p>Nothing is available right now.</p>
      <div class="flex items-center gap-3">
        <button id="home-retry" type="button" class="ls-button px-4 py-2 rounded-lg bg-accent text-bg hover:bg-accent-soft transition">Retry</button>
        <a href="/browse" class="ls-button px-4 py-2 rounded-lg border border-border hover:border-accent text-text transition">Browse</a>
      </div>
    </div>
  </main>
</AppShell>

<script>
  import { identiconSVG } from '../lib/identicon';
  const API_BASE = (import.meta as any).env?.PUBLIC_RECIPES_API_BASE || 'https://app.loopskill.io';
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: any) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as any)[c]);

  const GRAD: [string, string][] = [['#1fb6c0','#0d7d77'],['#a06bff','#6d28d9'],['#c084fc','#7c3aed'],['#ffb446','#c2410c'],['#ff6e50','#b91c1c'],['#34d399','#0f766e'],['#60a5fa','#1d4ed8']];
  function hashIdx(s: string, n: number): number { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0; return h % n; }

  type ShelfType = 'loops' | 'skills' | 'bundles' | 'personalities';
  const BADGE: Record<ShelfType, string> = { loops: 'Loop', skills: 'Skill', bundles: 'Bundle', personalities: 'Personality' };

  function href(type: ShelfType, item: any): string {
    if (type === 'loops') return `/loops/${encodeURIComponent(item.slug)}`;
    if (type === 'skills') return `/skills/${encodeURIComponent(item.slug)}`;
    if (type === 'bundles') return `/bundles/p?slug=${encodeURIComponent(item.slug)}`;
    return '/browse?type=personalities';
  }
  function meta(type: ShelfType, item: any): string {
    if (type === 'loops') { const n = item.run_count || 0; return n > 0 ? `${n} run${n === 1 ? '' : 's'}` : 'Not yet run'; }
    if (type === 'skills') {
      const n = item.install_count_total || item.install_count || 0;
      const cat = item.category || '';
      if (n > 0 && cat) return `${cat} · ${n.toLocaleString()} installs`;
      if (n > 0) return `${n.toLocaleString()} installs`;
      return cat;
    }
    if (type === 'bundles') { const n = item.skill_count; return typeof n === 'number' ? `${n} skill${n === 1 ? '' : 's'}` : ''; }
    if (type === 'personalities') return item.source || item.role || item.category || '';
    return '';
  }
  function cardHTML(type: ShelfType, item: any): string {
    const grad = GRAD[hashIdx(item.slug || item.title || 'x', GRAD.length)];
    const mono = ((item.title || item.slug || 'L').trim()[0] || 'L').toUpperCase();
    const m = meta(type, item);
    const ariaLabel = `${BADGE[type]}: ${item.title || item.slug}${m ? '. ' + m : ''}`;
    return `<a href="${esc(href(type, item))}" class="artifact-card" data-artifact-type="${type}" data-artifact-slug="${esc(item.slug)}" aria-label="${esc(ariaLabel)}">
      <span class="artifact-cover" style="background:linear-gradient(135deg, ${grad[0]} 0%, ${grad[1]} 100%);">
        ${identiconSVG(item.slug || item.title || 'loopskill')}
        <span class="artifact-badge">${BADGE[type]}</span>
        <span class="artifact-mono" aria-hidden="true">${esc(mono)}</span>
      </span>
      <span class="artifact-title">${esc(item.title || item.slug)}</span>
      ${m ? `<span class="artifact-meta">${esc(m)}</span>` : ''}
    </a>`;
  }
  function shelfHTML(title: string, type: ShelfType, items: any[]): string {
    // Council §2: a shelf with zero rows does not render — NOT its header either.
    if (!items.length) return '';
    return `<section class="ls-section">
      <div class="flex items-center justify-between ls-section-header">
        <h2 class="ls-section-title text-text">${esc(title)}</h2>
        <a href="/browse?type=${type}" class="text-xs text-accent hover:opacity-80 shrink-0">See all →</a>
      </div>
      <div class="shelf-row">${items.map((it) => cardHTML(type, it)).join('')}</div>
    </section>`;
  }

  async function fetchJson(u: string): Promise<any> {
    try {
      const r = await fetch(u, { credentials: 'include' });
      return r.ok ? await r.json() : null;
    } catch { return null; }
  }

  async function loadShelves() {
    $('home-empty-all').hidden = true;
    const wrap = $('home-shelves');
    wrap.innerHTML = `<div class="ls-body text-muted py-12 text-center">Loading…</div>`;

    // Greeting/subline: member vs anon copy, resolved from /api/auth/me
    // (client-side per AGENTS.md Trap B — never at build time).
    const me = await fetchJson(`${API_BASE}/api/auth/me`);
    const subline = $('home-subline');
    if (subline) subline.textContent = me ? 'Pick up where your agents left off.' : 'Explore runnable AI-agent artifacts.';

    const [loopsData, skillsData, bundlesDataPrimary, bundlesDataCompat, persData] = await Promise.all([
      fetchJson(`${API_BASE}/api/loops`),
      fetchJson(`${API_BASE}/api/skills/search?page_size=12`),
      fetchJson(`${API_BASE}/api/bundles/discover?sort=installs&limit=12`),
      fetchJson(`${API_BASE}/api/cookbooks/discover?sort=installs&limit=12`),
      fetchJson(`${API_BASE}/api/personalities`),
    ]);

    const loops: any[] = loopsData ? (Array.isArray(loopsData) ? loopsData : (loopsData.loops || loopsData.results || [])) : [];
    const skills: any[] = skillsData ? (skillsData.results || []) : [];
    const bundles: any[] = (bundlesDataPrimary && (bundlesDataPrimary.cookbooks || bundlesDataPrimary.bundles))
      || (bundlesDataCompat && (bundlesDataCompat.cookbooks || bundlesDataCompat.bundles))
      || [];
    const personalities: any[] = persData ? (Array.isArray(persData) ? persData : (persData.personalities || persData.results || [])) : [];

    const html =
      shelfHTML('Popular loops', 'loops', loops.slice(0, 12)) +
      shelfHTML('Curated skills', 'skills', skills.slice(0, 12)) +
      shelfHTML('Public bundles', 'bundles', bundles.slice(0, 12)) +
      shelfHTML('Personalities', 'personalities', personalities.slice(0, 12));

    if (!html) {
      wrap.innerHTML = '';
      $('home-empty-all').hidden = false;
    } else {
      wrap.innerHTML = html;
    }
  }

  $('home-retry').addEventListener('click', loadShelves);
  loadShelves();
</script>
