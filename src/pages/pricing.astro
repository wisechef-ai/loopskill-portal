---
import AppShell from '../layouts/AppShell.astro';
import CrossSell from '../components/CrossSell.astro';
import EarningsCalculator from '../components/EarningsCalculator.astro';

const tiers = [
  {
    name: 'Pro',
    price: '20',
    cadence: 'per month',
    currency: '$',
    tagline: '1 seat. Every paid skill. Local-first.',
    headline: 'Single seat. Browse and install every paid skill in the catalog. Bundles (private skill bundles) for your own use. Cross-vendor: same skill works on Claude Code, Cursor, Windsurf, Cline, OpenClaw, Hermes. Cancel anytime — installed skills keep working.',
    badgeClass: 'badge-pro',
    cta: 'Start Pro — $20/mo',
    ctaAuthed: 'Switch to Pro',
    ctaHref: '/signin?next=/api/checkout/pro',
    ctaTier: 'pro',
    accent: true,
    features: [
      'Every paid skill in the catalog — cross-vendor (Claude Code, Cursor, Cline, OpenClaw, Hermes)',
      'Personal bundle — bundle your favourite skills, synced across your machines',
      'Auto-update channel — patched skills delivered the day they ship, ed25519-signed',
      'Zero-to-productive transfer — new agent? Tell it "install the recipes skill" → full library in 60 seconds',
      '50% recurring rev share on every Pro/Pro+ user you refer',
    ],
    notFor: 'Not for: deploying skills to client agents you operate (use Pro+).',
  },
  {
    name: 'Pro+',
    price: '100',
    cadence: 'per month',
    currency: '$',
    tagline: 'Up to 200 bundles. Resell at any rate.',
    headline: 'Pro, plus up to 200 bundles — push your private bundles straight into agents you operate for clients. Resell skills at YOUR price (we keep zero). Private org-only catalog for skills you don\'t want public. 60-min onboarding for the first deployment.',
    badgeClass: 'badge-pro-plus',
    cta: 'Start Pro+ — $100/mo',
    ctaAuthed: 'Upgrade to Pro+',
    ctaHref: '/signin?next=/api/checkout/pro_plus',
    ctaTier: 'pro_plus',
    accent: false,
    moneyBack: '14-day money-back',
    features: [
      'Everything in Pro',
      'Up to 200 bundles — deploy bundles into agents you operate for clients',
      'Resell at YOUR rate — bill clients $300/mo, we still charge you $100',
      'Private org catalog — internal-only skills, never public',
      '60-min onboarding call + priority 24h skill review',
    ],
    notFor: null,
  },
];

// Free tier removed from /pricing rev 7.2.4 (Adam directive 2026-05-10).
// Free skills (super-memory, MIT) remain available — see /skills and the
// homepage catch-skill flow. They are simply not sold as a "tier" here.
// Removing Free clarifies the value prop: Pro vs Pro+ is the real decision.

const faqs = [
  {
    q: 'Can I white-label Pro+ for my clients? Will they see LoopSkill branding?',
    a: 'No LoopSkill branding appears in your client\'s agent runtime. Pro+ pushes your bundles (private skill bundles) into the agents you operate for clients — the skills run locally on the client\'s machine or yours, no cloud round-trip. Your client sees your agent doing your work; they don\'t see us. You bill them at YOUR rate ($300/mo, $500/mo, whatever your contract says) — we still charge YOU $100/mo flat. Whatever margin you set is yours.',
  },
  {
    q: 'Does my install stop working if I cancel Pro+?',
    a: 'No. The skills you have already installed keep running on your machine — they live locally, not in our cloud. Cancellation only stops auto-improvement updates and access to new catalog content. You can re-subscribe later and pick up exactly where you left off.',
  },
  {
    q: 'What if I switch from Pro+ to Pro?',
    a: 'Use the in-app downgrade button (or hit POST /api/subscriptions/downgrade). Stripe applies prorated credit for the unused portion of Pro+ to your next Pro invoice — no money lost, no surprise charge. Your private catalog and onboarding artefacts stay accessible until the end of the billing period.',
  },
  {
    q: 'Is this a real subscription or one-time?',
    a: 'Real monthly subscription handled by Stripe. EU pricing includes Stripe Tax / VAT MOSS. Receipts come from Stripe — we never custody your money.',
  },
  {
    q: 'Why $20 / $100 and not less?',
    a: '$20 covers operating one engineer\'s ongoing work on the catalog. $100 covers the 20-endpoint client deployment surface, the white-glove onboarding, and the priority skill review. The price funds the work; lower numbers fund nothing.',
  },
];
---

<AppShell title="Pricing — LoopSkill" description="Free, Pro $20/mo (1 seat, 10 bundles), Pro+ $100/mo (200 bundles). Cross-vendor catalog of agent skills. Cancel anytime, your installed skills keep working." mode="public">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-3 mb-14">
      <p class="eyebrow">Pricing</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Bring your agent. We bring the skills.</h1>
      <p class="text-muted">Start with Pro when you start deploying to your clients or running multi-agent fleets, pick Pro+. In 95% of cases Pro is what you need.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {tiers.map(t => (
        <div class={`relative bg-bg-card border ${t.accent ? 'border-accent glow-amber' : 'border-border'} rounded-2xl p-6 md:p-7 flex flex-col gap-5`}>
          {t.accent && <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-accent text-bg text-[11px] font-semibold uppercase tracking-wider">Most popular</div>}
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-xl font-semibold text-text">{t.name}</h3>
              <p class="text-xs text-muted-soft mt-1">{t.tagline}</p>
            </div>
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider ${t.badgeClass}`}>{t.name.toUpperCase()}</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-4xl md:text-5xl font-semibold text-text">{t.currency}{t.price}</span>
            <span class="text-sm text-muted">{t.cadence === 'forever' ? '· forever' : `/${t.cadence.replace('per ', '')}`}</span>
          </div>
          {t.headline && <p class="text-sm text-muted leading-relaxed">{t.headline}</p>}
          {t.moneyBack && (
            <span class="inline-flex items-center self-start gap-1.5 px-2 py-0.5 rounded-full border border-success/40 text-success text-[10px] font-semibold uppercase tracking-wider bg-success/10">
              {t.moneyBack}
            </span>
          )}
          <ul class="flex flex-col gap-2.5 text-sm text-muted">
            {t.features.map(f => (
              <li class="flex items-start gap-2">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-success mt-0.5 shrink-0"><path d="M3 8.5L6 11.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {t.notFor && (
            <p class="text-xs text-muted-soft italic border-t border-border-soft pt-3 mt-1">{t.notFor}</p>
          )}
          <a href={t.ctaHref}
             data-tier={t.ctaTier}
             data-cta-anon={t.cta}
             data-cta-authed={t.ctaAuthed}
             class={`tier-cta block text-center px-4 py-2.5 rounded-lg font-semibold text-sm transition mt-auto ${t.accent ? 'bg-accent text-bg hover:bg-accent-soft' : 'border border-border hover:border-accent text-text'}`}>
            {t.cta}
          </a>
        </div>
      ))}
    </div>

    {/* Free skills callout — discoverability for super-memory now that Free tier is gone */}
    <div class="max-w-4xl mx-auto mt-6 px-6 py-4 rounded-xl border border-border-soft bg-bg-card/30 flex flex-col md:flex-row items-center justify-between gap-3 text-sm">
      <div class="flex items-center gap-3 text-muted">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider badge-free">FREE</span>
        <span>Open-source skills like <a href="/skills/super-memory" class="text-accent hover:underline">super-memory</a> (MIT) install free. No subscription, no card. <span class="text-muted-soft">Try the engine before you pay.</span></span>
      </div>
      <a href="/skills?tier=free" class="text-xs text-accent hover:underline whitespace-nowrap">Browse free skills →</a>
    </div>

    <p class="text-center text-xs text-muted-soft mt-8">Cancel anytime. EU pricing includes VAT MOSS. Receipts via Stripe.</p>
  </section>

  <section class="border-t border-border">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <div class="flex flex-col items-center text-center gap-3 mb-10">
        <p class="eyebrow">FAQ</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Common questions</h2>
      </div>
      <div class="flex flex-col gap-3">
        {faqs.map(f => (
          <details class="group bg-bg-card border border-border rounded-xl px-5 py-4 open:border-accent/40 transition">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-text">
              <span>{f.q}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-muted-soft transition-transform group-open:rotate-180" aria-hidden="true">
                <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Earnings widget: below FAQ ── -->
  <section class="border-t border-border">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="flex flex-col gap-3 mb-10 text-center items-center">
        <p class="eyebrow">For creators &amp; operators</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">See what you'll earn referring LoopSkill →</h2>
        <p class="text-muted max-w-lg">50% recurring rev share on every Pro and Pro+ subscriber you refer. Bundle deployments add up fast.</p>
      </div>
      <EarningsCalculator />
    </div>
  </section>

  <CrossSell variant="banner" title="Need it run for you?" body="WiseChef Framework gives you a managed AI employee — same skills as LoopSkill, but operated end-to-end. Starting at €199/month." />
</AppShell>

<script>
  (async () => {
    const buttons = document.querySelectorAll<HTMLAnchorElement>('a.tier-cta[data-tier]');
    if (buttons.length === 0) return;

    // Pick up an optional promo code from ?promo=CODE in the URL.
    // Stored on window so the click handler can pass it to /api/checkout.
    const urlParams = new URLSearchParams(window.location.search);
    let promoCode = urlParams.get('promo') || urlParams.get('coupon');
    if (promoCode) {
      promoCode = promoCode.trim().toUpperCase();
      // Surface a small banner so the user knows a code is being applied.
      const banner = document.createElement('div');
      banner.className = 'max-w-3xl mx-auto mt-4 px-6';
      banner.innerHTML = `
        <div class="bg-accent/10 border border-accent/40 rounded-xl px-4 py-3 text-sm flex items-center gap-3">
          <span class="text-accent font-semibold">🎟️ Promo code applied:</span>
          <code class="font-mono text-xs bg-bg-elev border border-border rounded px-2 py-0.5">${promoCode}</code>
          <span class="text-muted text-xs">Discount will appear at checkout.</span>
        </div>`;
      const heroSection = document.querySelector('section');
      heroSection?.parentNode?.insertBefore(banner, heroSection.nextSibling);
    }

    let me: any = null;
    try {
      const r = await fetch('/api/auth/me', { credentials: 'include' });
      if (r.ok) me = await r.json();
    } catch { /* ignore */ }

    if (me) {
      const currentTier = (me.subscription_tier || '').toLowerCase();
      const isFree = !currentTier || me.subscription_status !== 'active';
      buttons.forEach(btn => {
        const tier = (btn.getAttribute('data-tier') || '').toLowerCase();
        const authedLabel = btn.getAttribute('data-cta-authed');
        if (authedLabel) btn.textContent = authedLabel;
        const isCurrent = (tier === 'free' && isFree) || (tier === currentTier && !isFree);
        if (isCurrent) {
          btn.textContent = 'Current plan ✓';
          btn.classList.add('opacity-60', 'pointer-events-none');
          btn.setAttribute('aria-disabled', 'true');
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (btn.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
        const tier = btn.getAttribute('data-tier');
        if (!tier || tier === 'free') return;
        e.preventDefault();
        const originalText = btn.textContent;
        btn.textContent = 'Loading…';
        if (me) {
          try {
            const body: Record<string, string> = {};
            if (promoCode) body.promo_code = promoCode;
            const res = await fetch(`/api/checkout/${tier}`, {
              method: 'POST', credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (res.ok) {
              const data = await res.json();
              window.location.href = data.url;
              return;
            }
          } catch { /* fall through */ }
          btn.textContent = originalText;
          // Preserve the promo code through the signin redirect so the
          // user lands back on /pricing?promo=… after auth.
          const next = btn.getAttribute('href') || '/signin';
          if (promoCode && next.includes('/signin')) {
            const sep = next.includes('?') ? '&' : '?';
            window.location.href = `${next}${sep}promo=${encodeURIComponent(promoCode)}`;
          } else {
            window.location.href = next;
          }
        } else {
          const next = btn.getAttribute('href') || '/signin';
          if (promoCode && next.includes('/signin')) {
            const sep = next.includes('?') ? '&' : '?';
            window.location.href = `${next}${sep}promo=${encodeURIComponent(promoCode)}`;
          } else {
            window.location.href = next;
          }
        }
      });
    });
  })();
</script>
