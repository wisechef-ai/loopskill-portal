---
import Base from '../layouts/Base.astro';
import CrossSell from '../components/CrossSell.astro';

const tiers = [
  {
    name: 'Cook',
    price: '5',
    cadence: 'per month',
    tagline: 'Self-healing catalog. All skills.',
    headline: 'Self-healing catalog. All skills. Auto-improvement updates. Architecture-aware install.',
    badgeClass: 'badge-free',
    cta: 'Start with Cook',
    ctaAuthed: 'Switch to Cook',
    ctaHref: '/signin?next=/api/checkout/cook',
    ctaTier: 'cook',
    accent: false,
    features: [
      'Self-healing catalog — every skill',
      'Auto-improvement updates',
      'Architecture-aware install',
      'Daily 7-card carousel',
      'API library (30+ specs)',
      'Community support',
    ],
  },
  {
    name: 'Operator',
    price: '25',
    cadence: 'per month',
    tagline: 'Cook + personal forks.',
    headline: 'Cook + personal forks. Edit any skill, version it, share with your team.',
    badgeClass: 'badge-pro',
    cta: 'Start with Operator',
    ctaAuthed: 'Upgrade to Operator',
    ctaHref: '/signin?next=/api/checkout/operator',
    ctaTier: 'operator',
    accent: true,
    features: [
      'Everything in Cook',
      'Personal forks of any skill',
      'Edit, version, and ship',
      'Share forks with your team',
      'Usage analytics dashboard',
      'Priority review (48h SLA)',
    ],
  },
  {
    name: 'Studio',
    price: '99',
    cadence: 'per month',
    tagline: 'Operator + fleet bootstrap + white-label.',
    headline: 'Operator + fleet bootstrap + white-label. One command spins up your full agent stack on any host.',
    badgeClass: 'badge-studio',
    cta: 'Talk to us',
    ctaAuthed: 'Talk to us',
    ctaHref: 'https://calendar.app.google/P9J9oaiemtHdsvG99',
    accent: false,
    moneyBack: '14-day money-back',
    features: [
      'Everything in Operator',
      'Fleet bootstrap — one command',
      'White-label option',
      'Private catalog (org-only skills)',
      '10 team seats included',
      'Team analytics & telemetry',
      'Dedicated 24h review SLA',
      '14-day money-back guarantee',
    ],
  },
];

const faqs = [
  {
    q: 'What does the Studio money-back guarantee cover?',
    a: 'If Studio doesn\'t spin up your agent stack the way you expected within 14 days of subscribing, email support and we refund the full month — no clawback on payouts to creators, no questions tied to usage. One-time per organization.',
  },
  {
    q: 'How does fleet bootstrap work?',
    a: 'Studio ships a single install command that provisions the meta-skill, your private catalog, and any pinned skills onto a fresh host. Architecture-aware: it refuses to install on incompatible hardware and suggests alternatives instead of failing silently.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. All tiers cancel at the end of the current billing period. Your installed skills keep running locally; only auto-improvement updates and new catalog access stop.',
  },
];

const creatorEcon = [
  { label: 'Cook tier creators', share: '50%', desc: 'Usage-attributed. We reward quality, not referrals.' },
  { label: 'Operator tier creators', share: '60%', desc: 'Higher share for skills that go through Operator-only paths.' },
  { label: 'Studio private skills', share: '70%', desc: 'Orgs keeping IP local get the highest share.' },
  { label: 'First 50 publishers', share: '75%', desc: 'Locked-in for life. Recruitment incentive.' },
];
---

<Base title="Pricing — Recipes" description="Simple plans for agents, agencies, and fleets. Cook $5/mo. Operator $25/mo. Studio $99/mo. Usage-attributed creator economy.">
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-3 mb-14">
      <p class="eyebrow">Pricing</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">One subscription. Unlimited skills.</h1>
      <p class="text-muted">All plans include the daily carousel, the meta-skill, and the API library. Pick the tier that matches your fleet size.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {tiers.map(t => (
        <div class={`relative bg-bg-card border ${t.accent ? 'border-accent glow-amber' : 'border-border'} rounded-2xl p-6 md:p-7 flex flex-col gap-5`}>
          {t.accent && <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-accent text-bg text-[11px] font-semibold uppercase tracking-wider">Most popular</div>}
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="text-xl font-semibold text-text">{t.name}</h3>
              <p class="text-xs text-muted-soft mt-1">{t.tagline}</p>
            </div>
            <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider ${t.badgeClass}`}>{t.name.toUpperCase()}</span>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-4xl md:text-5xl font-semibold text-text">${t.price}</span>
            <span class="text-sm text-muted">/{t.cadence.replace('per ', '')}</span>
          </div>
          {t.headline && <p class="text-sm text-muted leading-relaxed">{t.headline}</p>}
          {t.moneyBack && (
            <span class="inline-flex items-center self-start gap-1.5 px-2 py-0.5 rounded-full border border-success/40 text-success text-[10px] font-semibold uppercase tracking-wider bg-success/10">
              {t.moneyBack}
            </span>
          )}
          <ul class="flex flex-col gap-2.5 text-sm text-muted">
            {t.features.map(f => (
              <li class="flex items-start gap-2">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-success mt-0.5 shrink-0"><path d="M3 8.5L6 11.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <a href={t.ctaHref}
             data-tier={t.ctaTier}
             data-cta-anon={t.cta}
             data-cta-authed={t.ctaAuthed}
             class={`tier-cta block text-center px-4 py-2.5 rounded-lg font-semibold text-sm transition ${t.accent ? 'bg-accent text-bg hover:bg-accent-soft' : 'border border-border hover:border-accent text-text'}`}>
            {t.cta}
          </a>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-muted-soft mt-8">Cancel anytime. EU pricing includes VAT MOSS handling.</p>
  </section>

  <!-- Creator economy -->
  <section class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="flex flex-col items-center text-center gap-3 mb-12">
        <p class="eyebrow">Creator economy</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight max-w-2xl">Build skills. Earn forever.</h2>
        <p class="text-muted max-w-2xl">Usage-attributed payouts. Real money for real impact. The more your skill gets installed and run, the more you earn — every month.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {creatorEcon.map(e => (
          <div class="bg-bg-card border border-border rounded-2xl p-5">
            <div class="text-3xl font-semibold text-accent">{e.share}</div>
            <div class="text-sm text-text font-medium mt-1">{e.label}</div>
            <p class="text-xs text-muted mt-2 leading-relaxed">{e.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/publish" class="inline-flex items-center gap-1.5 text-sm text-accent hover:opacity-80">
          Start publishing →
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <div class="flex flex-col items-center text-center gap-3 mb-10">
        <p class="eyebrow">FAQ</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Common questions</h2>
      </div>
      <div class="flex flex-col gap-3">
        {faqs.map(f => (
          <details class="group bg-bg-card border border-border rounded-xl px-5 py-4 open:border-accent/40 transition">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-text">
              <span>{f.q}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-muted-soft transition-transform group-open:rotate-180" aria-hidden="true">
                <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CrossSell variant="banner" title="Need it run for you?" body="WiseChef Framework gives you a managed AI employee — same skills as Recipes, but operated end-to-end. Starting at €199/month." />
</Base>

<script>
  // Smart pricing CTAs (WIS-645): if authed, hit checkout directly;
  // if not, send to /signin?next=/api/checkout/{tier} so the OAuth callback resumes.
  // Auth-aware label swap (WIS-684 follow-up): "Start with Cook" → "Switch to Cook" when logged in.
  (async () => {
    const buttons = document.querySelectorAll<HTMLAnchorElement>('a.tier-cta[data-tier]');
    if (buttons.length === 0) return;

    // Probe auth once on mount and swap labels + highlight current tier.
    let me: any = null;
    try {
      const r = await fetch('/api/auth/me', { credentials: 'include' });
      if (r.ok) me = await r.json();
    } catch { /* ignore */ }

    if (me) {
      const currentTier = (me.subscription_tier || '').toLowerCase();
      buttons.forEach(btn => {
        const tier = (btn.getAttribute('data-tier') || '').toLowerCase();
        const authedLabel = btn.getAttribute('data-cta-authed');
        if (authedLabel) btn.textContent = authedLabel;
        if (currentTier && tier === currentTier) {
          btn.textContent = 'Current plan ✓';
          btn.classList.add('opacity-60', 'pointer-events-none');
          btn.setAttribute('aria-disabled', 'true');
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (btn.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
        const tier = btn.getAttribute('data-tier');
        if (!tier) return;  // Studio "Talk to us" lacks data-tier — falls through to default href
        e.preventDefault();
        const originalText = btn.textContent;
        btn.textContent = 'Loading…';
        if (me) {
          // POST checkout, redirect to Stripe Checkout URL
          try {
            const res = await fetch(`/api/checkout/${tier}`, {
              method: 'POST', credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: '{}',
            });
            if (res.ok) {
              const data = await res.json();
              window.location.href = data.url;
              return;
            }
            // Fall through on error
          } catch { /* fall through */ }
          btn.textContent = originalText;
          window.location.href = btn.getAttribute('href') || '/signin';
        } else {
          // Send to signin with next= so OAuth callback resumes checkout
          window.location.href = btn.getAttribute('href') || '/signin';
        }
      });
    });
  })();
</script>
