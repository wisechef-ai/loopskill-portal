---
import AppShell from '../layouts/AppShell.astro';
import CrossSell from '../components/CrossSell.astro';
import { buildFaqPageSchema, buildAggregateOfferSchema } from '../lib/schema';

// FOUR-WAY HONEST LADDER (Adam, 2026-08-07):
//   "for the pricing i would go on loopskill with the honest info: self host,
//    free, pro and on-demand (contact us); there should be written what is the
//    diff between pro/free — i guess 90% of users might remain on free but
//    it's fine"
//
// Two design consequences of that direction, both deliberate:
//
//  1. SELF-HOST IS ITS OWN COLUMN, not a footnote on Free. It is genuinely a
//     different deal — you run the infrastructure, you owe us nothing, and no
//     account exists. Folding it into "Free" hid the most honest thing we sell.
//
//  2. THE FREE/PRO DIFFERENCE IS STATED AS ONE SENTENCE, not inferred from two
//     feature lists. Previously a visitor had to diff two bullet lists to work
//     out what they were buying. `theDifference` below is that sentence, and it
//     is rendered in its own band above the cards.
//
// Adam expects ~90% to stay on Free and is fine with that. So the copy must NOT
// pressure-sell: no fake scarcity, no "most popular" crown on the paid tier, and
// an explicit "you probably don't need Pro" line. A free user who stays free and
// tells someone else is worth more than a reluctant $9.95.
//
// PRICES MIRROR THE SERVER LADDER (config/tiers.yaml in loopskill-api) — free $0,
// pro $9.95, pro_plus public:false per D-003. Never invent a number here.

const tiers = [
  {
    name: 'Self-host',
    price: '0',
    cadence: 'forever',
    currency: '$',
    tagline: 'Your hardware. Your rules.',
    headline: 'Clone the repo and run the whole platform yourself — registry, runner, catalog. MPL-2.0. No account, no card, nothing phones home. This is the real product, not a trial of it.',
    badgeClass: 'badge-free',
    cta: 'Read the self-host guide',
    ctaAuthed: 'Read the self-host guide',
    ctaHref: 'https://github.com/wisechef-ai/loopskill-api/blob/main/docs/SELF_HOST.md',
    ctaTier: null,
    accent: false,
    features: [
      'The entire platform, MPL-2.0 — no feature held back',
      'Runs on your own hardware; your data never leaves it',
      'Unlimited everything — bundles, loops, installs',
      'No account required at all',
    ],
    notFor: 'You maintain it: updates, uptime, and the runner sandbox are yours.',
    moneyBack: null,
  },
  {
    name: 'Free',
    price: '0',
    cadence: 'forever',
    currency: '$',
    tagline: 'Hosted by us. No card.',
    headline: 'An account on our hosted registry. Browse and install everything, run public loops, and keep 2 private bundles. Most people never need more than this — and that is fine by us.',
    badgeClass: 'badge-free',
    cta: 'Start free',
    ctaAuthed: 'You\'re on Free',
    ctaHref: '/signin?next=/library',
    ctaTier: 'free',
    accent: false,
    features: [
      'Install every public skill and bundle — the whole catalog',
      'Run public loops and get objective pass/fail',
      '2 private bundles',
      'Unlimited PUBLIC bundles — publishing is never rationed',
      'Cross-vendor: Codex, Claude Code, Cursor, OpenClaw, Hermes',
    ],
    notFor: null,
    moneyBack: null,
  },
  {
    name: 'Pro',
    price: '9.95',
    cadence: 'per month',
    currency: '$',
    tagline: 'When 2 private bundles stop being enough.',
    headline: 'Identical platform, one difference that matters: 50 private bundles instead of 2. If you keep a separate private bundle per client, this is the tier that stops getting in your way.',
    badgeClass: 'badge-pro',
    cta: 'Upgrade to Pro — $9.95/mo',
    ctaAuthed: 'Switch to Pro',
    ctaHref: '/signin?next=/api/checkout/pro',
    ctaTier: 'pro',
    accent: true,
    features: [
      '50 private bundles (Free gives you 2)',
      'Everything in Free — nothing is taken away',
      'Priority on catalog fixes and support',
      'Cancel anytime; installed skills keep working',
    ],
    notFor: 'Only worth it if you actually hit the 2-bundle cap. If you haven\'t, stay on Free.',
    moneyBack: null,
  },
  {
    name: 'On-demand',
    price: null,
    cadence: null,
    currency: null,
    tagline: 'Talk to a human.',
    headline: 'Running this inside an organisation with its own security review, procurement, or hosting constraints? That is a conversation, not a checkout button. Tell us the constraint and we will tell you honestly whether we can meet it.',
    badgeClass: 'badge-pro-plus',
    cta: 'Contact us',
    ctaAuthed: 'Contact us',
    ctaHref: 'mailto:hello@loopskill.io?subject=LoopSkill%20on-demand',
    ctaTier: null,
    accent: false,
    features: [
      'Self-hosted deployment support',
      'Security review and compliance questions',
      'Invoicing, procurement, custom terms',
      'Bespoke catalog or private registry work',
    ],
    notFor: 'No published price because there is no standard scope. We quote what you need.',
    moneyBack: null,
  },
];

// The single sentence a visitor came here for. Rendered above the cards so
// nobody has to diff two feature lists to find it.
const theDifference = {
  question: 'What is actually different between Free and Pro?',
  answer: 'Private bundles: Free gives you 2, Pro gives you 50. That is the whole difference.',
  detail: 'Every skill, every public loop, every install, and every capability is identical on both. Public bundles are unlimited on both — we never ration publishing, because a shared bundle helps everyone. Pro exists for people keeping one private bundle per client; if that is not you, Free is not a trial and does not expire.',
};

const faqs = [
  {
    q: 'What is the difference between Self-host and Free?',
    a: 'Who runs the server. Self-host means you clone the repo and run everything on your own hardware — no account, no limits, and we never see your data. Free means we run it for you and you get an account with 2 private bundles. Both cost nothing. Self-host has no caps at all; the trade is that updates, uptime and the runner sandbox are your job.',
  },
  {
    q: 'What is the Founding Member offer?',
    a: 'A launch-day, one-time $49 payment for permanent Pro — not a subscription, never renews, never expires. Capped at 100 seats. Once the counter on this page hits 0, the offer is gone and the button stops working; there is no waitlist or re-open.',
  },
  {
    q: 'Is LoopSkill really open source? What\'s the catch?',
    a: 'Yes — the whole platform is MPL-2.0. You can self-host the registry, the runner, and the catalog on your own hardware for free, forever. There is no feature locked behind Pro that the self-host does not have. Pro raises a hosted convenience limit (private bundles) and funds the hosting; it is not a capability gate.',
  },
  {
    q: 'I only need a couple of bundles. Should I pay?',
    a: 'No. If you are not hitting the 2-private-bundle cap, Free does everything Pro does and we would rather you stayed on it. We expect most people to. Upgrade when the cap actually gets in your way — not before.',
  },
  {
    q: 'Does my install stop working if I cancel Pro?',
    a: 'No. The skills you have already installed keep running on your machine — they live locally, not in our cloud. Cancelling drops you back to the Free limits for private bundles; nothing is deleted and nothing stops executing. You can also switch to the free self-host and keep everything.',
  },
  {
    q: 'Why are public bundles unlimited on every tier?',
    a: 'Because a public bundle helps other people find good skills, and rationing that would be self-defeating. We cap private bundles because those are the ones that consume hosted storage on our side for one person\'s benefit.',
  },
  {
    q: 'Is this a real subscription or one-time?',
    a: 'Real monthly subscription handled by Stripe. EU pricing includes Stripe Tax / VAT MOSS. Receipts come from Stripe — we never custody your money.',
  },
];

// JSON-LD: FAQPage, built FROM the `faqs` array above that ALSO renders the
// visible <details>/<summary> list below — one edit updates both, so the
// schema can never drift from what a visitor reads (AGENTS.md claim-drift
// discipline; see src/lib/schema.ts header).
const faqSchema = buildFaqPageSchema(faqs);

// JSON-LD: AggregateOffer for the PUBLIC price ladder only. HARD CONSTRAINT
// (hub §4 D-003/D-005, enforced by scripts/audit-claims.mjs `unlocked-price`):
// only $0 (Free) and $9.95/mo (Pro) may ever be emitted here. Self-host is a
// genuine $0 offer (the whole platform, MPL-2.0) so it is included; On-demand
// has `price: null` on purpose (hub §4 D-005: "a sales conversation, never an
// automated meter") and is deliberately EXCLUDED — filtering happens here,
// not by trusting the tiers array to stay shaped this way forever.
const siteURL = 'https://app.loopskill.io';
const publicTiers = tiers.filter((t) => t.price !== null);
const offerSchema = buildAggregateOfferSchema(
  publicTiers.map((t) => ({
    name: t.name,
    price: t.price as string,
    priceCurrency: 'USD',
    url: `${siteURL}/pricing`,
    description: t.tagline,
  })),
  `${siteURL}/pricing`,
);
---


<AppShell title="Pricing — LoopSkill" description="Self-host free forever (MPL-2.0), a free hosted account, Pro at $9.95/mo for 50 private bundles, or talk to us for anything bespoke. The only difference between Free and Pro is private bundles: 2 vs 50." mode="public">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(offerSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  </Fragment>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-12">
    <div class="text-center max-w-2xl mx-auto flex flex-col gap-3 mb-10">
      <p class="eyebrow">Pricing</p>
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Open source. Free to run yourself.</h1>
      <p class="text-muted">The whole platform is MPL-2.0. Self-host it for nothing, or let us host it. We expect most people to stay on the free tier — that is the point, not a failure.</p>
    </div>

    {/* The one question the page exists to answer, stated before the cards so
        nobody has to diff two feature lists to find it. */}
    <div class="max-w-3xl mx-auto mb-12 rounded-2xl border border-accent/30 bg-accent/5 p-6 md:p-7">
      <p class="text-xs uppercase tracking-widest font-semibold text-accent mb-2">{theDifference.question}</p>
      <p class="text-lg md:text-xl font-semibold text-text leading-snug mb-3">{theDifference.answer}</p>
      <p class="text-sm text-muted leading-relaxed">{theDifference.detail}</p>
    </div>

    {/* feat/founding — launch-day one-time offer. Hidden by default in
        static HTML (Trap C: both states must exist in markup, JS toggles
        visibility — never bake a build-time branch); client JS below fetches
        GET /api/founding/remaining and only reveals this card + fills the
        live counter when the SKU is configured AND seats remain. On any
        fetch failure or remaining<=0 it stays hidden — fail-closed, matches
        the build-time-fetch-ban contract (no build-time API dependency). */}
    <div id="founding-card" class="max-w-3xl mx-auto mb-10 rounded-2xl border-2 border-accent/60 bg-accent/5 p-6 md:p-7 hidden" style="display: none;">
      <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider border border-accent text-accent bg-bg-elev">LAUNCH OFFER</span>
            <span class="text-xs text-muted-soft">One-time payment, not a subscription</span>
          </div>
          <h3 class="text-xl font-semibold text-text mb-1">Founding Member — $49, forever</h3>
          <p class="text-sm text-muted leading-relaxed">Pay once, get Pro for life. No renewal, no expiry, no card on file after checkout. Capped at 100 seats — when they're gone, they're gone.</p>
          <p class="text-sm font-semibold text-accent mt-2" id="founding-counter" aria-live="polite">&nbsp;</p>
        </div>
        <a href="/signin?next=/api/checkout/founding" data-founding-cta class="shrink-0 text-center px-5 py-3 rounded-lg font-semibold text-sm bg-accent text-bg hover:bg-accent-soft transition">
          Become a Founding Member — $49
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5 max-w-6xl mx-auto items-start">
      {tiers.map(t => (
        <div class={`relative bg-bg-card border ${t.accent ? 'border-accent/60' : 'border-border'} rounded-2xl p-6 flex flex-col gap-4 h-full`}>
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-lg font-semibold text-text">{t.name}</h3>
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider whitespace-nowrap shrink-0 ${t.badgeClass}`}>{t.name.toUpperCase()}</span>
            </div>
            <p class="text-xs text-muted-soft">{t.tagline}</p>
          </div>
          <div class="flex items-baseline gap-1.5 min-h-[3.25rem]">
            {t.price !== null ? (
              <>
                <span class="text-4xl font-semibold text-text">{t.currency}{t.price}</span>
                <span class="text-sm text-muted">{t.cadence === 'forever' ? '· forever' : `/${t.cadence.replace('per ', '')}`}</span>
              </>
            ) : (
              <span class="text-3xl font-semibold text-text self-end pb-1">Let's talk</span>
            )}
          </div>
          {t.headline && <p class="text-sm text-muted leading-relaxed">{t.headline}</p>}
          <ul class="flex flex-col gap-2 text-sm text-muted">
            {t.features.map(f => (
              <li class="flex items-start gap-2">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-success mt-0.5 shrink-0"><path d="M3 8.5L6 11.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          {t.notFor && (
            <p class="text-xs text-muted-soft italic border-t border-border-soft pt-3 mt-1">{t.notFor}</p>
          )}
          <a href={t.ctaHref}
             data-tier={t.ctaTier}
             data-cta-anon={t.cta}
             data-cta-authed={t.ctaAuthed}
             class={`tier-cta block text-center px-4 py-2.5 rounded-lg font-semibold text-sm transition mt-auto ${t.accent ? 'bg-accent text-bg hover:bg-accent-soft' : 'border border-border hover:border-accent text-text'}`}>
            {t.cta}
          </a>
        </div>
      ))}
    </div>

    {/* Free-skills callout — a concrete example that costs nothing, for visitors
        who want to try the engine before creating any account at all. */}
    <div class="max-w-4xl mx-auto mt-6 px-6 py-4 rounded-xl border border-border-soft bg-bg-card/30 flex flex-col md:flex-row items-center justify-between gap-3 text-sm">
      <div class="flex items-center gap-3 text-muted">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider badge-free">FREE</span>
        <span>Open-source skills like <a href="/skills/super-memory" class="text-accent hover:underline">super-memory</a> (MIT) install free. No subscription, no card. <span class="text-muted-soft">Try the engine before you pay.</span></span>
      </div>
      <a href="/skills?tier=free" class="text-xs text-accent hover:underline whitespace-nowrap">Browse free skills →</a>
    </div>

    <p class="text-center text-xs text-muted-soft mt-8">Cancel anytime. EU pricing includes VAT MOSS. Receipts via Stripe.</p>
  </section>

  <section class="border-t border-border">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <div class="flex flex-col items-center text-center gap-3 mb-10">
        <p class="eyebrow">FAQ</p>
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Common questions</h2>
      </div>
      <div class="flex flex-col gap-3">
        {faqs.map(f => (
          <details class="group bg-bg-card border border-border rounded-xl px-5 py-4 open:border-accent/40 transition">
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold text-text">
              <span>{f.q}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-muted-soft transition-transform group-open:rotate-180" aria-hidden="true">
                <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="text-sm text-muted leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CrossSell variant="banner" title="Skip building this yourself." body="WiseChef — the team behind LoopSkill — installs, updates, and runs this exact skill catalog for you, end-to-end, from $199/month." />
</AppShell>

<script>
  (async () => {
    const buttons = document.querySelectorAll<HTMLAnchorElement>('a.tier-cta[data-tier]');
    if (buttons.length === 0) return;

    // Pick up an optional promo code from ?promo=CODE in the URL.
    // Stored on window so the click handler can pass it to /api/checkout.
    const urlParams = new URLSearchParams(window.location.search);
    let promoCode = urlParams.get('promo') || urlParams.get('coupon');
    if (promoCode) {
      promoCode = promoCode.trim().toUpperCase();
      // Surface a small banner so the user knows a code is being applied.
      const banner = document.createElement('div');
      banner.className = 'max-w-3xl mx-auto mt-4 px-6';
      banner.innerHTML = `
        <div class="bg-accent/10 border border-accent/40 rounded-xl px-4 py-3 text-sm flex items-center gap-3">
          <span class="text-accent font-semibold">🎟️ Promo code applied:</span>
          <code class="font-mono text-xs bg-bg-elev border border-border rounded px-2 py-0.5">${promoCode}</code>
          <span class="text-muted text-xs">Discount will appear at checkout.</span>
        </div>`;
      const heroSection = document.querySelector('section');
      heroSection?.parentNode?.insertBefore(banner, heroSection.nextSibling);
    }

    let me: any = null;
    try {
      const r = await fetch('/api/auth/me', { credentials: 'include' });
      if (r.ok) me = await r.json();
    } catch { /* ignore */ }

    // feat/founding — client-side island: reveal the launch card + live
    // counter ONLY on a successful, seats-remaining response. Same-origin
    // relative fetch, matching /api/auth/me's own-origin convention above —
    // portal + API share app.loopskill.io in production.
    (async () => {
      const card = document.getElementById('founding-card');
      const counter = document.getElementById('founding-counter');
      const cta = card?.querySelector<HTMLAnchorElement>('[data-founding-cta]');
      if (!card || !counter || !cta) return;
      try {
        const r = await fetch('/api/founding/remaining', { credentials: 'omit' });
        if (!r.ok) return; // fail closed — stays hidden
        const data = await r.json();
        if (!data.configured || typeof data.remaining !== 'number' || data.remaining <= 0) {
          return; // sold out or not configured — stays hidden
        }
        counter.textContent = `${data.remaining} of ${data.cap} left`;
        card.classList.remove('hidden');
        card.style.display = '';

        if (me) {
          const currentTier = (me.subscription_tier || '').toLowerCase();
          const isFoundingAlready = me.founding_member === true;
          if (isFoundingAlready || currentTier === 'pro' || currentTier === 'pro_plus') {
            cta.textContent = isFoundingAlready ? 'You\u2019re a Founding Member \u2713' : 'Already Pro \u2713';
            cta.classList.add('opacity-60', 'pointer-events-none');
            cta.setAttribute('aria-disabled', 'true');
            return;
          }
        }

        cta.addEventListener('click', async (e) => {
          if (cta.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
          e.preventDefault();
          const originalText = cta.textContent;
          cta.textContent = 'Loading\u2026';
          if (me) {
            try {
              const res = await fetch('/api/checkout/founding', {
                method: 'POST', credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({}),
              });
              if (res.ok) {
                const body = await res.json();
                window.location.href = body.url;
                return;
              }
              if (res.status === 409) {
                cta.textContent = 'Sold out';
                cta.classList.add('opacity-60', 'pointer-events-none');
                cta.setAttribute('aria-disabled', 'true');
                return;
              }
            } catch { /* fall through */ }
            cta.textContent = originalText;
          } else {
            window.location.href = cta.getAttribute('href') || '/signin?next=/api/checkout/founding';
          }
        });
      } catch {
        /* network error — card stays hidden, fail closed */
      }
    })();

    if (me) {
      const currentTier = (me.subscription_tier || '').toLowerCase();
      const isFree = !currentTier || me.subscription_status !== 'active';
      buttons.forEach(btn => {
        const tier = (btn.getAttribute('data-tier') || '').toLowerCase();
        const authedLabel = btn.getAttribute('data-cta-authed');
        if (authedLabel) btn.textContent = authedLabel;
        const isCurrent = (tier === 'free' && isFree) || (tier === currentTier && !isFree);
        if (isCurrent) {
          btn.textContent = 'Current plan ✓';
          btn.classList.add('opacity-60', 'pointer-events-none');
          btn.setAttribute('aria-disabled', 'true');
        }
      });
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        if (btn.getAttribute('aria-disabled') === 'true') { e.preventDefault(); return; }
        const tier = btn.getAttribute('data-tier');
        if (!tier || tier === 'free') return;
        e.preventDefault();
        const originalText = btn.textContent;
        btn.textContent = 'Loading…';
        if (me) {
          try {
            const body: Record<string, string> = {};
            if (promoCode) body.promo_code = promoCode;
            const res = await fetch(`/api/checkout/${tier}`, {
              method: 'POST', credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body),
            });
            if (res.ok) {
              const data = await res.json();
              window.location.href = data.url;
              return;
            }
          } catch { /* fall through */ }
          btn.textContent = originalText;
          // Preserve the promo code through the signin redirect so the
          // user lands back on /pricing?promo=… after auth.
          const next = btn.getAttribute('href') || '/signin';
          if (promoCode && next.includes('/signin')) {
            const sep = next.includes('?') ? '&' : '?';
            window.location.href = `${next}${sep}promo=${encodeURIComponent(promoCode)}`;
          } else {
            window.location.href = next;
          }
        } else {
          const next = btn.getAttribute('href') || '/signin';
          if (promoCode && next.includes('/signin')) {
            const sep = next.includes('?') ? '&' : '?';
            window.location.href = `${next}${sep}promo=${encodeURIComponent(promoCode)}`;
          } else {
            window.location.href = next;
          }
        }
      });
    });
  })();
</script>
