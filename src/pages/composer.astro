---
// /composer — portal_0610 J2: the hero authed surface (L3).
// Multi-select basket over the UNIFIED catalog (curated + federation). Search
// once, add N skills to a working cookbook, reorder, flip visibility inline,
// tier-ghost gated skills (L4), per-skill version-pin (curated-only, L5), and a
// live output panel that emits the share link + per-skill install lines.
//
// All dynamic (client fetch); auth via the AppShell gate + cookie/key. The
// backend contracts it drives: POST /api/cookbooks, POST .../skills,
// PATCH .../visibility, PATCH .../skills/{slug}/pin, PATCH .../reorder,
// DELETE .../skills/{slug}, GET .../install (the install-line source).
import AppShell from '../layouts/AppShell.astro';
---
<AppShell title="Composer — Recipes" active="">
  <section class="max-w-7xl mx-auto px-6 py-8">
    <header class="mb-6 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Composer</h1>
        <p class="text-sm text-muted mt-1">Search the catalog, multi-select, order, share. Compose a cookbook in under a minute.</p>
      </div>
      <div class="flex items-center gap-2">
        <select id="composer-cookbook" class="px-3 py-2 rounded-lg bg-bg-card border border-border text-sm text-text focus:outline-none focus:border-accent max-w-[16rem]">
          <option value="">＋ New cookbook…</option>
        </select>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6">
      <!-- ── LEFT: unified catalog search ──────────────────────────── -->
      <div>
        <div class="flex items-center gap-2 mb-3">
          <input id="composer-search" type="search" placeholder="Search curated + community skills…"
                 class="flex-1 px-4 py-2.5 rounded-lg bg-bg-card border border-border text-sm text-text placeholder:text-muted-soft focus:outline-none focus:border-accent transition" />
        </div>
        <div class="flex flex-wrap gap-2 items-center mb-4" id="composer-zone-facet">
          <span class="text-[10px] uppercase tracking-wider text-muted-soft">Zone:</span>
          <button data-zone="all" class="zone-pill text-[11px] px-2.5 py-1 rounded-full border border-accent text-accent bg-accent/10 transition">All</button>
          <button data-zone="curated" class="zone-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition">Curated</button>
          <button data-zone="community" class="zone-pill text-[11px] px-2.5 py-1 rounded-full border border-border text-muted hover:text-text transition">Community</button>
        </div>
        <div id="composer-results" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="col-span-full text-sm text-muted py-10 text-center" id="composer-results-loading">Loading the catalog…</div>
        </div>
      </div>

      <!-- ── RIGHT: the basket + output ────────────────────────────── -->
      <aside class="lg:sticky lg:top-6 self-start flex flex-col gap-4">
        <div class="bg-bg-card border border-border rounded-2xl p-5">
          <div class="flex items-center justify-between gap-2 mb-3">
            <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-soft">Basket</h2>
            <span id="basket-count" class="text-xs text-muted-soft">0 skills</span>
          </div>
          <div id="basket-list" class="flex flex-col gap-1.5">
            <p id="basket-empty" class="text-xs text-muted py-4 text-center">Add skills from the catalog to start composing.</p>
          </div>

          <!-- Inline visibility toggle (L3) -->
          <div class="mt-4 pt-4 border-t border-border-soft flex items-center justify-between gap-2">
            <span class="text-xs text-muted">Visibility</span>
            <div class="inline-flex rounded-lg border border-border overflow-hidden text-xs" id="vis-toggle">
              <button data-vis="private" class="vis-btn px-3 py-1.5 bg-accent/10 text-accent font-medium">Private</button>
              <button data-vis="public" class="vis-btn px-3 py-1.5 text-muted hover:text-text">Public</button>
            </div>
          </div>
        </div>

        <!-- Live output panel: share link + install lines -->
        <div class="bg-bg-card border border-border rounded-2xl p-5" id="output-panel">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-soft mb-3">Output</h2>
          <div id="output-empty" class="text-xs text-muted py-2">Compose a cookbook to get its share link + install lines.</div>
          <div id="output-body" class="hidden flex-col gap-3">
            <div>
              <div class="text-[10px] uppercase tracking-wider text-muted-soft mb-1">Share link (whole cookbook)</div>
              <div class="flex items-center gap-1.5">
                <code id="out-share" class="font-mono text-[11px] bg-bg-elev border border-border rounded px-2 py-1.5 flex-1 break-all"></code>
                <button data-copy="out-share" class="copy-btn px-2 py-1.5 rounded bg-accent text-bg text-[11px] font-semibold shrink-0">Copy</button>
              </div>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-muted-soft mb-1">Per-skill install lines (in order)</div>
              <div class="flex items-center gap-1.5">
                <pre id="out-lines" class="font-mono text-[11px] bg-bg-elev border border-border rounded px-2 py-1.5 flex-1 overflow-x-auto whitespace-pre"></pre>
                <button data-copy="out-lines" class="copy-btn px-2 py-1.5 rounded bg-accent text-bg text-[11px] font-semibold shrink-0 self-start">Copy</button>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <script>
    type Skill = { slug: string; title: string; description?: string; tier?: string;
                   source?: string; install_path?: string; license?: string;
                   redistributable?: boolean; __community?: boolean };

    const API_BASE = (import.meta as any).env?.PUBLIC_RECIPES_API_BASE || 'https://recipes.wisechef.ai';
    const COMMUNITY_SOURCES = 'hermes-hub,skills-sh,well-known,clawhub,lobehub,browse-sh,github-oss';
    const $ = (id: string) => document.getElementById(id)!;

    const apiKey = (() => { try { return localStorage.getItem('recipes_api_key'); } catch { return null; } })();
    const authHeaders = (extra?: any) => { const h = Object.assign({}, extra || {}); if (apiKey) h['x-api-key'] = apiKey; return h; };
    async function api(path: string, opts: any = {}) {
      return fetch(API_BASE + path, { credentials: 'include', ...opts, headers: authHeaders(opts.headers) });
    }
    function esc(s: any) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'} as any)[c]); }

    // ── caller tier (for L4 tier-ghost) ───────────────────────────────
    let callerTier = 'free';
    const TIER_RANK: Record<string, number> = { free: 1, pro: 2, pro_plus: 3, cook: 2, operator: 3, studio: 3 };
    function canInstall(skillTier?: string) {
      return (TIER_RANK[(callerTier || 'free').toLowerCase()] || 1) >= (TIER_RANK[(skillTier || 'free').toLowerCase()] || 1);
    }

    // ── state ──────────────────────────────────────────────────────────
    let activeZone = 'all';
    let curated: Skill[] = [];
    let community: Skill[] = [];
    let basket: Skill[] = [];        // ordered
    let currentCookbookId: string | null = null;
    let currentVisibility = 'private';
    let searchTimer: number | undefined;

    // ── toast ──────────────────────────────────────────────────────────
    function toast(msg: string, kind?: string) {
      let el = document.getElementById('cmp-toast');
      if (!el) { el = document.createElement('div'); el.id = 'cmp-toast';
        el.style.cssText = 'position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);z-index:80;padding:.6rem 1rem;border-radius:.6rem;font-size:.82rem;font-weight:600;box-shadow:0 6px 24px rgba(0,0,0,.35);';
        document.body.appendChild(el); }
      el.style.background = kind === 'error' ? '#7f1d1d' : 'var(--accent,#6ee7b7)';
      el.style.color = kind === 'error' ? '#fff' : 'var(--bg,#0b0b0c)';
      el.textContent = msg; el.style.opacity = '1';
      setTimeout(() => { el!.style.transition = 'opacity .4s'; el!.style.opacity = '0'; }, 2600);
    }

    // ── load me (tier) + cookbooks dropdown ────────────────────────────
    async function boot() {
      try { const r = await api('/api/auth/me'); if (r.ok) { const u = await r.json();
        const t = (u.subscription_tier || 'free').toLowerCase();
        const active = ['active','trialing','past_due'].includes(u.subscription_status || '');
        callerTier = active ? t : 'free';
      } } catch {}

      const sel = $('composer-cookbook') as HTMLSelectElement;
      try { const r = await api('/api/cookbooks'); if (r.ok) { const d = await r.json();
        const cbs = (d.cookbooks || d.items || d || []);
        cbs.forEach((cb: any) => { const o = document.createElement('option'); o.value = cb.id; o.textContent = cb.name; sel.appendChild(o); });
      } } catch {}

      await loadCatalog('');
      renderResults();
    }

    // ── catalog load (curated + community) ─────────────────────────────
    async function loadCatalog(q: string) {
      // curated
      try {
        const r = await api(`/api/skills/search?page_size=60${q ? '&q=' + encodeURIComponent(q) : ''}`);
        if (r.ok) { const d = await r.json(); curated = (d.results || []).map((s: any) => ({ ...s, __community: false })); }
      } catch { curated = []; }
      // community (only when a query is present OR zone=community; keep cold load light)
      if (q.length >= 2 || activeZone === 'community') {
        try {
          const r = await api(`/api/skills/external?sources=${COMMUNITY_SOURCES}&limit=24${q ? '&q=' + encodeURIComponent(q) : ''}`);
          if (r.ok) { const d = await r.json(); community = (d.external || []).map((s: any) => ({ ...s, __community: true, tier: 'free' })); }
        } catch { community = []; }
      } else { community = []; }
    }

    function inBasket(s: Skill) { return basket.some(b => b.slug === s.slug && !!b.__community === !!s.__community); }

    function skillCard(s: Skill): string {
      const ghost = !s.__community && !canInstall(s.tier);   // L4: tier-ghost gated curated skills
      const added = inBasket(s);
      const tierBadge = s.__community
        ? '<span class="text-[10px] uppercase tracking-wide text-amber-300/80 bg-amber-500/10 border border-amber-500/25 rounded px-1.5 py-0.5">community</span>'
        : `<span class="text-[10px] uppercase tracking-wide ${s.tier && s.tier !== 'free' ? 'text-accent bg-accent/10 border-accent/25' : 'text-muted-soft border-border'} border rounded px-1.5 py-0.5">${esc(s.tier || 'free')}</span>`;
      const btn = ghost
        ? `<a href="/pricing" class="text-[11px] px-2.5 py-1 rounded-lg border border-accent/40 text-accent hover:bg-accent/10 transition">🔒 Unlock with ${esc((s.tier||'pro').replace('_','+'))}</a>`
        : added
          ? `<button class="cmp-add text-[11px] px-2.5 py-1 rounded-lg border border-emerald-500/40 text-emerald-400" data-slug="${esc(s.slug)}" data-community="${s.__community?'1':''}" disabled>✓ Added</button>`
          : `<button class="cmp-add text-[11px] px-2.5 py-1 rounded-lg bg-accent text-bg font-semibold hover:bg-accent-soft transition" data-slug="${esc(s.slug)}" data-community="${s.__community?'1':''}" data-source="${esc(s.source||'')}">+ Add</button>`;
      return `<div class="rounded-xl border ${ghost ? 'border-border-soft opacity-60' : 'border-border'} bg-bg-card p-4 flex flex-col gap-2" data-zone="${s.__community?'community':'curated'}">
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-sm font-semibold text-text leading-tight">${esc(s.title || s.slug)}</h3>
          ${tierBadge}
        </div>
        <p class="text-xs text-muted line-clamp-2 flex-1">${esc(s.description || 'No description.')}</p>
        <div class="flex items-center justify-between gap-2 pt-1">
          <span class="text-[10px] text-muted-soft">${s.__community ? esc(s.source || 'community') : 'curated'}</span>
          ${btn}
        </div>
      </div>`;
    }

    function renderResults() {
      const wrap = $('composer-results');
      let items: Skill[] = [];
      if (activeZone === 'all') items = [...curated, ...community];
      else if (activeZone === 'curated') items = curated;
      else items = community;
      if (!items.length) { wrap.innerHTML = '<div class="col-span-full text-sm text-muted py-10 text-center">No skills match. Try a different search or zone.</div>'; return; }
      wrap.innerHTML = items.map(skillCard).join('');
      wrap.querySelectorAll<HTMLButtonElement>('.cmp-add').forEach(b => {
        b.addEventListener('click', () => {
          const slug = b.dataset.slug!; const isCommunity = !!b.dataset.community;
          const pool = isCommunity ? community : curated;
          const s = pool.find(x => x.slug === slug);
          if (s) addToBasket(s);
        });
      });
    }

    // ── basket ──────────────────────────────────────────────────────────
    function renderBasket() {
      const wrap = $('basket-list'); const empty = $('basket-empty');
      $('basket-count').textContent = `${basket.length} skill${basket.length === 1 ? '' : 's'}`;
      if (!basket.length) { wrap.innerHTML = ''; wrap.appendChild(empty); empty.classList.remove('hidden'); return; }
      empty.classList.add('hidden');
      wrap.innerHTML = basket.map((s, i) => `
        <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-bg-elev border border-border-soft" data-slug="${esc(s.slug)}">
          <div class="flex flex-col leading-tight min-w-0 flex-1">
            <span class="text-xs text-text truncate">${esc(s.title || s.slug)}</span>
            <span class="text-[10px] text-muted-soft">${s.__community ? esc(s.source||'community') : 'curated'}</span>
          </div>
          <div class="flex items-center gap-0.5 shrink-0">
            <button class="bk-up p-1 text-muted-soft hover:text-text ${i === 0 ? 'opacity-30 pointer-events-none' : ''}" data-i="${i}" title="Move up">▲</button>
            <button class="bk-down p-1 text-muted-soft hover:text-text ${i === basket.length-1 ? 'opacity-30 pointer-events-none' : ''}" data-i="${i}" title="Move down">▼</button>
            <button class="bk-rm p-1 text-muted-soft hover:text-red-400" data-i="${i}" title="Remove">✕</button>
          </div>
        </div>`).join('');
      wrap.querySelectorAll<HTMLButtonElement>('.bk-up').forEach(b => b.addEventListener('click', () => moveBasket(+b.dataset.i!, -1)));
      wrap.querySelectorAll<HTMLButtonElement>('.bk-down').forEach(b => b.addEventListener('click', () => moveBasket(+b.dataset.i!, 1)));
      wrap.querySelectorAll<HTMLButtonElement>('.bk-rm').forEach(b => b.addEventListener('click', () => removeBasket(+b.dataset.i!)));
    }
    function moveBasket(i: number, dir: number) {
      const j = i + dir; if (j < 0 || j >= basket.length) return;
      [basket[i], basket[j]] = [basket[j], basket[i]];
      renderBasket(); persistOrder();
    }
    async function removeBasket(i: number) {
      const s = basket[i]; basket.splice(i, 1); renderBasket(); renderResults();
      if (currentCookbookId && s) {
        await api(`/api/cookbooks/${currentCookbookId}/skills/${encodeURIComponent(s.slug)}`, { method: 'DELETE' });
        await refreshOutput();
      }
    }

    // ── ensure a cookbook exists (create on first add if "new") ─────────
    async function ensureCookbook(): Promise<string | null> {
      if (currentCookbookId) return currentCookbookId;
      const sel = $('composer-cookbook') as HTMLSelectElement;
      if (sel.value) { currentCookbookId = sel.value; return currentCookbookId; }
      // create a new cookbook
      const name = `Composer cookbook ${new Date().toISOString().slice(0,10)}`;
      try {
        const r = await api('/api/cookbooks', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name }) });
        if (r.status === 401) { toast('Sign in to compose.', 'error'); return null; }
        if (!r.ok) { toast('Could not create cookbook.', 'error'); return null; }
        const cb = await r.json();
        currentCookbookId = cb.id;
        const o = document.createElement('option'); o.value = cb.id; o.textContent = cb.name; o.selected = true; sel.appendChild(o);
        return currentCookbookId;
      } catch { toast('Network error.', 'error'); return null; }
    }

    async function addToBasket(s: Skill) {
      if (inBasket(s)) return;
      const cbId = await ensureCookbook();
      if (!cbId) return;
      const body: any = s.__community ? { slug: s.slug, external_source: s.source } : { slug: s.slug };
      const r = await api(`/api/cookbooks/${cbId}/skills`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      if (r.status === 201 || r.status === 200) {
        basket.push(s); renderBasket(); renderResults();
        await persistOrder(); await refreshOutput();
        toast(`Added ${s.title || s.slug}`);
      } else if (r.status === 403) {
        const d = await r.json().catch(() => ({}));
        const reason = (d && d.detail && (d.detail.reason || d.detail)) || '';
        toast(String(reason).includes('cap') ? 'Skill cap reached — upgrade to Pro+.' : 'Not allowed on this tier.', 'error');
      } else if (r.status === 401) { toast('Sign in to compose.', 'error'); }
      else { toast(`Could not add (HTTP ${r.status}).`, 'error'); }
    }

    async function persistOrder() {
      if (!currentCookbookId || !basket.length) return;
      await api(`/api/cookbooks/${currentCookbookId}/reorder`, {
        method: 'PATCH', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ order: basket.map(s => s.slug) }),
      }).catch(() => {});
    }

    // ── visibility toggle (L3) ──────────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.vis-btn').forEach(b => {
      b.addEventListener('click', async () => {
        const vis = b.dataset.vis!;
        currentVisibility = vis;
        document.querySelectorAll<HTMLButtonElement>('.vis-btn').forEach(x => {
          const on = x.dataset.vis === vis;
          x.classList.toggle('bg-accent/10', on); x.classList.toggle('text-accent', on); x.classList.toggle('font-medium', on);
          x.classList.toggle('text-muted', !on);
        });
        if (currentCookbookId) {
          await api(`/api/cookbooks/${currentCookbookId}/visibility`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ visibility: vis }) }).catch(() => {});
          await refreshOutput();
        }
      });
    });

    // ── live output panel ───────────────────────────────────────────────
    async function refreshOutput() {
      if (!currentCookbookId || !basket.length) { $('output-empty').classList.remove('hidden'); $('output-body').classList.add('hidden'); $('output-body').classList.remove('flex'); return; }
      $('output-empty').classList.add('hidden'); $('output-body').classList.remove('hidden'); $('output-body').classList.add('flex');
      // share link: public page if public, else the install MCP one-liner
      let slug = currentCookbookId;
      try { const r = await api(`/api/cookbooks/${currentCookbookId}`); if (r.ok) { const d = await r.json(); if (d.slug) slug = d.slug; } } catch {}
      const shareUrl = currentVisibility === 'public'
        ? `${location.origin}/cookbooks/p?slug=${encodeURIComponent(String(slug))}`
        : `recipes_cookbook_install(cookbook_id="${currentCookbookId}")`;
      ($('out-share') as HTMLElement).textContent = shareUrl;
      // per-skill install lines, in basket order
      const lines = basket.map(s => s.__community
        ? `# ${s.slug} (community · ${s.source}) — install via cookbook`
        : `recipes_install(slug="${s.slug}")`).join('\n');
      ($('out-lines') as HTMLElement).textContent = lines;
    }

    // copy buttons
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach(b => {
      b.addEventListener('click', async () => {
        const txt = ($(b.dataset.copy!) as HTMLElement).textContent || '';
        try { await navigator.clipboard.writeText(txt); const o = b.textContent; b.textContent = 'Copied ✓'; setTimeout(() => b.textContent = o, 1500); } catch {}
      });
    });

    // ── zone facet + search wiring ──────────────────────────────────────
    document.querySelectorAll<HTMLButtonElement>('.zone-pill').forEach(b => {
      b.addEventListener('click', async () => {
        activeZone = b.dataset.zone!;
        document.querySelectorAll<HTMLButtonElement>('.zone-pill').forEach(x => {
          const on = x.dataset.zone === activeZone;
          x.classList.toggle('border-accent', on); x.classList.toggle('text-accent', on); x.classList.toggle('bg-accent/10', on);
          x.classList.toggle('border-border', !on); x.classList.toggle('text-muted', !on);
        });
        const q = ($('composer-search') as HTMLInputElement).value.trim();
        if (activeZone === 'community' && !community.length) { await loadCatalog(q); }
        renderResults();
      });
    });
    ($('composer-search') as HTMLInputElement).addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim();
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = window.setTimeout(async () => { await loadCatalog(q); renderResults(); }, 300);
    });

    // cookbook selector change → switch working cookbook + load its basket
    ($('composer-cookbook') as HTMLSelectElement).addEventListener('change', async (e) => {
      const id = (e.target as HTMLSelectElement).value;
      currentCookbookId = id || null;
      basket = [];
      if (id) {
        try { const r = await api(`/api/cookbooks/${id}`); if (r.ok) { const d = await r.json();
          const sk = (d.skills || []).filter((x: any) => x.source !== 'disabled');
          basket = sk.map((x: any) => ({ slug: x.slug, title: x.title || x.slug, tier: x.tier, __community: x.source === 'external' }));
          currentVisibility = d.visibility || 'private';
        } } catch {}
      }
      renderBasket(); renderResults(); await refreshOutput();
    });

    boot();
  </script>
</AppShell>
