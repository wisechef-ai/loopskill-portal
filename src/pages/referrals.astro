---
/**
 * /referrals — Phase H server-side auth split.
 *
 * Server-side: fetch /api/auth/me with cookie passthrough.
 * - Authenticated user → ReferralDashboard (shows referral_code, stats, payout_status)
 * - Anonymous visitor  → ReferralPitch (sign-up / how-it-works pitch)
 *
 * This eliminates the 8 stray /signin?mode=signup CTAs visible to logged-in users
 * and removes the client-side flash-of-wrong-content.
 */
import Base from '../layouts/Base.astro';
import ReferralDashboard from '../components/ReferralDashboard.astro';
import ReferralPitch from '../components/ReferralPitch.astro';

const cookieHeader = Astro.request.headers.get('cookie') || '';
let user: { id: string; display_name?: string; referral_code?: string; click_count?: number; conversion_count?: number; mrr_earned?: number; payout_status?: string } | null = null;
try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/auth/me`, {
    headers: { cookie: cookieHeader },
  });
  if (res.ok) user = await res.json();
} catch {} // Rationale: anon fallback is safe; API may be unavailable at build time
---

<Base
  title="Share Recipes. Keep half the revenue, forever. — Referrals"
  description="Earn 50% recurring rev-share on every Pro and Pro+ subscriber you refer. No caps. No fine print. Share your code, earn every month they're subscribed."
>
  {user ? <ReferralDashboard user={user} /> : <ReferralPitch />}
</Base>
