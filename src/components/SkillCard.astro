---
// Skill card used on /skills and on the 6 vertical landing pages.
// install_count_total comes straight from /api/skills/search — no
// hardcoded "0 installs" fallback. If the field is missing (older
// API response) we omit the install line entirely rather than lying.
import { tierBadge, tierBadgeClass } from '../lib/tiers';
interface Props {
  skill: {
    slug: string;
    title: string;
    description?: string;
    category?: string;
    tier?: string;
    install_count_total?: number;
    install_count_7d?: number;
  };
}
const { skill } = Astro.props;
const tier = skill.tier || 'cook';
const tierClass = tierBadgeClass(tier);
const tierDisplay = tierBadge(tier);
const cat = skill.category || 'general';
const total = typeof skill.install_count_total === 'number' ? skill.install_count_total : null;
const last7 = typeof skill.install_count_7d === 'number' ? skill.install_count_7d : null;
---
<a
  href={`/skills/${skill.slug}`}
  class="skill-card group bg-bg-card border border-border rounded-2xl p-5 card-lift flex flex-col gap-3"
  data-tier={tier}
  data-category={cat}
  data-search={`${skill.title} ${skill.description ?? ''} ${skill.slug} ${cat}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-2">
    <h3 class="text-base font-semibold text-text group-hover:text-accent transition leading-tight">{skill.title}</h3>
    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider shrink-0 ${tierClass}`}>{tierDisplay}</span>
  </div>
  {skill.description && <p class="text-sm text-muted leading-relaxed line-clamp-3">{skill.description}</p>}
  <div class="flex items-center justify-between pt-3 border-t border-border-soft text-xs">
    <span class="text-muted-soft capitalize">{cat}</span>
    {total !== null && (
      <span class="text-muted-soft">
        {total.toLocaleString()} installs{last7 ? ` · ${last7.toLocaleString()} this week` : ''}
      </span>
    )}
  </div>
</a>
