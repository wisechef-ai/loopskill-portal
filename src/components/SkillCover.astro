---
// SkillCover — Spotify-style generated "album art" for a skill.
// Full-bleed gradient by category + large white monogram + tier + source.
// Deterministic: same category → same hue. No real images needed (scales to 84k).
interface Props {
  slug: string;
  title?: string;
  category?: string;
  tier?: string;
  source?: string | null; // external registry (clawhub, skills-sh, …) | null = ours
}
const { slug, title, category, tier, source } = Astro.props;
const cat = (category || 'general').toLowerCase();
const grad_palette: [string, string][] = [
  ['#1fb6c0', '#0d7d77'], // teal
  ['#a06bff', '#6d28d9'], // violet
  ['#c084fc', '#7c3aed'], // purple
  ['#ffb446', '#c2410c'], // amber
  ['#ff6e50', '#b91c1c'], // warm-red
  ['#34d399', '#0f766e'], // green
  ['#60a5fa', '#1d4ed8'], // blue
];
const HUES: Record<string, [string, string]> = {
  marketing: grad_palette[0], agency: grad_palette[0],
  research: grad_palette[1], discovery: grad_palette[1],
  content: grad_palette[2], meta: grad_palette[2],
  ops: grad_palette[3], devops: grad_palette[3],
  data: grad_palette[4], planning: grad_palette[4],
  productivity: grad_palette[5], automation: grad_palette[5],
};
// Deterministic slug→hue fallback when category is unknown/unmapped (cookbooks,
// uncategorized skills): hash the slug to a palette index so cards still vary
// instead of all collapsing to one color.
function hashIdx(s: string, n: number): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h % n;
}
const grad = HUES[cat] || grad_palette[hashIdx(slug, grad_palette.length)];
// Monogram: first letter of the TITLE (Spotify-style), fallback slug. Varies per card.
const mono = ((title || slug).trim()[0] || 'R').toUpperCase();
const isPro = tier && tier !== 'free';
const isExt = !!source;
---
<div class="skill-cover" style={`background:linear-gradient(135deg, ${grad[0]} 0%, ${grad[1]} 100%);`}>
  <span class="sc-mono" aria-hidden="true">{mono}</span>
  <div class="sc-badges">
    {isPro && <span class="sc-tier">{(tier || 'pro').toUpperCase()}</span>}
    {isExt && <span class="sc-src">{source}</span>}
    {!isPro && <span class="sc-tier sc-free">FREE</span>}
  </div>
</div>
<style>
  .skill-cover { position:relative; width:100%; aspect-ratio:1/1; border-radius:0.6rem; overflow:hidden; }
  .sc-mono { position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:flex-start; padding:0.5rem 0.7rem; font-size:5rem; font-weight:800; line-height:0.8; color:rgba(255,255,255,0.95); letter-spacing:-0.04em; text-shadow:0 2px 12px rgba(0,0,0,0.25); }
  .sc-badges { position:absolute; top:0.5rem; right:0.5rem; display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem; }
  .sc-tier { font-size:0.56rem; font-weight:700; letter-spacing:0.06em; padding:0.15rem 0.4rem; border-radius:0.4rem; background:rgba(0,0,0,0.45); color:#fff; backdrop-filter:blur(4px); }
  .sc-free { background:rgba(255,255,255,0.92); color:#0a0a0a; }
  .sc-src { font-size:0.52rem; font-weight:600; letter-spacing:0.04em; padding:0.12rem 0.4rem; border-radius:0.4rem; background:rgba(0,0,0,0.4); color:rgba(255,255,255,0.9); text-transform:lowercase; }
</style>
