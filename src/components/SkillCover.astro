---
// SkillCover — Spotify-style generated "album art" for a skill.
// Full-bleed gradient by category + large white monogram + tier + source.
// Deterministic: same category → same hue. No real images needed (scales to 84k).
interface Props {
  slug: string;
  title?: string;
  category?: string;
  tier?: string;
  source?: string | null; // external registry (clawhub, skills-sh, …) | null = ours
}
const { slug, title, category, tier, source } = Astro.props;
const cat = (typeof category === 'string' && category ? category : 'general').toLowerCase();
const grad_palette: [string, string][] = [
  ['#1fb6c0', '#0d7d77'], // teal
  ['#a06bff', '#6d28d9'], // violet
  ['#c084fc', '#7c3aed'], // purple
  ['#ffb446', '#c2410c'], // amber
  ['#ff6e50', '#b91c1c'], // warm-red
  ['#34d399', '#0f766e'], // green
  ['#60a5fa', '#1d4ed8'], // blue
];
const HUES: Record<string, [string, string]> = {
  marketing: grad_palette[0], agency: grad_palette[0],
  research: grad_palette[1], discovery: grad_palette[1],
  content: grad_palette[2], meta: grad_palette[2],
  ops: grad_palette[3], devops: grad_palette[3],
  data: grad_palette[4], planning: grad_palette[4],
  productivity: grad_palette[5], automation: grad_palette[5],
};
// Deterministic slug→hue fallback when category is unknown/unmapped (bundles,
// uncategorized skills): hash the slug to a palette index so cards still vary
// instead of all collapsing to one color.
function hashIdx(s: string, n: number): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return h % n;
}
const grad = HUES[cat] || grad_palette[hashIdx(slug, grad_palette.length)];
// Monogram: first letter of the TITLE (Spotify-style), fallback slug. Varies per card.
const mono = ((title || slug).trim()[0] || 'L').toUpperCase();
const isPro = tier && tier !== 'free';
const isExt = !!source;

// Badge label normalization (loopskill_portal_0627): the rename + open-core
// repricing mean raw tier slugs must render as human labels — cookbook→BUNDLE,
// pro_plus→legacy PRO+, etc. Never surface the raw underscore slug on a card.
const TIER_BADGE: Record<string, string> = {
  cookbook: 'BUNDLE',
  bundle: 'BUNDLE',
  pro_plus: 'PRO+',
  operator: 'PRO+',
  studio: 'PRO+',
  cook: 'PRO',
  pro: 'PRO',
};
const tierLabel = isPro ? (TIER_BADGE[(tier || '').toLowerCase()] || (tier || 'pro').toUpperCase()) : 'FREE';

// Per-category watermark glyph paths (stroke icons, 24×24 viewBox).
// Keyed by the same `cat` string used for HUES above.
const GLYPHS: Record<string, string> = {
  // marketing / agency → megaphone with sound waves
  marketing: 'M3 10v4h4l5 3.5V6.5L7 10H3zm11-1.5a5 5 0 0 1 0 7M17 6a8 8 0 0 1 0 12',
  agency:    'M3 10v4h4l5 3.5V6.5L7 10H3zm11-1.5a5 5 0 0 1 0 7M17 6a8 8 0 0 1 0 12',
  // research / discovery → magnifying glass
  research:  'M21 21l-5.2-5.2M16 11a7 7 0 1 1-14 0 7 7 0 0 1 14 0z',
  discovery: 'M21 21l-5.2-5.2M16 11a7 7 0 1 1-14 0 7 7 0 0 1 14 0z',
  // content / meta → 4-point sparkle
  content:   'M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z',
  meta:      'M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z',
  // ops / devops → gear (8-spoke sun + center circle)
  ops:    'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.41 1.41m9.9 9.9 1.41 1.41M5.64 18.36l1.41-1.41m9.9-9.9 1.41-1.41',
  devops: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM12 3v2m0 14v2M3 12h2m14 0h2M5.64 5.64l1.41 1.41m9.9 9.9 1.41 1.41M5.64 18.36l1.41-1.41m9.9-9.9 1.41-1.41',
  // data / planning → database cylinder (ellipse top + sides + middle ring + bottom arc)
  data:     'M5 6a7 2.5 0 0 1 14 0a7 2.5 0 0 1-14 0zM5 6v12m14-12v12M5 18a7 2.5 0 0 0 14 0M5 12a7 2.5 0 0 0 14 0',
  planning: 'M5 6a7 2.5 0 0 1 14 0a7 2.5 0 0 1-14 0zM5 6v12m14-12v12M5 18a7 2.5 0 0 0 14 0M5 12a7 2.5 0 0 0 14 0',
  // productivity / automation → lightning bolt
  productivity: 'M13 2 4 13h7l-2 9 11-12h-7z',
  automation:   'M13 2 4 13h7l-2 9 11-12h-7z',
};
// Fallback for unknown/uncategorized: hexagon
const glyph: string = GLYPHS[cat] ?? 'M12 2l9 5v10l-9 5-9-5V7z';

// feat/fleet-console-ui — identicon blocks (Adam picked GitHub-avatar style):
// 5×5 mirrored geometric pattern hashed from the slug, layered over the
// gradient. Deterministic + zero-storage → scales to the 84k federated
// catalog. The monogram letter stays but drops to a corner accent.
import { identiconRects } from '../lib/identicon';
const idRects = identiconRects(slug);
---
<div class="skill-cover" style={`background:linear-gradient(135deg, ${grad[0]} 0%, ${grad[1]} 100%);`}>
  <svg class="sc-identicon" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" set:html={idRects} />
  <svg class="sc-glyph" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={glyph} />
  </svg>
  <span class="sc-mono" aria-hidden="true">{mono}</span>
  <div class="sc-badges">
    {isPro && <span class="sc-tier">{tierLabel}</span>}
    {isExt && <span class="sc-src">{source}</span>}
    {!isPro && <span class="sc-tier sc-free">FREE</span>}
  </div>
</div>
<style>
  .skill-cover { position:relative; width:100%; aspect-ratio:1/1; border-radius:0.6rem; overflow:hidden; }
  .sc-identicon { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; }
  .sc-glyph { position:absolute; width:52%; height:52%; top:-2%; right:-2%; opacity:0.12; pointer-events:none; }
  .sc-mono { position:absolute; inset:0; display:flex; align-items:flex-end; justify-content:flex-start; padding:0.45rem 0.6rem; font-size:2.2rem; font-weight:800; line-height:0.8; color:rgba(255,255,255,0.92); letter-spacing:-0.04em; text-shadow:0 2px 10px rgba(0,0,0,0.35); }
  .sc-badges { position:absolute; top:0.5rem; right:0.5rem; display:flex; flex-direction:column; align-items:flex-end; gap:0.25rem; }
  .sc-tier { font-size:0.56rem; font-weight:700; letter-spacing:0.06em; padding:0.15rem 0.4rem; border-radius:0.4rem; background:rgba(0,0,0,0.45); color:#fff; backdrop-filter:blur(4px); }
  .sc-free { background:rgba(255,255,255,0.92); color:#0a0a0a; }
  .sc-src { font-size:0.52rem; font-weight:600; letter-spacing:0.04em; padding:0.12rem 0.4rem; border-radius:0.4rem; background:rgba(0,0,0,0.4); color:rgba(255,255,255,0.9); text-transform:lowercase; }
</style>
