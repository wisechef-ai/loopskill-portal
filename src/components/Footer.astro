---
// Build-time stamp for the "Last audited" footer line. Surfaced on every page.
const lastAuditedAt = new Date().toISOString().slice(0, 10);
---
<footer class="border-t border-border mt-24">
  <div class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-2 md:grid-cols-5 gap-8 text-sm text-muted">
    <div class="col-span-2 flex flex-col gap-2">
      <span class="text-text font-semibold">Recipes</span>
      <span class="text-xs text-muted-soft">Built by <a href="https://wisechef.ai" class="text-muted hover:text-accent transition underline underline-offset-2">WiseChef</a></span>
      <span class="text-xs text-muted-soft">Kraków, Poland</span>
      <span class="text-xs text-muted-soft mt-2">© 2026 WiseChef</span>
    </div>
    <div class="flex flex-col gap-2">
      <span class="text-text font-medium text-xs uppercase tracking-wider mb-1">Marketplace</span>
      <a href="/skills" class="hover:text-text transition">Skills</a>
      <a href="/carousel" class="hover:text-text transition">Today's 7</a>
      <a href="/pricing" class="hover:text-text transition">Pricing</a>
      <a href="https://tally.so/r/CHANGE-ME-RECIPES-REQUEST" class="hover:text-text transition">Request a skill</a>
    </div>
    <div class="flex flex-col gap-2">
      <span class="text-text font-medium text-xs uppercase tracking-wider mb-1">Resources</span>
      <a href="/docs" class="hover:text-text transition">Docs</a>
      <a href="/docs/api-reference" class="hover:text-text transition">API reference</a>
      <a href="/docs/install" class="hover:text-text transition">Install guide</a>
      <a href="/skill" class="hover:text-text transition">Meta-skill (.md)</a>
      <a href="/security" class="hover:text-text transition">Security &amp; audit</a>
    </div>
    <div class="flex flex-col gap-2">
      <span class="text-text font-medium text-xs uppercase tracking-wider mb-1">WiseChef</span>
      <a href="https://wisechef.ai" class="hover:text-text transition">Home</a>
      <a href="https://wisechef.ai/framework" class="hover:text-text transition">Framework</a>
      <a href="https://wisechef.ai/rescue" class="hover:text-text transition">Rescue</a>
      <a href="https://wisechef.ai/visibility" class="hover:text-text transition">Visibility</a>
      <a href="https://wisechef.ai/consulting" class="hover:text-text transition">Consulting</a>
    </div>
  </div>
  <div class="border-t border-border-soft">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-2 text-[11px] text-muted-soft">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="https://github.com/wisechef-ai/recipes-skill" target="_blank" rel="noopener" class="hover:text-accent transition inline-flex items-center gap-1.5" data-footer-github>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.4c-2.23.48-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.66 3.96.29.25.55.74.55 1.49v2.21c0 .21.15.46.55.38A8 8 0 0 0 8 0z"/></svg>
          GitHub
        </a>
        <span data-footer-license>Apache-2.0</span>
        <a href="/security" class="hover:text-accent transition" data-footer-audited>
          Last audited <time datetime={lastAuditedAt}>{lastAuditedAt}</time>
        </a>
      </div>
      <span class="text-muted-soft/70">recipes.wisechef.ai</span>
    </div>
  </div>
</footer>
