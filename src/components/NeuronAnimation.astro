---
// Astral neuron animation in chef-hat shape — visible drift, traveling pulses along edges,
// brighter nodes. Pure canvas, no deps, respects prefers-reduced-motion.
---
<div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden" id="neuron-bg" aria-hidden="true">
  <canvas id="neuron-canvas" class="w-full h-full"></canvas>
</div>

<style>
  #neuron-bg {
    mask-image: radial-gradient(ellipse 90% 80% at 50% 35%, black 50%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 50% 35%, black 50%, transparent 95%);
  }
</style>

<script>
  type Node = { x: number; y: number; baseX: number; baseY: number; r: number; hue: 0 | 1; phase: number };
  type Edge = { a: number; b: number; len: number; pulse: number; pulseSpeed: number };

  (() => {
    const canvas = document.getElementById('neuron-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const ACCENT = [255, 209, 102] as const; // amber
    const COOL = [125, 211, 192] as const;    // teal
    let dpr = Math.max(1, window.devicePixelRatio || 1);
    let W = 0, H = 0;
    let nodes: Node[] = [];
    let edges: Edge[] = [];
    let t = 0;

    // Shape: chef hat in a [-1,1] × [-1,1] box. Top puff is an ellipse, band is a rounded rect.
    function inHat(x: number, y: number): boolean {
      const inPuff =
        (x*x) / (0.95*0.95) + ((y + 0.2)*(y + 0.2)) / (0.55*0.55) < 1 && y < 0.32;
      const inBand = Math.abs(x) < 0.55 && y >= 0.32 && y < 0.62;
      return inPuff || inBand;
    }

    function resize() {
      const rect = canvas!.parentElement!.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      regenerate();
    }

    function regenerate() {
      nodes = [];
      edges = [];
      const targetCount = Math.min(110, Math.max(55, Math.floor(W * H / 14000)));
      const cx = W / 2;
      const cy = H * 0.48;
      const scale = Math.min(W * 0.45, H * 0.62);

      let attempts = 0;
      while (nodes.length < targetCount && attempts < targetCount * 80) {
        attempts++;
        const nx = Math.random() * 2 - 1;
        const ny = Math.random() * 2 - 1;
        if (!inHat(nx, ny)) continue;
        const x = cx + nx * scale;
        const y = cy + ny * scale;
        // Hue: amber (0) on right/top, teal (1) on left/bottom — mirrors the logo
        const useAmber = nx + ny * 0.4 > -0.05 ? 1 : 0;
        nodes.push({
          x, y,
          baseX: x, baseY: y,
          r: 0.8 + Math.random() * 1.6,
          hue: useAmber === 1 ? 0 : 1,
          phase: Math.random() * Math.PI * 2,
        });
      }

      // Build a sparse network — each node connects to 2-3 nearest neighbours
      for (let i = 0; i < nodes.length; i++) {
        const dists: { j: number; d: number }[] = [];
        for (let j = 0; j < nodes.length; j++) {
          if (i === j) continue;
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          dists.push({ j, d: Math.sqrt(dx*dx + dy*dy) });
        }
        dists.sort((a, b) => a.d - b.d);
        const k = 2 + Math.floor(Math.random() * 2);
        for (let n = 0; n < k && n < dists.length; n++) {
          if (dists[n].d > scale * 0.5) continue;
          // Avoid duplicates
          const a = i, b = dists[n].j;
          if (edges.find(e => (e.a === a && e.b === b) || (e.a === b && e.b === a))) continue;
          edges.push({ a, b, len: dists[n].d, pulse: Math.random(), pulseSpeed: 0.3 + Math.random() * 0.4 });
        }
      }
    }

    function frame() {
      if (!ctx) return;
      t += 0.016;

      ctx.clearRect(0, 0, W, H);

      // Drift each node — visible amplitude
      for (const n of nodes) {
        n.x = n.baseX + Math.sin(t * 0.7 + n.phase) * 4.5;
        n.y = n.baseY + Math.cos(t * 0.6 + n.phase * 1.3) * 4.5;
      }

      // Edges + traveling pulses
      ctx.lineCap = 'round';
      for (const e of edges) {
        const a = nodes[e.a], b = nodes[e.b];
        const sameHue = a.hue === b.hue;
        const c = sameHue ? (a.hue === 0 ? ACCENT : COOL) : ACCENT; // mixed defaults to amber

        // Base line
        ctx.strokeStyle = `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0.18)`;
        ctx.lineWidth = 0.8;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();

        // Pulse traveling along the edge
        e.pulse += 0.008 * e.pulseSpeed;
        if (e.pulse > 1.4) e.pulse = -0.4;
        if (e.pulse >= 0 && e.pulse <= 1) {
          const px = a.x + (b.x - a.x) * e.pulse;
          const py = a.y + (b.y - a.y) * e.pulse;
          // Soft glow blob travelling along
          const grad = ctx.createRadialGradient(px, py, 0, px, py, 14);
          grad.addColorStop(0, `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0.95)`);
          grad.addColorStop(0.4, `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0.35)`);
          grad.addColorStop(1, `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0)`);
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(px, py, 14, 0, Math.PI * 2);
          ctx.fill();
          // Bright core
          ctx.fillStyle = `rgba(${c[0]}, ${c[1]}, ${c[2]}, 1)`;
          ctx.beginPath();
          ctx.arc(px, py, 1.6, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Nodes
      for (const n of nodes) {
        const c = n.hue === 0 ? ACCENT : COOL;
        const breathe = 0.6 + Math.sin(t * 0.9 + n.phase) * 0.4;
        const glowR = n.r * (5 + breathe * 3);
        // Outer glow
        const grad = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, glowR);
        grad.addColorStop(0, `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${0.55 * breathe})`);
        grad.addColorStop(0.4, `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${0.18 * breathe})`);
        grad.addColorStop(1, `rgba(${c[0]}, ${c[1]}, ${c[2]}, 0)`);
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(n.x, n.y, glowR, 0, Math.PI * 2);
        ctx.fill();
        // Core
        ctx.fillStyle = `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${0.8 + breathe * 0.2})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }

      requestAnimationFrame(frame);
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.addEventListener('resize', () => { dpr = Math.max(1, window.devicePixelRatio || 1); resize(); });
    resize();
    if (reduce) {
      // Render a single static frame
      frame();
    } else {
      requestAnimationFrame(frame);
    }
  })();
</script>
