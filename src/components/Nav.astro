---
const nav = [
  { href: '/skills', label: 'Skills' },
  { href: '/carousel', label: 'Carousel' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/docs/getting-started', label: 'Docs' },
  { href: '/publish', label: 'Publish' },
];

const current = Astro.url.pathname;
---

<header class="nav-header">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Recipes home">
      <span class="nav-logo">🍳</span>
      <span class="nav-name">Recipes</span>
      <span class="nav-badge">by WiseChef</span>
    </a>

    <nav class="nav-links" aria-label="Main navigation">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-link', { 'nav-link-active': current.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href="/signin" class="btn-ghost">Sign in</a>
      <a href="/pricing" class="btn-primary">Get access</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="nav-hamburger" aria-label="Toggle menu" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav-mobile" id="nav-mobile">
    {nav.map(({ href, label }) => (
      <a href={href} class="nav-mobile-link">{label}</a>
    ))}
    <div class="nav-mobile-actions">
      <a href="/signin" class="btn-ghost w-full text-center">Sign in</a>
      <a href="/pricing" class="btn-primary w-full text-center">Get access</a>
    </div>
  </div>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10,10,10,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #222;
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-logo { font-size: 1.5rem; }
  .nav-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: #f5f5f5;
    letter-spacing: -0.025em;
  }
  .nav-badge {
    font-size: 0.7rem;
    background: rgba(249,115,22,0.15);
    color: #f97316;
    border: 1px solid rgba(249,115,22,0.3);
    padding: 2px 8px;
    border-radius: 999px;
    font-weight: 500;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }
  .nav-link {
    padding: 0.375rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    color: #888;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover { color: #f5f5f5; background: #1a1a1a; }
  .nav-link-active { color: #f97316 !important; }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .btn-ghost {
    padding: 0.4rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    color: #888;
    text-decoration: none;
    transition: color 0.15s;
  }
  .btn-ghost:hover { color: #f5f5f5; }
  .btn-primary {
    padding: 0.4rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    background: #f97316;
    color: #fff;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-primary:hover { background: #ea6c0c; }
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #f5f5f5;
    border-radius: 2px;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 1rem 1.5rem;
    border-top: 1px solid #222;
    gap: 0.5rem;
    background: #0a0a0a;
  }
  .nav-mobile-link {
    padding: 0.75rem 0;
    color: #888;
    text-decoration: none;
    font-size: 1rem;
    border-bottom: 1px solid #1a1a1a;
  }
  .nav-mobile-link:hover { color: #f5f5f5; }
  .nav-mobile-actions {
    display: flex;
    gap: 0.75rem;
    padding-top: 0.75rem;
  }
  .w-full { width: 100%; }
  .text-center { text-align: center; }

  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-actions { display: none; }
    .nav-hamburger { display: flex; }
    .nav-mobile.open { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => mobile?.classList.toggle('open'));
</script>
