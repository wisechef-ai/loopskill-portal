---
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || (p !== '/' && path.startsWith(p));
---
<header class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md">
  <nav class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-6" aria-label="Main navigation">
    <div class="flex items-center gap-3">
      <a href="https://wisechef.ai"
         class="hidden sm:inline-flex items-center gap-1.5 text-xs text-muted hover:text-text transition rounded px-2 py-1 -ml-2"
         aria-label="Back to WiseChef">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M7.5 9.5L4 6L7.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>WiseChef</span>
      </a>
      <span class="hidden sm:block w-px h-5 bg-border"></span>
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="relative flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-accent/15 to-cool/10 border border-accent/40 transition group-hover:border-accent/70 group-hover:shadow-[0_0_18px_rgba(255,209,102,0.35)]">
          <img src="/brand/mark-96.png?v=2" alt="" width="38" height="38" class="select-none" loading="eager" decoding="sync" />
        </span>
        <span class="text-lg font-semibold tracking-tight text-text group-hover:text-accent transition">
          Recipes
        </span>
        <span class="text-[10px] uppercase tracking-widest text-muted-soft border border-border rounded-full px-1.5 py-0.5">
          beta
        </span>
      </a>
    </div>

    <div class="flex items-center gap-5">
      <div class="hidden md:flex items-center gap-5 text-sm text-muted">
        <a href="/skills" class={`hover:text-text transition ${isActive('/skills') ? 'text-text' : ''}`}>Skills</a>
        <a href="/carousel" class={`hover:text-text transition ${isActive('/carousel') ? 'text-text' : ''}`}>Today's 7</a>
        <a href="/integrations" class={`hover:text-text transition ${isActive('/integrations') ? 'text-text' : ''}`}>Integrations</a>
        <a href="/stats" class={`hover:text-text transition ${isActive('/stats') ? 'text-text' : ''}`}>Stats</a>
        <a href="/graph" class={`hover:text-text transition ${isActive('/graph') ? 'text-text' : ''}`}>Graph</a>
        <a href="/pricing" class={`hover:text-text transition ${isActive('/pricing') ? 'text-text' : ''}`}>Pricing</a>
        <a href="/docs" class={`hover:text-text transition ${isActive('/docs') ? 'text-text' : ''}`}>Docs</a>
      </div>
      <a href="/signin" class="hidden md:inline-flex text-sm text-muted hover:text-text transition px-3 py-1.5 rounded-lg" data-auth-anon>
        Sign in
      </a>
      <a href="/signin?mode=signup"
         class="nav-cta inline-flex items-center justify-center gap-1.5 rounded-full font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
         data-auth-anon>
        <span class="nav-cta-label">Get access</span>
      </a>

      <!-- Authenticated user dropdown — hidden until /api/auth/me confirms auth -->
      <details id="user-menu" class="relative hidden" data-auth-authed>
        <summary class="list-none cursor-pointer flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-bg-card transition">
          <span id="user-avatar" class="w-8 h-8 rounded-full bg-bg-card border border-border flex items-center justify-center text-sm font-semibold text-text overflow-hidden">
            <span id="user-initials">·</span>
          </span>
          <span id="user-name-label" class="hidden md:inline text-sm text-muted max-w-[10rem] truncate">…</span>
          <span id="user-plan-badge" class="hidden md:inline text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-full border border-border-soft text-muted-soft"></span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-64 bg-bg-elev border border-border rounded-xl shadow-xl overflow-hidden z-50">
          <div class="px-4 py-3 border-b border-border bg-bg-card/40">
            <div id="user-menu-name" class="text-sm font-medium text-text truncate">…</div>
            <div id="user-menu-email" class="text-[11px] text-muted-soft truncate">…</div>
            <div id="user-menu-plan" class="hidden mt-2 flex items-center gap-2">
              <span class="text-[10px] uppercase tracking-wider text-muted-soft">Plan</span>
              <span id="user-menu-plan-name" class="text-[11px] font-semibold text-accent"></span>
              <span id="user-menu-plan-renews" class="text-[10px] text-muted-soft"></span>
            </div>
          </div>
          <nav class="flex flex-col text-sm">
            <a href="/library" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Library</a>
            <a href="/pricing" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Plans &amp; billing</a>
            <a href="/skills" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Browse skills</a>
            <button id="signout-btn" type="button" class="text-left px-4 py-3 text-muted hover:text-accent hover:bg-bg-card transition border-t border-border">
              Sign out
            </button>
          </nav>
        </div>
      </details>
      <details class="md:hidden relative" id="mobile-nav">
        <summary class="list-none cursor-pointer p-2 rounded-lg text-muted hover:text-text" aria-label="Open menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect y="3" width="20" height="2" rx="1" fill="currentColor"/>
            <rect y="9" width="20" height="2" rx="1" fill="currentColor"/>
            <rect y="15" width="20" height="2" rx="1" fill="currentColor"/>
          </svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-56 bg-bg-elev border border-border rounded-xl shadow-xl overflow-hidden">
          <nav class="flex flex-col text-sm">
            <a href="/skills" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Skills</a>
            <a href="/carousel" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Today's 7</a>
            <a href="/stats" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Stats</a>
            <a href="/graph" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Graph</a>
            <a href="/pricing" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Pricing</a>
            <a href="/docs" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition">Docs</a>
            <a href="/signin" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition border-t border-border">Sign in</a>
            <a href="https://wisechef.ai" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition border-t border-border">← WiseChef</a>
          </nav>
        </div>
      </details>
    </div>
  </nav>
</header>
<style>
  /* "Get access" CTA — secondary but elevated.
     - Pill shape (rounded-full) for refinement at small sizes
     - Subtle linear gradient from accent → accent-soft for depth
     - Inner highlight (1px top inset) gives it a polished button quality
     - Soft amber glow shadow → button feels alive but not loud
     - Smaller font + tighter padding on mobile so it sits cleanly next to hamburger
     - Larger padding + slight scale-up on hover for affordance */
  .nav-cta {
    background: linear-gradient(180deg, #FFE08A 0%, #FFA320 100%);
    color: #0a0a0a;
    font-size: 0.8rem;
    padding: 0.45rem 0.95rem;
    box-shadow:
      0 0 0 1px rgba(255, 230, 168, 0.85) inset,
      0 1.5px 0 rgba(255, 255, 255, 0.85) inset,
      0 -1.5px 0 rgba(180, 100, 0, 0.30) inset,
      0 6px 16px rgba(255, 161, 50, 0.45),
      0 2px 4px rgba(0, 0, 0, 0.45);
    letter-spacing: 0.01em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .nav-cta:hover {
    background: linear-gradient(180deg, #FFEDA8 0%, #FFB840 100%);
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(255, 240, 190, 0.95) inset,
      0 1.5px 0 rgba(255, 255, 255, 0.95) inset,
      0 -1.5px 0 rgba(180, 100, 0, 0.25) inset,
      0 8px 22px rgba(255, 161, 50, 0.55),
      0 2px 4px rgba(0, 0, 0, 0.45);
  }
  .nav-cta:active {
    transform: translateY(0);
    background: linear-gradient(180deg, #FFC870 0%, #F09010 100%);
    box-shadow:
      0 0 0 1px rgba(255, 209, 102, 0.6) inset,
      0 1px 2px rgba(0, 0, 0, 0.4);
  }
  /* On md+ screens the button sits in a more spacious nav — give it slightly more presence. */
  @media (min-width: 768px) {
    .nav-cta {
      font-size: 0.875rem;
      padding: 0.5rem 1.15rem;
    }
  }
</style>
<script>
  document.querySelectorAll('#mobile-nav nav a').forEach((link) => {
    link.addEventListener('click', () => {
      const d = document.getElementById('mobile-nav') as HTMLDetailsElement | null;
      if (d) d.open = false;
    });
  });

  // Auth-aware nav: poll /api/auth/me on mount, swap anonymous/authed UI
  (async () => {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'include' });
      if (!res.ok) return;  // 401 anon — keep default UI
      const user = await res.json();

      // Hide anon-only buttons, show authed-only buttons + user menu.
      // Use inline style.display to beat Tailwind's md:inline-flex which would
      // otherwise re-show the elements at md+ breakpoints (the "Sign in/Get access
      // still visible while logged in" bug).
      document.querySelectorAll<HTMLElement>('[data-auth-anon]').forEach(el => {
        el.classList.add('hidden');
        el.style.display = 'none';
      });
      document.querySelectorAll<HTMLElement>('[data-auth-authed]').forEach(el => {
        el.classList.remove('hidden');
        el.style.display = '';
        if (el.tagName === 'A' || el.tagName === 'BUTTON') {
          el.classList.add('inline-flex');
        }
      });
      const menu = document.getElementById('user-menu');
      if (menu) menu.classList.remove('hidden');

      // Populate avatar / name
      const initials = (user.display_name || user.email || '?').slice(0, 1).toUpperCase();
      const initialsEl = document.getElementById('user-initials');
      if (initialsEl) initialsEl.textContent = initials;

      const nameLabel = document.getElementById('user-name-label');
      if (nameLabel) nameLabel.textContent = user.display_name || user.email || 'Account';

      // Plan badge — visible top-bar pill + dropdown row.
      const tier: string | undefined = (user.subscription_tier || '').toLowerCase();
      const status: string = user.subscription_status || '';
      const isActive = status === 'active' || status === 'trialing' || status === 'past_due';

      const planBadge = document.getElementById('user-plan-badge');
      if (planBadge && tier && isActive) {
        planBadge.textContent = tier.toUpperCase();
        planBadge.classList.remove('text-muted-soft', 'border-border-soft');
        planBadge.classList.add('text-accent', 'border-accent/40', 'bg-accent/10');
      } else if (planBadge) {
        planBadge.textContent = 'FREE';
      }

      // Dropdown header
      const menuName = document.getElementById('user-menu-name');
      const menuEmail = document.getElementById('user-menu-email');
      const menuPlan = document.getElementById('user-menu-plan');
      const menuPlanName = document.getElementById('user-menu-plan-name');
      const menuPlanRenews = document.getElementById('user-menu-plan-renews');
      if (menuName) menuName.textContent = user.display_name || 'Account';
      if (menuEmail) menuEmail.textContent = user.email || '';
      if (tier && isActive && menuPlan) {
        menuPlan.classList.remove('hidden');
        menuPlan.classList.add('flex');
        if (menuPlanName) menuPlanName.textContent = tier.charAt(0).toUpperCase() + tier.slice(1);
        if (menuPlanRenews && user.subscription_current_period_end) {
          const ts = new Date(user.subscription_current_period_end).getTime();
          if (!isNaN(ts)) {
            const days = Math.max(0, Math.round((ts - Date.now()) / 86400000));
            menuPlanRenews.textContent = `· renews in ${days}d`;
          }
        }
      }

      if (user.avatar_url) {
        const avatar = document.getElementById('user-avatar');
        if (avatar) {
          avatar.innerHTML = `<img src="${user.avatar_url}" alt="" class="w-full h-full object-cover" referrerpolicy="no-referrer"/>`;
        }
      }

      // Mobile nav: replace "Sign in" link with "Library" + "Sign out"
      const mobileNav = document.querySelector('#mobile-nav nav');
      if (mobileNav) {
        const signInLink = mobileNav.querySelector('a[href="/signin"]');
        if (signInLink) {
          signInLink.outerHTML = `
            <a href="/library" class="px-4 py-3 text-muted hover:text-text hover:bg-bg-card transition border-t border-border">Library</a>
            <button type="button" data-mobile-signout class="text-left px-4 py-3 text-muted hover:text-accent hover:bg-bg-card transition border-t border-border">Sign out</button>
          `;
        }
      }

      // Sign out handlers
      const signOut = async () => {
        try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch {}
        // Belt-and-suspenders: clear cookie client-side too
        document.cookie = 'wr_jwt=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
        window.location.href = '/';
      };
      document.getElementById('signout-btn')?.addEventListener('click', signOut);
      document.querySelector('[data-mobile-signout]')?.addEventListener('click', signOut);
    } catch (err) {
      // Silent fail — anon UI is already the default
    }
  })();
</script>
