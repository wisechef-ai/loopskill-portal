---
import AgentMark from './AgentMark.astro';
const compatibleAgents = [
  { name: 'Claude Code', mark: 'claude' },
  { name: 'Cursor', mark: 'cursor' },
  { name: 'OpenClaw', mark: 'openclaw' },
  { name: 'Hermes', mark: 'hermes' },
  { name: 'Cline', mark: 'cline' },
  { name: 'Windsurf', mark: 'windsurf' },
];
---
<div class="border-y border-border bg-bg-card/30">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <p class="text-xs text-muted-soft uppercase tracking-widest md:max-w-[180px]">
        Works with every<br/>major AI agent
      </p>
      <div class="flex flex-wrap items-center gap-x-7 gap-y-4">
        {compatibleAgents.map(a => (
          <div class="flex items-center gap-2 text-muted hover:text-text transition group">
            <AgentMark name={a.mark as any} size={20} class="text-muted group-hover:text-accent transition" />
            <span class="text-sm font-medium tracking-tight">{a.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
