---
const compatibleAgents = [
  { name: 'Claude Code', symbol: 'CC' },
  { name: 'Cursor', symbol: 'CUR' },
  { name: 'OpenClaw', symbol: 'OC' },
  { name: 'Hermes', symbol: 'H' },
  { name: 'Cline', symbol: 'CL' },
  { name: 'Windsurf', symbol: 'WS' },
];
---
<div class="border-y border-border bg-bg-card/30">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <p class="text-xs text-muted-soft uppercase tracking-widest md:max-w-[180px]">
        Works with every<br/>major AI agent
      </p>
      <div class="flex flex-wrap gap-2 md:gap-3">
        {compatibleAgents.map(a => (
          <div class="flex items-center gap-2 px-3 py-1.5 bg-bg-card border border-border rounded-lg text-xs text-muted">
            <span class="font-mono text-[10px] font-bold text-accent bg-accent/10 rounded px-1.5 py-0.5">{a.symbol}</span>
            <span>{a.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
