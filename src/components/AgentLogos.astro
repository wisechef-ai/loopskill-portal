---
const compatibleAgents = [
  { name: 'Claude Code' },
  { name: 'Cursor' },
  { name: 'Codex' },
  { name: 'Hermes' },
  { name: 'OpenClaw' },
  { name: 'Cline' },
  { name: 'Zed' },
];
---
<div class="border-y border-border bg-bg-card/30">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <p class="text-xs text-muted-soft uppercase tracking-widest md:max-w-[180px]">
        Works with every<br/>major AI agent
      </p>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-3">
        {compatibleAgents.map((a, i) => (
          <>
            <span class="text-sm font-semibold tracking-tight text-muted hover:text-accent transition cursor-default">
              {a.name}
            </span>
            {i < compatibleAgents.length - 1 && (
              <span class="text-muted-soft select-none" aria-hidden="true">·</span>
            )}
          </>
        ))}
      </div>
    </div>
  </div>
</div>
