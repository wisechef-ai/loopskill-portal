---
import { META_INSTALL_PHRASE } from '../lib/agentInstall';
// InstallWidget — agent-install dialogue block.
// LoopSkill is installed by telling your agent to fetch its SKILL.md from
// /skill (plain HTTPS, no key for free skills). The optional `loopskill` CLI
// on PyPI is a separate local-diff tool, not the install. This block shows the
// first-contact motion: paste one phrase into your agent's chat.
// Inspired by the larrybrain.com / AgentPact /skill install pattern.

interface Props {
  skillCount?: number;
  // first-impression fix (5): the dialogue below asserted a literal
  // "80,000+ skills" regardless of the caller — bind it to the live
  // federation count (see index.astro's federatedSkillLabel, sourced from
  // /api/skills/external at build time) so it can never drift from the
  // homepage hero/stats strip that uses the same number. Falls back to the
  // last-verified honest floor if a caller doesn't pass one.
  federatedCount?: string;
}

// qa1018 C12: the dialogue no longer repeats the federated count — the hero
// shows each number once, labelled. The props stay declared so existing
// callers type-check; they are intentionally unused.

// The single phrase the user pastes into their agent. This IS the install.
// qa1018 C04 (4 personas): this used to be a private copy with a trailing
// "please" and no https:// — the visible text and the clipboard differed from
// every other surface. It is now the canonical constant; the button copies
// exactly the string rendered in the dialogue below.
const installPhrase = META_INSTALL_PHRASE;
---

<div
  class="install-widget bg-[#0d0d0d] border border-border rounded-2xl overflow-hidden w-full max-w-2xl mx-auto shadow-2xl shadow-black/40"
  data-component="install-widget"
>
  <!-- window chrome -->
  <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-bg-elev">
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
    </div>
    <span class="text-xs text-muted-soft ml-2 font-mono">your agent's chat (example)</span>
    <button
      type="button"
      class="install-copy-btn ml-auto shrink-0 min-h-[44px] px-4 text-xs font-semibold text-text hover:text-accent border border-border rounded-md transition"
      data-copy={installPhrase}
      aria-label="Copy the install phrase for your agent"
    >
      Copy install phrase
    </button>
  </div>

  <!-- you → agent dialogue -->
  <div class="p-5 font-mono text-xs leading-relaxed text-left">
    <div class="text-success">$ you</div>
    <div class="text-text mb-3" data-command>{installPhrase}</div>

    <div class="text-accent">$ agent</div>
    <div class="text-muted mb-1">→ Reading SKILL.md from app.loopskill.io/skill</div>
    <div class="text-muted mb-1">→ I can now search the catalog and install skills (free ones need no key)</div>
    <div class="text-success font-semibold">
      ✓ LoopSkill installed. The curated catalog and the federated index are searchable.
    </div>
    <div class="text-muted mt-2 mb-3">Just tell me what you need.</div>

    <div class="text-success">$ you</div>
    <div class="text-text mb-3">Run the secret-scan loop on my repo before I push</div>

    <div class="text-accent">$ agent</div>
    <div class="text-muted mb-1">→ Running secret-scan-loop under enforced bounds (bounded confinement)</div>
    <div class="text-muted mb-1">→ Scanned working tree · exit 0 · no leaked credentials found</div>
    <div class="text-success font-semibold">
      ✓ Loop passed in 1.2s. Safe to push. Verdict logged to the registry.
    </div>
  </div>

  <!-- runtime affordance -->
  <div class="px-5 py-3 border-t border-border bg-bg-elev/50 text-xs text-muted-soft">
    Paste the first line into your agent's chat and press Enter. Works in Claude Code, Codex, Cursor, Cline, OpenClaw, Hermes &amp; Windsurf.
  </div>
</div>

<script is:inline>
  (function () {
    const widgets = document.querySelectorAll('[data-component="install-widget"]');
    widgets.forEach(function (root) {
      root.querySelectorAll('.install-copy-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.textContent;
            btn.textContent = 'Copied ✓';
            btn.classList.add('text-success');
            setTimeout(function () {
              btn.textContent = original;
              btn.classList.remove('text-success');
            }, 1400);
          } catch {
            // Fallback for older browsers — select the command text instead.
            const cmd = root.querySelector('[data-command]');
            if (!cmd) return;
            const range = document.createRange();
            range.selectNode(cmd);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
        });
      });
    });
  })();
</script>
