---
// InstallWidget — agent-install dialogue block.
// LoopSkill is installed by telling your agent to fetch the skill via MCP —
// NOT via npm/pip/curl (no such package exists). This block shows the actual
// first-contact motion: paste one phrase to your agent, it installs LoopSkill.
// Inspired by the larrybrain.com / AgentPact /skill install pattern.

interface Props {
  skillCount?: number;
}

const { skillCount } = Astro.props;
const countLabel = skillCount && skillCount > 0 ? `${skillCount}+ skills` : 'the full catalog';

// The single phrase the user pastes into their agent. This IS the install.
const installPhrase = 'Install the loopskill skill from app.loopskill.io/skill please';
---

<div
  class="install-widget bg-[#0d0d0d] border border-border rounded-2xl overflow-hidden w-full max-w-2xl mx-auto shadow-2xl shadow-black/40"
  data-component="install-widget"
>
  <!-- window chrome -->
  <div class="flex items-center gap-2 px-4 py-3 border-b border-border bg-bg-elev">
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
    </div>
    <span class="text-xs text-muted-soft ml-2 font-mono">agent session</span>
    <button
      type="button"
      class="install-copy-btn ml-auto shrink-0 px-3 py-1.5 text-[11px] font-semibold text-muted hover:text-accent border border-border-soft rounded-md transition"
      data-copy={installPhrase}
      aria-label="Copy the install phrase for your agent"
    >
      Copy install phrase
    </button>
  </div>

  <!-- you → agent dialogue -->
  <div class="p-5 font-mono text-xs leading-relaxed text-left">
    <div class="text-success">$ you</div>
    <div class="text-text mb-3" data-command>{installPhrase}</div>

    <div class="text-accent">$ agent</div>
    <div class="text-muted mb-1">→ Fetching SKILL.md from app.loopskill.io/skill</div>
    <div class="text-muted mb-1">→ Wiring LoopSkill MCP — run loops · search · install · bundles</div>
    <div class="text-success font-semibold">
      ✓ LoopSkill installed. The runnable registry + <span class="text-text">80,000+ skills</span> — ready.
    </div>
    <div class="text-muted mt-2 mb-3">Just tell me what you need.</div>

    <div class="text-success">$ you</div>
    <div class="text-text mb-3">Run the secret-scan loop on my repo before I push</div>

    <div class="text-accent">$ agent</div>
    <div class="text-muted mb-1">→ Running secret-scan-loop under enforced bounds (bounded confinement)</div>
    <div class="text-muted mb-1">→ Scanned working tree · exit 0 · no leaked credentials found</div>
    <div class="text-success font-semibold">
      ✓ Loop passed in 1.2s. Safe to push. Verdict logged to the registry.
    </div>
  </div>

  <!-- runtime affordance -->
  <div class="px-5 py-3 border-t border-border bg-bg-elev/50 text-[11px] text-muted-soft">
    Works in Claude Code, Cursor, Cline, OpenClaw, Hermes &amp; Windsurf — any MCP-capable agent.
  </div>
</div>

<script is:inline>
  (function () {
    const widgets = document.querySelectorAll('[data-component="install-widget"]');
    widgets.forEach(function (root) {
      root.querySelectorAll('.install-copy-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const text = btn.getAttribute('data-copy') || '';
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('text-success');
            setTimeout(function () {
              btn.textContent = original;
              btn.classList.remove('text-success');
            }, 1400);
          } catch {
            // Fallback for older browsers — select the command text instead.
            const cmd = root.querySelector('[data-command]');
            if (!cmd) return;
            const range = document.createRange();
            range.selectNode(cmd);
            const sel = window.getSelection();
            sel.removeAllRanges();
            sel.addRange(range);
          }
        });
      });
    });
  })();
</script>
