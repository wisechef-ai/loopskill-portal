---
interface Props {
  name: 'claude' | 'cursor' | 'openclaw' | 'hermes' | 'cline' | 'windsurf';
  size?: number;
  class?: string;
}
const { name, size = 16, class: className = '' } = Astro.props;
---
{/* Lightweight, monoline SVG marks. NOT trademark-cloned — abstract glyphs that read as the brand */}
{name === 'claude' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M5 18 L9.5 5.5 H14.5 L19 18 H16 L15 14.5 H9 L8 18 Z M9.7 12 H14.3 L12 6.5 Z" fill="currentColor"/>
  </svg>
)}
{name === 'cursor' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M5 4 L19 12 L5 20 Z" fill="currentColor" stroke="currentColor" stroke-width="0.5" stroke-linejoin="round"/>
  </svg>
)}
{name === 'openclaw' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8 9 L8 16 M12 7 L12 16 M16 9 L16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}
{name === 'hermes' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 3 L12 21 M5 8 L19 8 M7 14 L17 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <circle cx="12" cy="5" r="1.4" fill="currentColor"/>
  </svg>
)}
{name === 'cline' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M7 9 L10 12 L7 15 M13 15 H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'windsurf' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M3 17 C 6 14, 9 14, 12 17 C 15 20, 18 20, 21 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M3 12 C 6 9, 9 9, 12 12 C 15 15, 18 15, 21 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.6"/>
    <path d="M3 7 C 6 4, 9 4, 12 7 C 15 10, 18 10, 21 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.3"/>
  </svg>
)}
