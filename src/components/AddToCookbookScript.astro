---
// fedui_0604 Unit C — shared behaviour for every <AddToCookbook /> button on a page.
// Include ONCE near the end of any page that renders the picker. Reads the API
// base the same way the rest of the portal does (PUBLIC_API_BASE), and uses the
// livefix_0601 cookie+optional-key auth pattern.
// qa0208-w3: LOOPSKILL env preferred, RECIPES fallback (dual-accept window).
const API_BASE = import.meta.env.PUBLIC_LOOPSKILL_API_BASE || import.meta.env.PUBLIC_RECIPES_API_BASE || 'https://app.loopskill.io';
---
<script is:inline define:vars={{ API_BASE }}>
  (function () {
    if (window.__atcInit) return;        // idempotent — only wire once
    window.__atcInit = true;

    // qa0208-w3: loopskill_api_key primary, migrate-on-read from
    // recipes_api_key (is:inline script — no ES module import available,
    // so the readMigratedKey lib logic is duplicated here inline).
    const apiKey = (() => {
      try {
        var v = localStorage.getItem('loopskill_api_key');
        if (v != null) return v;
        var legacy = localStorage.getItem('recipes_api_key');
        if (legacy != null) { try { localStorage.setItem('loopskill_api_key', legacy); } catch (e) {} return legacy; }
        return null;
      } catch (e) { return null; }
    })();
    function authHeaders(extra) {
      const h = Object.assign({}, extra || {});
      if (apiKey) h['x-api-key'] = apiKey;
      return h;
    }

    // ── tiny toast ──────────────────────────────────────────────────────
    let toastTimer = null;
    function toast(msg, kind) {
      let el = document.getElementById('atc-toast');
      if (!el) {
        el = document.createElement('div');
        el.id = 'atc-toast';
        el.style.cssText =
          'position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);z-index:80;' +
          'padding:.6rem 1rem;border-radius:.6rem;font-size:.82rem;font-weight:600;' +
          'box-shadow:0 6px 24px rgba(0,0,0,.35);max-width:90vw;';
        document.body.appendChild(el);
      }
      const ok = kind !== 'error';
      el.style.background = ok ? 'var(--accent, #6ee7b7)' : '#7f1d1d';
      el.style.color = ok ? 'var(--bg, #0b0b0c)' : '#fff';
      el.textContent = msg;
      el.style.opacity = '1';
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { el.style.transition = 'opacity .4s'; el.style.opacity = '0'; }, 3200);
    }

    // ── bundles cache (fetched once per page, refreshed after create) ──
    let bundles = null;     // null = not loaded; [] = loaded-empty; array = loaded
    let authState = 'unknown'; // 'ok' | 'anon'
    async function loadCookbooks(force) {
      if (bundles !== null && !force) return bundles;
      let res;
      try {
        res = await fetch(API_BASE + '/api/cookbooks', { headers: authHeaders(), credentials: 'include' });
      } catch (e) { authState = 'unknown'; return null; }
      if (res.status === 401) { authState = 'anon'; bundles = []; return []; }
      if (!res.ok) { authState = 'unknown'; return null; }
      authState = 'ok';
      let data;
      try { data = await res.json(); } catch (e) { return null; }
      bundles = Array.isArray(data) ? data : (data.cookbooks || data.items || []);
      return bundles;
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    async function addSkill(root, cookbookId, cookbookName) {
      const btn = root.querySelector('.atc-btn');
      const slug = btn.getAttribute('data-atc-slug');
      const external = btn.getAttribute('data-atc-external') || '';
      // spotify_2607 Phase D: personalities and loops have their own
      // cookbook-mutation routes (loopskill-api bundle_routes.py
      // add_personality_to_cookbook / add_loop_to_cookbook) — no body, slug
      // in the URL. Skills keep their existing route + body shape unchanged
      // (external_source is only meaningful there). Defaults to 'skill' so
      // every pre-existing call site (no data-atc-type attribute) is
      // unaffected.
      const atcType = btn.getAttribute('data-atc-type') || 'skill';
      let url;
      let body;
      if (atcType === 'personality') {
        url = API_BASE + '/api/cookbooks/' + encodeURIComponent(cookbookId) + '/personalities/' + encodeURIComponent(slug);
        body = null;
      } else if (atcType === 'loop') {
        url = API_BASE + '/api/cookbooks/' + encodeURIComponent(cookbookId) + '/loops/' + encodeURIComponent(slug);
        body = null;
      } else {
        url = API_BASE + '/api/cookbooks/' + encodeURIComponent(cookbookId) + '/skills';
        body = JSON.stringify(external ? { slug: slug, external_source: external } : { slug: slug });
      }
      let res;
      try {
        res = await fetch(url, {
          method: 'POST',
          headers: authHeaders(body ? { 'content-type': 'application/json' } : {}),
          credentials: 'include',
          body: body,
        });
      } catch (e) { toast('Network error — try again.', 'error'); return; }

      if (res.status === 201 || res.status === 200) {
        toast('Added to ' + cookbookName, 'ok');
        closeAll();
        return;
      }
      if (res.status === 401) { toast('Sign in to save skills.', 'error'); return; }
      if (res.status === 403) {
        let d = {}; try { d = await res.json(); } catch (e) {}
        const reason = (d && d.detail && (d.detail.reason || d.detail)) || '';
        // spotify2607_D MUST-FIX 2: plan §3 Phase D item 7 requires the
        // free-tier cap 403 to use the inline upgrade wall, NEVER a toast or
        // redirect. composer.astro/library.astro's showUpgradeWall() is
        // tightly coupled to a `#basket-list` DOM element that only exists on
        // that page — it cannot be called from here (browse/home/skill-detail
        // cards, /skills/external), so we cannot reuse it directly. Instead
        // this renders a SELF-CONTAINED inline wall inside the picker's own
        // menu (the `.atc-cap` node the markup already carries on every atc
        // root, previously dead/unused), wired to the SAME live
        // POST /api/checkout/pro_plus call — inline, never a toast, never a
        // dead-end redirect to /pricing.
        if (String(reason).indexOf('cap') >= 0) {
          showCapWall(root);
        } else {
          toast('Not allowed on this tier.', 'error');
        }
        return;
      }
      if (res.status === 404) { toast('Skill could not be resolved from its source.', 'error'); return; }
      if (res.status === 422) { toast('Unknown source — cannot add this skill.', 'error'); return; }
      toast('Could not add (HTTP ' + res.status + ').', 'error');
    }

    // ── Inline cap wall — spotify2607_D MUST-FIX 2 ─────────────────────────
    // Renders INSIDE the picker's own `.atc-cap` node (present in every
    // AddToCookbook.astro / external.astro markup instance, previously
    // hidden-and-unused). Live checkout, no toast, no dead-end redirect —
    // matches AGENTS.md's contract for the (composer-page) upgrade wall, just
    // scoped to this picker's own DOM rather than `#basket-list`.
    function showCapWall(root) {
      const list = root.querySelector('.atc-list');
      const loading = root.querySelector('.atc-loading');
      const signin = root.querySelector('.atc-signin');
      const empty = root.querySelector('.atc-empty');
      const cap = root.querySelector('.atc-cap');
      if (!cap) { toast('Skill cap reached — upgrade to Pro+.', 'error'); return; }
      loading.classList.add('hidden');
      signin.classList.add('hidden');
      empty.classList.add('hidden');
      list.innerHTML = '';
      cap.classList.remove('hidden');
      cap.innerHTML =
        '<p class="mb-1.5">Skill cap reached on this tier.</p>' +
        '<button type="button" class="atc-cap-upgrade rounded-md bg-accent text-bg text-xs font-semibold px-2.5 py-1 hover:opacity-90 transition">Upgrade to Pro+ — $100/mo</button>';
      const upgradeBtn = cap.querySelector('.atc-cap-upgrade');
      upgradeBtn.addEventListener('click', async function () {
        upgradeBtn.textContent = 'Loading…'; upgradeBtn.disabled = true;
        let res;
        try {
          res = await fetch(API_BASE + '/api/checkout/pro_plus', {
            method: 'POST',
            headers: authHeaders({ 'content-type': 'application/json' }),
            credentials: 'include',
            body: '{}',
          });
        } catch (e) { res = null; }
        if (res && res.ok) {
          let d; try { d = await res.json(); } catch (e) { d = null; }
          if (d && d.url) { window.location.href = d.url; return; }
        }
        upgradeBtn.textContent = 'Upgrade to Pro+ — $100/mo'; upgradeBtn.disabled = false;
        toast('Checkout unavailable — try again or use /pricing.', 'error');
      });
    }

    async function createAndAdd(root, name) {
      let res;
      try {
        res = await fetch(API_BASE + '/api/cookbooks', {
          method: 'POST',
          headers: authHeaders({ 'content-type': 'application/json' }),
          credentials: 'include',
          body: JSON.stringify({ name: name }),
        });
      } catch (e) { toast('Network error — try again.', 'error'); return; }
      if (res.status === 401) { toast('Sign in to create a bundle.', 'error'); return; }
      if (res.status === 403) { toast('Bundle cap reached — upgrade for more.', 'error'); return; }
      if (res.status !== 201 && res.status !== 200) { toast('Could not create bundle (HTTP ' + res.status + ').', 'error'); return; }
      let cb; try { cb = await res.json(); } catch (e) { toast('Malformed response.', 'error'); return; }
      await loadCookbooks(true);
      await addSkill(root, cb.id, cb.name || name);
    }

    function renderMenu(root) {
      const list = root.querySelector('.atc-list');
      const loading = root.querySelector('.atc-loading');
      const signin = root.querySelector('.atc-signin');
      const empty = root.querySelector('.atc-empty');
      const cap = root.querySelector('.atc-cap');
      loading.classList.add('hidden');
      signin.classList.add('hidden');
      empty.classList.add('hidden');
      // spotify2607_D MUST-FIX 2: clear any inline cap wall left over from a
      // prior open of this same picker — a fresh open must re-attempt the
      // normal bundle list, not keep showing a stale upgrade prompt.
      if (cap) { cap.classList.add('hidden'); cap.innerHTML = ''; }
      list.innerHTML = '';

      if (authState === 'anon') {
        signin.classList.remove('hidden');
        // spotify_2607 Phase D acceptance gate: anonymous users get
        // "Sign in to save" -> /signin?next=<here>, never a silent no-op —
        // and never a bare /signup that drops them back to nowhere.
        const link = signin.querySelector('.atc-signin-link');
        if (link) link.setAttribute('href', '/signin?next=' + encodeURIComponent(location.pathname + location.search));
        return;
      }
      if (!bundles || bundles.length === 0) { empty.classList.remove('hidden'); return; }

      bundles.forEach(function (cb) {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'atc-item w-full text-left rounded-md px-3 py-1.5 text-xs text-text hover:bg-accent/10 hover:text-accent transition truncate';
        item.textContent = cb.name || 'Untitled bundle';
        item.addEventListener('click', function () { addSkill(root, cb.id, cb.name || 'bundle'); });
        list.appendChild(item);
      });
    }

    function closeAll() {
      document.querySelectorAll('[data-atc-root]').forEach(function (r) {
        r.querySelector('.atc-menu').classList.add('hidden');
        const b = r.querySelector('.atc-btn');
        b.setAttribute('aria-expanded', 'false');
        const caret = r.querySelector('.atc-caret');
        if (caret) caret.style.transform = '';
      });
    }

    async function openMenu(root) {
      closeAll();
      const menu = root.querySelector('.atc-menu');
      menu.classList.remove('hidden');
      root.querySelector('.atc-btn').setAttribute('aria-expanded', 'true');
      const caret = root.querySelector('.atc-caret');
      if (caret) caret.style.transform = 'rotate(180deg)';
      root.querySelector('.atc-loading').classList.remove('hidden');
      await loadCookbooks(false);
      renderMenu(root);
    }

    // ── wire every picker on the page (idempotent per-element) ──────────
    function wireRoot(root) {
      if (root.__atcWired) return;
      root.__atcWired = true;
      const btn = root.querySelector('.atc-btn');
      btn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        const isOpen = root.querySelector('.atc-menu').classList.contains('hidden') === false;
        if (isOpen) { closeAll(); } else { openMenu(root); }
      });
      const form = root.querySelector('.atc-new');
      form.addEventListener('submit', function (e) {
        e.preventDefault(); e.stopPropagation();
        const input = root.querySelector('.atc-new-name');
        const name = (input.value || '').trim();
        if (!name) { input.focus(); return; }
        createAndAdd(root, name);
        input.value = '';
      });
      // stop clicks inside the menu from bubbling to the card link
      root.querySelector('.atc-menu').addEventListener('click', function (e) { e.stopPropagation(); });
    }

    function wireAll() {
      document.querySelectorAll('[data-atc-root]').forEach(wireRoot);
    }
    // Expose for pages that render picker markup dynamically (e.g. /skills/external
    // builds cards client-side after this script has already run).
    window.__atcWire = wireAll;
    wireAll();

    document.addEventListener('click', function () { closeAll(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(); });
  })();
</script>
