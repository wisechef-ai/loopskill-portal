---
interface Props {
  name: 'chart' | 'search' | 'document' | 'calendar' | 'mail' | 'lightning' | 'terminal' | 'shield' | 'check' | 'arrow-right' | 'chevron-left' | 'sparkle' | 'box' | 'play';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
---
{name === 'chart' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M3 21V8M3 21H21M3 21L9 15M9 15V21M9 15L15 11M15 21V11M15 11L21 5M21 5V21M21 5H17M21 5V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'search' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
    <path d="M16 16L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M11 8C9.34 8 8 9.34 8 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}
{name === 'document' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M14 3H7C5.9 3 5 3.9 5 5V19C5 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V8L14 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M14 3V8H19" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M9 12H15M9 16H15M9 8H10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}
{name === 'calendar' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M3 10H21" stroke="currentColor" stroke-width="1.6"/>
    <path d="M8 3V7M16 3V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    <circle cx="8" cy="15" r="1" fill="currentColor"/>
    <circle cx="12" cy="15" r="1" fill="currentColor"/>
    <circle cx="16" cy="15" r="1" fill="currentColor"/>
  </svg>
)}
{name === 'mail' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'lightning' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M13 2L4 14H11L11 22L20 10H13L13 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
)}
{name === 'terminal' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
    <path d="M7 9L10 12L7 15M13 15H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'shield' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 3L4 6V12C4 16.5 7 20 12 21C17 20 20 16.5 20 12V6L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    <path d="M9 12L11 14L15 10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'check' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M5 12L10 17L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'arrow-right' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'chevron-left' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}
{name === 'sparkle' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 3V8M12 16V21M3 12H8M16 12H21M5.5 5.5L8.5 8.5M15.5 15.5L18.5 18.5M5.5 18.5L8.5 15.5M15.5 8.5L18.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
)}
{name === 'box' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M21 8L12 3L3 8M21 8V16L12 21L3 16V8M21 8L12 13M3 8L12 13M12 13V21" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
  </svg>
)}
{name === 'play' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M7 5V19L19 12L7 5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" fill="currentColor" fill-opacity="0.2"/>
  </svg>
)}
