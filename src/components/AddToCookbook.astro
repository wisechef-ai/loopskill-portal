---
// fedui_0604 Unit C — reusable "Add to bundle" picker.
//
// Drop-in control rendered on:
//   - catalog skill detail (/skills/[slug])
//   - external/community result cards (/skills/external)
//
// NOTE (2026-07-26 removal pass): previously also rendered on /browse and
// /home CARD surfaces (spotify_2607 Phase D). Adam decided to remove it
// there — "as for the 3 - add button - to me this can be removed from ui as
// i don't see the purpose of it as of now" — because to an anonymous
// visitor it opened a small "Sign in to save" dead-end. The backend routes
// and JS wiring were verified working; this was a deliberate UX/product
// deletion, not a bugfix. This component and its shared script
// (AddToCookbookScript.astro) remain live for the two call sites above.
//
// Markup-only here; the behaviour is a single shared inline script
// (AddToCookbookScript.astro) included ONCE per page. Each button carries
// data-* attributes the script reads:
//   data-atc-slug      catalog slug OR external slug
//   data-atc-external  "" for catalog, the source id (lobehub/clawhub/…) for federated
//   data-atc-type      "skill" | "personality" | "loop" — routes to the
//                      matching cookbook mutation endpoint (spotify_2607
//                      Phase D). Defaults to "skill" when omitted, so every
//                      pre-existing call site (skill detail, /skills/external)
//                      keeps working unchanged.
//
// Auth: cookie (credentials:include) + optional localStorage x-api-key —
// the livefix_0601 pattern from bundles/view.astro. No token = "Sign in to save".
interface Props {
  slug: string;
  /** Federation source id (lobehub/clawhub/skills-sh/browse-sh/well-known/hermes-hub).
   *  Empty/undefined for a curated catalog skill. Only meaningful when type="skill". */
  externalSource?: string;
  /** Artifact type — routes to the matching bundle mutation endpoint. Default "skill". */
  type?: 'skill' | 'personality' | 'loop';
  /** Visual size — "sm" for cards, "md" for the detail page. */
  size?: 'sm' | 'md';
  class?: string;
}
const { slug, externalSource = '', type = 'skill', size = 'sm', class: extraClass = '' } = Astro.props;
const pad = size === 'md' ? 'px-4 py-2 text-sm' : 'px-3 py-1.5 text-xs';
---
<div class={`atc-wrap relative inline-block ${extraClass}`} data-atc-root>
  <button
    type="button"
    class={`atc-btn inline-flex items-center gap-1.5 rounded-lg border border-border text-text hover:border-accent hover:text-accent transition font-semibold ${pad}`}
    data-atc-slug={slug}
    data-atc-external={externalSource}
    data-atc-type={type}
    aria-haspopup="true"
    aria-expanded="false"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 5v14M5 12h14" />
    </svg>
    <span class="atc-label">Add to bundle</span>
    <svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="atc-caret transition-transform" aria-hidden="true">
      <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <!-- Dropdown (hidden until opened; populated client-side) -->
  <div
    class="atc-menu hidden absolute right-0 z-30 mt-1 w-64 rounded-xl border border-border bg-bg-card shadow-xl p-1.5"
    role="menu"
  >
    <div class="atc-list flex flex-col gap-0.5 max-h-56 overflow-y-auto"></div>
    <div class="atc-loading px-3 py-2 text-xs text-muted">Loading your bundles…</div>
    <div class="atc-signin hidden px-3 py-3 text-xs text-muted">
      <a href="/signup" class="atc-signin-link text-accent hover:underline font-semibold">Sign in</a> to save skills to a cookbook.
    </div>
    <div class="atc-empty hidden px-3 py-2 text-xs text-muted">No bundles yet — create one below.</div>
    <div class="atc-cap hidden px-3 py-2 text-xs text-amber-300">
      Skill cap reached on this tier. <a href="/pricing" class="text-accent hover:underline">Upgrade to Pro+</a> for more.
    </div>
    <div class="border-t border-border-soft mt-1 pt-1">
      <form class="atc-new flex items-center gap-1.5 px-1.5 py-1">
        <input
          type="text"
          class="atc-new-name flex-1 rounded-md border border-border-soft bg-bg px-2 py-1 text-xs text-text placeholder:text-muted focus:border-accent focus:outline-none"
          placeholder="＋ New bundle…"
          maxlength="80"
        />
        <button type="submit" class="atc-new-btn rounded-md bg-accent text-bg text-xs font-semibold px-2.5 py-1 hover:opacity-90 transition">Add</button>
      </form>
    </div>
  </div>
</div>
