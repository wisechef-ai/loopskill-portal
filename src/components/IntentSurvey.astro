---
// Exit-intent survey modal (stabilization_2605 phase A).
// Fires once per session via localStorage flag `recipes_intent_survey_v1`.
// POSTs to /api/intent-survey (anonymous, no auth).
---
<div id="intent-survey-root" class="hidden fixed inset-0 z-[80] items-center justify-center p-4 bg-black/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="intent-survey-title">
  <div id="intent-survey-card" class="relative max-w-sm md:max-w-md w-full max-h-[90vh] overflow-y-auto bg-bg-card border border-border rounded-2xl p-5 md:p-7 flex flex-col gap-4 shadow-2xl">
    <button type="button" id="intent-survey-close" class="absolute top-3 right-3 z-10 p-2 -m-2 text-muted-soft hover:text-text touch-manipulation" aria-label="Close survey">
      <svg width="22" height="22" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4 4L14 14M14 4L4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <p class="eyebrow text-xs">Quick check</p>
    <h2 id="intent-survey-title" class="text-xl font-semibold tracking-tight">Help us price this right.</h2>
    <p class="text-xs text-muted-soft">Anonymous. Five questions, ~30 seconds.</p>

    <form id="intent-survey-form" class="flex flex-col gap-4 mt-1">
      <fieldset class="flex flex-col gap-1.5">
        <legend class="text-sm font-medium text-text mb-1">Would you pay $100/mo for the Pro+ bundle (skills + 20 endpoints + fleet sync + framework installer)?</legend>
        <div class="flex gap-2 text-sm">
          <label class="flex-1"><input type="radio" name="q1" value="yes" required class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Yes</span></label>
          <label class="flex-1"><input type="radio" name="q1" value="maybe" class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Maybe</span></label>
          <label class="flex-1"><input type="radio" name="q1" value="no" class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">No</span></label>
        </div>
      </fieldset>

      <label class="flex flex-col gap-1 text-sm">
        <span class="font-medium text-text">What would make $100/mo a no-brainer? <span class="text-muted-soft font-normal">(optional)</span></span>
        <textarea name="q2" rows="2" maxlength="2000" class="bg-bg-base border border-border rounded-md px-3 py-2 text-sm focus:outline-none focus:border-accent"></textarea>
      </label>

      <label class="flex flex-col gap-1 text-sm">
        <span class="font-medium text-text">What would make you NOT subscribe? <span class="text-muted-soft font-normal">(optional)</span></span>
        <textarea name="q3" rows="2" maxlength="2000" class="bg-bg-base border border-border rounded-md px-3 py-2 text-sm focus:outline-none focus:border-accent"></textarea>
      </label>

      <fieldset class="flex flex-col gap-1.5">
        <legend class="text-sm font-medium text-text mb-1">Which best describes you?</legend>
        <div class="grid grid-cols-2 gap-2 text-sm">
          <label><input type="radio" name="q4" value="agency" required class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Agency owner</span></label>
          <label><input type="radio" name="q4" value="solo" class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Solo operator</span></label>
          <label><input type="radio" name="q4" value="dev" class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Developer</span></label>
          <label><input type="radio" name="q4" value="curious" class="peer sr-only"/><span class="block text-center px-3 py-1.5 rounded-md border border-border peer-checked:border-accent peer-checked:bg-accent/10 cursor-pointer transition">Just curious</span></label>
        </div>
      </fieldset>

      <label class="flex flex-col gap-1 text-sm">
        <span class="font-medium text-text">Email if you want updates <span class="text-muted-soft font-normal">(optional, anonymous skip OK)</span></span>
        <input type="email" name="q5" maxlength="512" placeholder="you@example.com" class="bg-bg-base border border-border rounded-md px-3 py-2 text-sm focus:outline-none focus:border-accent"/>
      </label>

      <div class="flex items-center justify-between gap-3 pt-1">
        <button type="button" id="intent-survey-skip" class="text-sm text-muted-soft hover:text-text">Skip</button>
        <button type="submit" id="intent-survey-submit" class="px-4 py-2 rounded-lg bg-accent text-bg font-semibold text-sm hover:bg-accent-soft transition">Send</button>
      </div>
      <p id="intent-survey-status" class="text-xs text-muted-soft text-center hidden"></p>
    </form>
  </div>
</div>

<script>
  const KEY = 'recipes_intent_survey_v1';
  const root = document.getElementById('intent-survey-root');
  const form = document.getElementById('intent-survey-form') as HTMLFormElement | null;
  const closeBtn = document.getElementById('intent-survey-close');
  const skipBtn = document.getElementById('intent-survey-skip');
  const status = document.getElementById('intent-survey-status');

  if (root && form) {
    const seen = (() => { try { return localStorage.getItem(KEY); } catch { return null; } })();
    if (!seen) {
      // Exit-intent: fire when mouse leaves the viewport top, OR after 45s idle, whichever first.
      let armed = true;
      const open = (reason: string) => {
        if (!armed) return;
        armed = false;
        root.classList.remove('hidden');
        root.classList.add('flex');
        try { localStorage.setItem(KEY, reason); } catch {}
      };
      const onLeave = (e: MouseEvent) => {
        if (e.clientY <= 0) open('exit-intent');
      };
      document.addEventListener('mouseout', onLeave);
      const idleTimer = window.setTimeout(() => open('idle-45s'), 45_000);

      const close = () => {
        root.classList.add('hidden');
        root.classList.remove('flex');
        document.removeEventListener('mouseout', onLeave);
        window.clearTimeout(idleTimer);
      };
      closeBtn?.addEventListener('click', close);
      skipBtn?.addEventListener('click', close);

      // Phase D (top1pct_1105) — backdrop tap-to-close, mobile-friendly.
      // The card stops propagation so a tap inside the form doesn't dismiss.
      const card = document.getElementById('intent-survey-card');
      root.addEventListener('click', (e) => {
        if (e.target === root) close();
      });
      card?.addEventListener('click', (e) => e.stopPropagation());
      // Escape key dismisses (keyboard-accessible).
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !root.classList.contains('hidden')) close();
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const payload: Record<string, string> = {};
        ['q1', 'q2', 'q3', 'q4', 'q5'].forEach(k => {
          const v = (fd.get(k) || '').toString().trim();
          if (v) payload[k] = v;
        });
        if (status) {
          status.textContent = 'Sending…';
          status.classList.remove('hidden');
        }
        try {
          const res = await fetch('/api/intent-survey', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            if (status) status.textContent = 'Thanks. Closing…';
            try { localStorage.setItem(KEY, 'submitted'); } catch {}
            window.setTimeout(close, 800);
          } else {
            if (status) status.textContent = 'Could not send — please try again.';
          }
        } catch {
          if (status) status.textContent = 'Network error — please try again.';
        }
      });
    }
  }
</script>
