---
interface Props {
  variant?: 'inline' | 'card' | 'banner';
  title?: string;
  body?: string;
}

const {
  variant = 'card',
  title = 'Want this run for you?',
  body = 'WiseChef ships managed AI employees for marketing agencies. Same skills you see here, run end-to-end as a service. From €199/month.',
} = Astro.props;
---
{variant === 'card' && (
  <aside class="bg-bg-card border border-border rounded-2xl p-6 mt-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <p class="eyebrow">Done-for-you</p>
      <h3 class="text-base font-semibold text-text">{title}</h3>
      <p class="text-sm text-muted max-w-xl">{body}</p>
    </div>
    <a href="https://wisechef.ai/framework"
       class="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold bg-accent text-bg hover:bg-accent-soft transition">
      See WiseChef
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7H11M11 7L7 3M11 7L7 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </aside>
)}

{variant === 'banner' && (
  <aside class="border-y border-border bg-gradient-to-r from-bg via-bg-card to-bg py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex flex-col gap-1.5">
        <p class="eyebrow">Cross-sell · WiseChef</p>
        <h3 class="text-xl md:text-2xl font-semibold text-text tracking-tight">{title}</h3>
        <p class="text-sm text-muted max-w-2xl">{body}</p>
      </div>
      <div class="flex gap-3">
        <a href="https://wisechef.ai" class="px-4 py-2 rounded-lg text-sm font-medium border border-border hover:border-accent text-text transition">Visit WiseChef</a>
        <a href="https://calendar.app.google/P9J9oaiemtHdsvG99" class="px-4 py-2 rounded-lg text-sm font-semibold bg-accent text-bg hover:bg-accent-soft transition">Book a call</a>
      </div>
    </div>
  </aside>
)}

{variant === 'inline' && (
  <p class="text-sm text-muted">
    Want this run for you? <a href="https://wisechef.ai/framework" class="text-accent hover:opacity-80 underline underline-offset-2">See WiseChef →</a>
  </p>
)}
