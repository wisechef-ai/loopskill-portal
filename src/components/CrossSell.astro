---

<!-- WiseChef Cross-Sell Card — shown on every page -->
<aside class="crosssell-card" aria-label="WiseChef cross-sell">
  <div class="crosssell-inner">
    <div class="crosssell-icon">🤝</div>
    <div class="crosssell-body">
      <p class="crosssell-headline">Want this <em>run for you?</em></p>
      <p class="crosssell-sub">
        See WiseChef — managed AI employees for marketing agencies.
        We handle setup, skills, and results. You focus on clients.
      </p>
      <a
        href="https://wisechef.ai/agencies"
        target="_blank"
        rel="noopener noreferrer"
        class="crosssell-cta"
      >
        WiseChef for agencies → wisechef.ai/agencies
      </a>
    </div>
  </div>
</aside>

<style>
  .crosssell-card {
    border: 1px solid rgba(249,115,22,0.35);
    background: rgba(249,115,22,0.06);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
  }
  .crosssell-inner {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .crosssell-icon { font-size: 2rem; flex-shrink: 0; }
  .crosssell-headline {
    font-weight: 700;
    font-size: 1.05rem;
    color: #f5f5f5;
    margin: 0 0 0.25rem;
  }
  .crosssell-headline em { color: #f97316; font-style: normal; }
  .crosssell-sub {
    color: #888;
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .crosssell-cta {
    display: inline-block;
    color: #f97316;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s;
  }
  .crosssell-cta:hover { border-color: #f97316; }
</style>
